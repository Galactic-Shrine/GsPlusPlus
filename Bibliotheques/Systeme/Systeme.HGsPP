/**
 * Bibliothèque système freestanding de Gs++ 0.16.
 * Cette interface n’alloue aucune mémoire et ne dépend d’aucun runtime.
 **/

espace GalacticShrine::GsPP::Intrinseques
{
    naturel32 ChargerAtomique32(volatile naturel32* cible);
    naturel64 ChargerAtomique64(volatile naturel64* cible);
    vide StockerAtomique32(volatile naturel32* cible, naturel32 valeur);
    vide StockerAtomique64(volatile naturel64* cible, naturel64 valeur);
    naturel32 EchangerAtomique32(volatile naturel32* cible, naturel32 valeur);
    naturel64 EchangerAtomique64(volatile naturel64* cible, naturel64 valeur);
    naturel32 AjouterAtomique32(volatile naturel32* cible, naturel32 valeur);
    naturel64 AjouterAtomique64(volatile naturel64* cible, naturel64 valeur);
    naturel32 ComparerEchanger32(
        volatile naturel32* cible, naturel32 attendu, naturel32 desire);
    naturel64 ComparerEchanger64(
        volatile naturel64* cible, naturel64 attendu, naturel64 desire);
    vide BarriereMemoire();
    vide PauseProcesseur();
}

espace GalacticShrine::GsPP::Systeme
{
    structure VueOctets
    {
        octet* Donnees;
        naturel64 Taille;
        alias Data = Donnees;
        alias Size = Taille;
    };

    structure VueTexte
    {
        caractère* Donnees;
        naturel64 Taille;
        alias Data = Donnees;
        alias Size = Taille;
    };

    structure VerrouAtomique
    {
        volatile naturel32 Etat;
        alias State = Etat;
    };

    publique vide RemplirMemoire(
        octet* destination, octet valeur, naturel64 taille);
    publique vide CopierMemoire(
        octet* destination, octet* source, naturel64 taille);
    publique entier32 ComparerMemoire(
        octet* gauche, octet* droite, naturel64 taille);
    publique booléen MemoiresEgales(
        octet* gauche, octet* droite, naturel64 taille);

    publique VueOctets CreerVueOctets(octet* donnees, naturel64 taille);
    publique VueOctets SousVueOctets(
        VueOctets vue, naturel64 debut, naturel64 taille);
    publique booléen VuesOctetsEgales(VueOctets gauche, VueOctets droite);
    publique naturel64 ChercherOctet(VueOctets vue, octet valeur);

    publique naturel64 LongueurTexte(caractère* texte);
    publique VueTexte CreerVueTexte(caractère* texte);
    publique booléen VuesTexteEgales(VueTexte gauche, VueTexte droite);
    publique entier32 ComparerVuesTexte(VueTexte gauche, VueTexte droite);
    publique naturel64 ChercherCaractere(VueTexte vue, caractère valeur);

    publique naturel32 RotationGauche32(naturel32 valeur, naturel32 distance);
    publique naturel64 RotationGauche64(naturel64 valeur, naturel32 distance);
    publique naturel32 RotationDroite32(naturel32 valeur, naturel32 distance);
    publique naturel64 RotationDroite64(naturel64 valeur, naturel32 distance);
    publique naturel32 CompterBitsUn32(naturel32 valeur);
    publique naturel32 CompterBitsUn64(naturel64 valeur);
    publique naturel32 InverserOctets32(naturel32 valeur);
    publique naturel64 InverserOctets64(naturel64 valeur);
    publique booléen EstPuissanceDeux(naturel64 valeur);
    publique naturel64 AlignerSuperieur(naturel64 valeur, naturel64 alignement);

    publique naturel32 ChargerAtomique32(volatile naturel32* cible);
    publique naturel64 ChargerAtomique64(volatile naturel64* cible);
    publique vide StockerAtomique32(volatile naturel32* cible, naturel32 valeur);
    publique vide StockerAtomique64(volatile naturel64* cible, naturel64 valeur);
    publique naturel32 EchangerAtomique32(
        volatile naturel32* cible, naturel32 valeur);
    publique naturel64 EchangerAtomique64(
        volatile naturel64* cible, naturel64 valeur);
    publique naturel32 AjouterAtomique32(
        volatile naturel32* cible, naturel32 valeur);
    publique naturel64 AjouterAtomique64(
        volatile naturel64* cible, naturel64 valeur);
    publique naturel32 ComparerEchanger32(
        volatile naturel32* cible, naturel32 attendu, naturel32 desire);
    publique naturel64 ComparerEchanger64(
        volatile naturel64* cible, naturel64 attendu, naturel64 desire);
    publique vide BarriereMemoire();
    publique vide PauseProcesseur();
    publique vide InitialiserVerrou(VerrouAtomique* verrou);
    publique booléen EssayerAcquerirVerrou(VerrouAtomique* verrou);
    publique vide AcquerirVerrou(VerrouAtomique* verrou);
    publique vide LibererVerrou(VerrouAtomique* verrou);

    alias FillMemory = RemplirMemoire;
    alias CopyMemory = CopierMemoire;
    alias CompareMemory = ComparerMemoire;
    alias MemoryEqual = MemoiresEgales;
    alias MakeByteView = CreerVueOctets;
    alias SubByteView = SousVueOctets;
    alias ByteViewsEqual = VuesOctetsEgales;
    alias FindByte = ChercherOctet;
    alias TextLength = LongueurTexte;
    alias MakeTextView = CreerVueTexte;
    alias TextViewsEqual = VuesTexteEgales;
    alias CompareTextViews = ComparerVuesTexte;
    alias FindCharacter = ChercherCaractere;
    alias RotateLeft32 = RotationGauche32;
    alias RotateLeft64 = RotationGauche64;
    alias RotateRight32 = RotationDroite32;
    alias RotateRight64 = RotationDroite64;
    alias CountOnes32 = CompterBitsUn32;
    alias CountOnes64 = CompterBitsUn64;
    alias ByteSwap32 = InverserOctets32;
    alias ByteSwap64 = InverserOctets64;
    alias IsPowerOfTwo = EstPuissanceDeux;
    alias AlignUp = AlignerSuperieur;
    alias AtomicLoad32 = ChargerAtomique32;
    alias AtomicLoad64 = ChargerAtomique64;
    alias AtomicStore32 = StockerAtomique32;
    alias AtomicStore64 = StockerAtomique64;
    alias AtomicExchange32 = EchangerAtomique32;
    alias AtomicExchange64 = EchangerAtomique64;
    alias AtomicFetchAdd32 = AjouterAtomique32;
    alias AtomicFetchAdd64 = AjouterAtomique64;
    alias AtomicCompareExchange32 = ComparerEchanger32;
    alias AtomicCompareExchange64 = ComparerEchanger64;
    alias MemoryFence = BarriereMemoire;
    alias ProcessorPause = PauseProcesseur;
    alias InitializeLock = InitialiserVerrou;
    alias TryAcquireLock = EssayerAcquerirVerrou;
    alias AcquireLock = AcquerirVerrou;
    alias ReleaseLock = LibererVerrou;
}

alias GalacticShrine::GsPP::System::ByteView = GalacticShrine::GsPP::Systeme::VueOctets;
alias GalacticShrine::GsPP::System::TextView = GalacticShrine::GsPP::Systeme::VueTexte;
alias GalacticShrine::GsPP::System::SpinLock = GalacticShrine::GsPP::Systeme::VerrouAtomique;
alias GalacticShrine::GsPP::System::FillMemory = GalacticShrine::GsPP::Systeme::RemplirMemoire;
alias GalacticShrine::GsPP::System::CopyMemory = GalacticShrine::GsPP::Systeme::CopierMemoire;
alias GalacticShrine::GsPP::System::CompareMemory = GalacticShrine::GsPP::Systeme::ComparerMemoire;
alias GalacticShrine::GsPP::System::MemoryEqual = GalacticShrine::GsPP::Systeme::MemoiresEgales;
alias GalacticShrine::GsPP::System::MakeByteView = GalacticShrine::GsPP::Systeme::CreerVueOctets;
alias GalacticShrine::GsPP::System::SubByteView = GalacticShrine::GsPP::Systeme::SousVueOctets;
alias GalacticShrine::GsPP::System::ByteViewsEqual = GalacticShrine::GsPP::Systeme::VuesOctetsEgales;
alias GalacticShrine::GsPP::System::FindByte = GalacticShrine::GsPP::Systeme::ChercherOctet;
alias GalacticShrine::GsPP::System::TextLength = GalacticShrine::GsPP::Systeme::LongueurTexte;
alias GalacticShrine::GsPP::System::MakeTextView = GalacticShrine::GsPP::Systeme::CreerVueTexte;
alias GalacticShrine::GsPP::System::TextViewsEqual = GalacticShrine::GsPP::Systeme::VuesTexteEgales;
alias GalacticShrine::GsPP::System::CompareTextViews = GalacticShrine::GsPP::Systeme::ComparerVuesTexte;
alias GalacticShrine::GsPP::System::FindCharacter = GalacticShrine::GsPP::Systeme::ChercherCaractere;
alias GalacticShrine::GsPP::System::RotateLeft32 = GalacticShrine::GsPP::Systeme::RotationGauche32;
alias GalacticShrine::GsPP::System::RotateLeft64 = GalacticShrine::GsPP::Systeme::RotationGauche64;
alias GalacticShrine::GsPP::System::RotateRight32 = GalacticShrine::GsPP::Systeme::RotationDroite32;
alias GalacticShrine::GsPP::System::RotateRight64 = GalacticShrine::GsPP::Systeme::RotationDroite64;
alias GalacticShrine::GsPP::System::CountOnes32 = GalacticShrine::GsPP::Systeme::CompterBitsUn32;
alias GalacticShrine::GsPP::System::CountOnes64 = GalacticShrine::GsPP::Systeme::CompterBitsUn64;
alias GalacticShrine::GsPP::System::ByteSwap32 = GalacticShrine::GsPP::Systeme::InverserOctets32;
alias GalacticShrine::GsPP::System::ByteSwap64 = GalacticShrine::GsPP::Systeme::InverserOctets64;
alias GalacticShrine::GsPP::System::IsPowerOfTwo = GalacticShrine::GsPP::Systeme::EstPuissanceDeux;
alias GalacticShrine::GsPP::System::AlignUp = GalacticShrine::GsPP::Systeme::AlignerSuperieur;
alias GalacticShrine::GsPP::System::AtomicLoad32 = GalacticShrine::GsPP::Systeme::ChargerAtomique32;
alias GalacticShrine::GsPP::System::AtomicLoad64 = GalacticShrine::GsPP::Systeme::ChargerAtomique64;
alias GalacticShrine::GsPP::System::AtomicStore32 = GalacticShrine::GsPP::Systeme::StockerAtomique32;
alias GalacticShrine::GsPP::System::AtomicStore64 = GalacticShrine::GsPP::Systeme::StockerAtomique64;
alias GalacticShrine::GsPP::System::AtomicExchange32 = GalacticShrine::GsPP::Systeme::EchangerAtomique32;
alias GalacticShrine::GsPP::System::AtomicExchange64 = GalacticShrine::GsPP::Systeme::EchangerAtomique64;
alias GalacticShrine::GsPP::System::AtomicFetchAdd32 = GalacticShrine::GsPP::Systeme::AjouterAtomique32;
alias GalacticShrine::GsPP::System::AtomicFetchAdd64 = GalacticShrine::GsPP::Systeme::AjouterAtomique64;
alias GalacticShrine::GsPP::System::AtomicCompareExchange32 = GalacticShrine::GsPP::Systeme::ComparerEchanger32;
alias GalacticShrine::GsPP::System::AtomicCompareExchange64 = GalacticShrine::GsPP::Systeme::ComparerEchanger64;
alias GalacticShrine::GsPP::System::MemoryFence = GalacticShrine::GsPP::Systeme::BarriereMemoire;
alias GalacticShrine::GsPP::System::ProcessorPause = GalacticShrine::GsPP::Systeme::PauseProcesseur;
alias GalacticShrine::GsPP::System::InitializeLock = GalacticShrine::GsPP::Systeme::InitialiserVerrou;
alias GalacticShrine::GsPP::System::TryAcquireLock = GalacticShrine::GsPP::Systeme::EssayerAcquerirVerrou;
alias GalacticShrine::GsPP::System::AcquireLock = GalacticShrine::GsPP::Systeme::AcquerirVerrou;
alias GalacticShrine::GsPP::System::ReleaseLock = GalacticShrine::GsPP::Systeme::LibererVerrou;
