/**
 * Frontend auto-hébergé Gs++ 0.27 : première tranche de l'AST syntaxique.
 *
 * L'analyseur couvre les déclarations de code et de données, les membres
 * exécutables des classes, la hiérarchie des instructions et l'AST interne des
 * expressions. Le stockage de sortie appartient à l'appelant ; l'AST de
 * travail est construit dans une arène.
 **/

espace GalacticShrine::GsPP::Autohebergement {
    énumération ErreurAnalyseDeclarations {
        Reussite = 0,
        Success = 0,
        CapaciteInsuffisante = 1,
        InsufficientCapacity = 1,
        ErreurLexicale = 2,
        LexicalError = 2,
        ArgumentInvalide = 3,
        InvalidArgument = 3,
        AllocationImpossible = 4,
        AllocationFailure = 4,
        IdentifiantAttendu = 5,
        ExpectedIdentifier = 5,
        TypeAttendu = 6,
        ExpectedType = 6,
        ParentheseOuvranteAttendue = 7,
        ExpectedOpeningParenthesis = 7,
        ParentheseFermanteAttendue = 8,
        ExpectedClosingParenthesis = 8,
        AccoladeOuvranteAttendue = 9,
        ExpectedOpeningBrace = 9,
        AccoladeFermanteAttendue = 10,
        ExpectedClosingBrace = 10,
        PointVirguleAttendu = 11,
        ExpectedSemicolon = 11,
        DeclarationNonPriseEnCharge = 12,
        UnsupportedDeclaration = 12,
        TailleTableauInvalide = 13,
        InvalidArraySize = 13,
        ExpressionAttendue = 14,
        ExpectedExpression = 14,
        InitialiseurExterneInterdit = 15,
        ExternalInitializerForbidden = 15,
        MembreClasseNonPrisEnCharge = 16,
        UnsupportedClassMember = 16,
        CrochetFermantAttendu = 17,
        ExpectedClosingBracket = 17,
        EgalAttendu = 18,
        ExpectedEquals = 18,
        DeuxPointsAttendu = 19,
        ExpectedColon = 19,
        InitialiseurChampHorsClasse = 20,
        DefaultFieldInitializerOutsideClass = 20,
        OperateurSurchargeableAttendu = 21,
        ExpectedOverloadableOperator = 21,
        ModificateurMembreDuplique = 22,
        DuplicateMemberModifier = 22,
        ModificateurConstructeurInterdit = 23,
        InvalidConstructorModifier = 23,
        ParametreDestructeurInterdit = 24,
        DestructorParameterForbidden = 24,
        ListeInitialisationInterdite = 25,
        InitializerListForbidden = 25,
        InitialiseurConstructeurInvalide = 26,
        InvalidConstructorInitializer = 26,
        ChevronOuvrantAttendu = 27,
        ExpectedOpeningAngleBracket = 27,
        ChevronFermantAttendu = 28,
        ExpectedClosingAngleBracket = 28,
        NombreEntierInvalide = 29,
        InvalidIntegerLiteral = 29,
        EspaceAttendu = 30,
        ExpectedNamespace = 30,
    };

    énumération GenreNoeudDeclaration {
        Programme = 0,
        Program = 0,
        Fonction = 1,
        Function = 1,
        Parametre = 2,
        Parameter = 2,
        VariableGlobale = 3,
        GlobalVariable = 3,
        Structure = 4,
        Struct = 4,
        Union = 5,
        Classe = 6,
        Class = 6,
        Champ = 7,
        Field = 7,
        Enumeration = 8,
        Enum = 8,
        Enumerateur = 9,
        Enumerator = 9,
        Alias = 10,
        AliasChamp = 11,
        FieldAlias = 11,
        Methode = 12,
        Method = 12,
        FonctionConstructeur = 13,
        ConstructorFunction = 13,
        FonctionDestructeur = 14,
        DestructorFunction = 14,
        SurchargeOperateur = 15,
        OperatorOverload = 15,
        BlocInstructions = 16,
        StatementBlock = 16,
        InstructionRetour = 17,
        ReturnStatement = 17,
        InstructionExpression = 18,
        ExpressionStatement = 18,
        VariableLocale = 19,
        LocalVariable = 19,
        Conditionnelle = 20,
        Conditional = 20,
        BoucleTantQue = 21,
        WhileLoop = 21,
        LitteralEntier = 22,
        IntegerLiteral = 22,
        LitteralChaine = 23,
        StringLiteral = 23,
        ReferenceVariable = 24,
        VariableReference = 24,
        ExpressionUnaire = 25,
        UnaryExpression = 25,
        ExpressionBinaire = 26,
        BinaryExpression = 26,
        Affectation = 27,
        Assignment = 27,
        Appel = 28,
        Call = 28,
        AccesMembre = 29,
        MemberAccess = 29,
        Indexation = 30,
        Index = 30,
        Conversion = 31,
        Cast = 31,
        Agregat = 32,
        Aggregate = 32,
        InitialiseurConstructeurDelegue = 33,
        DelegatingConstructorInitializer = 33,
        InitialiseurConstructeurBase = 34,
        BaseConstructorInitializer = 34,
        InitialiseurChampConstructeur = 35,
        ConstructorFieldInitializer = 35,
        UtilisationEspace = 36,
        UsingNamespace = 36,
    };

    énumération DrapeauNoeudDeclaration {
        Aucun = 0,
        None = 0,
        Publique = 1,
        Public = 1,
        Externe = 2,
        External = 2,
        DefinitionPresente = 4,
        HasDefinition = 4,
        Protegee = 8,
        Protected = 8,
        Privee = 16,
        Private = 16,
        HeritagePresent = 32,
        HasBase = 32,
        Virtuelle = 64,
        Virtual = 64,
        Remplacement = 128,
        Override = 128,
        InitialiseurBasePresent = 256,
        HasBaseInitializer = 256,
        DelegationConstructeurPresente = 512,
        HasDelegatingConstructor = 512,
        InitialiseurChampPresent = 1024,
        HasFieldInitializer = 1024,
        ExpressionPresente = 2048,
        HasExpression = 2048,
        BrancheSinonPresente = 4096,
        HasElseBranch = 4096,
        ConstructionExplicite = 8192,
        HasExplicitConstruction = 8192,
        LitteralBooleen = 16384,
        BooleanLiteral = 16384,
        AccesViaPointeur = 32768,
        PointerMemberAccess = 32768,
        ReferenceBase = 65536,
        BaseReference = 65536,
    };

    structure NoeudDeclaration {
        naturel32 Genre;
        naturel32 Ligne;
        naturel32 Colonne;
        naturel32 Drapeaux;
        naturel64 Parent;
        naturel64 DebutNom;
        naturel64 TailleNom;
        naturel64 HachageNom;
        naturel64 HachageEspace;
        naturel64 HachageType;
    };

    structure ResultatAnalyseDeclarations {
        ErreurAnalyseDeclarations Erreur;
        naturel32 LigneErreur;
        naturel32 ColonneErreur;
        naturel32 Detail;
        naturel64 NombreNoeuds;
        naturel64 CapaciteRequise;
        naturel64 NombreOctetsArene;
        naturel64 Reserve;
    };

    structure RequeteAnalyseDeclarations {
        constante caractère* Source;
        naturel64 Taille;
        NoeudDeclaration* Noeuds;
        naturel64 Capacite;
        ResultatAnalyseDeclarations Resultat;
    };

    énumération ErreurAssemblageDeclarations {
        Reussite = 0,
        Success = 0,
        CapaciteInsuffisante = 1,
        InsufficientCapacity = 1,
        ArgumentInvalide = 2,
        InvalidArgument = 2,
        AllocationImpossible = 3,
        AllocationFailure = 3,
        ErreurDeclaration = 4,
        DeclarationError = 4,
        TailleExcessive = 5,
        ExcessiveSize = 5,
        FonctionIncompatible = 6,
        IncompatibleFunction = 6,
        FonctionDefiniePlusieursFois = 7,
        FunctionDefinedMoreThanOnce = 7,
        GlobaleIncompatible = 8,
        IncompatibleGlobal = 8,
        GlobaleDefiniePlusieursFois = 9,
        GlobalDefinedMoreThanOnce = 9,
        AliasIncompatible = 10,
        IncompatibleAlias = 10,
    };

    structure UniteDeclarationsPreparee {
        constante caractère* Source;
        naturel64 Taille;
        naturel32 EstInterface;
        naturel32 Reserve;
    };

    structure OrigineUniteDeclarations {
        naturel64 DebutOctets;
        naturel64 TailleOctets;
        naturel32 PremiereLigne;
        naturel32 NombreLignes;
        naturel32 OctetsBom;
        naturel32 Reserve;
    };

    structure ResultatAssemblageDeclarations {
        ErreurAssemblageDeclarations Erreur;
        naturel32 LigneErreur;
        naturel32 ColonneErreur;
        naturel32 Detail;
        naturel64 IndexUniteErreur;
        naturel64 NombreNoeuds;
        naturel64 NombreOctetsSource;
        naturel64 NombreOrigines;
        naturel64 NombreOctetsArene;
        naturel32 DetailLexical;
        naturel32 Reserve;
    };

    structure RequeteAssemblageDeclarations {
        constante UniteDeclarationsPreparee* Unites;
        naturel64 NombreUnites;
        caractère* SourceAssemblee;
        naturel64 CapaciteSource;
        NoeudDeclaration* Noeuds;
        naturel64 CapaciteNoeuds;
        OrigineUniteDeclarations* Origines;
        naturel64 CapaciteOrigines;
        ResultatAssemblageDeclarations Resultat;
    };

    /**
     * <résumé>Assemble les AST d'unités préparées et conserve leurs origines sans lire de fichier.</résumé>
     * @Paramètre(RequeteAssemblageDeclarations*: requete) Unités et trois tampons distincts de sortie.
     * @Retourner(ErreurAssemblageDeclarations) Diagnostic local à une unité ou tailles exactes requises.
     * @etc. Aucun tampon de sortie n'est écrit en cas d'erreur ou de capacité insuffisante.
     * @etc. Les tampons ne doivent se recouvrir ni entre eux ni avec les entrées.
     * @etc. Un LF sépare les unités ; les BOM initiaux sont retirés ; les déclarations ne sont pas fusionnées.
     **/
    publique ErreurAssemblageDeclarations AssemblerDeclarationsPreparees(
        RequeteAssemblageDeclarations* requete);

    alias PreparedDeclarationUnit = UniteDeclarationsPreparee;
    alias DeclarationUnitOrigin = OrigineUniteDeclarations;
    alias DeclarationAssemblyResult = ResultatAssemblageDeclarations;
    alias DeclarationAssemblyRequest = RequeteAssemblageDeclarations;
    alias AssemblePreparedDeclarations = AssemblerDeclarationsPreparees;

    /**
     * <résumé>Assemble puis normalise les fonctions libres, globales et alias racines préparés.</résumé>
     * @Paramètre(RequeteAssemblageDeclarations*: requete) Unités et trois tampons distincts ne recouvrant pas les entrées.
     * @Retourner(ErreurAssemblageDeclarations) Diagnostic local ou tailles exactes après normalisation.
     * @etc. Types comparés avant résolution des alias ; fonctions, puis globales, puis alias.
     * @etc. Définitions préférées aux prototypes à la place de leur première déclaration.
     * @etc. Membres de classes et types non fusionnés ; aucune sortie partielle ni lecture de fichier.
     **/
    publique ErreurAssemblageDeclarations AssemblerDeclarationsNormalisees(
        RequeteAssemblageDeclarations* requete);

    alias AssembleNormalizedDeclarations = AssemblerDeclarationsNormalisees;

    publique ErreurAnalyseDeclarations AnalyserDeclarationsSource(
        RequeteAnalyseDeclarations* requete);

    /**
     * <résumé>Analyse le contenu préparé d'une interface sans lire de fichier.</résumé>
     * @Paramètre(RequeteAnalyseDeclarations*: requete) Texte sans directives d'inclusion et tampon AST.
     * @Retourner(ErreurAnalyseDeclarations) Résultat selon le même protocole de capacité que les sources.
     * @etc. Fonctions et globales externes implicites ; membres sans corps, visibilité conservée.
     **/
    publique ErreurAnalyseDeclarations AnalyserDeclarationsInterface(
        RequeteAnalyseDeclarations* requete);

    alias DeclarationNode = NoeudDeclaration;
    alias DeclarationAnalysisResult = ResultatAnalyseDeclarations;
    alias DeclarationAnalysisRequest = RequeteAnalyseDeclarations;
    alias AnalyzeSourceDeclarations = AnalyserDeclarationsSource;
    alias AnalyzeInterfaceDeclarations = AnalyserDeclarationsInterface;

    alias NoeudSyntaxique = NoeudDeclaration;
    alias SyntaxNode = NoeudDeclaration;
    alias ResultatAnalyseSyntaxique = ResultatAnalyseDeclarations;
    alias SyntaxAnalysisResult = ResultatAnalyseDeclarations;
    alias RequeteAnalyseSyntaxique = RequeteAnalyseDeclarations;
    alias SyntaxAnalysisRequest = RequeteAnalyseDeclarations;
    alias AnalyserSyntaxeSource = AnalyserDeclarationsSource;
    alias AnalyzeSourceSyntax = AnalyserDeclarationsSource;
}
