espace GalacticShrine::GsPP::Autohebergement {

    /**
     * <résumé>Codes d'erreur pour l'analyse sémantique.</résumé>
     * @etc. Les codes d'erreur sont utilisés pour indiquer le résultat de l'analyse sémantique.
     **/
    énumération ErreurAnalyseSemantique {

        /**
         * <résumé>Aucune erreur.</résumé>
         * @etc. Aucune erreur n'a été détectée lors de l'analyse sémantique.
         **/
        Reussite = 0,

        /**
         * <résumé>No errors.</résumé>
         * @etc. No errors were detected during the semantic analysis.
         **/
        Success = 0,
        ArgumentInvalide = 1,
        InvalidArgument = 1,
        AstInvalide = 2,
        InvalidAst = 2,
        AllocationImpossible = 3,
        AllocationFailure = 3,
        CapaciteSymbolesInsuffisante = 4,
        InsufficientSymbolCapacity = 4,
        CapaciteResolutionsInsuffisante = 5,
        InsufficientResolutionCapacity = 5,
        TypeDeclarePlusieursFois = 6,
        TypeDeclaredMoreThanOnce = 6,
        NomTypeEnConflit = 7,
        TypeNameConflict = 7,
        GlobaleDeclareePlusieursFois = 8,
        GlobalDeclaredMoreThanOnce = 8,
        NomGlobalEnConflit = 9,
        GlobalNameConflict = 9,
        AliasDeclarePlusieursFois = 10,
        AliasDeclaredMoreThanOnce = 10,
        AliasEnConflit = 11,
        AliasConflict = 11,
        ChampDeclarePlusieursFois = 12,
        FieldDeclaredMoreThanOnce = 12,
        AliasChampDeclarePlusieursFois = 13,
        FieldAliasDeclaredMoreThanOnce = 13,
        AliasChampEnConflit = 14,
        FieldAliasConflict = 14,
        EnumerateurDeclarePlusieursFois = 15,
        EnumeratorDeclaredMoreThanOnce = 15,
        ParametreDeclarePlusieursFois = 16,
        ParameterDeclaredMoreThanOnce = 16,
        VariableLocaleDeclareePlusieursFois = 17,
        LocalVariableDeclaredMoreThanOnce = 17,
        SymboleIntrouvable = 18,
        UnknownSymbol = 18,
        AdresseSurchargeAmbigue = 19,
        AmbiguousOverloadAddress = 19,
        FonctionAbsente = 20,
        MissingFunction = 20,
        AucuneSurchargeCompatible = 21,
        NoMatchingOverload = 21,
        AppelSurchargeAmbigu = 22,
        AmbiguousOverloadCall = 22,
        RecepteurMembreInvalide = 23,
        InvalidMemberReceiver = 23,
        MembreIntrouvable = 24,
        UnknownMember = 24,
        MembreInaccessible = 25,
        InaccessibleMember = 25,
        ConstructeurInaccessible = 26,
        InaccessibleConstructor = 26,
        ConstructeurNonDeclare = 27,
        UndeclaredConstructor = 27,
        OperateurIntrouvable = 28,
        MissingOperator = 28,
        InitialiseurClasseInterdit = 29,
        ClassInitializerForbidden = 29,
        InitialiseurBaseSansClasseBase = 30,
        BaseInitializerWithoutBaseClass = 30,
        DelegationConstructeurDirecte = 31,
        DirectConstructorDelegation = 31,
        CycleDelegationConstructeur = 32,
        ConstructorDelegationCycle = 32,
        ChampInitialiseurIntrouvable = 33,
        UnknownInitializerField = 33,
        ChampInitialisePlusieursFois = 34,
        FieldInitializedMoreThanOnce = 34,
        OrdreInitialisationChampInvalide = 35,
        InvalidFieldInitializationOrder = 35,
        AriteInitialiseurChampInvalide = 36,
        InvalidFieldInitializerArity = 36,
        TypeInitialiseurChampIncompatible = 37,
        IncompatibleFieldInitializerType = 37,
        ValeurChampParDefautObjetClasseInterdite = 38,
        ClassObjectDefaultFieldValueForbidden = 38,
        ClasseValeurChampParDefautSansConstructeur = 39,
        ClassWithDefaultFieldValueWithoutConstructor = 39,
        ChampConstantNonInitialise = 40,
        UninitializedConstField = 40,
        InitialiseurChampTableauNonAgrege = 41,
        NonAggregateArrayFieldInitializer = 41,
        TropElementsInitialiseurTableau = 42,
        TooManyArrayInitializerElements = 42,
        TropElementsInitialiseurStructure = 43,
        TooManyStructInitializerElements = 43,
        TropElementsInitialiseurScalaire = 44,
        TooManyScalarInitializerElements = 44,
        TypeElementInitialiseurAgregeIncompatible = 45,
        IncompatibleAggregateInitializerElementType = 45,
        InitialiseurTableauNonAgrege = 46,
        NonAggregateArrayInitializer = 46,
        AdresseValeurNonAdressable = 47,
        AddressOfNonAddressableValue = 47,
        AdresseTableauCompletInterdite = 48,
        CompleteArrayAddressForbidden = 48,
        DereferencementSansPointeur = 49,
        DereferenceWithoutPointer = 49,
        CibleIndexationInvalide = 50,
        InvalidIndexingTarget = 50,
        IndiceNonEntier = 51,
        NonIntegerIndex = 51,
        IndexationPointeurVide = 52,
        VoidPointerIndexing = 52,
        CibleAppelIndirectInvalide = 53,
        InvalidIndirectCallTarget = 53,
        AriteAppelIndirectInvalide = 54,
        InvalidIndirectCallArity = 54,
        TypeArgumentAppelIndirectIncompatible = 55,
        IncompatibleIndirectCallArgumentType = 55,
        DestructeurInaccessible = 56,
        InaccessibleDestructor = 56,
        CycleTypeParValeur = 57,
        ByValueTypeCycle = 57,
        TailleObjetInvalide = 58,
        InvalidObjectSize = 58,
        AriteOperateurInvalide = 59,
        InvalidOperatorArity = 59,
        NegationNonScalaire = 60,
        NonScalarNegation = 60,
        OperateurUnaireNonEntier = 61,
        NonIntegerUnaryOperator = 61,
        OperateurLogiqueNonScalaire = 62,
        NonScalarLogicalOperator = 62,
        TypesOperandesDifferents = 63,
        DifferentOperandTypes = 63,
        DecalageNonEntier = 64,
        NonIntegerBitShift = 64,
        CalculNonEntier = 65,
        NonIntegerArithmetic = 65,
        ComparaisonTypeInvalide = 66,
        InvalidComparisonType = 66,
        ComparaisonPointeurInvalide = 67,
        InvalidPointerComparison = 67,
        ComparaisonBooleenneInvalide = 68,
        InvalidBooleanComparison = 68,
        LiaisonReferenceIncompatible = 69,
        IncompatibleReferenceBinding = 69,
        CibleAffectationNonModifiable = 70,
        NonModifiableAssignmentTarget = 70,
        AffectationValeurConstanteInterdite = 71,
        ConstValueAssignmentForbidden = 71,
        AffectationTableauInterdite = 72,
