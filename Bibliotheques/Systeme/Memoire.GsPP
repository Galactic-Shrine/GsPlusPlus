espace GalacticShrine::GsPP::Systeme {

    /**
     * <résumé>Remplit une zone mémoire avec une valeur spécifique.</résumé>
     * @Paramètre(octet*: destination) Adresse du premier octet de la zone à remplir.
     * @Paramètre(octet: valeur) Valeur à utiliser pour remplir la zone.
     * @Paramètre(naturel64: taille) Nombre d'octets à remplir.
     **/
    publique vide RemplirMemoire(octet* destination, octet valeur, naturel64 taille) {

        naturel64 index = 0;

        tantque (index < taille) {

            destination[index] = valeur;
            index = index + 1;
        }
    }

    /**
     * <résumé>Copie une zone mémoire vers une autre.</résumé>
     * @Paramètre(octet*: destination) Adresse du premier octet de la zone de destination.
     * @Paramètre(octet*: source) Adresse du premier octet de la zone source.
     * @Paramètre(naturel64: taille) Nombre d'octets à copier.
     **/
    publique vide CopierMemoire(octet* destination, octet* source, naturel64 taille) {

        naturel64 index = 0;

        tantque (index < taille) {

            destination[index] = source[index];
            index = index + 1;
        }
    }

    /**
     * <résumé>Compare deux zones mémoire octet par octet.</résumé>
     * @Paramètre(octet*: gauche) Adresse du premier octet de la première zone.
     * @Paramètre(octet*: droite) Adresse du premier octet de la deuxième zone.
     * @Paramètre(naturel64: taille) Nombre d'octets à comparer.
     * @Retourner(entier32) -1 si la première zone est inférieure, 1 si elle est supérieure, 0 si elles sont égales.
     **/
    publique entier32 ComparerMemoire(octet* gauche, octet* droite, naturel64 taille) {

        naturel64 index = 0;

        tantque (index < taille) {

            si (gauche[index] < droite[index])
                retourner -1;

            si (gauche[index] > droite[index])
                retourner 1;

            index = index + 1;
        }

        retourner 0;
    }

    /**
     * <résumé>Vérifie si deux zones mémoire sont identiques octet par octet.</résumé>
     * @Paramètre(octet*: gauche) Adresse du premier octet de la première zone.
     * @Paramètre(octet*: droite) Adresse du premier octet de la deuxième zone.
     * @Paramètre(naturel64: taille) Nombre d'octets à comparer.
     * @Retourner(booléen) `vrai` si les zones sont identiques, sinon `faux`.
     **/
    publique booléen MemoiresEgales(octet* gauche, octet* droite, naturel64 taille) {

        naturel64 index = 0;

        tantque (index < taille) {

            si (gauche[index] != droite[index])
                retourner faux;

            index = index + 1;
        }

        retourner vrai;
    }
}
