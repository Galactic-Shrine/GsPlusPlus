espace GalacticShrine::GsPP::Hebergee {

    /**
     * <résumé>Codes d'erreur retournés par les fonctions de la bibliothèque.</résumé>
     **/
    énumération CodeErreurHebergee {

        /**
         * <résumé>Indique que l'opération a réussi.</résumé>
         **/
        Reussite = 0,

        /**
         * <résumé>Indicates that an invalid argument has been provided.</résumé>
         **/
        Success = 0,

        /**
         * <résumé>Indique qu'une allocation de mémoire a échoué.</résumé>
         **/
        ArgumentInvalide = 1,

        /**
         * <résumé>Indicates that a memory allocation has failed.</résumé>
         **/
        InvalidArgument = 1,

        /**
         * <résumé>Indique qu'une allocation de mémoire a échoué.</résumé>
         **/
        AllocationEchouee = 2,

        /**
         * <résumé>Indicates that a memory allocation has failed.</résumé>
         **/
        AllocationFailed = 2,

        /**
         * <résumé>Indique qu'une capacité maximale a été dépassée.</résumé>
         **/
        CapaciteDepassee = 3,

        /**
         * <résumé>Indicates that a capacity limit has been exceeded.</résumé>
         **/
        CapacityExceeded = 3,

        /**
         * <résumé>Indique qu'une lecture de fichier a échoué.</résumé>
         **/
        LectureEchouee = 4,

        /**
         * <résumé>Indicates that a file read operation has failed.</résumé>
         **/
        ReadFailed = 4,

        /**
         * <résumé>Indique qu'une écriture de fichier a échoué.</résumé>
         **/
        EcritureEchouee = 5,

        /**
         * <résumé>Indicates that a file write operation has failed.</résumé>
         **/
        WriteFailed = 5,

        /**
         * <résumé>Indique qu'un chemin de fichier est invalide.</résumé>
         **/
        CheminInvalide = 6,

        /**
         * <résumé>Indicates that a file path is invalid.</résumé>
         **/
        InvalidPath = 6,

        /**
         * <résumé>Indique qu'une chaîne de caractères UTF-8 est invalide.</résumé>
         **/
        Utf8Invalide = 7,

        /**
         * <résumé>Indicates that a UTF-8 string is invalid.</résumé>
         **/
        InvalidUtf8 = 7,
    };

    /**
     * <résumé>Vue non propriétaire sur une zone de texte.</résumé>
     **/
    structure VueTexte {

        /**
         * <résumé>Adresse du premier caractère de la zone.</résumé>
         **/
        constante caractère* Donnees;

        /**
         * <résumé>Nombre de caractères accessibles dans la zone.</résumé>
         **/
        naturel64 Taille;

        /**
         * <résumé>Address of the first character in the field.</résumé>
         **/
        alias Data = Donnees;

        /**
         * <résumé>Number of characters available in the field.</résumé>
         **/
        alias Size = Taille;
    };

    /**
     * <résumé>Chaîne de caractères UTF-8 allouée dynamiquement.</résumé>
     **/
    structure ChaineUtf8 {

        /**
         * <résumé>Adresse du premier caractère de la chaîne.</résumé>
         **/
        caractère* Donnees;

        /**
         * <résumé>Nombre de caractères actuellement utilisés dans la chaîne.</résumé>
         **/
        naturel64 Taille;

        /**
         * <résumé>Nombre de caractères pouvant être stockés dans la chaîne sans réallocation.</résumé>
         **/
        naturel64 Capacite;
    };

    /**
     * <résumé>Vecteur d'octets alloué dynamiquement.</résumé>
     **/
    structure VecteurOctetsDynamique {

        octet* Donnees;
        naturel64 Taille;
        naturel64 Capacite;
    };

    /**
     * <résumé>Vecteur de naturels alloué dynamiquement.</résumé>
     **/
    structure VecteurNaturelsDynamique {

        naturel64* Donnees;
        naturel64 Taille;
        naturel64 Capacite;
    };

    /**
     * <résumé>Bloc de mémoire dans une arène.</résumé>
     **/
    structure BlocArene {

        BlocArene* Suivant;
        naturel64 Capacite;
        naturel64 Position;
    };

    /**
     * <résumé>Arène de mémoire pour allocations rapides.</résumé>
     **/
    structure AreneMemoire {

        BlocArene* Premier;
        BlocArene* Dernier;
        naturel64 TailleBloc;
        naturel64 NombreOctets;
    };

    /**
     * <résumé>Flux de lecture non propriétaire sur une zone d'octets.</résumé>
     **/
    structure FluxLecture {

        octet* Donnees;
        naturel64 Taille;
        naturel64 Position;
    };

    /**
     * <résumé>Flux d'écriture non propriétaire sur une zone d'octets.</résumé>
     **/
    structure FluxEcriture {

        octet* Donnees;
        naturel64 Capacite;
        naturel64 Position;
    };

    /**
     * <résumé>Vecteur de naturels non propriétaire.</résumé>
     **/
    structure VecteurNaturels {

        naturel64* Donnees;
        naturel64 Taille;
        naturel64 Capacite;
    };

    /**
     * <résumé>Entrée dans une table de symboles.</résumé>
     **/
    structure EntreeTableSymboles {

        VueTexte Cle;
        naturel64 Valeur;
        booléen Occupee;
    };

    /**
     * <résumé>Table de symboles non propriétaire.</résumé>
     **/
    structure TableSymboles {

        EntreeTableSymboles* Entrees;
        naturel64 Capacite;
        naturel64 Nombre;
    };

    /**
     * <résumé>Table de symboles allouée dynamiquement.</résumé>
     **/
    structure TableSymbolesDynamique {

        EntreeTableSymboles* Entrees;
        naturel64 Capacite;
        naturel64 Nombre;
    };

    /**
     * <résumé>Requête de lecture ou d'écriture de fichier.</résumé>
     **/
    structure RequeteFichier {

        constante caractère* Chemin;
        octet* Donnees;
        naturel64 Taille;
        naturel64 Capacite;
    };

    /**
     * <résumé>Fichier chargé en mémoire avec allocation dynamique.</résumé>
     **/
    structure FichierAlloue {

        octet* Donnees;
        naturel64 Taille;
    };

    /**
     * <résumé>Diagnostic signalé par le préprocesseur.</résumé>
     **/
    structure Diagnostic {

        naturel32 Niveau;
        naturel32 Ligne;
        naturel32 Colonne;
        naturel32 Reserve;
        VueTexte Fichier;
        VueTexte Message;
    };

    /**
     * <résumé>Construit une vue non propriétaire sur une zone de caractères.</résumé>
     * @Paramètre(constante caractère*: donnees) Adresse du premier caractère.
     * @Paramètre(naturel64: taille) Nombre de caractères accessibles.
     * @Retourner(VueTexte) Vue formée à partir de l'adresse et de la taille.
     **/
    publique VueTexte CreerVueTexte(constante caractère* donnees, naturel64 taille);

    /**
     * <résumé>Construit une vue sur un texte terminé par un caractère nul.</résumé>
     * @Paramètre(constante caractère*: texte) Adresse du premier caractère.
     * @Retourner(VueTexte) Vue qui exclut le caractère nul final.
     **/
    publique VueTexte CreerVueTexteTerminee(constante caractère* texte);

    /**
     * <résumé>Compare deux vues de texte octet par octet.</résumé>
     * @Paramètre(VueTexte: gauche) Première vue à comparer.
     * @Paramètre(VueTexte: droite) Deuxième vue à comparer.
     * @Retourner(booléen) `vrai` si les tailles et contenus sont identiques.
     **/
    publique booléen VuesTexteEgales(VueTexte gauche, VueTexte droite);

    /**
     * <résumé>Calcule le hachage FNV-1a d'une vue de texte.</résumé>
     * @Paramètre(VueTexte: texte) Vue dont le contenu doit être haché.
     * @Retourner(naturel64) Valeur de hachage non signée sur 64 bits.
     **/
    publique naturel64 HacherVueTexte(VueTexte texte);

    /**
     * <résumé>Valide qu'une vue de texte est une chaîne UTF-8 bien formée.</résumé>
     * @Paramètre(VueTexte: texte) Vue à valider.
     * @Retourner(booléen) `vrai` si le texte est valide UTF-8, sinon `faux`.
     **/
    publique booléen ValiderUtf8(VueTexte texte);

    /**
     * <résumé>Initialise une chaîne de caractères UTF-8 vide.</résumé>
     * @Paramètre(ChaineUtf8*: chaine) Chaîne à initialiser.
     **/
    publique vide InitialiserChaineUtf8(ChaineUtf8* chaine);

    /**
     * <résumé>Détruit une chaîne de caractères UTF-8 et libère sa mémoire.</résumé>
     * @Paramètre(ChaineUtf8*: chaine) Chaîne à détruire.
     **/
    publique vide DetruireChaineUtf8(ChaineUtf8* chaine);

    /**
     * <résumé>Réserve de la mémoire pour une chaîne de caractères UTF-8.</résumé>
     * @Paramètre(ChaineUtf8*: chaine) Chaîne à réserver.
     * @Paramètre(naturel64: capacite) Nombre maximal de caractères à stocker.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee ReserverChaineUtf8(ChaineUtf8* chaine, naturel64 capacite);

    /**
     * <résumé>Assigne une vue de texte à une chaîne de caractères UTF-8.</résumé>
     * @Paramètre(ChaineUtf8*: chaine) Chaîne à modifier.
     * @Paramètre(VueTexte: texte) Vue de texte à copier dans la chaîne.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee AssignerChaineUtf8(ChaineUtf8* chaine, VueTexte texte);

    /**
     * <résumé>Ajoute une vue de texte à la fin d'une chaîne de caractères UTF-8.</résumé>
     * @Paramètre(ChaineUtf8*: chaine) Chaîne à modifier.
     * @Paramètre(VueTexte: texte) Vue de texte à ajouter à la chaîne.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee AjouterVueChaineUtf8(ChaineUtf8* chaine, VueTexte texte);

    /**
     * <résumé>Ajoute un caractère ASCII à la fin d'une chaîne de caractères UTF-8.</résumé>
     * @Paramètre(ChaineUtf8*: chaine) Chaîne à modifier.
     * @Paramètre(caractère: valeur) Caractère ASCII à ajouter à la chaîne.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee AjouterAsciiChaineUtf8(ChaineUtf8* chaine, caractère valeur);

    /**
     * <résumé>Construit une vue de texte à partir d'une chaîne de caractères UTF-8.</résumé>
     * @Paramètre(ChaineUtf8*: chaine) Chaîne à convertir en vue.
     * @Retourner(VueTexte) Vue de texte représentant le contenu de la chaîne.
     **/
    publique VueTexte VueDepuisChaineUtf8(ChaineUtf8* chaine);

    /**
     * <résumé>Initialise une arène de mémoire pour allocations rapides.</résumé>
     * @Paramètre(AreneMemoire*: arene) Arène à initialiser.
     * @Paramètre(naturel64: tailleBloc) Taille des blocs de mémoire à allouer.
     **/
    publique vide InitialiserArene(AreneMemoire* arene, naturel64 tailleBloc);

    /**
     * <résumé>Détruit une arène de mémoire et libère tous ses blocs.</résumé>
     * @Paramètre(AreneMemoire*: arene) Arène à détruire.
     **/
    publique vide DetruireArene(AreneMemoire* arene);

    /**
     * <résumé>Alloue un bloc de mémoire dans une arène.</résumé>
     * @Paramètre(AreneMemoire*: arene) Arène dans laquelle allouer la mémoire.
     * @Paramètre(naturel64: taille) Nombre d'octets à allouer.
     * @Paramètre(naturel64: alignement) Alignement requis pour l'adresse retournée.
     * @Retourner(octet*) Adresse du bloc alloué, ou `null` si l'allocation a échoué.
     **/
    publique octet* AllouerArene(AreneMemoire* arene, naturel64 taille, naturel64 alignement);

    /**
     * <résumé>Crée un flux de lecture non propriétaire.</résumé>
     * @Paramètre(octet*: donnees) Adresse du premier octet lisible.
     * @Paramètre(naturel64: taille) Nombre total d'octets lisibles.
     * @Retourner(FluxLecture) Flux positionné au début de la zone.
     **/
    publique FluxLecture CreerFluxLecture(octet* donnees, naturel64 taille);

    /**
     * <résumé>Lit l'octet courant d'un flux et avance sa position.</résumé>
     * @Paramètre(FluxLecture*: flux) Flux de lecture à consommer.
     * @Paramètre(octet*: valeur) Destination qui reçoit l'octet lu.
     * @Retourner(booléen) `vrai` si un octet a été lu, sinon `faux`.
     **/
    publique booléen LireOctetFlux(FluxLecture* flux, octet* valeur);

    /**
     * <résumé>Copie un bloc depuis la position courante d'un flux.</résumé>
     * @Paramètre(FluxLecture*: flux) Flux de lecture à consommer.
     * @Paramètre(octet*: destination) Zone qui reçoit les octets.
     * @Paramètre(naturel64: taille) Nombre maximal d'octets à lire.
     * @Retourner(naturel64) Nombre d'octets effectivement copiés.
     **/
    publique naturel64 LireBlocFlux(FluxLecture* flux, octet* destination, naturel64 taille);

    /**
     * <résumé>Crée un flux d'écriture non propriétaire.</résumé>
     * @Paramètre(octet*: donnees) Adresse du premier octet inscriptible.
     * @Paramètre(naturel64: capacite) Nombre total d'octets inscriptibles.
     * @Retourner(FluxEcriture) Flux positionné au début de la zone.
     **/
    publique FluxEcriture CreerFluxEcriture(octet* donnees, naturel64 capacite);

    /**
     * <résumé>Écrit un octet à la position courante d'un flux.</résumé>
     * @Paramètre(FluxEcriture*: flux) Flux d'écriture à modifier.
     * @Paramètre(octet: valeur) Octet à écrire.
     * @Retourner(booléen) `vrai` si l'octet a été écrit, sinon `faux`.
     **/
    publique booléen EcrireOctetFlux(FluxEcriture* flux, octet valeur);

    /**
     * <résumé>Copie un bloc dans un flux d'écriture.</résumé>
     * @Paramètre(FluxEcriture*: flux) Flux d'écriture à modifier.
     * @Paramètre(octet*: source) Zone contenant les octets à copier.
     * @Paramètre(naturel64: taille) Nombre maximal d'octets à écrire.
     * @Retourner(naturel64) Nombre d'octets effectivement copiés.
     **/
    publique naturel64 EcrireBlocFlux(FluxEcriture* flux, octet* source, naturel64 taille);

    /**
     * <résumé>Initialise un vecteur de naturels non propriétaire.</résumé>
     * @Paramètre(VecteurNaturels*: vecteur) Vecteur à initialiser.
     * @Paramètre(naturel64*: stockage) Zone mémoire contenant les éléments.
     * @Paramètre(naturel64: capacite) Nombre maximal d'éléments dans le vecteur.
     **/
    publique vide InitialiserVecteurNaturels(VecteurNaturels* vecteur, naturel64* stockage, naturel64 capacite);

    /**
     * <résumé>Ajoute un naturel à la fin d'un vecteur de naturels.</résumé>
     * @Paramètre(VecteurNaturels*: vecteur) Vecteur à modifier.
     * @Paramètre(naturel64: valeur) Valeur à ajouter au vecteur.
     * @Retourner(booléen) `vrai` si l'ajout a réussi, sinon `faux`.
     **/
    publique booléen AjouterNaturel(VecteurNaturels* vecteur, naturel64 valeur);

    /**
     * <résumé>Lit un naturel à partir d'un vecteur de naturels.</résumé>
     * @Paramètre(VecteurNaturels*: vecteur) Vecteur à lire.
     * @Paramètre(naturel64: index) Index de l'élément à lire.
     * @Paramètre(naturel64*: valeur) Destination qui reçoit la valeur lue.
     * @Retourner(booléen) `vrai` si la lecture a réussi, sinon `faux`.
     **/
    publique booléen LireNaturel(VecteurNaturels* vecteur, naturel64 index, naturel64* valeur);

    /**
     * <résumé>Initialise un vecteur d'octets alloué dynamiquement.</résumé>
     * @Paramètre(VecteurOctetsDynamique*: vecteur) Vecteur à initialiser.
     **/
    publique vide InitialiserVecteurOctetsDynamique(VecteurOctetsDynamique* vecteur);

    /**
     * <résumé>Détruit un vecteur d'octets alloué dynamiquement et libère sa mémoire.</résumé>
     * @Paramètre(VecteurOctetsDynamique*: vecteur) Vecteur à détruire.
     **/
    publique vide DetruireVecteurOctetsDynamique(VecteurOctetsDynamique* vecteur);

    /**
     * <résumé>Réserve de la mémoire pour un vecteur d'octets alloué dynamiquement.</résumé>
     * @Paramètre(VecteurOctetsDynamique*: vecteur) Vecteur à réserver.
     * @Paramètre(naturel64: capacite) Nombre maximal d'octets à stocker.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee ReserverVecteurOctetsDynamique(VecteurOctetsDynamique* vecteur, naturel64 capacite);

    /**
     * <résumé>Ajoute un bloc d'octets à la fin d'un vecteur d'octets alloué dynamiquement.</résumé>
     * @Paramètre(VecteurOctetsDynamique*: vecteur) Vecteur à modifier.
     * @Paramètre(octet*: source) Zone contenant les octets à ajouter.
     * @Paramètre(naturel64: taille) Nombre d'octets à ajouter.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee AjouterBlocVecteurOctetsDynamique(VecteurOctetsDynamique* vecteur, octet* source, naturel64 taille);

    /**
     * <résumé>Initialise un vecteur de naturels alloué dynamiquement.</résumé>
     * @Paramètre(VecteurNaturelsDynamique*: vecteur) Vecteur à initialiser.
     **/
    publique vide InitialiserVecteurNaturelsDynamique(VecteurNaturelsDynamique* vecteur);

    /**
     * <résumé>Détruit un vecteur de naturels alloué dynamiquement et libère sa mémoire.</résumé>
     * @Paramètre(VecteurNaturelsDynamique*: vecteur) Vecteur à détruire.
     **/
    publique vide DetruireVecteurNaturelsDynamique(VecteurNaturelsDynamique* vecteur);

    /**
     * <résumé>Réserve de la mémoire pour un vecteur de naturels alloué dynamiquement.</résumé>
     * @Paramètre(VecteurNaturelsDynamique*: vecteur) Vecteur à réserver.
     * @Paramètre(naturel64: capacite) Nombre maximal d'éléments à stocker.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee ReserverVecteurNaturelsDynamique(VecteurNaturelsDynamique* vecteur, naturel64 capacite);

    /**
     * <résumé>Ajoute un naturel à la fin d'un vecteur de naturels alloué dynamiquement.</résumé>
     * @Paramètre(VecteurNaturelsDynamique*: vecteur) Vecteur à modifier.
     * @Paramètre(naturel64: valeur) Valeur à ajouter au vecteur.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee AjouterVecteurNaturelsDynamique(VecteurNaturelsDynamique* vecteur, naturel64 valeur);

    /**
     * <résumé>Lit un naturel à partir d'un vecteur de naturels alloué dynamiquement.</résumé>
     * @Paramètre(VecteurNaturelsDynamique*: vecteur) Vecteur à lire.
     * @Paramètre(naturel64: index) Index de l'élément à lire.
     * @Paramètre(naturel64*: valeur) Destination qui reçoit la valeur lue.
     * @Retourner(booléen) `vrai` si la lecture a réussi, sinon `faux`.
     **/
    publique booléen LireVecteurNaturelsDynamique(VecteurNaturelsDynamique* vecteur, naturel64 index, naturel64* valeur);

    /**
     * <résumé>Initialise une table de symboles non propriétaire.</résumé>
     * @Paramètre(TableSymboles*: table) Table à initialiser.
     * @Paramètre(EntreeTableSymboles*: stockage) Zone mémoire contenant les entrées.
     * @Paramètre(naturel64: capacite) Nombre maximal d'entrées dans la table.
     **/
    publique vide InitialiserTableSymboles(TableSymboles* table, EntreeTableSymboles* stockage, naturel64 capacite);

    /**
     * <résumé>Insère un symbole dans une table de symboles.</résumé>
     * @Paramètre(TableSymboles*: table) Table à modifier.
     * @Paramètre(VueTexte: cle) Clé du symbole à insérer.
     * @Paramètre(naturel64: valeur) Valeur associée au symbole.
     * @Retourner(booléen) `vrai` si l'insertion a réussi, sinon `faux`.
     **/
    publique booléen InsererSymbole(TableSymboles* table, VueTexte cle, naturel64 valeur);

    /**
     * <résumé>Cherche un symbole dans une table de symboles.</résumé>
     * @Paramètre(TableSymboles*: table) Table à rechercher.
     * @Paramètre(VueTexte: cle) Clé du symbole à chercher.
     * @Paramètre(naturel64*: valeur) Destination qui reçoit la valeur si trouvée.
     * @Retourner(booléen) `vrai` si le symbole a été trouvé, sinon `faux`.
     **/
    publique booléen ChercherSymbole(TableSymboles* table, VueTexte cle, naturel64* valeur);

    /**
     * <résumé>Initialise une table de symboles allouée dynamiquement.</résumé>
     * @Paramètre(TableSymbolesDynamique*: table) Table à initialiser.
     **/
    publique vide InitialiserTableSymbolesDynamique(TableSymbolesDynamique* table);

    /**
     * <résumé>Détruit une table de symboles allouée dynamiquement et libère sa mémoire.</résumé>
     * @Paramètre(TableSymbolesDynamique*: table) Table à détruire.
     **/
    publique vide DetruireTableSymbolesDynamique(TableSymbolesDynamique* table);

    /**
     * <résumé>Réserve de la mémoire pour une table de symboles allouée dynamiquement.</résumé>
     * @Paramètre(TableSymbolesDynamique*: table) Table à réserver.
     * @Paramètre(naturel64: capacite) Nombre maximal d'entrées dans la table.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee ReserverTableSymbolesDynamique(TableSymbolesDynamique* table, naturel64 capacite);

    /**
     * <résumé>Insère un symbole dans une table de symboles allouée dynamiquement.</résumé>
     * @Paramètre(TableSymbolesDynamique*: table) Table à modifier.
     * @Paramètre(VueTexte: cle) Clé du symbole à insérer.
     * @Paramètre(naturel64: valeur) Valeur associée au symbole.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee InsererTableSymbolesDynamique(TableSymbolesDynamique* table, VueTexte cle, naturel64 valeur);

    /**
     * <résumé>Cherche un symbole dans une table de symboles allouée dynamiquement.</résumé>
     * @Paramètre(TableSymbolesDynamique*: table) Table à rechercher.
     * @Paramètre(VueTexte: cle) Clé du symbole à chercher.
     * @Paramètre(naturel64*: valeur) Destination qui reçoit la valeur si trouvée.
     * @Retourner(booléen) `vrai` si le symbole a été trouvé, sinon `faux`.
     **/
    publique booléen ChercherTableSymbolesDynamique(TableSymbolesDynamique* table, VueTexte cle, naturel64* valeur);

    /**
     * <résumé>Charge un fichier depuis le système de fichiers hôte.</résumé>
     * @Paramètre(constante caractère*: chemin) Chemin du fichier à charger.
     * @Paramètre(octet*: destination) Zone mémoire où stocker le contenu du fichier.
     * @Paramètre(naturel64: capacite) Capacité maximale de la zone mémoire.
     * @Paramètre(naturel64*: taille) Destination qui reçoit la taille réelle du fichier chargé.
     * @Retourner(booléen) `vrai` si le fichier a été chargé avec succès, sinon `faux`.
     **/
    publique booléen ChargerFichier(constante caractère* chemin, octet* destination, naturel64 capacite, naturel64* taille);

    /**
     * <résumé>Sauvegarde un fichier dans le système de fichiers hôte.</résumé>
     * @Paramètre(constante caractère*: chemin) Chemin du fichier à sauvegarder.
     * @Paramètre(octet*: source) Zone mémoire contenant le contenu à sauvegarder.
     * @Paramètre(naturel64: taille) Taille du contenu à sauvegarder.
     * @Retourner(booléen) `vrai` si le fichier a été sauvegardé avec succès, sinon `faux`.
     **/
    publique booléen SauverFichier(constante caractère* chemin, octet* source, naturel64 taille);

    /**
     * <résumé>Charge un fichier depuis le système de fichiers hôte avec allocation dynamique.</résumé>
     * @Paramètre(constante caractère*: chemin) Chemin du fichier à charger.
     * @Paramètre(FichierAlloue*: fichier) Structure qui reçoit le contenu et la taille du fichier.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee ChargerFichierAlloue(constante caractère* chemin, FichierAlloue* fichier);

    /**
     * <résumé>Initialise une structure de fichier alloué dynamiquement.</résumé>
     * @Paramètre(FichierAlloue*: fichier) Structure à initialiser.
     **/
    publique vide InitialiserFichierAlloue(FichierAlloue* fichier);

    /**
     * <résumé>Libère la mémoire d'un fichier alloué dynamiquement.</résumé>
     * @Paramètre(FichierAlloue*: fichier) Structure à libérer.
     **/
    publique vide LibererFichierAlloue(FichierAlloue* fichier);

    /**
     * <résumé>Sauvegarde un fichier dans le système de fichiers hôte avec gestion des erreurs.</résumé>
     * @Paramètre(constante caractère*: chemin) Chemin du fichier à sauvegarder.
     * @Paramètre(octet*: source) Zone mémoire contenant le contenu à sauvegarder.
     * @Paramètre(naturel64: taille) Taille du contenu à sauvegarder.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee SauverFichierResultat(constante caractère* chemin, octet* source, naturel64 taille);

    /**
     * <résumé>Joint deux chemins de fichiers UTF-8 avec un séparateur.</résumé>
     * @Paramètre(ChaineUtf8*: sortie) Chaîne qui reçoit le chemin joint.
     * @Paramètre(VueTexte: base) Chemin de base.
     * @Paramètre(VueTexte: enfant) Chemin enfant à ajouter.
     * @Paramètre(caractère: separateur) Caractère utilisé pour séparer les chemins.
     * @Retourner(CodeErreurHebergee) Code d'erreur indiquant le succès ou l'échec.
     **/
    publique CodeErreurHebergee JoindreCheminUtf8(ChaineUtf8* sortie, VueTexte base, VueTexte enfant, caractère separateur);

    /**
     * <résumé>Extrait le nom de fichier d'un chemin de fichier UTF-8.</résumé>
     * @Paramètre(VueTexte: chemin) Chemin complet du fichier.
     * @Retourner(VueTexte) Vue représentant le nom de fichier extrait.
     **/
    publique VueTexte NomFichierVue(VueTexte chemin);

    /**
     * <résumé>Extrait l'extension de fichier d'un chemin de fichier UTF-8.</résumé>
     * @Paramètre(VueTexte: chemin) Chemin complet du fichier.
     * @Retourner(VueTexte) Vue représentant l'extension de fichier extraite.
     **/
    publique VueTexte ExtensionVue(VueTexte chemin);

    /**
     * <résumé>Signale un diagnostic vers le système hôte.</résumé>
     * @Paramètre(Diagnostic: diagnostic) Diagnostic à signaler.
     **/
    publique vide SignalerDiagnostic(Diagnostic diagnostic);

    alias MakeTextView = CreerVueTexte;
    alias MakeTerminatedTextView = CreerVueTexteTerminee;
    alias TextViewsEqual = VuesTexteEgales;
    alias HashTextView = HacherVueTexte;
    alias ValidateUtf8 = ValiderUtf8;
    alias InitializeUtf8String = InitialiserChaineUtf8;
    alias DestroyUtf8String = DetruireChaineUtf8;
    alias ReserveUtf8String = ReserverChaineUtf8;
    alias AssignUtf8String = AssignerChaineUtf8;
    alias AppendUtf8View = AjouterVueChaineUtf8;
    alias AppendAscii = AjouterAsciiChaineUtf8;
    alias ViewUtf8String = VueDepuisChaineUtf8;
    alias InitializeArena = InitialiserArene;
    alias DestroyArena = DetruireArene;
    alias ArenaAllocate = AllouerArene;
    alias MakeInputStream = CreerFluxLecture;
    alias ReadByte = LireOctetFlux;
    alias ReadBlock = LireBlocFlux;
    alias MakeOutputStream = CreerFluxEcriture;
    alias WriteByte = EcrireOctetFlux;
    alias WriteBlock = EcrireBlocFlux;
    alias InitializeVector = InitialiserVecteurNaturels;
    alias AppendValue = AjouterNaturel;
    alias ReadValue = LireNaturel;
    alias InitializeDynamicByteVector = InitialiserVecteurOctetsDynamique;
    alias DestroyDynamicByteVector = DetruireVecteurOctetsDynamique;
    alias ReserveDynamicByteVector = ReserverVecteurOctetsDynamique;
    alias AppendDynamicByteBlock = AjouterBlocVecteurOctetsDynamique;
    alias InitializeDynamicValueVector = InitialiserVecteurNaturelsDynamique;
    alias DestroyDynamicValueVector = DetruireVecteurNaturelsDynamique;
    alias ReserveDynamicValueVector = ReserverVecteurNaturelsDynamique;
    alias AppendDynamicValue = AjouterVecteurNaturelsDynamique;
    alias ReadDynamicValue = LireVecteurNaturelsDynamique;
    alias InitializeSymbolTable = InitialiserTableSymboles;
    alias InsertSymbol = InsererSymbole;
    alias FindSymbol = ChercherSymbole;
    alias InitializeDynamicSymbolTable = InitialiserTableSymbolesDynamique;
    alias DestroyDynamicSymbolTable = DetruireTableSymbolesDynamique;
    alias ReserveDynamicSymbolTable = ReserverTableSymbolesDynamique;
    alias InsertDynamicSymbol = InsererTableSymbolesDynamique;
    alias FindDynamicSymbol = ChercherTableSymbolesDynamique;
    alias LoadFile = ChargerFichier;
    alias SaveFile = SauverFichier;
    alias LoadAllocatedFile = ChargerFichierAlloue;
    alias InitializeAllocatedFile = InitialiserFichierAlloue;
    alias FreeAllocatedFile = LibererFichierAlloue;
    alias SaveFileResult = SauverFichierResultat;
    alias JoinUtf8Path = JoindreCheminUtf8;
    alias FileNameView = NomFichierVue;
    alias ExtensionView = ExtensionVue;
    alias ReportDiagnostic = SignalerDiagnostic;
}

espace GalacticShrine::GsPP::Hote {

    /**
     * <résumé>Alloue un bloc de mémoire de taille spécifiée.</résumé>
     * @Paramètre(naturel64: taille) Nombre d'octets à allouer.
     * @Retourner(octet*) Adresse du bloc alloué, ou `null` si l'allocation a échoué.
     **/
    externe octet* AllouerMemoire(naturel64 taille);

    /**
     * <résumé>Libère un bloc de mémoire précédemment alloué.</résumé>
     * @Paramètre(octet*: adresse) Adresse du bloc à libérer.
     **/
    externe vide LibererMemoire(octet* adresse);

    /**
     * <résumé>Lit un fichier depuis le système de fichiers hôte.</résumé>
     * @Paramètre(RequeteFichier*: requete) Requête contenant le chemin et la destination.
     * @Retourner(naturel32) Code d'erreur indiquant le succès ou l'échec.
     **/
    externe naturel32 LireFichier(GalacticShrine::GsPP::Hebergee::RequeteFichier* requete);

    /**
     * <résumé>Écrit un fichier dans le système de fichiers hôte.</résumé>
     * @Paramètre(RequeteFichier*: requete) Requête contenant le chemin et la source.
     * @Retourner(naturel32) Code d'erreur indiquant le succès ou l'échec.
     **/
    externe naturel32 EcrireFichier(GalacticShrine::GsPP::Hebergee::RequeteFichier* requete);

    /**
     * <résumé>Émet un diagnostic vers le système hôte.</résumé>
     * @Paramètre(Diagnostic: diagnostic) Diagnostic à signaler.
     **/
    externe vide EmettreDiagnostic(GalacticShrine::GsPP::Hebergee::Diagnostic diagnostic);
}

