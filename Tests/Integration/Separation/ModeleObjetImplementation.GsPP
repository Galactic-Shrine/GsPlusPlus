publique entier32 DestructionsObjetSepare = 0;

classe AccumulateurSepare
{
    privée:
        entier32 Valeur;

    publique:
        constructeur(entier32 valeur)
        {
            soi.Valeur = valeur;
        }

        destructeur()
        {
            DestructionsObjetSepare = DestructionsObjetSepare + 1;
        }

        virtuel entier32 Ajouter(entier32 delta)
        {
            soi.Valeur = soi.Valeur + delta;
            retourner soi.Valeur;
        }

        entier32 Lire()
        {
            retourner soi.Valeur;
        }
};
