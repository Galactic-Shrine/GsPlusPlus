publique entier32 TraceConstruction;
publique entier32 TraceDestruction;
publique entier32 CompteurArguments;

publique entier32 ProchaineValeur()
{
    CompteurArguments = CompteurArguments + 1;
    retourner CompteurArguments;
}

classe ElementInitialise
{
    publique:
        entier32 Valeur;

        constructeur(entier32 valeur)
        {
            soi.Valeur = valeur;
            TraceConstruction = TraceConstruction * 10 + valeur;
        }

        destructeur()
        {
            TraceDestruction = TraceDestruction * 10 + soi.Valeur;
        }
};

classe ConfigurationInitialisee
{
    publique:
        entier32 Base = 7;
        entier32 Codes[3] = {1, 2};
        ElementInitialise Elements[3];

        constructeur() : Elements(ProchaineValeur()) {}

        constructeur(entier32 valeur) : soi()
        {
            soi.Base = valeur;
        }

        destructeur() {}
};

classe ChoixInitialise
{
    publique:
        entier32 Valeur = 5;

        constructeur() {}
        constructeur(entier32 valeur) : Valeur(valeur) {}
};

publique entier32 Principal()
{
    TraceConstruction = 0;
    TraceDestruction = 0;
    CompteurArguments = 0;
    {
        ConfigurationInitialisee configuration(9);
        si (configuration.Base != 9) retourner 1;
        si (configuration.Codes[0] != 1) retourner 2;
        si (configuration.Codes[1] != 2) retourner 3;
        si (configuration.Codes[2] != 0) retourner 4;
        si (TraceConstruction != 123) retourner 5;
        si (configuration.Elements[0].Valeur != 1) retourner 13;
        si (configuration.Elements[2].Valeur != 3) retourner 14;
    }
    si (TraceDestruction != 321) retourner 6;

    TraceConstruction = 0;
    TraceDestruction = 0;
    CompteurArguments = 0;
    {
        ElementInitialise locaux[3](ProchaineValeur());
        si (TraceConstruction != 123) retourner 7;
        si (locaux[0].Valeur != 1) retourner 8;
        si (locaux[2].Valeur != 3) retourner 9;
    }
    si (TraceDestruction != 321) retourner 10;

    ChoixInitialise valeurDefaut;
    ChoixInitialise valeurExplicite(8);
    si (valeurDefaut.Valeur != 5) retourner 11;
    si (valeurExplicite.Valeur != 8) retourner 12;
    retourner 25;
}
