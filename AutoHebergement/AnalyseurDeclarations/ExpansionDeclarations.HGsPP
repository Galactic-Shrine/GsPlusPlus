/** <résumé>Expansion en mémoire des inclusions textuelles ; les chemins sont résolus par l'hôte.</résumé> **/
espace GalacticShrine::GsPP::Autohebergement {
    structure FichierInclusionDeclarations {
        constante caractère* Source;
        naturel64 Taille;
        naturel64 Identite;
        naturel32 EstInterface;
        naturel32 Reserve;
    };

    /** <résumé>Lien trié par fichier puis début de directive : disponible 0, introuvable 1, extension incompatible 2.</résumé> **/
    structure LienInclusionDeclarations {
        naturel64 IndexFichier;
        naturel64 DebutDirective;
        naturel64 IndexCible;
        naturel32 Etat;
        naturel32 Reserve;
    };

    énumération ErreurExpansionDeclarations {
        Reussite = 0,
        Success = 0,
        CapaciteInsuffisante = 1,
        InsufficientCapacity = 1,
        ArgumentInvalide = 2,
        InvalidArgument = 2,
        AllocationImpossible = 3,
        AllocationFailure = 3,
        ErreurLexicale = 4,
        LexicalError = 4,
        DirectiveHorsDebutLigne = 5,
        DirectiveNotAtLineStart = 5,
        ArgumentDirectiveAttendu = 6,
        ExpectedDirectiveArgument = 6,
        TexteApresDirective = 7,
        TextAfterDirective = 7,
        PragmaNonPrisEnCharge = 8,
        UnsupportedPragma = 8,
        CheminInclusionAttendu = 9,
        ExpectedIncludePath = 9,
        FichierIntrouvable = 10,
        FileNotFound = 10,
        ExtensionIncompatible = 11,
        IncompatibleExtension = 11,
        CycleInclusion = 12,
        IncludeCycle = 12,
        ProfondeurExcessive = 13,
        ExcessiveDepth = 13,
        TailleExcessive = 14,
        ExcessiveSize = 14,
        ResolutionRequise = 15,
        ResolutionRequired = 15,
        LectureRequise = 16,
        ReadRequired = 16,
    };

    structure ResultatExpansionDeclarations {
        ErreurExpansionDeclarations Erreur;
        naturel32 DetailLexical;
        naturel64 IndexFichierErreur;
        naturel32 LigneErreur;
        naturel32 ColonneErreur;
        naturel64 NombreOctetsSource;
        naturel64 NombreOrigines;
        naturel64 NombreOctetsArene;
    };

    structure RequeteExpansionDeclarations {
        constante FichierInclusionDeclarations* Fichiers;
        naturel64 NombreFichiers;
        constante LienInclusionDeclarations* Liens;
        naturel64 NombreLiens;
        naturel64 IndexRacine;
        caractère* SourcePreparee;
        naturel64 CapaciteSource;
        OrigineJetonDeclarations* Origines;
        naturel64 CapaciteOrigines;
        naturel32 MarqueUtf8;
        naturel32 FinLigneCrlf;
        ResultatExpansionDeclarations Resultat;
    };

    /**
     * <résumé>Développe #inclure/#include et #pragma once puis prépare le texte et les origines.</résumé>
     * @Paramètre(RequeteExpansionDeclarations*: requete) Catalogue stable, identités canoniques et liens résolus par l'hôte.
     * @Retourner(ErreurExpansionDeclarations) Capacités exactes ou premier diagnostic dans le fichier original.
     * @etc. Les identités partagent les états once/cycle, mais les indices gardent les noms de diagnostic des alias.
     * @etc. Les liens sont uniques et triés ; les états 1/2 portent IndexCible=NombreFichiers.
     * @etc. L'hôte garantit les identités, contenus et cibles ; aucune lecture ni résolution de chemin ici.
     * @etc. Deux sorties transactionnelles, arène libérée, limite de 128 fichiers actifs, EOF racine seul conservé.
     * @etc. Entrées, sorties et requête doivent être des zones distinctes et stables.
     **/
    publique ErreurExpansionDeclarations DevelopperInclusionsDeclarations(RequeteExpansionDeclarations* requete);

    /** <résumé>Demande hôte : opération 1 résolution, 2 lecture ; plage brute de l'argument entre guillemets pour 1.</résumé> **/
    structure DemandeExpansionDeclarations {
        naturel32 Operation;
        naturel32 Reserve;
        naturel64 IndexFichier;
        naturel64 DebutDirective;
        naturel64 DebutArgument;
        naturel64 TailleArgument;
    };

    structure RequeteExpansionDeclarationsADemande {
        RequeteExpansionDeclarations* Expansion;
        constante naturel32* Disponibles;
        DemandeExpansionDeclarations Demande;
    };

    /**
     * <résumé>Suspend l'expansion avant une résolution ou lecture nécessaire, sans publier les sorties.</résumé>
     * @Paramètre(RequeteExpansionDeclarationsADemande*: requete) Catalogue partiel et disponibilités 0/1, une par fichier.
     * @Retourner(ErreurExpansionDeclarations) Codes habituels, ou 15/16 avec demande ; l'hôte complète puis rappelle.
     * @etc. Les fichiers indisponibles ont Source nulle et Taille zéro, mais identité et mode déjà résolus.
     * @etc. La résolution suit la validation grammaticale ; la lecture suit once, cycles et profondeur.
     * @etc. Aucun état ne survit à l'appel ; chaque reprise relance le parcours sur l'instantané complété.
     * @etc. L'entrée historique et son contrat ne sont pas modifiés ; demandes et sorties sont des zones distinctes.
     **/
    publique ErreurExpansionDeclarations DevelopperInclusionsADemande(RequeteExpansionDeclarationsADemande* requete);

    structure RequeteExpansionDeclarationsEnSession {
        RequeteExpansionDeclarationsADemande* Expansion;
        octet* Memoire;
        naturel32 Operation;
        naturel32 Reserve;
        naturel64 NombreLexages;
        naturel64 NombreReutilisations;
    };

    /**
     * <résumé>Conserve les jetons des fichiers déjà lexés entre les suspensions, sans conserver le parcours.</résumé>
     * @Paramètre(RequeteExpansionDeclarationsEnSession*: requete) Initialiser à zéro ; opération 0 développer, 1 libérer.
     * @Retourner(ErreurExpansionDeclarations) Même protocole de demande ; la libération renvoie zéro et vide la session.
     * @etc. Memoire appartient au frontend : ne pas copier, modifier, partager ni libérer ce pointeur côté hôte.
     * @etc. Les indices déjà lexés, leurs adresses et leurs contenus restent immuables jusqu'à la libération.
     * @etc. Le catalogue peut grandir ; ses tableaux et les sorties peuvent changer d'adresse entre deux appels.
     * @etc. Changer l'adresse ou la taille d'une source déjà lexée est refusé ; une mutation en place viole le contrat.
     * @etc. Libérer même après refus, allocation impossible ou exception hôte, avant de décharger l'image.
     * @etc. Les compteurs cumulent fichiers lexés et réutilisations ; le parcours est encore rejoué à chaque appel.
     **/
    publique ErreurExpansionDeclarations DevelopperInclusionsEnSession(RequeteExpansionDeclarationsEnSession* requete);

    structure RequeteExpansionDeclarationsAvecReprise {
        RequeteExpansionDeclarationsADemande* Expansion;
        octet* Memoire;
        naturel32 Operation;
        naturel32 Reserve;
        naturel64 NombreLexages;
        naturel64 NombreReutilisations;
        naturel64 NombreJetonsParcourus;
    };

    /**
     * <résumé>Reprend au point suspendu, avec pile, once, jetons et fragments conservés.</résumé>
     * @Paramètre(RequeteExpansionDeclarationsAvecReprise*: requete) Initialiser à zéro ; opération 0 poursuivre, 1 libérer.
     * @Retourner(ErreurExpansionDeclarations) Demandes 15/16, capacités exactes ou premier diagnostic, sorties transactionnelles.
     * @etc. Memoire est opaque, non copiable et propre à une seule expansion ; libérer avant de décharger l'image.
     * @etc. Racine et modes BOM/CRLF sont fixes ; fichiers et liens peuvent être ajoutés, jamais retirés.
     * @etc. Sources lues, métadonnées déjà observées et liens déjà fournis restent immuables.
     * @etc. Une cible en attente de lecture conserve son identité et son mode ; tableaux et sorties peuvent se déplacer.
     * @etc. Mutation de contenu en place interdite ; la validation contrôle adresses, tailles, métadonnées et liens.
     * @etc. Mesure et publications répétées ne reparcourent pas le graphe ; la préparation finale relexe les fragments.
     * @etc. NombreJetonsParcourus compte les jetons engagés dans le parcours, arguments et EOF inclus, pas les essais suspendus.
     * @etc. Toute mémoire survit aux suspensions/refus jusqu'à la libération, y compris après allocation impossible.
     **/
    publique ErreurExpansionDeclarations DevelopperInclusionsAvecReprise(RequeteExpansionDeclarationsAvecReprise* requete);

    alias InclusionSourceFile = FichierInclusionDeclarations;
    alias ResolvedInclusionLink = LienInclusionDeclarations;
    alias InclusionExpansionResult = ResultatExpansionDeclarations;
    alias InclusionExpansionRequest = RequeteExpansionDeclarations;
    alias ExpandDeclarationIncludes = DevelopperInclusionsDeclarations;
    alias InclusionExpansionDemand = DemandeExpansionDeclarations;
    alias OnDemandInclusionExpansionRequest = RequeteExpansionDeclarationsADemande;
    alias ExpandDeclarationIncludesOnDemand = DevelopperInclusionsADemande;
    alias SessionInclusionExpansionRequest = RequeteExpansionDeclarationsEnSession;
    alias ExpandDeclarationIncludesInSession = DevelopperInclusionsEnSession;
    alias ResumableInclusionExpansionRequest = RequeteExpansionDeclarationsAvecReprise;
    alias ResumeDeclarationIncludes = DevelopperInclusionsAvecReprise;
}
