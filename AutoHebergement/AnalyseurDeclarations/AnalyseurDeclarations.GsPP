espace GalacticShrine::GsPP::Autohebergement {
    JetonLexe* NulJetonsDeclarations;
    NoeudDeclaration* NulNoeudsDeclarations;

    structure TypeDeclarationInterne {
        naturel32 Genre;
        naturel32 Qualificatifs;
        naturel32 NiveauPointeur;
        naturel32 NombreDimensions;
        naturel64 HachageNom;
        naturel64 HachageDimensions;
    };

    structure ContexteEspaceDeclaration {
        naturel64 Hachage;
        booléen EstVide;
    };

    structure NomQualifieDeclaration {
        naturel64 Debut;
        naturel64 Taille;
        naturel64 Hachage;
        naturel32 Ligne;
        naturel32 Colonne;
    };

    structure NoeudExpressionInterne {
        naturel32 Genre;
        naturel32 Ligne;
        naturel32 Colonne;
        naturel32 Drapeaux;
        naturel64 DebutNom;
        naturel64 TailleNom;
        naturel64 HachageNom;
        naturel64 HachageType;
        naturel64 PremierEnfant;
        naturel64 DernierEnfant;
        naturel64 EnfantSuivant;
    };

    NoeudExpressionInterne* NulExpressionsDeclarations;

    structure EtatAnalyseDeclarations {
        RequeteAnalyseDeclarations* Requete;
        JetonLexe* Jetons;
        naturel64 NombreJetons;
        naturel64 Position;
        NoeudDeclaration* NoeudsTravail;
        naturel64 NombreNoeuds;
        NoeudExpressionInterne* ExpressionsTravail;
        naturel64 NombreExpressions;
        GalacticShrine::GsPP::Hebergee::AreneMemoire Arene;
    };

    structure ContexteMembreClasseDeclaration {
        ContexteEspaceDeclaration* Espace;
        naturel64 IndexClasse;
        naturel32 Visibilite;
        JetonLexe* NomClasse;
    };

    structure ContexteInstructionDeclaration {
        ContexteEspaceDeclaration* Espace;
        naturel64 Parent;
    };

    naturel64 HachageVideDeclaration() {
        retourner 14_695_981_039_346_656_037;
    }

    naturel64 AjouterOctetDeclaration(naturel64 hachage, octet valeur) {
        retourner (hachage ^ convertir<naturel64>(valeur))
            * 1_099_511_628_211;
    }

    naturel64 AjouterNaturel32Declaration(
        naturel64 hachage, naturel32 valeur) {
        naturel32 index = 0;
        tantque (index < 4) {
            hachage = AjouterOctetDeclaration(
                hachage, convertir<octet>(valeur & 255));
            valeur = valeur >> 8;
            index = index + 1;
        }
        retourner hachage;
    }

    naturel64 AjouterNaturel64Declaration(
        naturel64 hachage, naturel64 valeur) {
        naturel32 index = 0;
        tantque (index < 8) {
            hachage = AjouterOctetDeclaration(
                hachage, convertir<octet>(valeur & 255));
            valeur = valeur >> 8;
            index = index + 1;
        }
        retourner hachage;
    }

    naturel64 AjouterTrancheDeclaration(
        EtatAnalyseDeclarations* etat,
        naturel64 hachage,
        JetonLexe* jeton) {
        naturel64 index = 0;
        tantque (index < jeton->TailleSource) {
            hachage = AjouterOctetDeclaration(
                hachage,
                convertir<octet>(
                    etat->Requete->Source[jeton->Debut + index]));
            index = index + 1;
        }
        retourner hachage;
    }

    naturel64 HacherTypeDeclaration(TypeDeclarationInterne* type) {
        naturel64 hachage = HachageVideDeclaration();
        hachage = AjouterNaturel32Declaration(hachage, type->Genre);
        hachage = AjouterNaturel32Declaration(hachage, type->Qualificatifs);
        hachage = AjouterNaturel32Declaration(hachage, type->NiveauPointeur);
        hachage = AjouterNaturel32Declaration(
            hachage, type->NombreDimensions);
        hachage = AjouterNaturel64Declaration(hachage, type->HachageNom);
        hachage = AjouterNaturel64Declaration(
            hachage, type->HachageDimensions);
        retourner hachage;
    }

    vide InitialiserTypeVideDeclaration(TypeDeclarationInterne* type) {
        type->Genre = 12;
        type->Qualificatifs = 0;
        type->NiveauPointeur = 0;
        type->NombreDimensions = 0;
        type->HachageNom = HachageVideDeclaration();
        type->HachageDimensions = HachageVideDeclaration();
    }

    booléen EstOperateurSurchargeableDeclaration(naturel32 genre) {
        retourner genre == 61
            || genre == 62
            || genre == 63
            || genre == 64
            || genre == 65
            || genre == 46
            || genre == 47
            || genre == 48
            || genre == 49
            || genre == 50
            || genre == 51
            || genre == 55
            || genre == 56
            || genre == 57
            || genre == 59
            || genre == 60
            || genre == 52
            || genre == 58;
    }

    JetonLexe* JetonCourantDeclaration(EtatAnalyseDeclarations* etat) {
        retourner &etat->Jetons[etat->Position];
    }

    booléen EstJetonDeclaration(
        EtatAnalyseDeclarations* etat, naturel32 genre) {
        retourner JetonCourantDeclaration(etat)->Genre == genre;
    }

    booléen AccepterJetonDeclaration(
        EtatAnalyseDeclarations* etat, naturel32 genre) {
        si (!EstJetonDeclaration(etat, genre)) retourner faux;
        etat->Position = etat->Position + 1;
        retourner vrai;
    }

    ErreurAnalyseDeclarations SignalerErreurDeclaration(
        EtatAnalyseDeclarations* etat,
        ErreurAnalyseDeclarations erreur,
        naturel32 ligne,
        naturel32 colonne) {
        etat->Requete->Resultat.Erreur = erreur;
        etat->Requete->Resultat.LigneErreur = ligne;
        etat->Requete->Resultat.ColonneErreur = colonne;
        etat->Requete->Resultat.NombreNoeuds = etat->NombreNoeuds;
        etat->Requete->Resultat.CapaciteRequise = etat->NombreNoeuds;
        retourner erreur;
    }

    booléen ExigerJetonDeclaration(
        EtatAnalyseDeclarations* etat,
        naturel32 genre,
        ErreurAnalyseDeclarations erreur) {
        si (AccepterJetonDeclaration(etat, genre)) retourner vrai;
        JetonLexe* jetonExige = JetonCourantDeclaration(etat);
        SignalerErreurDeclaration(
            etat, erreur, jetonExige->Ligne, jetonExige->Colonne);
        retourner faux;
    }

    booléen AnalyserNomQualifieDeclaration(
        EtatAnalyseDeclarations* etat,
        NomQualifieDeclaration* resultat) {
        JetonLexe* premier = JetonCourantDeclaration(etat);
        si (premier->Genre != 1) {
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::IdentifiantAttendu,
                premier->Ligne,
                premier->Colonne);
            retourner faux;
        }
        resultat->Debut = premier->Debut;
        resultat->Taille = premier->TailleSource;
        resultat->Hachage = AjouterTrancheDeclaration(
            etat, HachageVideDeclaration(), premier);
        resultat->Ligne = premier->Ligne;
        resultat->Colonne = premier->Colonne;
        etat->Position = etat->Position + 1;

        tantque (AccepterJetonDeclaration(etat, 44)) {
            JetonLexe* partie = JetonCourantDeclaration(etat);
            si (partie->Genre != 1) {
                SignalerErreurDeclaration(
                    etat,
                    ErreurAnalyseDeclarations::IdentifiantAttendu,
                    partie->Ligne,
                    partie->Colonne);
                retourner faux;
            }
            resultat->Hachage = AjouterOctetDeclaration(
                resultat->Hachage, 58);
            resultat->Hachage = AjouterOctetDeclaration(
                resultat->Hachage, 58);
            resultat->Hachage = AjouterTrancheDeclaration(
                etat, resultat->Hachage, partie);
            resultat->Taille = partie->Debut + partie->TailleSource
                - resultat->Debut;
            etat->Position = etat->Position + 1;
        }
        retourner vrai;
    }

    booléen AjouterNoeudDeclaration(
        EtatAnalyseDeclarations* etat, NoeudDeclaration noeud) {
        si (etat->NombreNoeuds >= etat->NombreJetons) {
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::AllocationImpossible,
                noeud.Ligne,
                noeud.Colonne);
            retourner faux;
        }
        etat->NoeudsTravail[etat->NombreNoeuds] = noeud;
        etat->NombreNoeuds = etat->NombreNoeuds + 1;
        retourner vrai;
    }

    booléen AnalyserNomQualifieType(
        EtatAnalyseDeclarations* etat, TypeDeclarationInterne* type) {
        si (!EstJetonDeclaration(etat, 1)) {
            JetonLexe* premierNomManquant = JetonCourantDeclaration(etat);
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::IdentifiantAttendu,
                premierNomManquant->Ligne,
                premierNomManquant->Colonne);
            retourner faux;
        }
        JetonLexe* nom = JetonCourantDeclaration(etat);
        type->HachageNom = AjouterTrancheDeclaration(
            etat, HachageVideDeclaration(), nom);
        etat->Position = etat->Position + 1;
        tantque (AccepterJetonDeclaration(etat, 44)) {
            type->HachageNom = AjouterOctetDeclaration(
                type->HachageNom, 58);
            type->HachageNom = AjouterOctetDeclaration(
                type->HachageNom, 58);
            si (!EstJetonDeclaration(etat, 1)) {
                JetonLexe* nomQualifieManquant =
                    JetonCourantDeclaration(etat);
                SignalerErreurDeclaration(
                    etat,
                    ErreurAnalyseDeclarations::IdentifiantAttendu,
                    nomQualifieManquant->Ligne,
                    nomQualifieManquant->Colonne);
                retourner faux;
            }
            nom = JetonCourantDeclaration(etat);
            type->HachageNom = AjouterTrancheDeclaration(
                etat, type->HachageNom, nom);
            etat->Position = etat->Position + 1;
        }
        retourner vrai;
    }

    booléen AnalyserTypeDeclaration(
        EtatAnalyseDeclarations* etat, TypeDeclarationInterne* type) {
        type->Genre = 0;
        type->Qualificatifs = 0;
        type->NiveauPointeur = 0;
        type->NombreDimensions = 0;
        type->HachageNom = HachageVideDeclaration();
        type->HachageDimensions = HachageVideDeclaration();

        booléen continuer = vrai;
        tantque (continuer) {
            si (AccepterJetonDeclaration(etat, 12))
                type->Qualificatifs = type->Qualificatifs | 1;
            sinon si (AccepterJetonDeclaration(etat, 13))
                type->Qualificatifs = type->Qualificatifs | 2;
            sinon continuer = faux;
        }

        naturel32 genreJeton = JetonCourantDeclaration(etat)->Genre;
        si (genreJeton >= 14 && genreJeton <= 25) {
            type->Genre = genreJeton - 13;
            etat->Position = etat->Position + 1;
        }
        sinon si (genreJeton == 1) {
            type->Genre = 13;
            si (!AnalyserNomQualifieType(etat, type)) retourner faux;
        }
        sinon {
            JetonLexe* typeManquant = JetonCourantDeclaration(etat);
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::TypeAttendu,
                typeManquant->Ligne,
                typeManquant->Colonne);
            retourner faux;
        }

        tantque (AccepterJetonDeclaration(etat, 63))
            type->NiveauPointeur = type->NiveauPointeur + 1;
        si (AccepterJetonDeclaration(etat, 55))
            type->Qualificatifs = type->Qualificatifs | 4;
        retourner vrai;
    }

    booléen LireTailleTableauDeclaration(
        EtatAnalyseDeclarations* etat, naturel64* valeur) {
        JetonLexe* jeton = JetonCourantDeclaration(etat);
        si (jeton->Genre != 2) {
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::TailleTableauInvalide,
                jeton->Ligne,
                jeton->Colonne);
            retourner faux;
        }
        *valeur = 0;
        naturel64 index = 0;
        tantque (index < jeton->TailleSource) {
            octet courant = convertir<octet>(
                etat->Requete->Source[jeton->Debut + index]);
            si (courant != 95) {
                naturel64 chiffre = convertir<naturel64>(courant - 48);
                si (*valeur > 214_748_364
                    || (*valeur == 214_748_364 && chiffre > 7)) {
                    SignalerErreurDeclaration(
                        etat,
                        ErreurAnalyseDeclarations::TailleTableauInvalide,
                        jeton->Ligne,
                        jeton->Colonne);
                    retourner faux;
                }
                *valeur = *valeur * 10 + chiffre;
            }
            index = index + 1;
        }
        si (*valeur == 0) {
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::TailleTableauInvalide,
                jeton->Ligne,
                jeton->Colonne);
            retourner faux;
        }
        etat->Position = etat->Position + 1;
        retourner vrai;
    }

    booléen AnalyserDimensionsDeclaration(
        EtatAnalyseDeclarations* etat, TypeDeclarationInterne* type) {
        tantque (AccepterJetonDeclaration(etat, 38)) {
            naturel64 valeur = 0;
            si (!LireTailleTableauDeclaration(etat, &valeur)) retourner faux;
            si (!ExigerJetonDeclaration(
                    etat,
                    39,
                    ErreurAnalyseDeclarations::CrochetFermantAttendu))
                retourner faux;
            type->NombreDimensions = type->NombreDimensions + 1;
            type->HachageDimensions = AjouterNaturel64Declaration(
                type->HachageDimensions, valeur);
        }
        retourner vrai;
    }

    naturel64 IndexExpressionNulDeclaration() {
        retourner 18_446_744_073_709_551_615;
    }

    naturel64 HacherSoiDeclaration() {
        naturel64 hachage = HachageVideDeclaration();
        hachage = AjouterOctetDeclaration(hachage, 115);
        hachage = AjouterOctetDeclaration(hachage, 111);
        retourner AjouterOctetDeclaration(hachage, 105);
    }

    vide InitialiserExpressionInterneDeclaration(
        NoeudExpressionInterne* noeud,
        naturel32 genre,
        naturel32 ligne,
        naturel32 colonne) {
        noeud->Genre = genre;
        noeud->Ligne = ligne;
        noeud->Colonne = colonne;
        noeud->Drapeaux = 0;
        noeud->DebutNom = 0;
        noeud->TailleNom = 0;
        noeud->HachageNom = 0;
        noeud->HachageType = 0;
        noeud->PremierEnfant = IndexExpressionNulDeclaration();
        noeud->DernierEnfant = IndexExpressionNulDeclaration();
        noeud->EnfantSuivant = IndexExpressionNulDeclaration();
    }

    naturel64 AjouterExpressionInterneDeclaration(
        EtatAnalyseDeclarations* etat,
        NoeudExpressionInterne noeud) {
        si (etat->NombreExpressions >= etat->NombreJetons) {
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::AllocationImpossible,
                noeud.Ligne,
                noeud.Colonne);
            retourner IndexExpressionNulDeclaration();
        }
        naturel64 index = etat->NombreExpressions;
        etat->ExpressionsTravail[index] = noeud;
        etat->NombreExpressions = index + 1;
        retourner index;
    }

    vide AjouterEnfantExpressionDeclaration(
        EtatAnalyseDeclarations* etat,
        naturel64 indexParent,
        naturel64 enfant) {
        etat->ExpressionsTravail[enfant].EnfantSuivant =
            IndexExpressionNulDeclaration();
        si (etat->ExpressionsTravail[indexParent].PremierEnfant
            == IndexExpressionNulDeclaration()) {
            etat->ExpressionsTravail[indexParent].PremierEnfant = enfant;
        }
        sinon {
            naturel64 dernier =
                etat->ExpressionsTravail[indexParent].DernierEnfant;
            etat->ExpressionsTravail[dernier].EnfantSuivant = enfant;
        }
        etat->ExpressionsTravail[indexParent].DernierEnfant = enfant;
    }

    booléen LireValeurEntiereExpressionDeclaration(
        EtatAnalyseDeclarations* etat,
        JetonLexe* jeton,
        naturel64* valeur) {
        *valeur = 0;
        naturel64 index = 0;
        tantque (index < jeton->TailleSource) {
            octet courant = convertir<octet>(
                etat->Requete->Source[jeton->Debut + index]);
            si (courant != 95) {
                naturel64 chiffre = convertir<naturel64>(courant - 48);
                si (*valeur > 1_844_674_407_370_955_161
                    || (*valeur == 1_844_674_407_370_955_161
                        && chiffre > 5)) {
                    SignalerErreurDeclaration(
                        etat,
                        ErreurAnalyseDeclarations::NombreEntierInvalide,
                        jeton->Ligne,
                        jeton->Colonne);
                    retourner faux;
                }
                *valeur = *valeur * 10 + chiffre;
            }
            index = index + 1;
        }
        retourner vrai;
    }

    externe naturel64 AnalyserExpressionInterneDeclaration(
        EtatAnalyseDeclarations* etat);

    naturel64 CreerExpressionBinaireDeclaration(
        EtatAnalyseDeclarations* etat,
        JetonLexe* jetonOperateur,
        naturel64 gauche,
        naturel64 droite) {
        NoeudExpressionInterne noeud;
        InitialiserExpressionInterneDeclaration(
            &noeud, 26, jetonOperateur->Ligne, jetonOperateur->Colonne);
        noeud.DebutNom = jetonOperateur->Debut;
        noeud.TailleNom = jetonOperateur->TailleSource;
        noeud.HachageNom = jetonOperateur->HachageTexte;
        naturel64 resultat = AjouterExpressionInterneDeclaration(etat, noeud);
        si (resultat == IndexExpressionNulDeclaration()) retourner resultat;
        AjouterEnfantExpressionDeclaration(etat, resultat, gauche);
        AjouterEnfantExpressionDeclaration(etat, resultat, droite);
        retourner resultat;
    }

    naturel64 AnalyserPrimaireExpressionDeclaration(
        EtatAnalyseDeclarations* etat) {
        JetonLexe* position = JetonCourantDeclaration(etat);
        si (AccepterJetonDeclaration(etat, 36)) {
            NoeudExpressionInterne agregat;
            InitialiserExpressionInterneDeclaration(
                &agregat, 32, position->Ligne, position->Colonne);
            naturel64 indexAgregat =
                AjouterExpressionInterneDeclaration(etat, agregat);
            si (indexAgregat == IndexExpressionNulDeclaration())
                retourner indexAgregat;
            si (!EstJetonDeclaration(etat, 37)) {
                booléen continuer = vrai;
                tantque (continuer) {
                    naturel64 element =
                        AnalyserExpressionInterneDeclaration(etat);
                    si (element == IndexExpressionNulDeclaration())
                        retourner element;
                    AjouterEnfantExpressionDeclaration(
                        etat, indexAgregat, element);
                    si (AccepterJetonDeclaration(etat, 41)) {
                        si (EstJetonDeclaration(etat, 37))
                            continuer = faux;
                    }
                    sinon continuer = faux;
                }
            }
            si (!ExigerJetonDeclaration(
                    etat,
                    37,
                    ErreurAnalyseDeclarations::AccoladeFermanteAttendue))
                retourner IndexExpressionNulDeclaration();
            retourner indexAgregat;
        }
        si (AccepterJetonDeclaration(etat, 2)) {
            naturel64 valeurEntiere = 0;
            si (!LireValeurEntiereExpressionDeclaration(
                    etat, position, &valeurEntiere))
                retourner IndexExpressionNulDeclaration();
            NoeudExpressionInterne entier;
            InitialiserExpressionInterneDeclaration(
                &entier, 22, position->Ligne, position->Colonne);
            entier.HachageType = valeurEntiere;
            retourner AjouterExpressionInterneDeclaration(etat, entier);
        }
        si (AccepterJetonDeclaration(etat, 3)) {
            NoeudExpressionInterne chaine;
            InitialiserExpressionInterneDeclaration(
                &chaine, 23, position->Ligne, position->Colonne);
            chaine.DebutNom = position->Debut;
            chaine.TailleNom = position->TailleSource;
            chaine.HachageNom = position->HachageTexte;
            retourner AjouterExpressionInterneDeclaration(etat, chaine);
        }
        si (AccepterJetonDeclaration(etat, 32)
            || AccepterJetonDeclaration(etat, 33)) {
            NoeudExpressionInterne litteralBooleen;
            InitialiserExpressionInterneDeclaration(
                &litteralBooleen, 22, position->Ligne, position->Colonne);
            litteralBooleen.Drapeaux = 16384;
            si (position->Genre == 32) litteralBooleen.HachageType = 1;
            retourner AjouterExpressionInterneDeclaration(etat, litteralBooleen);
        }
        si (AccepterJetonDeclaration(etat, 27)) {
            si (!ExigerJetonDeclaration(
                    etat,
                    48,
                    ErreurAnalyseDeclarations::ChevronOuvrantAttendu))
                retourner IndexExpressionNulDeclaration();
            TypeDeclarationInterne typeCible;
            si (!AnalyserTypeDeclaration(etat, &typeCible))
                retourner IndexExpressionNulDeclaration();
            si (!ExigerJetonDeclaration(
                    etat,
                    50,
                    ErreurAnalyseDeclarations::ChevronFermantAttendu))
                retourner IndexExpressionNulDeclaration();
            si (!ExigerJetonDeclaration(
                    etat,
                    34,
                    ErreurAnalyseDeclarations::ParentheseOuvranteAttendue))
                retourner IndexExpressionNulDeclaration();
            naturel64 valeurConvertie = AnalyserExpressionInterneDeclaration(etat);
            si (valeurConvertie == IndexExpressionNulDeclaration())
                retourner valeurConvertie;
            si (!ExigerJetonDeclaration(
                    etat,
                    35,
                    ErreurAnalyseDeclarations::ParentheseFermanteAttendue))
                retourner IndexExpressionNulDeclaration();
            NoeudExpressionInterne conversion;
            InitialiserExpressionInterneDeclaration(
                &conversion, 31, position->Ligne, position->Colonne);
            conversion.HachageType = HacherTypeDeclaration(&typeCible);
            naturel64 indexConversion =
                AjouterExpressionInterneDeclaration(etat, conversion);
            si (indexConversion == IndexExpressionNulDeclaration())
                retourner indexConversion;
            AjouterEnfantExpressionDeclaration(
                etat, indexConversion, valeurConvertie);
            retourner indexConversion;
        }
        si (AccepterJetonDeclaration(etat, 72)
            || AccepterJetonDeclaration(etat, 75)) {
            NoeudExpressionInterne referenceSoi;
            InitialiserExpressionInterneDeclaration(
                &referenceSoi, 24, position->Ligne, position->Colonne);
            referenceSoi.DebutNom = position->Debut;
            referenceSoi.TailleNom = position->TailleSource;
            referenceSoi.HachageNom = HacherSoiDeclaration();
            si (position->Genre == 75) referenceSoi.Drapeaux = 65536;
            retourner AjouterExpressionInterneDeclaration(etat, referenceSoi);
        }
        si (EstJetonDeclaration(etat, 1)) {
            NomQualifieDeclaration nom;
            si (!AnalyserNomQualifieDeclaration(etat, &nom))
                retourner IndexExpressionNulDeclaration();
            NoeudExpressionInterne variable;
            InitialiserExpressionInterneDeclaration(
                &variable, 24, nom.Ligne, nom.Colonne);
            variable.DebutNom = nom.Debut;
            variable.TailleNom = nom.Taille;
            variable.HachageNom = nom.Hachage;
            retourner AjouterExpressionInterneDeclaration(etat, variable);
        }
        si (AccepterJetonDeclaration(etat, 34)) {
            naturel64 expression =
                AnalyserExpressionInterneDeclaration(etat);
            si (expression == IndexExpressionNulDeclaration())
                retourner expression;
            si (!ExigerJetonDeclaration(
                    etat,
                    35,
                    ErreurAnalyseDeclarations::ParentheseFermanteAttendue))
                retourner IndexExpressionNulDeclaration();
            retourner expression;
        }
        SignalerErreurDeclaration(
            etat,
            ErreurAnalyseDeclarations::ExpressionAttendue,
            position->Ligne,
            position->Colonne);
        retourner IndexExpressionNulDeclaration();
    }

    naturel64 AnalyserPostfixeExpressionDeclaration(
        EtatAnalyseDeclarations* etat) {
        naturel64 expression = AnalyserPrimaireExpressionDeclaration(etat);
        si (expression == IndexExpressionNulDeclaration())
            retourner expression;
        booléen continuer = vrai;
        tantque (continuer) {
            si (AccepterJetonDeclaration(etat, 34)) {
                NoeudExpressionInterne appel;
                NoeudExpressionInterne* cible =
                    &etat->ExpressionsTravail[expression];
                InitialiserExpressionInterneDeclaration(
                    &appel, 28, cible->Ligne, cible->Colonne);
                naturel64 indexAppel =
                    AjouterExpressionInterneDeclaration(etat, appel);
                si (indexAppel == IndexExpressionNulDeclaration())
                    retourner indexAppel;
                AjouterEnfantExpressionDeclaration(
                    etat, indexAppel, expression);
                si (!EstJetonDeclaration(etat, 35)) {
                    booléen continuerArguments = vrai;
                    tantque (continuerArguments) {
                        naturel64 argument =
                            AnalyserExpressionInterneDeclaration(etat);
                        si (argument == IndexExpressionNulDeclaration())
                            retourner argument;
                        AjouterEnfantExpressionDeclaration(
                            etat, indexAppel, argument);
                        si (!AccepterJetonDeclaration(etat, 41))
                            continuerArguments = faux;
                    }
                }
                si (!ExigerJetonDeclaration(
                        etat,
                        35,
                        ErreurAnalyseDeclarations::ParentheseFermanteAttendue))
                    retourner IndexExpressionNulDeclaration();
                expression = indexAppel;
            }
            sinon si (EstJetonDeclaration(etat, 38)) {
                JetonLexe* crochet = JetonCourantDeclaration(etat);
                etat->Position = etat->Position + 1;
                naturel64 indice =
                    AnalyserExpressionInterneDeclaration(etat);
                si (indice == IndexExpressionNulDeclaration())
                    retourner indice;
                si (!ExigerJetonDeclaration(
                        etat,
                        39,
                        ErreurAnalyseDeclarations::CrochetFermantAttendu))
                    retourner IndexExpressionNulDeclaration();
                NoeudExpressionInterne indexation;
                InitialiserExpressionInterneDeclaration(
                    &indexation, 30, crochet->Ligne, crochet->Colonne);
                naturel64 indexIndexation =
                    AjouterExpressionInterneDeclaration(etat, indexation);
                si (indexIndexation == IndexExpressionNulDeclaration())
                    retourner indexIndexation;
                AjouterEnfantExpressionDeclaration(
                    etat, indexIndexation, expression);
                AjouterEnfantExpressionDeclaration(
                    etat, indexIndexation, indice);
                expression = indexIndexation;
            }
            sinon si (EstJetonDeclaration(etat, 42)
                || EstJetonDeclaration(etat, 43)) {
                JetonLexe* jetonOperateur = JetonCourantDeclaration(etat);
                etat->Position = etat->Position + 1;
                JetonLexe* membre = JetonCourantDeclaration(etat);
                si (!ExigerJetonDeclaration(
                        etat,
                        1,
                        ErreurAnalyseDeclarations::IdentifiantAttendu))
                    retourner IndexExpressionNulDeclaration();
                NoeudExpressionInterne acces;
                InitialiserExpressionInterneDeclaration(
                    &acces, 29, jetonOperateur->Ligne, jetonOperateur->Colonne);
                acces.DebutNom = membre->Debut;
                acces.TailleNom = membre->TailleSource;
                acces.HachageNom = membre->HachageTexte;
                si (jetonOperateur->Genre == 43) acces.Drapeaux = 32768;
                naturel64 indexAcces =
                    AjouterExpressionInterneDeclaration(etat, acces);
                si (indexAcces == IndexExpressionNulDeclaration())
                    retourner indexAcces;
                AjouterEnfantExpressionDeclaration(
                    etat, indexAcces, expression);
                expression = indexAcces;
            }
            sinon continuer = faux;
        }
        retourner expression;
    }

    naturel64 AnalyserUnaireExpressionDeclaration(
