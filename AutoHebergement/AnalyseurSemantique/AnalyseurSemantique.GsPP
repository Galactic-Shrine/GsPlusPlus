        retourner EstTypeAdresseSemantique(etat, hachageType)
            || EstPointeurFonctionExpressionSemantique(
                etat, indexExpression, hachageType);
    }

    ErreurAnalyseSemantique ValiderUnaireIntrinsequeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        constante NoeudDeclaration* expressionUnaire =
            &etat->Requete->Noeuds[indexExpression];
        si (expressionUnaire->Genre != 25)
            retourner ErreurAnalyseSemantique::Reussite;
        si (HachageTypeResolutionExpressionSemantique(
                etat, indexExpression) != 0)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 operateurAdresseUnaire =
            HacherOperateurExpressionSemantique(38, 0);
        naturel64 operateurDereferencementUnaire =
            HacherOperateurExpressionSemantique(42, 0);
        naturel64 operateurNegationUnaire =
            HacherOperateurExpressionSemantique(33, 0);

        naturel64 operandeUnaire = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 typeOperandeUnaire = HachageTypeExpressionSemantique(
            etat, operandeUnaire);
        si (expressionUnaire->HachageNom == operateurAdresseUnaire) {
            naturel64 origineOperandeAdresseUnaire =
                TrouverOrigineTypeExpressionSemantique(
                    etat, operandeUnaire);
            naturel64 symboleOperandeAdresse =
                TrouverCibleSymboleExpressionSemantique(
                    etat, operandeUnaire);
            si (symboleOperandeAdresse < etat->NombreSymboles
                && etat->SymbolesTravail[
                    symboleOperandeAdresse].Genre == 2)
                retourner ErreurAnalyseSemantique::Reussite;
            si (!EstValeurGaucheSemantique(etat, operandeUnaire))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AdresseValeurNonAdressable,
                    indexExpression,
                    0);
            naturel64 typeAdresseResultat =
                TransformerPointeurTypeSemantique(
                    etat,
                    typeOperandeUnaire,
                    origineOperandeAdresseUnaire,
                    vrai);
            si (typeAdresseResultat == 0) {
                DescriptionHachageTypeSemantique dimensionsAdresse;
                si (LireDimensionsNoeudSemantique(
                        etat,
                        origineOperandeAdresseUnaire,
                        &dimensionsAdresse))
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AdresseTableauCompletInterdite,
                        indexExpression,
                        dimensionsAdresse.NombreDimensions);
            }
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (expressionUnaire->HachageNom
            == operateurDereferencementUnaire) {
            naturel64 origineOperandeDereferenceUnaire =
                TrouverOrigineTypeExpressionSemantique(
                    etat, operandeUnaire);
            naturel64 typeDereferenceResultat =
                TransformerPointeurTypeSemantique(
                    etat,
                    typeOperandeUnaire,
                    origineOperandeDereferenceUnaire,
                    faux);
            si (typeDereferenceResultat == 0)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::DereferencementSansPointeur,
                    indexExpression,
                    0);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (expressionUnaire->HachageNom == operateurNegationUnaire) {
            si (!EstExpressionScalaireIntrinsequeSemantique(
                    etat, operandeUnaire, typeOperandeUnaire))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::NegationNonScalaire,
                    indexExpression,
                    0);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (!EstTypeEntierExpressionSemantique(typeOperandeUnaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::OperateurUnaireNonEntier,
                indexExpression,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderBinaireIntrinsequeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        constante NoeudDeclaration* expressionBinaire =
            &etat->Requete->Noeuds[indexExpression];
        si (expressionBinaire->Genre != 26)
            retourner ErreurAnalyseSemantique::Reussite;
        si (HachageTypeResolutionExpressionSemantique(
                etat, indexExpression) != 0)
            retourner ErreurAnalyseSemantique::Reussite;

        naturel64 operandeGaucheBinaire = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 operandeDroiteBinaire = TrouverEnfantDirectSemantique(
            etat, indexExpression, 1);
        naturel64 typeGaucheBinaire = HachageTypeExpressionSemantique(
            etat, operandeGaucheBinaire);
        naturel64 typeDroiteBinaire = HachageTypeExpressionSemantique(
            etat, operandeDroiteBinaire);
        naturel64 nomOperateurBinaire = expressionBinaire->HachageNom;
        booléen comparaisonBinaire =
            EstOperateurComparaisonExpressionSemantique(
                expressionBinaire);
        booléen decalageBinaire =
            EstOperateurDecalageExpressionSemantique(
                expressionBinaire);
        booléen logiqueBinaire =
            nomOperateurBinaire
                    == HacherOperateurExpressionSemantique(38, 38)
                || nomOperateurBinaire
                    == HacherOperateurExpressionSemantique(124, 124);

        si (logiqueBinaire) {
            si (!EstExpressionScalaireIntrinsequeSemantique(
                    etat,
                    operandeGaucheBinaire,
                    typeGaucheBinaire)
                || !EstExpressionScalaireIntrinsequeSemantique(
                    etat,
                    operandeDroiteBinaire,
                    typeDroiteBinaire))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::OperateurLogiqueNonScalaire,
                    indexExpression,
                    0);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (!decalageBinaire
            && !TypesValeurEgauxSemantique(
                etat, typeGaucheBinaire, typeDroiteBinaire)) {
            naturel64 cibleGaucheBinaire =
                SansQualificatifsValeurSemantique(
                    etat, typeDroiteBinaire);
            naturel64 cibleDroiteBinaire =
                SansQualificatifsValeurSemantique(
                    etat, typeGaucheBinaire);
            si (LitteralExpressionCompatibleTypeSemantique(
                    etat,
                    operandeGaucheBinaire,
                    cibleGaucheBinaire))
                typeGaucheBinaire = cibleGaucheBinaire;
            sinon si (LitteralExpressionCompatibleTypeSemantique(
                    etat,
                    operandeDroiteBinaire,
                    cibleDroiteBinaire))
                typeDroiteBinaire = cibleDroiteBinaire;
        }
        si (!decalageBinaire
            && !TypesValeurEgauxSemantique(
                etat, typeGaucheBinaire, typeDroiteBinaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::TypesOperandesDifferents,
                indexExpression,
                0);
        si (decalageBinaire
            && (!EstTypeEntierExpressionSemantique(typeGaucheBinaire)
                || !EstTypeEntierExpressionSemantique(
                    typeDroiteBinaire)))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::DecalageNonEntier,
                indexExpression,
                0);
        si (!comparaisonBinaire
            && !EstTypeEntierExpressionSemantique(typeGaucheBinaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::CalculNonEntier,
                indexExpression,
                0);
        si (comparaisonBinaire
            && !EstExpressionScalaireIntrinsequeSemantique(
                etat,
                operandeGaucheBinaire,
                typeGaucheBinaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ComparaisonTypeInvalide,
                indexExpression,
                0);

        booléen egaliteBinaire =
            nomOperateurBinaire
                    == HacherOperateurExpressionSemantique(61, 61)
                || nomOperateurBinaire
                    == HacherOperateurExpressionSemantique(33, 61);
        si (!egaliteBinaire
            && EstExpressionAdresseIntrinsequeSemantique(
                etat,
                operandeGaucheBinaire,
                typeGaucheBinaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ComparaisonPointeurInvalide,
                indexExpression,
                0);
        si (!egaliteBinaire
            && EstTypeBooleenExpressionSemantique(typeGaucheBinaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ComparaisonBooleenneInvalide,
                indexExpression,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderIndexationSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        naturel64 objetIndexationValidee = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 indiceIndexationValidee = TrouverEnfantDirectSemantique(
            etat, indexExpression, 1);
        naturel64 typeObjetIndexationValidee =
            HachageTypeExpressionSemantique(
                etat, objetIndexationValidee);
        naturel64 typeResultatIndexationValidee =
            HachageTypeIndexationSemantique(
                etat, indexExpression);
        naturel64 symboleObjetIndexationValidee =
            TrouverCibleSymboleExpressionSemantique(
                etat, objetIndexationValidee);
        booléen fonctionDirecteIndexee =
            symboleObjetIndexationValidee < etat->NombreSymboles
            && etat->SymbolesTravail[
                symboleObjetIndexationValidee].Genre == 2;
        naturel64 origineObjetIndexationValidee =
            TrouverOrigineTypeExpressionSemantique(
                etat, objetIndexationValidee);
        DescriptionTypeJetonsSemantique descriptionFonctionIndexee;
        booléen fonctionPureIndexee =
            LireDescriptionPointeurFonctionNoeudSemantique(
                etat,
                origineObjetIndexationValidee,
                typeObjetIndexationValidee,
                &descriptionFonctionIndexee)
            && descriptionFonctionIndexee.NiveauPointeur == 0;
        si (typeResultatIndexationValidee == 0
            || fonctionDirecteIndexee
            || fonctionPureIndexee)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::CibleIndexationInvalide,
                indexExpression,
                0);
        naturel64 typeIndiceIndexationValidee =
            HachageTypeExpressionSemantique(
                etat, indiceIndexationValidee);
        si (!EstTypeEntierExpressionSemantique(
                typeIndiceIndexationValidee))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::IndiceNonEntier,
                indiceIndexationValidee,
                0);
        si (EstTypeVideExpressionSemantique(
                typeResultatIndexationValidee))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::IndexationPointeurVide,
                indexExpression,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderArgumentsAppelIndirectSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexAppel,
        naturel64 debutTypePointeurFonction,
        naturel32 nombreParametresPointeurFonction) {
        CurseurTypeJetonsSemantique curseurArgumentsIndirects = {
            debutTypePointeurFonction, faux};
        booléen continuerQualificatifsAppel = vrai;
        tantque (continuerQualificatifsAppel) {
            si (AccepterTypeJetonsSemantique(
                    etat, &curseurArgumentsIndirects, 12)) {}
            sinon si (AccepterTypeJetonsSemantique(
                    etat, &curseurArgumentsIndirects, 13)) {}
            sinon continuerQualificatifsAppel = faux;
        }
        si (!AccepterTypeJetonsSemantique(
                etat, &curseurArgumentsIndirects, 26)
            || !AccepterTypeJetonsSemantique(
                etat, &curseurArgumentsIndirects, 48))
            retourner ErreurAnalyseSemantique::AstInvalide;
        DescriptionTypeJetonsSemantique retourArgumentsIndirects;
        si (!AnalyserTypeJetonsSemantique(
                etat,
                &curseurArgumentsIndirects,
                &retourArgumentsIndirects)
            || !AccepterTypeJetonsSemantique(
                etat, &curseurArgumentsIndirects, 34))
            retourner ErreurAnalyseSemantique::AstInvalide;

        naturel32 indexArgumentIndirect = 0;
        tantque (indexArgumentIndirect
            < nombreParametresPointeurFonction) {
            DescriptionTypeJetonsSemantique parametreAppelIndirect;
            si (!AnalyserTypeJetonsSemantique(
                    etat,
                    &curseurArgumentsIndirects,
                    &parametreAppelIndirect))
                retourner ErreurAnalyseSemantique::AstInvalide;
            naturel64 argumentAppelIndirect =
                TrouverEnfantDirectSemantique(
                    etat,
                    indexAppel,
                    convertir<naturel64>(indexArgumentIndirect) + 1);
            booléen parametreIndirectReference =
                (parametreAppelIndirect.Qualificatifs & 4) != 0;
            booléen argumentIndirectCompatible = vrai;
            si (parametreIndirectReference) {
                argumentIndirectCompatible =
                    LiaisonReferenceCompatibleSemantique(
                        etat,
                        argumentAppelIndirect,
                        parametreAppelIndirect.HachageType);
            }
            sinon argumentIndirectCompatible =
                InitialiseurCompatibleTypeSemantique(
                    etat,
                    argumentAppelIndirect,
                    parametreAppelIndirect.HachageType);
            si (!argumentIndirectCompatible)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        TypeArgumentAppelIndirectIncompatible,
                    argumentAppelIndirect,
                    indexArgumentIndirect);
            indexArgumentIndirect = indexArgumentIndirect + 1;
            si (indexArgumentIndirect
                < nombreParametresPointeurFonction
                && !AccepterTypeJetonsSemantique(
                    etat, &curseurArgumentsIndirects, 41))
                retourner ErreurAnalyseSemantique::AstInvalide;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderAppelIndirectSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAppel) {
        naturel64 cibleAppelIndirect = TrouverEnfantDirectSemantique(
            etat, indexAppel, 0);
        naturel64 symboleCibleAppelIndirect =
            TrouverCibleSymboleExpressionSemantique(
                etat, cibleAppelIndirect);
        si (symboleCibleAppelIndirect < etat->NombreSymboles
            && etat->SymbolesTravail[
                symboleCibleAppelIndirect].Genre == 2)
            retourner ErreurAnalyseSemantique::Reussite;

        naturel64 typeCibleAppelIndirect =
            HachageTypeExpressionSemantique(
                etat, cibleAppelIndirect);
        naturel64 origineCibleAppelIndirect =
            TrouverOrigineTypeExpressionSemantique(
                etat, cibleAppelIndirect);
        naturel64 symboleOrigineAppelIndirect =
            TrouverSymboleNoeudSemantique(
                etat, origineCibleAppelIndirect, 2);
        si (symboleOrigineAppelIndirect < etat->NombreSymboles
            && typeCibleAppelIndirect
                == HacherPointeurFonctionDeclarationSemantique(
                    etat, origineCibleAppelIndirect)) {
            naturel64 nombreEnfantsAdresseFonction =
                CompterEnfantsDirectsSemantique(etat, indexAppel);
            naturel64 nombreArgumentsAdresseFonction = 0;
            si (nombreEnfantsAdresseFonction != 0)
                nombreArgumentsAdresseFonction =
                    nombreEnfantsAdresseFonction - 1;
            si (nombreArgumentsAdresseFonction
                != CompterParametresFonctionSemantique(
                    etat, origineCibleAppelIndirect))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AriteAppelIndirectInvalide,
                    indexAppel,
                    convertir<naturel32>(nombreArgumentsAdresseFonction));
            si (EvaluerArgumentsFonctionSemantique(
                    etat,
                    indexAppel,
                    origineCibleAppelIndirect,
                    1) == 4_294_967_295) {
                naturel64 premierArgumentAdresseFonction =
                    TrouverEnfantDirectSemantique(
                        etat, indexAppel, 1);
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        TypeArgumentAppelIndirectIncompatible,
                    premierArgumentAdresseFonction,
                    0);
            }
            retourner ErreurAnalyseSemantique::Reussite;
        }
        DescriptionTypeJetonsSemantique descriptionAppelIndirect;
        si (!LireDescriptionPointeurFonctionNoeudSemantique(
                etat,
                origineCibleAppelIndirect,
                typeCibleAppelIndirect,
                &descriptionAppelIndirect)
            || descriptionAppelIndirect.NiveauPointeur != 0)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::CibleAppelIndirectInvalide,
                cibleAppelIndirect,
                0);

        naturel64 nombreEnfantsAppelIndirect =
            CompterEnfantsDirectsSemantique(etat, indexAppel);
        naturel64 nombreArgumentsAppelIndirect = 0;
        si (nombreEnfantsAppelIndirect != 0)
            nombreArgumentsAppelIndirect =
                nombreEnfantsAppelIndirect - 1;
        si (nombreArgumentsAppelIndirect
            != convertir<naturel64>(descriptionAppelIndirect.Reserve))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AriteAppelIndirectInvalide,
                indexAppel,
                convertir<naturel32>(nombreArgumentsAppelIndirect));
        retourner ValiderArgumentsAppelIndirectSemantique(
            etat,
            indexAppel,
            descriptionAppelIndirect.DebutType,
            descriptionAppelIndirect.Reserve);
    }

    ErreurAnalyseSemantique ResoudreOperateurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        si ((expression->Genre != 25 && expression->Genre != 26)
            || EstOperateurUnaireIntrinsequeSemantique(expression))
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 gauche = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 typeGauche = TrouverTypeDepuisHachageSemantique(
            etat,
            HachageTypeExpressionSemantique(etat, gauche),
            0);
        booléen classeGauche = typeGauche < etat->NombreSymboles
            && etat->Requete->Noeuds[
                etat->SymbolesTravail[typeGauche].IndexNoeud].Genre == 6;
        si (classeGauche) {
            naturel64 typeDeclarant =
                TrouverTypeDeclarantOperateurSemantique(
                    etat, typeGauche, expression->HachageNom);
            si (typeDeclarant < etat->NombreSymboles) {
                naturel64 cibleOperateur = SelectionnerOperateurSemantique(
                    etat, indexExpression, typeDeclarant);
                si (cibleOperateur >= etat->NombreSymboles)
                    retourner etat->Requete->Resultat.Erreur;
                si (!AccesMembreAutoriseSemantique(
                        etat, cibleOperateur, indexExpression))
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::MembreInaccessible,
                        indexExpression,
                        convertir<naturel32>(cibleOperateur));
                naturel32 drapeauxMembre = 8 | 32 | 256;
                si (typeDeclarant != typeGauche)
                    drapeauxMembre = drapeauxMembre | 16;
                si (CompterOperateursTypeSemantique(
                        etat,
                        typeDeclarant,
                        expression->HachageNom) > 1)
                    drapeauxMembre = drapeauxMembre | 1;
                AjouterResolutionSemantique(
                    etat,
                    indexExpression,
                    cibleOperateur,
                    drapeauxMembre);
                retourner ErreurAnalyseSemantique::Reussite;
            }
        }

        booléen classeDroite = faux;
        si (expression->Genre == 26) {
            naturel64 droite = TrouverEnfantDirectSemantique(
                etat, indexExpression, 1);
            naturel64 typeDroite = TrouverTypeDepuisHachageSemantique(
                etat,
                HachageTypeExpressionSemantique(etat, droite),
                0);
            classeDroite = typeDroite < etat->NombreSymboles
                && etat->Requete->Noeuds[
                    etat->SymbolesTravail[typeDroite].IndexNoeud].Genre == 6;
        }
        si (!classeGauche && !classeDroite)
            retourner ErreurAnalyseSemantique::Reussite;

        naturel64 espaceOperateurLibre = 0;
        si (!TrouverEspaceOperateurLibreSemantique(
                etat, indexExpression, &espaceOperateurLibre))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::OperateurIntrouvable,
                indexExpression,
                0);
        naturel64 cibleOperateurLibre =
            SelectionnerOperateurLibreSemantique(
                etat, indexExpression, espaceOperateurLibre);
        si (cibleOperateurLibre >= etat->NombreSymboles)
            retourner etat->Requete->Resultat.Erreur;
        naturel32 drapeauxLibres = 256;
        si (CompterOperateursLibresSemantique(
                etat,
                indexExpression,
                espaceOperateurLibre) > 1)
            drapeauxLibres = drapeauxLibres | 1;
        AjouterResolutionSemantique(
            etat,
            indexExpression,
            cibleOperateurLibre,
            drapeauxLibres);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 CompterFonctionsCorrespondantesSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        naturel64 nombre = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == 0
                && ReferenceCorrespondSymboleSemantique(
                    etat, reference, candidat))
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    ErreurAnalyseSemantique ResoudreReferenceSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexNoeud];
        si (reference->Genre != 24)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 cible = etat->NombreSymboles;
        naturel32 drapeaux = 0;
        si ((reference->Drapeaux & 65_536) != 0) {
            cible = TrouverBaseSemantique(etat, indexNoeud);
            drapeaux = 2 | 4;
        }
        sinon si (reference->HachageNom == HacherSoiSemantique()) {
            cible = TrouverRecepteurSemantique(etat, indexNoeud);
            drapeaux = 2;
        }
        sinon {
            cible = TrouverVariableSemantique(etat, indexNoeud);
            si (cible >= etat->NombreSymboles)
                cible = TrouverDeclarationRacineSemantique(etat, indexNoeud);
        }

        si (cible >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::SymboleIntrouvable,
                indexNoeud,
                0);

        si (etat->SymbolesTravail[cible].Genre == 2) {
            naturel64 nombre = CompterFonctionsCorrespondantesSemantique(
                etat, indexNoeud);
            constante NoeudDeclaration* noeudParent =
                &etat->Requete->Noeuds[reference->Parent];
            booléen cibleAppel = noeudParent->Genre == 28
                && indexNoeud == reference->Parent + 1;
            si (nombre > 1) {
                si (!cibleAppel)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AdresseSurchargeAmbigue,
                        indexNoeud,
                        convertir<naturel32>(nombre));
                cible = SelectionnerSurchargeSemantique(
                    etat, indexNoeud, reference->Parent);
                si (cible >= etat->NombreSymboles)
                    retourner etat->Requete->Resultat.Erreur;
                drapeaux = drapeaux | 1;
            }
        }
        AjouterResolutionSemantique(etat, indexNoeud, cible, drapeaux);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    booléen EstExpressionTableauSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        naturel64 origineTableau = TrouverOrigineTypeExpressionSemantique(
            etat, indexExpression);
        DescriptionHachageTypeSemantique dimensionsTableau;
        si (origineTableau >= etat->Requete->NombreNoeuds
            || !LireDimensionsNoeudSemantique(
                etat, origineTableau, &dimensionsTableau))
            retourner faux;
        naturel64 typeElementFinal = HachageElementFinalTableauSemantique(
            etat, origineTableau);
        naturel64 typeExpression = HachageTypeExpressionSemantique(
            etat, indexExpression);
        retourner typeElementFinal != 0
            && typeExpression != typeElementFinal;
    }

    ErreurAnalyseSemantique ValiderAffectationSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAffectation) {
        naturel64 cibleAffectation = TrouverEnfantDirectSemantique(
            etat, indexAffectation, 0);
        naturel64 valeurAffectation = TrouverEnfantDirectSemantique(
            etat, indexAffectation, 1);
        si (!EstValeurGaucheSemantique(etat, cibleAffectation))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::CibleAffectationNonModifiable,
                indexAffectation,
                0);
        si (EstExpressionValeurConstanteSemantique(
                etat, cibleAffectation))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::
                    AffectationValeurConstanteInterdite,
                indexAffectation,
                0);
        si (EstExpressionTableauSemantique(etat, cibleAffectation))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AffectationTableauInterdite,
                indexAffectation,
                0);
        naturel64 typeCibleAffectation = HachageTypeExpressionSemantique(
            etat, cibleAffectation);
        si (!InitialiseurCompatibleTypeSemantique(
                etat, valeurAffectation, typeCibleAffectation))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::TypeAffectationIncompatible,
                valeurAffectation,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 TrouverFonctionContenantSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        si (indexNoeud >= etat->Requete->NombreNoeuds)
            retourner etat->Requete->NombreNoeuds;
        naturel64 courantFonction = etat->Requete->Noeuds[
            indexNoeud].Parent;
        tantque (courantFonction != 0
            && courantFonction < etat->Requete->NombreNoeuds) {
            si (EstGenreFonctionSemantique(
                    etat->Requete->Noeuds[courantFonction].Genre))
                retourner courantFonction;
            courantFonction = etat->Requete->Noeuds[
                courantFonction].Parent;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    ErreurAnalyseSemantique ValiderRetourSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexRetour) {
        naturel64 indexFonction = TrouverFonctionContenantSemantique(
            etat, indexRetour);
        si (indexFonction >= etat->Requete->NombreNoeuds)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexRetour,
                46);
        naturel64 typeRetour = etat->Requete->Noeuds[
            indexFonction].HachageType;
        booléen valeurPresente =
            (etat->Requete->Noeuds[indexRetour].Drapeaux & 2048) != 0;
        si (!valeurPresente) {
            si (!EstTypeVideExpressionSemantique(typeRetour))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::ValeurRetourAttendue,
                    indexRetour,
                    0);
            retourner ErreurAnalyseSemantique::Reussite;
        }
        naturel64 valeurRetour = TrouverEnfantDirectSemantique(
            etat, indexRetour, 0);
        si (!InitialiseurCompatibleTypeSemantique(
                etat, valeurRetour, typeRetour))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::TypeRetourIncompatible,
                valeurRetour,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ResoudreExpressionsSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 indexExpression = etat->Requete->NombreNoeuds;
        tantque (indexExpression != 0) {
            indexExpression = indexExpression - 1;
            constante NoeudDeclaration* expressionCourante =
                &etat->Requete->Noeuds[indexExpression];
            ErreurAnalyseSemantique erreurExpression =
                ErreurAnalyseSemantique::Reussite;
            si (expressionCourante->Genre == 24)
                erreurExpression = ResoudreReferenceSemantique(
                    etat, indexExpression);
            sinon si (expressionCourante->Genre == 29)
                erreurExpression = ResoudreMembreSemantique(
                    etat, indexExpression);
            sinon si (expressionCourante->Genre == 25
                || expressionCourante->Genre == 26)
                erreurExpression = ResoudreOperateurSemantique(
                    etat, indexExpression);
            si (erreurExpression == ErreurAnalyseSemantique::Reussite
                && expressionCourante->Genre == 25)
                erreurExpression = ValiderUnaireIntrinsequeSemantique(
                    etat, indexExpression);
            si (erreurExpression == ErreurAnalyseSemantique::Reussite
                && expressionCourante->Genre == 26)
                erreurExpression = ValiderBinaireIntrinsequeSemantique(
                    etat, indexExpression);
            si (erreurExpression == ErreurAnalyseSemantique::Reussite
                && expressionCourante->Genre == 30)
                erreurExpression = ValiderIndexationSemantique(
                    etat, indexExpression);
            si (erreurExpression == ErreurAnalyseSemantique::Reussite
                && expressionCourante->Genre == 28)
                erreurExpression = ValiderAppelIndirectSemantique(
                    etat, indexExpression);
            si (erreurExpression == ErreurAnalyseSemantique::Reussite
                && expressionCourante->Genre == 27)
                erreurExpression = ValiderAffectationSemantique(
                    etat, indexExpression);
            si (erreurExpression == ErreurAnalyseSemantique::Reussite
                && expressionCourante->Genre == 17)
                erreurExpression = ValiderRetourSemantique(
                    etat, indexExpression);
            si (erreurExpression != ErreurAnalyseSemantique::Reussite)
                retourner erreurExpression;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    publique ErreurAnalyseSemantique AnalyserSemantique(
        RequeteAnalyseSemantique* requete) {
        si (requete == NulRequetesAnalyseSemantique)
            retourner ErreurAnalyseSemantique::ArgumentInvalide;

        requete->Resultat.Erreur = ErreurAnalyseSemantique::Reussite;
        requete->Resultat.LigneErreur = 0;
        requete->Resultat.ColonneErreur = 0;
        requete->Resultat.Detail = 0;
        requete->Resultat.NombreSymboles = 0;
        requete->Resultat.CapaciteSymbolesRequise = 0;
        requete->Resultat.NombreResolutions = 0;
        requete->Resultat.CapaciteResolutionsRequise = 0;
        requete->Resultat.NombreOctetsArene = 0;

        EtatAnalyseSemantique etat;
        etat.Requete = requete;
        etat.SymbolesTravail = NulSymbolesSemantiques;
        etat.NombreSymboles = 0;
        etat.NombreResolutions = 0;
        etat.CiblesInitialiseurs = NulCiblesInitialiseursSemantiques;
        etat.CiblesExpressions = NulCiblesExpressionsSemantiques;
        etat.JetonsTypes = NulJetonsTypesSemantiques;
        etat.NombreJetonsTypes = 0;
        etat.TaillesTypes = NulNaturelsDispositionSemantique;
        etat.AlignementsTypes = NulNaturelsDispositionSemantique;
        etat.DecalagesChamps = NulNaturelsDispositionSemantique;
        etat.DecalagesTablesVirtuelles = NulNaturelsDispositionSemantique;
        etat.EtatsDisposition = NulEtatsDispositionSemantique;
        etat.EtatsPolymorphisme = NulEtatsDispositionSemantique;
        GalacticShrine::GsPP::Hebergee::InitialiserArene(&etat.Arene, 4096);
        naturel64 index = 0;

        si (requete->Source == NulCaracteresSemantiques
            || (requete->CapaciteSymboles != 0
                && requete->Symboles == NulSymbolesSemantiques)
            || (requete->CapaciteResolutions != 0
                && requete->Resolutions == NulResolutionsSemantiques)) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::ArgumentInvalide, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        si (!ValiderAstSemantique(&etat)) {
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        si (requete->NombreNoeuds
            > 384_307_168_202_282_325) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        si (!InitialiserJetonsTypesSemantiques(&etat)) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        etat.SymbolesTravail = convertir<SymboleSemantique*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene,
                requete->NombreNoeuds * 48,
                8));
        si (etat.SymbolesTravail == NulSymbolesSemantiques) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        etat.CiblesInitialiseurs = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene,
                requete->NombreNoeuds * 8,
                8));
        si (etat.CiblesInitialiseurs
            == NulCiblesInitialiseursSemantiques) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        etat.CiblesExpressions = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene,
                requete->NombreNoeuds * 8,
                8));
        si (etat.CiblesExpressions == NulCiblesExpressionsSemantiques) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        index = 0;
        tantque (index < requete->NombreNoeuds) {
            etat.CiblesInitialiseurs[index] = requete->NombreNoeuds;
            etat.CiblesExpressions[index] = requete->NombreNoeuds;
            index = index + 1;
        }

        index = 0;
        tantque (index < requete->NombreNoeuds) {
            AjouterSymboleSemantique(&etat, index);
            index = index + 1;
        }
        requete->Resultat.NombreSymboles = etat.NombreSymboles;
        requete->Resultat.CapaciteSymbolesRequise = etat.NombreSymboles;

        etat.TaillesTypes = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.AlignementsTypes = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.DecalagesChamps = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.DecalagesTablesVirtuelles = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.EtatsDisposition = convertir<octet*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles, 1));
        etat.EtatsPolymorphisme = convertir<octet*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles, 1));
        si (etat.TaillesTypes == NulNaturelsDispositionSemantique
            || etat.AlignementsTypes == NulNaturelsDispositionSemantique
            || etat.DecalagesChamps == NulNaturelsDispositionSemantique
            || etat.DecalagesTablesVirtuelles
                == NulNaturelsDispositionSemantique
            || etat.EtatsDisposition == NulEtatsDispositionSemantique
            || etat.EtatsPolymorphisme == NulEtatsDispositionSemantique) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        index = 0;
        tantque (index < etat.NombreSymboles) {
            etat.TaillesTypes[index] = 0;
            etat.AlignementsTypes[index] = 0;
            etat.DecalagesChamps[index] = 0;
            etat.DecalagesTablesVirtuelles[index] = 0;
            etat.EtatsDisposition[index] = 0;
            etat.EtatsPolymorphisme[index] = 0;
            index = index + 1;
        }

        ErreurAnalyseSemantique erreur = VerifierConflitsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderAritesOperateursSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = CalculerDispositionsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderGlobalesSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ResoudreExpressionsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ResoudreConstructionsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderInitialiseursAgregesSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderInitialiseursGlobauxSemantiques(&etat);

        requete->Resultat.NombreResolutions = etat.NombreResolutions;
        requete->Resultat.CapaciteResolutionsRequise = etat.NombreResolutions;
        requete->Resultat.NombreOctetsArene = etat.Arene.NombreOctets;

        naturel64 nombreCopie = etat.NombreSymboles;
        si (nombreCopie > requete->CapaciteSymboles)
            nombreCopie = requete->CapaciteSymboles;
        index = 0;
        tantque (index < nombreCopie) {
            requete->Symboles[index] = etat.SymbolesTravail[index];
            index = index + 1;
        }

        si (erreur == ErreurAnalyseSemantique::Reussite
            && requete->CapaciteSymboles < etat.NombreSymboles)
            erreur = SignalerErreurSemantique(
                &etat,
                ErreurAnalyseSemantique::CapaciteSymbolesInsuffisante,
                0,
                convertir<naturel32>(etat.NombreSymboles));
        sinon si (erreur == ErreurAnalyseSemantique::Reussite
            && requete->CapaciteResolutions < etat.NombreResolutions)
            erreur = SignalerErreurSemantique(
                &etat,
                ErreurAnalyseSemantique::CapaciteResolutionsInsuffisante,
                0,
                convertir<naturel32>(etat.NombreResolutions));

        GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
        retourner erreur;
    }
}
