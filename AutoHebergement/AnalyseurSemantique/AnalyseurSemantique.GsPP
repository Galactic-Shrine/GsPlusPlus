espace GalacticShrine::GsPP::Autohebergement {
    constante NoeudDeclaration* NulNoeudsSemantiques;
    SymboleSemantique* NulSymbolesSemantiques;
    ResolutionSemantique* NulResolutionsSemantiques;
    RequeteAnalyseSemantique* NulRequetesAnalyseSemantique;
    constante caractère* NulCaracteresSemantiques;

    structure EtatAnalyseSemantique {
        RequeteAnalyseSemantique* Requete;
        SymboleSemantique* SymbolesTravail;
        naturel64 NombreSymboles;
        naturel64 NombreResolutions;
        GalacticShrine::GsPP::Hebergee::AreneMemoire Arene;
    };

    naturel64 HachageVideSemantique() {
        retourner 14_695_981_039_346_656_037;
    }

    naturel64 AjouterOctetSemantique(naturel64 hachage, octet valeur) {
        retourner (hachage ^ convertir<naturel64>(valeur))
            * 1_099_511_628_211;
    }

    naturel64 AjouterNaturel32Semantique(
        naturel64 hachage, naturel32 valeur) {
        naturel32 index = 0;
        tantque (index < 4) {
            hachage = AjouterOctetSemantique(
                hachage, convertir<octet>(valeur & 255));
            valeur = valeur >> 8;
            index = index + 1;
        }
        retourner hachage;
    }

    naturel64 AjouterNaturel64Semantique(
        naturel64 hachage, naturel64 valeur) {
        naturel32 index = 0;
        tantque (index < 8) {
            hachage = AjouterOctetSemantique(
                hachage, convertir<octet>(valeur & 255));
            valeur = valeur >> 8;
            index = index + 1;
        }
        retourner hachage;
    }

    naturel64 HacherTypeSimpleSemantique(
        naturel32 genre,
        naturel32 qualificatifs,
        naturel32 niveauPointeur) {
        naturel64 hachage = HachageVideSemantique();
        hachage = AjouterNaturel32Semantique(hachage, genre);
        hachage = AjouterNaturel32Semantique(hachage, qualificatifs);
        hachage = AjouterNaturel32Semantique(hachage, niveauPointeur);
        hachage = AjouterNaturel32Semantique(hachage, 0);
        hachage = AjouterNaturel64Semantique(
            hachage, HachageVideSemantique());
        hachage = AjouterNaturel64Semantique(
            hachage, HachageVideSemantique());
        retourner hachage;
    }

    naturel64 HacherTypeNommeSemantique(
        naturel64 hachageNom,
        naturel32 qualificatifs,
        naturel32 niveauPointeur) {
        naturel64 hachage = HachageVideSemantique();
        hachage = AjouterNaturel32Semantique(hachage, 13);
        hachage = AjouterNaturel32Semantique(hachage, qualificatifs);
        hachage = AjouterNaturel32Semantique(hachage, niveauPointeur);
        hachage = AjouterNaturel32Semantique(hachage, 0);
        hachage = AjouterNaturel64Semantique(hachage, hachageNom);
        hachage = AjouterNaturel64Semantique(
            hachage, HachageVideSemantique());
        retourner hachage;
    }

    naturel64 AjouterNomNoeudSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachage,
        naturel64 indexNoeud) {
        constante NoeudDeclaration* noeud =
            &etat->Requete->Noeuds[indexNoeud];
        naturel64 index = 0;
        tantque (index < noeud->TailleNom) {
            hachage = AjouterOctetSemantique(
                hachage,
                convertir<octet>(
                    etat->Requete->Source[noeud->DebutNom + index]));
            index = index + 1;
        }
        retourner hachage;
    }

    naturel64 HacherNomCompletSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        constante NoeudDeclaration* noeud =
            &etat->Requete->Noeuds[indexNoeud];
        naturel64 hachage = noeud->HachageEspace;
        si (hachage != HachageVideSemantique()) {
            hachage = AjouterOctetSemantique(hachage, 58);
            hachage = AjouterOctetSemantique(hachage, 58);
        }
        retourner AjouterNomNoeudSemantique(etat, hachage, indexNoeud);
    }

    naturel64 HacherSoiSemantique() {
        naturel64 hachage = HachageVideSemantique();
        hachage = AjouterOctetSemantique(hachage, 115);
        hachage = AjouterOctetSemantique(hachage, 111);
        retourner AjouterOctetSemantique(hachage, 105);
    }

    booléen EstGenreFonctionSemantique(naturel32 genre) {
        retourner genre == 1
            || genre == 12
            || genre == 13
            || genre == 14
            || genre == 15;
    }

    naturel32 GenreSymboleDepuisNoeudSemantique(naturel32 genre) {
        si (genre == 4 || genre == 5 || genre == 6 || genre == 8)
            retourner 1;
        si (EstGenreFonctionSemantique(genre)) retourner 2;
        si (genre == 3) retourner 3;
        si (genre == 10) retourner 4;
        si (genre == 7) retourner 5;
        si (genre == 11) retourner 6;
        si (genre == 9) retourner 7;
        si (genre == 2) retourner 8;
        si (genre == 19) retourner 9;
        retourner 0;
    }

    ErreurAnalyseSemantique SignalerErreurSemantique(
        EtatAnalyseSemantique* etat,
        ErreurAnalyseSemantique erreur,
        naturel64 indexNoeud,
        naturel32 detail) {
        etat->Requete->Resultat.Erreur = erreur;
        etat->Requete->Resultat.Detail = detail;
        si (indexNoeud < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[indexNoeud];
            etat->Requete->Resultat.LigneErreur = noeud->Ligne;
            etat->Requete->Resultat.ColonneErreur = noeud->Colonne;
        }
        sinon {
            etat->Requete->Resultat.LigneErreur = 1;
            etat->Requete->Resultat.ColonneErreur = 1;
        }
        retourner erreur;
    }

    booléen ValiderAstSemantique(EtatAnalyseSemantique* etat) {
        si (etat->Requete->NombreNoeuds == 0
            || etat->Requete->Noeuds == NulNoeudsSemantiques) {
            SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::AstInvalide, 0, 0);
            retourner faux;
        }
        si (etat->Requete->Noeuds[0].Genre != 0) {
            SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::AstInvalide, 0, 1);
            retourner faux;
        }

        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[index];
            si (index != 0 && noeud->Parent >= index) {
                SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    index,
                    2);
                retourner faux;
            }
            si (noeud->TailleNom != 0
                && (noeud->DebutNom > etat->Requete->TailleSource
                    || noeud->TailleNom
                        > etat->Requete->TailleSource - noeud->DebutNom)) {
                SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    index,
                    3);
                retourner faux;
            }
            index = index + 1;
        }
        retourner vrai;
    }

    booléen AjouterSymboleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        constante NoeudDeclaration* noeud =
            &etat->Requete->Noeuds[indexNoeud];
        naturel32 genre = GenreSymboleDepuisNoeudSemantique(noeud->Genre);
        si (genre == 0) retourner vrai;
        SymboleSemantique symbole = {
            indexNoeud,
            noeud->Parent,
            noeud->HachageNom,
            noeud->HachageEspace,
            noeud->HachageType,
            genre,
            noeud->Drapeaux};
        etat->SymbolesTravail[etat->NombreSymboles] = symbole;
        etat->NombreSymboles = etat->NombreSymboles + 1;
        retourner vrai;
    }

    booléen MemesNomsCompletsSemantiques(
        SymboleSemantique* gauche, SymboleSemantique* droite) {
        retourner gauche->HachageNom == droite->HachageNom
            && gauche->HachageEspace == droite->HachageEspace;
    }

    booléen MemesNomsPorteeSemantiques(
        SymboleSemantique* gauche, SymboleSemantique* droite) {
        retourner gauche->IndexPortee == droite->IndexPortee
            && gauche->HachageNom == droite->HachageNom;
    }

    booléen EstAncetreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 ancetre,
        naturel64 descendant) {
        naturel64 courant = descendant;
        tantque (courant != 0 && courant < etat->Requete->NombreNoeuds) {
            si (courant == ancetre) retourner vrai;
            courant = etat->Requete->Noeuds[courant].Parent;
        }
        retourner ancetre == 0;
    }

    naturel64 TrouverFonctionAncetreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        naturel64 courant = indexNoeud;
        tantque (courant != 0 && courant < etat->Requete->NombreNoeuds) {
            si (EstGenreFonctionSemantique(
                    etat->Requete->Noeuds[courant].Genre))
                retourner courant;
            courant = etat->Requete->Noeuds[courant].Parent;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    ErreurAnalyseSemantique VerifierConflitsSemantiques(
        EtatAnalyseSemantique* etat) {
        booléen fonctionPresente = faux;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            si (etat->SymbolesTravail[index].Genre == 2)
                fonctionPresente = vrai;
            index = index + 1;
        }

        /**
         * Le bootstrap indexe d'abord les énumérations, puis les autres types.
         * Cet ordre reste stable même si les déclarations sont entrelacées dans
         * le fichier source.
         **/
        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantEnumeration =
                &etat->SymbolesTravail[index];
            si (courantEnumeration->Genre == 1
                && etat->Requete->Noeuds[
                    courantEnumeration->IndexNoeud].Genre == 8) {
                naturel64 precedentEnumeration = 0;
                tantque (precedentEnumeration < index) {
                    SymboleSemantique* autreEnumeration =
                        &etat->SymbolesTravail[precedentEnumeration];
                    si (autreEnumeration->Genre == 1
                        && etat->Requete->Noeuds[
                            autreEnumeration->IndexNoeud].Genre == 8
                        && MemesNomsCompletsSemantiques(
                            courantEnumeration, autreEnumeration))
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::TypeDeclarePlusieursFois,
                            courantEnumeration->IndexNoeud,
                            convertir<naturel32>(
                                autreEnumeration->IndexNoeud));
                    precedentEnumeration = precedentEnumeration + 1;
                }
            }
            index = index + 1;
        }

        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantType = &etat->SymbolesTravail[index];
            naturel32 genreNoeud =
                etat->Requete->Noeuds[courantType->IndexNoeud].Genre;
            si (courantType->Genre == 1 && genreNoeud != 8) {
                naturel64 precedentType = 0;
                tantque (precedentType < etat->NombreSymboles) {
                    SymboleSemantique* autreType =
                        &etat->SymbolesTravail[precedentType];
                    si (autreType->Genre == 1
                        && autreType->IndexNoeud != courantType->IndexNoeud
                        && MemesNomsCompletsSemantiques(
                            courantType, autreType)) {
                        naturel32 genreAutre =
                            etat->Requete->Noeuds[
                                autreType->IndexNoeud].Genre;
                        si (genreAutre == 8)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::NomTypeEnConflit,
                                courantType->IndexNoeud,
                                convertir<naturel32>(
                                    autreType->IndexNoeud));
                        si (autreType->IndexNoeud < courantType->IndexNoeud)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::TypeDeclarePlusieursFois,
                                courantType->IndexNoeud,
                                convertir<naturel32>(
                                    autreType->IndexNoeud));
                    }
                    precedentType = precedentType + 1;
                }
            }
            index = index + 1;
        }

        // Les fonctions libres sont ensuite confrontées aux noms de types.
        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantFonction =
                &etat->SymbolesTravail[index];
            si (courantFonction->Genre == 2
                && courantFonction->IndexPortee == 0) {
                naturel64 precedentFonction = 0;
                tantque (precedentFonction < etat->NombreSymboles) {
                    SymboleSemantique* autreFonction =
                        &etat->SymbolesTravail[precedentFonction];
                    si (autreFonction->Genre == 1
                        && MemesNomsCompletsSemantiques(
                            courantFonction, autreFonction))
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::NomTypeEnConflit,
                            courantFonction->IndexNoeud,
                            convertir<naturel32>(
                                autreFonction->IndexNoeud));
                    precedentFonction = precedentFonction + 1;
                }
            }
            index = index + 1;
        }

        // Les globales sont indexées après les fonctions et les types.
        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantGlobale =
                &etat->SymbolesTravail[index];
            si (courantGlobale->Genre == 3
                && courantGlobale->IndexPortee == 0) {
                naturel64 precedentGlobale = 0;
                tantque (precedentGlobale < etat->NombreSymboles) {
                    SymboleSemantique* autreGlobale =
                        &etat->SymbolesTravail[precedentGlobale];
                    si (autreGlobale->IndexPortee == 0
                        && MemesNomsCompletsSemantiques(
                            courantGlobale, autreGlobale)) {
                        si (autreGlobale->Genre == 3
                            && autreGlobale->IndexNoeud
                                < courantGlobale->IndexNoeud)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::GlobaleDeclareePlusieursFois,
                                courantGlobale->IndexNoeud,
                                convertir<naturel32>(
                                    autreGlobale->IndexNoeud));
                        si (autreGlobale->Genre == 1
                            || autreGlobale->Genre == 2)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::NomGlobalEnConflit,
                                courantGlobale->IndexNoeud,
                                convertir<naturel32>(
                                    autreGlobale->IndexNoeud));
                    }
                    precedentGlobale = precedentGlobale + 1;
                }
            }
            index = index + 1;
        }

        // Les alias ferment l'index des déclarations racines.
        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantAlias =
                &etat->SymbolesTravail[index];
            si (courantAlias->Genre == 4
                && courantAlias->IndexPortee == 0) {
                naturel64 precedentAlias = 0;
                tantque (precedentAlias < etat->NombreSymboles) {
                    SymboleSemantique* autreAlias =
                        &etat->SymbolesTravail[precedentAlias];
                    si (autreAlias->IndexPortee == 0
                        && autreAlias->IndexNoeud
                            != courantAlias->IndexNoeud
                        && MemesNomsCompletsSemantiques(
                            courantAlias, autreAlias)) {
                        si (autreAlias->Genre == 4) {
                            si (autreAlias->IndexNoeud
                                < courantAlias->IndexNoeud)
                                retourner SignalerErreurSemantique(
                                    etat,
                                    ErreurAnalyseSemantique::AliasDeclarePlusieursFois,
                                    courantAlias->IndexNoeud,
                                    convertir<naturel32>(
                                        autreAlias->IndexNoeud));
                        }
                        sinon
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::AliasEnConflit,
                                courantAlias->IndexNoeud,
                                convertir<naturel32>(
                                    autreAlias->IndexNoeud));
                    }
                    precedentAlias = precedentAlias + 1;
                }
            }
            index = index + 1;
        }

        // Les portées membres et locales suivent l'ordre lexical de l'AST.
        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantPortee =
                &etat->SymbolesTravail[index];
            naturel64 precedentPortee = 0;
            tantque (precedentPortee < index) {
                SymboleSemantique* autrePortee =
                    &etat->SymbolesTravail[precedentPortee];
                booléen memePorteeLocale = MemesNomsPorteeSemantiques(
                    courantPortee, autrePortee);
                si (courantPortee->Genre == 5 && memePorteeLocale
                    && (autrePortee->Genre == 5 || autrePortee->Genre == 6)) {
                    si (autrePortee->Genre == 5)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::ChampDeclarePlusieursFois,
                            courantPortee->IndexNoeud,
                            convertir<naturel32>(autrePortee->IndexNoeud));
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AliasChampEnConflit,
                        courantPortee->IndexNoeud,
                        convertir<naturel32>(autrePortee->IndexNoeud));
                }
                sinon si (courantPortee->Genre == 6 && memePorteeLocale
                    && (autrePortee->Genre == 5 || autrePortee->Genre == 6)) {
                    si (autrePortee->Genre == 6)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::AliasChampDeclarePlusieursFois,
                            courantPortee->IndexNoeud,
                            convertir<naturel32>(autrePortee->IndexNoeud));
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AliasChampEnConflit,
                        courantPortee->IndexNoeud,
                        convertir<naturel32>(autrePortee->IndexNoeud));
                }
                sinon si (courantPortee->Genre == 7
                    && autrePortee->Genre == 7 && memePorteeLocale)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::EnumerateurDeclarePlusieursFois,
                        courantPortee->IndexNoeud,
                        convertir<naturel32>(autrePortee->IndexNoeud));
                sinon si (courantPortee->Genre == 8
                    && autrePortee->Genre == 8 && memePorteeLocale)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::ParametreDeclarePlusieursFois,
                        courantPortee->IndexNoeud,
                        convertir<naturel32>(autrePortee->IndexNoeud));
                sinon si (courantPortee->Genre == 9
                    && courantPortee->HachageNom == autrePortee->HachageNom) {
                    naturel64 fonctionCourante =
                        TrouverFonctionAncetreSemantique(
                            etat, courantPortee->IndexNoeud);
                    naturel64 fonctionAutre = TrouverFonctionAncetreSemantique(
                        etat, autrePortee->IndexNoeud);
                    si (fonctionCourante == fonctionAutre
                        && (autrePortee->Genre == 8
                            || (autrePortee->Genre == 9
                                && EstAncetreSemantique(
                                    etat,
                                    autrePortee->IndexPortee,
                                    courantPortee->IndexPortee))))
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::VariableLocaleDeclareePlusieursFois,
                            courantPortee->IndexNoeud,
                            convertir<naturel32>(autrePortee->IndexNoeud));
                }
                precedentPortee = precedentPortee + 1;
            }
            index = index + 1;
        }
        si (!fonctionPresente)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::FonctionAbsente,
                0,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 TrouverSymboleNoeudSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            si (etat->SymbolesTravail[index].IndexNoeud == indexNoeud)
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    booléen ReferenceCorrespondSymboleSemantique(
        EtatAnalyseSemantique* etat,
        constante NoeudDeclaration* reference,
        SymboleSemantique* symbole) {
        si (reference->HachageNom == symbole->HachageNom
            && reference->HachageEspace == symbole->HachageEspace)
            retourner vrai;
        naturel64 complet = HacherNomCompletSemantique(
            etat, symbole->IndexNoeud);
        retourner reference->HachageNom == complet;
    }

    booléen AjouterResolutionSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel64 indexSymbole,
        naturel32 drapeaux) {
        SymboleSemantique* symbole = &etat->SymbolesTravail[indexSymbole];
        ResolutionSemantique resolution = {
            indexNoeud,
            indexSymbole,
            symbole->HachageType,
            symbole->Genre,
            drapeaux};
        si (etat->NombreResolutions < etat->Requete->CapaciteResolutions
            && etat->Requete->Resolutions != NulResolutionsSemantiques)
            etat->Requete->Resolutions[etat->NombreResolutions] = resolution;
        etat->NombreResolutions = etat->NombreResolutions + 1;
        retourner vrai;
    }

    naturel64 TrouverRecepteurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        naturel64 fonction = TrouverFonctionAncetreSemantique(
            etat, indexReference);
        si (fonction >= etat->Requete->NombreNoeuds)
            retourner etat->NombreSymboles;
        constante NoeudDeclaration* noeudFonction =
            &etat->Requete->Noeuds[fonction];
        si (!EstGenreFonctionSemantique(noeudFonction->Genre)
            || noeudFonction->Parent == 0)
            retourner etat->NombreSymboles;
        si (etat->Requete->Noeuds[noeudFonction->Parent].Genre != 6)
            retourner etat->NombreSymboles;
        retourner TrouverSymboleNoeudSemantique(
            etat, noeudFonction->Parent);
    }

    naturel64 TrouverBaseSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        naturel64 recepteur = TrouverRecepteurSemantique(
            etat, indexReference);
        si (recepteur >= etat->NombreSymboles)
            retourner recepteur;
        constante NoeudDeclaration* typeClasse = &etat->Requete->Noeuds[
            etat->SymbolesTravail[recepteur].IndexNoeud];
        si (typeClasse->HachageType == 0) retourner etat->NombreSymboles;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1
                && (typeClasse->HachageType == candidat->HachageNom
                    || typeClasse->HachageType == HacherNomCompletSemantique(
                        etat, candidat->IndexNoeud)))
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverVariableSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        naturel64 fonction = TrouverFonctionAncetreSemantique(
            etat, indexReference);
        naturel64 index = etat->NombreSymboles;
        tantque (index != 0) {
            index = index - 1;
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->IndexNoeud < indexReference
                && candidat->HachageNom == reference->HachageNom) {
                si (candidat->Genre == 9
                    && TrouverFonctionAncetreSemantique(
                        etat, candidat->IndexNoeud) == fonction
                    && EstAncetreSemantique(
                        etat, candidat->IndexPortee, indexReference))
                    retourner index;
                si (candidat->Genre == 8
                    && candidat->IndexPortee == fonction)
                    retourner index;
            }
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverDeclarationRacineSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->IndexPortee == 0
                && (candidat->Genre == 2
                    || candidat->Genre == 3
                    || candidat->Genre == 4)
                && ReferenceCorrespondSymboleSemantique(
                    etat, reference, candidat))
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverEnfantDirectSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexParent,
        naturel64 position) {
        naturel64 nombre = 0;
        naturel64 index = indexParent + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            si (etat->Requete->Noeuds[index].Parent == indexParent) {
                si (nombre == position) retourner index;
                nombre = nombre + 1;
            }
            index = index + 1;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    naturel64 CompterEnfantsDirectsSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexParent) {
        naturel64 nombre = 0;
        naturel64 index = indexParent + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            si (etat->Requete->Noeuds[index].Parent == indexParent)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 TrouverParametreFonctionSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexFonction,
        naturel64 position) {
        naturel64 nombre = 0;
        naturel64 index = indexFonction + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[index];
            si (noeud->Parent == indexFonction && noeud->Genre == 2) {
                si (nombre == position) retourner index;
                nombre = nombre + 1;
            }
            index = index + 1;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    naturel64 CompterParametresFonctionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexFonction) {
        naturel64 nombre = 0;
        naturel64 index = indexFonction + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[index];
            si (noeud->Parent == indexFonction && noeud->Genre == 2)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 TrouverTypeDepuisHachageSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachageType,
        naturel32 niveauPointeur) {
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1) {
                naturel64 nomSimple = candidat->HachageNom;
                naturel64 nomComplet = HacherNomCompletSemantique(
                    etat, candidat->IndexNoeud);
                naturel32 qualificatifs = 0;
                tantque (qualificatifs < 8) {
                    si (hachageType == HacherTypeNommeSemantique(
                            nomSimple, qualificatifs, niveauPointeur)
                        || hachageType == HacherTypeNommeSemantique(
                            nomComplet, qualificatifs, niveauPointeur))
                        retourner index;
                    qualificatifs = qualificatifs + 1;
                }
            }
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 SansReferenceTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType) {
        naturel32 genre = 1;
        tantque (genre <= 12) {
            naturel32 qualificatifs = 0;
            tantque (qualificatifs < 4) {
                naturel32 pointeurs = 0;
                tantque (pointeurs <= 2) {
                    si (hachageType == HacherTypeSimpleSemantique(
                            genre, qualificatifs | 4, pointeurs))
                        retourner HacherTypeSimpleSemantique(
                            genre, qualificatifs, pointeurs);
                    pointeurs = pointeurs + 1;
                }
                qualificatifs = qualificatifs + 1;
            }
            genre = genre + 1;
        }

        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1) {
                naturel64 nomSimple = candidat->HachageNom;
                naturel64 nomComplet = HacherNomCompletSemantique(
                    etat, candidat->IndexNoeud);
                naturel32 qualificatifsNommes = 0;
                tantque (qualificatifsNommes < 4) {
                    naturel32 pointeursNommes = 0;
                    tantque (pointeursNommes <= 2) {
                        si (hachageType == HacherTypeNommeSemantique(
                                nomSimple,
                                qualificatifsNommes | 4,
                                pointeursNommes))
                            retourner HacherTypeNommeSemantique(
                                nomSimple,
                                qualificatifsNommes,
                                pointeursNommes);
                        si (hachageType == HacherTypeNommeSemantique(
                                nomComplet,
                                qualificatifsNommes | 4,
                                pointeursNommes))
                            retourner HacherTypeNommeSemantique(
                                nomComplet,
                                qualificatifsNommes,
                                pointeursNommes);
                        pointeursNommes = pointeursNommes + 1;
                    }
                    qualificatifsNommes = qualificatifsNommes + 1;
                }
            }
            index = index + 1;
        }
        retourner hachageType;
    }

    booléen EstTypeReferenceSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType) {
        retourner SansReferenceTypeSemantique(etat, hachageType)
            != hachageType;
    }

    naturel64 HachageTypeReferenceSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        si ((reference->Drapeaux & 65_536) != 0) {
            naturel64 base = TrouverBaseSemantique(
                etat, indexReference);
            si (base >= etat->NombreSymboles) retourner 0;
            retourner HacherTypeNommeSemantique(
                HacherNomCompletSemantique(
                    etat, etat->SymbolesTravail[base].IndexNoeud),
                0,
                0);
        }
        si (reference->HachageNom == HacherSoiSemantique()) {
            naturel64 recepteur = TrouverRecepteurSemantique(
                etat, indexReference);
            si (recepteur >= etat->NombreSymboles) retourner 0;
            retourner HacherTypeNommeSemantique(
                HacherNomCompletSemantique(
                    etat,
                    etat->SymbolesTravail[recepteur].IndexNoeud),
                0,
                0);
        }
        naturel64 cible = TrouverVariableSemantique(
            etat, indexReference);
        si (cible >= etat->NombreSymboles)
            cible = TrouverDeclarationRacineSemantique(
                etat, indexReference);
        si (cible >= etat->NombreSymboles) retourner 0;
        retourner SansReferenceTypeSemantique(
            etat, etat->SymbolesTravail[cible].HachageType);
    }

    externe naturel64 HachageTypeMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre);

    naturel64 HachageTypeExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner 0;
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];

        si (expression->Genre == 22) {
            si ((expression->Drapeaux & 16_384) != 0)
                retourner HacherTypeSimpleSemantique(9, 0, 0);
            si (expression->HachageType <= 2_147_483_647)
                retourner HacherTypeSimpleSemantique(3, 0, 0);
            si (expression->HachageType
                <= 9_223_372_036_854_775_807)
                retourner HacherTypeSimpleSemantique(4, 0, 0);
            retourner HacherTypeSimpleSemantique(8, 0, 0);
        }
        si (expression->Genre == 23)
            retourner HacherTypeSimpleSemantique(11, 1, 1);
        si (expression->Genre == 24)
            retourner HachageTypeReferenceSemantique(
                etat, indexExpression);
        si (expression->Genre == 29)
            retourner HachageTypeMembreSemantique(
                etat, indexExpression);
        si (expression->Genre == 31)
            retourner expression->HachageType;
        si (expression->Genre == 25
            || expression->Genre == 26
            || expression->Genre == 27) {
            naturel64 enfant = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner HachageTypeExpressionSemantique(etat, enfant);
        }
        retourner 0;
    }

    booléen LitteralCompatibleTypeSemantique(
        constante NoeudDeclaration* argument, naturel64 hachageType) {
        si (argument->Genre != 22
            || (argument->Drapeaux & 16_384) != 0)
            retourner faux;
        naturel64 valeur = argument->HachageType;
        si (hachageType == HacherTypeSimpleSemantique(1, 0, 0))
            retourner valeur <= 127;
        si (hachageType == HacherTypeSimpleSemantique(2, 0, 0))
            retourner valeur <= 32_767;
        si (hachageType == HacherTypeSimpleSemantique(3, 0, 0))
            retourner valeur <= 2_147_483_647;
        si (hachageType == HacherTypeSimpleSemantique(4, 0, 0))
            retourner valeur <= 9_223_372_036_854_775_807;
        si (hachageType == HacherTypeSimpleSemantique(5, 0, 0))
            retourner valeur <= 255;
        si (hachageType == HacherTypeSimpleSemantique(6, 0, 0))
            retourner valeur <= 65_535;
        si (hachageType == HacherTypeSimpleSemantique(7, 0, 0))
            retourner valeur <= 4_294_967_295;
        si (hachageType == HacherTypeSimpleSemantique(8, 0, 0))
            retourner vrai;
        si (hachageType == HacherTypeSimpleSemantique(10, 0, 0)
            || hachageType == HacherTypeSimpleSemantique(11, 0, 0))
            retourner valeur <= 255;
        retourner faux;
    }

    naturel64 TrouverTypeBaseSymboleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        si (indexType >= etat->NombreSymboles) retourner etat->NombreSymboles;
        constante NoeudDeclaration* type = &etat->Requete->Noeuds[
            etat->SymbolesTravail[indexType].IndexNoeud];
        si ((type->Drapeaux & 32) == 0 || type->HachageType == 0)
            retourner etat->NombreSymboles;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1
                && (type->HachageType == candidat->HachageNom
                    || type->HachageType == HacherNomCompletSemantique(
                        etat, candidat->IndexNoeud)))
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    booléen EstTypeDeriveSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexSource,
        naturel64 indexDestination) {
        naturel64 courant = indexSource;
        naturel64 profondeur = 0;
        tantque (courant < etat->NombreSymboles
            && profondeur < etat->NombreSymboles) {
            courant = TrouverTypeBaseSymboleSemantique(etat, courant);
            si (courant == indexDestination) retourner vrai;
            profondeur = profondeur + 1;
        }
        retourner faux;
    }

    booléen ConversionHeritageSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 source,
        naturel64 destination,
        booléen liaisonReference) {
        naturel32 niveauPointeur = 0;
        tantque (niveauPointeur <= 1) {
            si (niveauPointeur != 0 || liaisonReference) {
                naturel64 typeSource = TrouverTypeDepuisHachageSemantique(
                    etat, source, niveauPointeur);
                naturel64 typeDestination = TrouverTypeDepuisHachageSemantique(
                    etat, destination, niveauPointeur);
                si (typeSource < etat->NombreSymboles
                    && typeDestination < etat->NombreSymboles
                    && typeSource != typeDestination
                    && EstTypeDeriveSemantique(
                        etat, typeSource, typeDestination))
                    retourner vrai;
            }
            niveauPointeur = niveauPointeur + 1;
        }
        retourner faux;
    }

    booléen EstValeurGaucheSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner faux;
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        retourner expression->Genre == 24
            || expression->Genre == 29
            || expression->Genre == 30;
    }

    booléen EstMembreDuGenreSemantique(
        EtatAnalyseSemantique* etat,
        SymboleSemantique* symbole,
        naturel32 masque) {
        si ((masque & 1) != 0
            && (symbole->Genre == 5 || symbole->Genre == 6))
            retourner vrai;
        si ((masque & 2) != 0 && symbole->Genre == 2) {
            naturel32 genreNoeud = etat->Requete->Noeuds[
                symbole->IndexNoeud].Genre;
            retourner genreNoeud == 12 || genreNoeud == 15;
        }
        retourner faux;
    }

    naturel64 CompterMembresTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageNom,
        naturel32 masque) {
        naturel64 nombre = 0;
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->IndexPortee == indexNoeudType
                && candidat->HachageNom == hachageNom
                && EstMembreDuGenreSemantique(etat, candidat, masque))
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 TrouverTypeDeclarantMembreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageNom,
        naturel32 masque) {
        naturel64 courant = indexType;
        naturel64 profondeur = 0;
        tantque (courant < etat->NombreSymboles
            && profondeur < etat->NombreSymboles) {
            si (CompterMembresTypeSemantique(
                    etat, courant, hachageNom, masque) != 0)
                retourner courant;
            courant = TrouverTypeBaseSymboleSemantique(etat, courant);
            profondeur = profondeur + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverPremierMembreTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageNom,
        naturel32 masque) {
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->IndexPortee == indexNoeudType
                && candidat->HachageNom == hachageNom
                && EstMembreDuGenreSemantique(etat, candidat, masque))
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverTypeObjetMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre) {
        naturel64 objet = TrouverEnfantDirectSemantique(
            etat, indexMembre, 0);
        naturel64 hachageType = HachageTypeExpressionSemantique(
            etat, objet);
        naturel32 niveauPointeur = 0;
        si ((etat->Requete->Noeuds[indexMembre].Drapeaux & 32_768) != 0)
            niveauPointeur = 1;
        retourner TrouverTypeDepuisHachageSemantique(
            etat, hachageType, niveauPointeur);
    }

    naturel64 ResoudreAliasChampSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexAlias,
        naturel64 indexType) {
        SymboleSemantique* symboleAlias =
            &etat->SymbolesTravail[indexAlias];
        si (symboleAlias->Genre != 6) retourner indexAlias;
        retourner TrouverPremierMembreTypeSemantique(
            etat, indexType, symboleAlias->HachageType, 1);
    }

    naturel64 HachageTypeMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre) {
        si (indexMembre >= etat->Requete->NombreNoeuds) retourner 0;
        constante NoeudDeclaration* membre =
            &etat->Requete->Noeuds[indexMembre];
        naturel64 typeObjet = TrouverTypeObjetMembreSemantique(
            etat, indexMembre);
        si (typeObjet >= etat->NombreSymboles) retourner 0;
        naturel64 typeDeclarant = TrouverTypeDeclarantMembreSemantique(
            etat, typeObjet, membre->HachageNom, 3);
        si (typeDeclarant >= etat->NombreSymboles) retourner 0;
        naturel64 cible = TrouverPremierMembreTypeSemantique(
            etat, typeDeclarant, membre->HachageNom, 3);
        si (cible >= etat->NombreSymboles) retourner 0;
        cible = ResoudreAliasChampSemantique(
            etat, cible, typeDeclarant);
        si (cible >= etat->NombreSymboles) retourner 0;
        retourner SansReferenceTypeSemantique(
            etat, etat->SymbolesTravail[cible].HachageType);
    }

    booléen EvaluerSurchargeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexAppel,
        naturel64 indexFonction,
        naturel32* score) {
        naturel64 nombreEnfants = CompterEnfantsDirectsSemantique(
            etat, indexAppel);
        si (nombreEnfants == 0) retourner faux;
        naturel64 nombreArguments = nombreEnfants - 1;
        si (CompterParametresFonctionSemantique(
                etat, indexFonction) != nombreArguments)
            retourner faux;

        *score = 0;
        naturel64 indexArgument = 0;
        tantque (indexArgument < nombreArguments) {
            naturel64 argument = TrouverEnfantDirectSemantique(
                etat, indexAppel, indexArgument + 1);
            naturel64 parametre = TrouverParametreFonctionSemantique(
                etat, indexFonction, indexArgument);
            si (argument >= etat->Requete->NombreNoeuds
                || parametre >= etat->Requete->NombreNoeuds)
                retourner faux;
            naturel64 typeArgument = HachageTypeExpressionSemantique(
                etat, argument);
            naturel64 typeParametre =
                etat->Requete->Noeuds[parametre].HachageType;
            booléen parametreReference = EstTypeReferenceSemantique(
                etat, typeParametre);
            typeParametre = SansReferenceTypeSemantique(
                etat, typeParametre);

            si (etat->Requete->Noeuds[argument].Genre == 32) {
                si (parametreReference) retourner faux;
                *score = *score + 2;
            }
            sinon si (parametreReference) {
                si (!EstValeurGaucheSemantique(etat, argument))
                    retourner faux;
                si (typeArgument != typeParametre) {
                    si (!ConversionHeritageSemantique(
                            etat,
                            typeArgument,
                            typeParametre,
                            vrai))
                        retourner faux;
                    *score = *score + 1;
                }
            }
            sinon si (typeArgument != typeParametre) {
                si (ConversionHeritageSemantique(
                        etat,
                        typeArgument,
                        typeParametre,
                        faux))
                    *score = *score + 1;
                sinon {
                    si (!LitteralCompatibleTypeSemantique(
                            &etat->Requete->Noeuds[argument], typeParametre))
                        retourner faux;
                    *score = *score + 1;
                }
            }
            indexArgument = indexArgument + 1;
        }
        retourner vrai;
    }

    naturel64 SelectionnerSurchargeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexReference,
        naturel64 indexAppel) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        naturel64 meilleure = etat->NombreSymboles;
        naturel32 meilleurScore = 4_294_967_295;
        naturel32 nombreMeilleures = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == 0
                && ReferenceCorrespondSymboleSemantique(
                    etat, reference, candidat)) {
                naturel32 score = 0;
                si (EvaluerSurchargeSemantique(
                        etat,
                        indexAppel,
                        candidat->IndexNoeud,
                        &score)) {
                    si (score < meilleurScore) {
                        meilleure = index;
                        meilleurScore = score;
                        nombreMeilleures = 1;
                    }
                    sinon si (score == meilleurScore)
                        nombreMeilleures = nombreMeilleures + 1;
                }
            }
            index = index + 1;
        }

        si (meilleure >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexReference,
                convertir<naturel32>(
                    CompterEnfantsDirectsSemantique(etat, indexAppel) - 1));
            retourner etat->NombreSymboles;
        }
        si (nombreMeilleures > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexReference,
                nombreMeilleures);
            retourner etat->NombreSymboles;
        }
        retourner meilleure;
    }

    naturel64 SelectionnerSurchargeMembreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexMembre,
        naturel64 indexAppel,
        naturel64 indexTypeDeclarant) {
        constante NoeudDeclaration* membre =
            &etat->Requete->Noeuds[indexMembre];
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexTypeDeclarant].IndexNoeud;
        naturel64 meilleure = etat->NombreSymboles;
        naturel32 meilleurScore = 4_294_967_295;
        naturel32 nombreMeilleures = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->IndexPortee == indexNoeudType
                && candidat->HachageNom == membre->HachageNom
                && EstMembreDuGenreSemantique(etat, candidat, 2)) {
                naturel32 score = 0;
                si (EvaluerSurchargeSemantique(
                        etat,
                        indexAppel,
                        candidat->IndexNoeud,
                        &score)) {
                    si (score < meilleurScore) {
                        meilleure = index;
                        meilleurScore = score;
                        nombreMeilleures = 1;
                    }
                    sinon si (score == meilleurScore)
                        nombreMeilleures = nombreMeilleures + 1;
                }
            }
            index = index + 1;
        }

        si (meilleure >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexMembre,
                convertir<naturel32>(
                    CompterEnfantsDirectsSemantique(etat, indexAppel) - 1));
            retourner etat->NombreSymboles;
        }
        si (nombreMeilleures > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexMembre,
                nombreMeilleures);
            retourner etat->NombreSymboles;
        }
        retourner meilleure;
    }

    ErreurAnalyseSemantique ResoudreMembresSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 indexMembre = 0;
        tantque (indexMembre < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* membre =
                &etat->Requete->Noeuds[indexMembre];
            si (membre->Genre == 29) {
                naturel64 typeObjet = TrouverTypeObjetMembreSemantique(
                    etat, indexMembre);
                si (typeObjet >= etat->NombreSymboles)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::RecepteurMembreInvalide,
                        indexMembre,
                        0);

                constante NoeudDeclaration* noeudParentMembre =
                    &etat->Requete->Noeuds[membre->Parent];
                booléen cibleAppel = noeudParentMembre->Genre == 28
                    && indexMembre == membre->Parent + 1;
                naturel32 masque = 1;
                si (cibleAppel) masque = 2;
                naturel64 typeDeclarant =
                    TrouverTypeDeclarantMembreSemantique(
                        etat,
                        typeObjet,
                        membre->HachageNom,
                        masque);
                si (typeDeclarant >= etat->NombreSymboles)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::MembreIntrouvable,
                        indexMembre,
                        0);

                naturel64 cible = etat->NombreSymboles;
                naturel32 drapeaux = 8;
                si (typeDeclarant != typeObjet)
                    drapeaux = drapeaux | 16;
                si (cibleAppel) {
                    cible = SelectionnerSurchargeMembreSemantique(
                        etat,
                        indexMembre,
                        membre->Parent,
                        typeDeclarant);
                    si (cible >= etat->NombreSymboles)
                        retourner etat->Requete->Resultat.Erreur;
                    drapeaux = drapeaux | 32;
                    si (CompterMembresTypeSemantique(
                            etat,
                            typeDeclarant,
                            membre->HachageNom,
                            2) > 1)
                        drapeaux = drapeaux | 1;
                }
                sinon {
                    cible = TrouverPremierMembreTypeSemantique(
                        etat,
                        typeDeclarant,
                        membre->HachageNom,
                        1);
                    cible = ResoudreAliasChampSemantique(
                        etat, cible, typeDeclarant);
                }
                si (cible >= etat->NombreSymboles)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::MembreIntrouvable,
                        indexMembre,
                        0);
                AjouterResolutionSemantique(
                    etat, indexMembre, cible, drapeaux);
            }
            indexMembre = indexMembre + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 CompterFonctionsCorrespondantesSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        naturel64 nombre = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == 0
                && ReferenceCorrespondSymboleSemantique(
                    etat, reference, candidat))
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    ErreurAnalyseSemantique ResoudreReferencesSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 indexNoeud = 0;
        tantque (indexNoeud < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* reference =
                &etat->Requete->Noeuds[indexNoeud];
            si (reference->Genre == 24) {
                naturel64 cible = etat->NombreSymboles;
                naturel32 drapeaux = 0;
                si ((reference->Drapeaux & 65_536) != 0) {
                    cible = TrouverBaseSemantique(etat, indexNoeud);
                    drapeaux = 2 | 4;
                }
                sinon si (reference->HachageNom == HacherSoiSemantique()) {
                    cible = TrouverRecepteurSemantique(etat, indexNoeud);
                    drapeaux = 2;
                }
                sinon {
                    cible = TrouverVariableSemantique(etat, indexNoeud);
                    si (cible >= etat->NombreSymboles)
                        cible = TrouverDeclarationRacineSemantique(
                            etat, indexNoeud);
                }

                si (cible >= etat->NombreSymboles)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::SymboleIntrouvable,
                        indexNoeud,
                        0);

                si (etat->SymbolesTravail[cible].Genre == 2) {
                    naturel64 nombre =
                        CompterFonctionsCorrespondantesSemantique(
                            etat, indexNoeud);
                    constante NoeudDeclaration* noeudParent =
                        &etat->Requete->Noeuds[reference->Parent];
                    booléen cibleAppel = noeudParent->Genre == 28
                        && indexNoeud == reference->Parent + 1;
                    si (nombre > 1) {
                        si (!cibleAppel)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::AdresseSurchargeAmbigue,
                                indexNoeud,
                                convertir<naturel32>(nombre));
                        cible = SelectionnerSurchargeSemantique(
                            etat, indexNoeud, reference->Parent);
                        si (cible >= etat->NombreSymboles)
                            retourner etat->Requete->Resultat.Erreur;
                        drapeaux = drapeaux | 1;
                    }
                }
                AjouterResolutionSemantique(
                    etat, indexNoeud, cible, drapeaux);
            }
            indexNoeud = indexNoeud + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    publique ErreurAnalyseSemantique AnalyserSemantique(
        RequeteAnalyseSemantique* requete) {
        si (requete == NulRequetesAnalyseSemantique)
            retourner ErreurAnalyseSemantique::ArgumentInvalide;

        requete->Resultat.Erreur = ErreurAnalyseSemantique::Reussite;
        requete->Resultat.LigneErreur = 0;
        requete->Resultat.ColonneErreur = 0;
        requete->Resultat.Detail = 0;
        requete->Resultat.NombreSymboles = 0;
        requete->Resultat.CapaciteSymbolesRequise = 0;
        requete->Resultat.NombreResolutions = 0;
        requete->Resultat.CapaciteResolutionsRequise = 0;
        requete->Resultat.NombreOctetsArene = 0;

        EtatAnalyseSemantique etat;
        etat.Requete = requete;
        etat.SymbolesTravail = NulSymbolesSemantiques;
        etat.NombreSymboles = 0;
        etat.NombreResolutions = 0;
        GalacticShrine::GsPP::Hebergee::InitialiserArene(&etat.Arene, 4096);

        si (requete->Source == NulCaracteresSemantiques
            || (requete->CapaciteSymboles != 0
                && requete->Symboles == NulSymbolesSemantiques)
            || (requete->CapaciteResolutions != 0
                && requete->Resolutions == NulResolutionsSemantiques)) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::ArgumentInvalide, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        si (!ValiderAstSemantique(&etat)) {
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        si (requete->NombreNoeuds
            > 384_307_168_202_282_325) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        etat.SymbolesTravail = convertir<SymboleSemantique*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene,
                requete->NombreNoeuds * 48,
                8));
        si (etat.SymbolesTravail == NulSymbolesSemantiques) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }

        naturel64 index = 0;
        tantque (index < requete->NombreNoeuds) {
            AjouterSymboleSemantique(&etat, index);
            index = index + 1;
        }
        requete->Resultat.NombreSymboles = etat.NombreSymboles;
        requete->Resultat.CapaciteSymbolesRequise = etat.NombreSymboles;

        ErreurAnalyseSemantique erreur = VerifierConflitsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ResoudreReferencesSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ResoudreMembresSemantiques(&etat);

        requete->Resultat.NombreResolutions = etat.NombreResolutions;
        requete->Resultat.CapaciteResolutionsRequise = etat.NombreResolutions;
        requete->Resultat.NombreOctetsArene = etat.Arene.NombreOctets;

        naturel64 nombreCopie = etat.NombreSymboles;
        si (nombreCopie > requete->CapaciteSymboles)
            nombreCopie = requete->CapaciteSymboles;
        index = 0;
        tantque (index < nombreCopie) {
            requete->Symboles[index] = etat.SymbolesTravail[index];
            index = index + 1;
        }

        si (erreur == ErreurAnalyseSemantique::Reussite
            && requete->CapaciteSymboles < etat.NombreSymboles)
            erreur = SignalerErreurSemantique(
                &etat,
                ErreurAnalyseSemantique::CapaciteSymbolesInsuffisante,
                0,
                convertir<naturel32>(etat.NombreSymboles));
        sinon si (erreur == ErreurAnalyseSemantique::Reussite
            && requete->CapaciteResolutions < etat.NombreResolutions)
            erreur = SignalerErreurSemantique(
                &etat,
                ErreurAnalyseSemantique::CapaciteResolutionsInsuffisante,
                0,
                convertir<naturel32>(etat.NombreResolutions));

        GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
        retourner erreur;
    }
}
