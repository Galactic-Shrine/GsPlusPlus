espace GalacticShrine::GsPP::Autohebergement {

    structure DescriptionTypeJetonsSemantique {

        naturel32 Genre;
        naturel32 Qualificatifs;
        naturel32 NiveauPointeur;
        naturel32 Reserve;
        naturel64 HachageNom;
        naturel64 HachageType;
        naturel64 HachageRetourFonction;
        naturel64 DebutType;
    };

    DescriptionTypeJetonsSemantique* NulDescriptionsTypesSemantiques;
    constante NoeudDeclaration* NulNoeudsSemantiques;
    SymboleSemantique* NulSymbolesSemantiques;
    ResolutionSemantique* NulResolutionsSemantiques;
    naturel64* NulCiblesInitialiseursSemantiques;
    naturel64* NulCiblesExpressionsSemantiques;
    naturel64* NulNaturelsDispositionSemantique;
    octet* NulEtatsDispositionSemantique;
    JetonLexe* NulJetonsTypesSemantiques;
    RequeteAnalyseSemantique* NulRequetesAnalyseSemantique;
    constante caractère* NulCaracteresSemantiques;
    RequeteEmissionGlobales* NulRequetesEmissionGlobales;
    GlobaleEmise* NulGlobalesEmises;
    RelocalisationGlobale* NulRelocalisationsGlobales;

    structure ContexteNomLiaisonSemantique {

        naturel64 Parent;
        naturel64 DebutNom;
        naturel64 FinNom;
    };

    ContexteNomLiaisonSemantique* NulContextesNomsLiaisonSemantiques;

    structure EtatAnalyseSemantique {

        RequeteAnalyseSemantique* Requete;
        SymboleSemantique* SymbolesTravail;
        naturel64 NombreSymboles;
        naturel64 NombreResolutions;
        naturel64* CiblesInitialiseurs;
        naturel64* CiblesExpressions;
        /** <résumé>Types adaptés des opérandes, privés à cette analyse et sans modifier l'AST public.</résumé> **/
        naturel64* TypesConversionsImplicites;
        /** <résumé>Constructeur actif lors de la visite d'un champ par défaut, hors du corps.</résumé> **/
        naturel64 ConstructeurChampActif;
        naturel64* CiblesAliasesChamps;
        octet* EtatsAliasesChamps;
        naturel64* CiblesAliasesRacines;
        octet* EtatsAliasesRacines;
        naturel64 NombreAliasesRacines;
        naturel64 NombreEspacesUtilises;
        naturel64* NomsEspacesUtilises;
        naturel64* ParentsEspacesUtilises;
        naturel64* PositionsEspacesUtilises;
        naturel64* CiblesEspacesUtilises;
        naturel64* FileEspacesUtilises;
        octet* VisitesEspacesUtilises;
        JetonLexe* JetonsTypes;
        naturel64 NombreJetonsTypes;
        naturel64* EspacesJetonsTypes;
        ErreurAnalyseSemantique ErreurTypeDeclare;
        DescriptionTypeJetonsSemantique* TypesComposes;
        naturel64 NombreTypesComposes;
        ContexteNomLiaisonSemantique* ContextesNomsLiaison;
        naturel64* EspacesNomsLiaisonJetons;
        naturel64* TypesBases;
        naturel64* TaillesTypes;
        naturel64* AlignementsTypes;
        naturel64* DecalagesChamps;
        naturel64* DecalagesTablesVirtuelles;
        naturel64* ValeursEnumerateurs;
        naturel32 ConstanteHorsPlage;
        octet* EtatsDisposition;
        octet* EtatsPolymorphisme;
        octet* EtatsEnumerateurs;
        GalacticShrine::GsPP::Hebergee::AreneMemoire Arene;
    };

    structure DescriptionHachageTypeSemantique {

        naturel32 NombreDimensions;
        naturel32 Reserve;
        naturel64 HachageNom;
        naturel64 HachageDimensions;
    };

    structure DestinationInitialiseurSemantique {

        naturel64 HachageElement;
        naturel64 IndexNoeudDeclaration;
        naturel32 ProfondeurTableau;
        naturel32 NombreDimensions;
        naturel32 Globale;
        /** <résumé>Bit 0 : résoudre les feuilles ; bit 1 : diagnostiquer l'affectation finale d'un champ par défaut.</résumé> **/
        naturel32 Reserve;
    };

    structure DescriptionEtapeDureeVieSemantique {

        naturel64 Decalage;
        naturel32 Drapeaux;
        naturel32 Reserve;
    };

    structure CurseurTypeJetonsSemantique {

        naturel64 Index;
        booléen DemiFermeture;
    };

    structure DescriptionTypeNumeriqueSemantique {

        naturel32 Largeur;
        naturel32 Signe;
        naturel32 Booleen;
        naturel32 Enumeration;
    };

    naturel64 HachageVideSemantique() {

        retourner 14_695_981_039_346_656_037;
    }

    naturel64 AjouterOctetSemantique(naturel64 hachage, octet valeur) {

        retourner (hachage ^ convertir<naturel64>(valeur)) * 1_099_511_628_211;
    }

    naturel64 AjouterNaturel32Semantique(naturel64 hachage, naturel32 valeur) {

        naturel32 index = 0;

        tantque (index < 4) {

            hachage = AjouterOctetSemantique(hachage, convertir<octet>(valeur & 255));
            valeur = valeur >> 8;
            index = index + 1;
        }

        retourner hachage;
    }

    naturel64 AjouterNaturel64Semantique(naturel64 hachage, naturel64 valeur) {

        naturel32 index = 0;

        tantque (index < 8) {

            hachage = AjouterOctetSemantique(hachage, convertir<octet>(valeur & 255));
            valeur = valeur >> 8;
            index = index + 1;
        }

        retourner hachage;
    }

    naturel64 HacherTypeCompletSemantique(naturel32 genre, naturel32 qualificatifs, naturel32 niveauPointeur, DescriptionHachageTypeSemantique* description) {

        naturel64 hachage = HachageVideSemantique();

        hachage = AjouterNaturel32Semantique(hachage, genre);
        hachage = AjouterNaturel32Semantique(hachage, qualificatifs);
        hachage = AjouterNaturel32Semantique(hachage, niveauPointeur);
        hachage = AjouterNaturel32Semantique(hachage, description->NombreDimensions);
        hachage = AjouterNaturel64Semantique(hachage, description->HachageNom);
        hachage = AjouterNaturel64Semantique(hachage, description->HachageDimensions);

        retourner hachage;
    }

    naturel64 HacherTypeSimpleSemantique(naturel32 genre, naturel32 qualificatifs, naturel32 niveauPointeur) {

        DescriptionHachageTypeSemantique description = {

            0,
            0,
            HachageVideSemantique(),
            HachageVideSemantique()
        };

        retourner HacherTypeCompletSemantique(genre, qualificatifs, niveauPointeur, &description);
    }

    naturel64 HacherTypeTableauSimpleSemantique(naturel32 genre, naturel32 qualificatifs, naturel32 niveauPointeur, DescriptionHachageTypeSemantique* descriptionDimensions) {

        DescriptionHachageTypeSemantique description = {

            descriptionDimensions->NombreDimensions,
            0,
            HachageVideSemantique(),
            descriptionDimensions->HachageDimensions
        };

        retourner HacherTypeCompletSemantique(genre, qualificatifs, niveauPointeur, &description);
    }

    naturel64 HacherTypeTableauNommeSemantique(naturel64 hachageNom, naturel32 qualificatifs, naturel32 niveauPointeur, DescriptionHachageTypeSemantique* descriptionDimensions) {

        DescriptionHachageTypeSemantique description = {

            descriptionDimensions->NombreDimensions,
            0,
            hachageNom,
            descriptionDimensions->HachageDimensions
        };

        retourner HacherTypeCompletSemantique(13, qualificatifs, niveauPointeur, &description);
    }

    naturel32 GenreCourantTypeJetonsSemantique(EtatAnalyseSemantique* etat, CurseurTypeJetonsSemantique* curseur) {

        si (curseur->DemiFermeture)
            retourner 50;

        si (curseur->Index >= etat->NombreJetonsTypes)
            retourner 0;

        retourner etat->JetonsTypes[curseur->Index].Genre;
    }

    vide AvancerTypeJetonsSemantique(CurseurTypeJetonsSemantique* curseur) {

        si (curseur->DemiFermeture) {

            curseur->DemiFermeture = faux;
            curseur->Index = curseur->Index + 1;
        }

        sinon curseur->Index = curseur->Index + 1;
    }

    booléen AccepterTypeJetonsSemantique(EtatAnalyseSemantique* etat, CurseurTypeJetonsSemantique* curseur, naturel32 genre) {

        si (GenreCourantTypeJetonsSemantique(etat, curseur) != genre)
            retourner faux;

        AvancerTypeJetonsSemantique(curseur);

        retourner vrai;
    }

    booléen AccepterFermetureTypeJetonsSemantique(EtatAnalyseSemantique* etat, CurseurTypeJetonsSemantique* curseur) {

        si (AccepterTypeJetonsSemantique(etat, curseur, 50))
            retourner vrai;

        si (GenreCourantTypeJetonsSemantique(etat, curseur) != 60)
            retourner faux;

        curseur->DemiFermeture = vrai;

        retourner vrai;
    }

    naturel64 AjouterTrancheTypeJetonsSemantique(EtatAnalyseSemantique* etat, naturel64 hachage, JetonLexe* jeton) {

        naturel64 indexOctetType = 0;

        tantque (indexOctetType < jeton->TailleSource) {

            hachage = AjouterOctetSemantique(hachage, convertir<octet>(etat->Requete->Source[jeton->Debut + indexOctetType]));

            indexOctetType = indexOctetType + 1;
        }

        retourner hachage;
    }

    naturel64 HacherDescriptionTypeJetonsSemantique(DescriptionTypeJetonsSemantique* type) {

        DescriptionHachageTypeSemantique descriptionVideType = {

            0,
            0,
            type->HachageNom,
            HachageVideSemantique()
        };

        retourner HacherTypeCompletSemantique(type->Genre, type->Qualificatifs, type->NiveauPointeur, &descriptionVideType);
    }

    externe booléen AnalyserTypeJetonsSemantique(EtatAnalyseSemantique* etat, CurseurTypeJetonsSemantique* curseur, DescriptionTypeJetonsSemantique* type);

    externe naturel64 ResoudreNomTypeJetonsSemantique(
        EtatAnalyseSemantique* etat, naturel64 debut, naturel64 fin, naturel64 hachage);
    externe booléen EstDescriptionStructureValeurSemantique(
        EtatAnalyseSemantique* etat, DescriptionTypeJetonsSemantique* type);

    booléen AnalyserTypeJetonsSemantique(EtatAnalyseSemantique* etat, CurseurTypeJetonsSemantique* curseur, DescriptionTypeJetonsSemantique* type) {

        type->Genre = 0;
        type->Qualificatifs = 0;
        type->NiveauPointeur = 0;
        type->Reserve = 0;
        type->HachageNom = HachageVideSemantique();
        type->HachageType = 0;
        type->HachageRetourFonction = 0;
        type->DebutType = curseur->Index;

        booléen continuerQualificatifsType = vrai;

        tantque (continuerQualificatifsType) {

            si (AccepterTypeJetonsSemantique(etat, curseur, 12))
                type->Qualificatifs = type->Qualificatifs | 1;

            sinon si (AccepterTypeJetonsSemantique(etat, curseur, 13))
                type->Qualificatifs = type->Qualificatifs | 2;

            sinon continuerQualificatifsType = faux;
        }

        naturel32 genreBaseType = GenreCourantTypeJetonsSemantique(etat, curseur);

        si (genreBaseType >= 14 && genreBaseType <= 25) {

            type->Genre = genreBaseType - 13;
            AvancerTypeJetonsSemantique(curseur);
        }
        sinon si (genreBaseType == 1) {

            type->Genre = 13;
            naturel64 debutNomType = curseur->Index;
            JetonLexe* premierNomType = &etat->JetonsTypes[curseur->Index];
            type->HachageNom = AjouterTrancheTypeJetonsSemantique(etat, HachageVideSemantique(), premierNomType);
            AvancerTypeJetonsSemantique(curseur);

            tantque (AccepterTypeJetonsSemantique(etat, curseur, 44)) {

                si (GenreCourantTypeJetonsSemantique(etat, curseur) != 1)
                    retourner faux;

                type->HachageNom = AjouterOctetSemantique(type->HachageNom, 58);
                type->HachageNom = AjouterOctetSemantique(type->HachageNom, 58);
                JetonLexe* partieNomType = &etat->JetonsTypes[curseur->Index];
                type->HachageNom = AjouterTrancheTypeJetonsSemantique(etat, type->HachageNom, partieNomType);

                AvancerTypeJetonsSemantique(curseur);
            }
            si (etat->EspacesJetonsTypes != NulCiblesExpressionsSemantiques)
                type->HachageNom = ResoudreNomTypeJetonsSemantique(
                    etat, debutNomType, curseur->Index, type->HachageNom);
        }
        sinon si (genreBaseType == 26) {

            type->Genre = 14;
            AvancerTypeJetonsSemantique(curseur);

            si (!AccepterTypeJetonsSemantique(etat, curseur, 48))
                retourner faux;

            DescriptionTypeJetonsSemantique retourFonctionType;

            si (!AnalyserTypeJetonsSemantique(etat, curseur, &retourFonctionType))
                retourner faux;

            type->HachageRetourFonction = retourFonctionType.HachageType;

            naturel64 signatureFonctionType = AjouterNaturel64Semantique(HachageVideSemantique(), retourFonctionType.HachageType);

            si (!AccepterTypeJetonsSemantique(etat, curseur, 34))
                retourner faux;

            naturel32 nombreParametresFonctionType = 0;
            booléen parametreFonctionInvalide = faux;

            booléen continuerParametresFonctionType = GenreCourantTypeJetonsSemantique(etat, curseur) != 35;

            tantque (continuerParametresFonctionType) {

                DescriptionTypeJetonsSemantique parametreFonctionType;

                si (!AnalyserTypeJetonsSemantique(etat, curseur, &parametreFonctionType))
                    retourner faux;

                si (parametreFonctionType.Genre == 12
                    && parametreFonctionType.NiveauPointeur == 0
                    && (parametreFonctionType.Qualificatifs & 4) == 0)
                    parametreFonctionInvalide = vrai;
                signatureFonctionType = AjouterNaturel64Semantique(signatureFonctionType, parametreFonctionType.HachageType);
                nombreParametresFonctionType = nombreParametresFonctionType + 1;

                si (!AccepterTypeJetonsSemantique(etat, curseur, 41))
                    continuerParametresFonctionType = faux;
            }
            si (!AccepterTypeJetonsSemantique(etat, curseur, 35))
                retourner faux;

            si (!AccepterFermetureTypeJetonsSemantique(etat, curseur))
                retourner faux;

            type->HachageNom = AjouterNaturel32Semantique(signatureFonctionType, nombreParametresFonctionType);
            type->Reserve = nombreParametresFonctionType;
            si (etat->EspacesJetonsTypes != NulCiblesExpressionsSemantiques
                && etat->ErreurTypeDeclare == ErreurAnalyseSemantique::Reussite) {

                si (nombreParametresFonctionType > 4)
                    etat->ErreurTypeDeclare = ErreurAnalyseSemantique::AriteSignatureCallbackInvalide;
                sinon si (parametreFonctionInvalide)
                    etat->ErreurTypeDeclare = ErreurAnalyseSemantique::ParametreCallbackInvalide;
                sinon si (nombreParametresFonctionType > 3
                    && EstDescriptionStructureValeurSemantique(etat, &retourFonctionType))
                    etat->ErreurTypeDeclare = ErreurAnalyseSemantique::AriteSignatureCallbackInvalide;
            }
        }
        sinon retourner faux;

        tantque (AccepterTypeJetonsSemantique(etat, curseur, 63))
            type->NiveauPointeur = type->NiveauPointeur + 1;

        si (AccepterTypeJetonsSemantique(etat, curseur, 55))
            type->Qualificatifs = type->Qualificatifs | 4;

        type->HachageType = HacherDescriptionTypeJetonsSemantique(type);

        retourner vrai;
    }

    /**
     * <résumé>Indexe les signatures et les indirections profondes dans l'arène privée.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Source tokenisée de la requête.
     * @Retourner(booléen) Faux si la taille ou l'allocation ne peut être satisfaite.
     **/
    booléen InitialiserTypesComposesSemantiques(EtatAnalyseSemantique* etat) {

        naturel32 passe = 0;
        tantque (passe < 2) {

            naturel64 nombre = 0;
            naturel64 index = 0;
            tantque (index < etat->NombreJetonsTypes) {

                naturel32 genre = etat->JetonsTypes[index].Genre;
                si (genre == 1 || (genre >= 12 && genre <= 26)) {

                    CurseurTypeJetonsSemantique curseur = {index, faux};
                    DescriptionTypeJetonsSemantique type;
                    si (AnalyserTypeJetonsSemantique(etat, &curseur, &type)
                        && (type.Genre == 14 || type.NiveauPointeur > 2)) {

                        si (passe != 0) {

                            si (nombre >= etat->NombreTypesComposes) retourner faux;
                            etat->TypesComposes[nombre] = type;
                        }
                        nombre = nombre + 1;
                    }
                }
                index = index + 1;
            }
            si (passe == 0) {

                etat->NombreTypesComposes = nombre;
                si (nombre == 0) retourner vrai;
                si (nombre > 384_307_168_202_282_325) retourner faux;
                etat->TypesComposes = convertir<DescriptionTypeJetonsSemantique*>(
                    GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, nombre * 48, 8));
                si (etat->TypesComposes == NulDescriptionsTypesSemantiques) retourner faux;
            }
            passe = passe + 1;
        }
        retourner vrai;
    }

    /**
     * <résumé>Décrit un type composé et ses variantes de référence, qualification ou indirection.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Index privé des types de la requête.
     * @Paramètre(naturel64: hachageType) Empreinte du type recherché.
     * @Paramètre(DescriptionTypeJetonsSemantique*: description) Description correspondante en sortie.
     * @Retourner(booléen) Vrai si une signature présente dans la source correspond.
     **/
    booléen DecrireTypeComposeSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType,
        DescriptionTypeJetonsSemantique* description) {

        naturel64 index = 0;
        tantque (index < etat->NombreTypesComposes) {

            si (etat->TypesComposes[index].HachageType == hachageType) {

                *description = etat->TypesComposes[index];
                retourner vrai;
            }
            index = index + 1;
        }
        index = 0;
        tantque (index < etat->NombreTypesComposes) {

            DescriptionTypeJetonsSemantique variante = etat->TypesComposes[index];
            naturel32 niveauMaximum = variante.NiveauPointeur + 1;
            variante.NiveauPointeur = 0;
            tantque (variante.NiveauPointeur <= niveauMaximum) {

                variante.Qualificatifs = 0;
                tantque (variante.Qualificatifs < 8) {

                    variante.HachageType = HacherDescriptionTypeJetonsSemantique(&variante);
                    si (variante.HachageType == hachageType) {

                        *description = variante;
                        retourner vrai;
                    }
                    variante.Qualificatifs = variante.Qualificatifs + 1;
                }
                variante.NiveauPointeur = variante.NiveauPointeur + 1;
            }
            index = index + 1;
        }
        retourner faux;
    }

    /**
     * <résumé>Relit la cible d'une conversion sans étendre l'AST public.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Source et jetons de l'analyse.
     * @Paramètre(naturel64: indexNoeud) Expression convertir/cast.
     * @Paramètre(DescriptionTypeJetonsSemantique*: type) Cible et début de sa signature.
     * @Retourner(booléen) Vrai si la position et le type correspondent à l'AST.
     **/
    booléen LireTypeConversionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud,
        DescriptionTypeJetonsSemantique* type) {

        si (indexNoeud >= etat->Requete->NombreNoeuds
            || etat->Requete->Noeuds[indexNoeud].Genre != 31)
            retourner faux;
        constante NoeudDeclaration* conversion = &etat->Requete->Noeuds[indexNoeud];
        naturel64 indexJeton = 0;
        tantque (indexJeton + 2 < etat->NombreJetonsTypes) {

            JetonLexe* jeton = &etat->JetonsTypes[indexJeton];
            si (jeton->Ligne == conversion->Ligne && jeton->Colonne == conversion->Colonne) {

                si (jeton->Genre != 27 || etat->JetonsTypes[indexJeton + 1].Genre != 48)
                    retourner faux;
                CurseurTypeJetonsSemantique curseur = {indexJeton + 2, faux};
                si (!AnalyserTypeJetonsSemantique(etat, &curseur, type)
                    || !AccepterFermetureTypeJetonsSemantique(etat, &curseur)
                    || type->HachageType != conversion->HachageType)
                    retourner faux;
                type->DebutType = indexJeton + 2;
                retourner vrai;
            }
            indexJeton = indexJeton + 1;
        }
        retourner faux;
    }

    booléen LireTypeNoeudSemantique(EtatAnalyseSemantique* etat, naturel64 indexNoeud, DescriptionTypeJetonsSemantique* type) {

        si (indexNoeud >= etat->Requete->NombreNoeuds || etat->JetonsTypes == NulJetonsTypesSemantiques)
            retourner faux;

        constante NoeudDeclaration* noeudType = &etat->Requete->Noeuds[indexNoeud];
        si (noeudType->Genre == 31)
            retourner LireTypeConversionSemantique(etat, indexNoeud, type);
        naturel64 indexNomType = 0;

        tantque (indexNomType < etat->NombreJetonsTypes && etat->JetonsTypes[indexNomType].Debut != noeudType->DebutNom)
            indexNomType = indexNomType + 1;

        si (indexNomType >= etat->NombreJetonsTypes)
            retourner faux;
        si (noeudType->Genre == 15 && indexNomType != 0
            && etat->JetonsTypes[indexNomType - 1].Genre == 71)
            indexNomType = indexNomType - 1;

        naturel64 debutCandidatType = indexNomType;
        booléen typeTrouve = faux;

        tantque (debutCandidatType != 0) {

            debutCandidatType = debutCandidatType - 1;
            CurseurTypeJetonsSemantique curseurCandidatType = {

                debutCandidatType,
                faux
            };
            DescriptionTypeJetonsSemantique typeCandidatNoeud;

            si (AnalyserTypeJetonsSemantique(etat, &curseurCandidatType, &typeCandidatNoeud) && !curseurCandidatType.DemiFermeture && curseurCandidatType.Index == indexNomType) {

                *type = typeCandidatNoeud;
                typeTrouve = vrai;
            }
            sinon si (typeTrouve && etat->JetonsTypes[debutCandidatType].Genre != 44)
                retourner vrai;
        }

        retourner typeTrouve;
    }

    booléen LireTypePointeurFonctionNoeudSemantique(EtatAnalyseSemantique* etat, naturel64 indexNoeud, DescriptionTypeJetonsSemantique* type) {

        retourner LireTypeNoeudSemantique(etat, indexNoeud, type) && type->Genre == 14;
    }

    booléen InitialiserJetonsTypesSemantiques(EtatAnalyseSemantique* etat) {

        RequeteLexage interrogationTypes = {

            etat->Requete->Source,
            etat->Requete->TailleSource,
            NulJetonsTypesSemantiques,
            0,
            {}
        };
        ErreurLexage erreurInterrogationTypes = AnalyserSource(&interrogationTypes);

        si (erreurInterrogationTypes != ErreurLexage::CapaciteInsuffisante)
            retourner faux;

        etat->NombreJetonsTypes = interrogationTypes.Resultat.CapaciteRequise;

        si (etat->NombreJetonsTypes > 384_307_168_202_282_325)
            retourner faux;

        etat->JetonsTypes = convertir<JetonLexe*>(GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, etat->NombreJetonsTypes * 48, 8));

        si (etat->JetonsTypes == NulJetonsTypesSemantiques)
            retourner faux;

        RequeteLexage lectureTypes = {

            etat->Requete->Source,
            etat->Requete->TailleSource,
            etat->JetonsTypes,
            etat->NombreJetonsTypes,
            {}
        };
        ErreurLexage erreurLectureTypes = AnalyserSource(&lectureTypes);

        retourner erreurLectureTypes == ErreurLexage::Reussite && lectureTypes.Resultat.NombreJetons == etat->NombreJetonsTypes;
    }

    booléen EstEspaceSourceSemantique(octet valeur) {

        retourner valeur == 9 || valeur == 10 || valeur == 11 || valeur == 12 || valeur == 13 || valeur == 32;
    }

    naturel64 IgnorerSeparateursSourceSemantique(EtatAnalyseSemantique* etat, naturel64 position) {

        booléen continuer = vrai;

        tantque (continuer && position < etat->Requete->TailleSource) {

            continuer = faux;

            tantque (position < etat->Requete->TailleSource && EstEspaceSourceSemantique(convertir<octet>(etat->Requete->Source[position])))
                position = position + 1;

            si (position + 1 < etat->Requete->TailleSource && etat->Requete->Source[position] == 47 && etat->Requete->Source[position + 1] == 47) {

                position = position + 2;

                tantque (position < etat->Requete->TailleSource && etat->Requete->Source[position] != 10)
                    position = position + 1;

                continuer = vrai;
            }
            sinon si (position + 1 < etat->Requete->TailleSource && etat->Requete->Source[position] == 47 && etat->Requete->Source[position + 1] == 42) {

                position = position + 2;

                tantque (position + 1 < etat->Requete->TailleSource && !(etat->Requete->Source[position] == 42 && etat->Requete->Source[position + 1] == 47))
                    position = position + 1;

                si (position + 1 < etat->Requete->TailleSource)
                    position = position + 2;

                continuer = vrai;
            }
        }

        retourner position;
    }

    booléen LireDimensionSourceSemantique(EtatAnalyseSemantique* etat, naturel64* position, naturel64* valeur) {

        *position = IgnorerSeparateursSourceSemantique(etat, *position);

        si (*position >= etat->Requete->TailleSource || etat->Requete->Source[*position] != 91)
            retourner faux;

        *position = IgnorerSeparateursSourceSemantique(etat, *position + 1);
        *valeur = 0;
        booléen possedeChiffre = faux;
        booléen lireDimension = vrai;

        tantque (lireDimension && *position < etat->Requete->TailleSource) {

            octet courant = convertir<octet>(etat->Requete->Source[*position]);

            si (courant >= 48 && courant <= 57) {

                *valeur = *valeur * 10 + convertir<naturel64>(courant - 48);
                possedeChiffre = vrai;
                *position = *position + 1;
            }

            sinon si (courant == 95)
                *position = *position + 1;

            sinon lireDimension = faux;
        }

        *position = IgnorerSeparateursSourceSemantique(etat, *position);

        si (!possedeChiffre || *position >= etat->Requete->TailleSource || etat->Requete->Source[*position] != 93)
            retourner faux;

        *position = IgnorerSeparateursSourceSemantique(etat, *position + 1);

        retourner vrai;
    }

    booléen LireDimensionsNoeudSemantique(EtatAnalyseSemantique* etat, naturel64 indexNoeud, DescriptionHachageTypeSemantique* description) {

        description->NombreDimensions = 0;
        description->Reserve = 0;
        description->HachageNom = HachageVideSemantique();
        description->HachageDimensions = HachageVideSemantique();

        si (indexNoeud >= etat->Requete->NombreNoeuds)
            retourner faux;

        constante NoeudDeclaration* noeud = &etat->Requete->Noeuds[indexNoeud];
        naturel64 position = IgnorerSeparateursSourceSemantique(etat, noeud->DebutNom + noeud->TailleNom);
        naturel64 valeur = 0;

        tantque (LireDimensionSourceSemantique(etat, &position, &valeur)) {

            description->NombreDimensions = description->NombreDimensions + 1;
            description->HachageDimensions = AjouterNaturel64Semantique(description->HachageDimensions, valeur);
        }

        retourner description->NombreDimensions != 0;
    }

    booléen LireDimensionNoeudSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel32 indexDimension,
        naturel64* valeur) {
        si (indexNoeud >= etat->Requete->NombreNoeuds)
            retourner faux;
        constante NoeudDeclaration* noeud =
            &etat->Requete->Noeuds[indexNoeud];
        naturel64 position = IgnorerSeparateursSourceSemantique(
            etat, noeud->DebutNom + noeud->TailleNom);
        naturel32 courant = 0;
        naturel64 dimension = 0;
        tantque (LireDimensionSourceSemantique(
                etat, &position, &dimension)) {
            si (courant == indexDimension) {
                *valeur = dimension;
                retourner vrai;
            }
            courant = courant + 1;
        }
        retourner faux;
    }

    naturel64 HacherTypeNommeSemantique(
        naturel64 hachageNom,
        naturel32 qualificatifs,
        naturel32 niveauPointeur) {
        DescriptionHachageTypeSemantique description = {
            0,
            0,
            hachageNom,
            HachageVideSemantique()};
        retourner HacherTypeCompletSemantique(
            13,
            qualificatifs,
            niveauPointeur,
            &description);
    }

    naturel64 AjouterNomNoeudSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachage,
        naturel64 indexNoeud) {
        constante NoeudDeclaration* noeud =
            &etat->Requete->Noeuds[indexNoeud];
        si (noeud->Genre == 10) {

            naturel64 jeton = 0;
            tantque (jeton < etat->NombreJetonsTypes
                && etat->JetonsTypes[jeton].Debut < noeud->DebutNom + noeud->TailleNom) {

                JetonLexe* nom = &etat->JetonsTypes[jeton];
                si (nom->Debut >= noeud->DebutNom)
                    hachage = AjouterTrancheTypeJetonsSemantique(etat, hachage, nom);
                jeton = jeton + 1;
            }
            retourner hachage;
        }
        naturel64 index = 0;
        tantque (index < noeud->TailleNom) {
            hachage = AjouterOctetSemantique(
                hachage,
                convertir<octet>(
                    etat->Requete->Source[noeud->DebutNom + index]));
            index = index + 1;
        }
        retourner hachage;
    }

    naturel64 HacherNomCompletSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        constante NoeudDeclaration* noeud =
            &etat->Requete->Noeuds[indexNoeud];
        naturel64 hachage = noeud->HachageEspace;
        si (hachage != HachageVideSemantique()) {
            hachage = AjouterOctetSemantique(hachage, 58);
            hachage = AjouterOctetSemantique(hachage, 58);
        }
        retourner AjouterNomNoeudSemantique(etat, hachage, indexNoeud);
    }

    /**
     * <résumé>Identifie une cible racine ou une méthode par son nom complet, classe déclarante comprise.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Index brut des déclarations.
     * @Paramètre(SymboleSemantique*: symbole) Symbole candidat à la résolution d'un alias.
     * @Retourner(naturel64) Empreinte du nom complet écrit dans le langage.
     **/
    naturel64 HacherNomDeclarationAliasSemantique(EtatAnalyseSemantique* etat, SymboleSemantique* symbole) {

        constante NoeudDeclaration* noeud = &etat->Requete->Noeuds[symbole->IndexNoeud];
        si (noeud->Genre >= 12 && noeud->Genre <= 15 && noeud->Parent != 0) {

            naturel64 hachage = HacherNomCompletSemantique(etat, noeud->Parent);
            hachage = AjouterOctetSemantique(AjouterOctetSemantique(hachage, 58), 58);
            si (noeud->Genre == 13 || noeud->Genre == 14) {

                constante caractère* nom = "$constructeur";
                naturel64 taille = 13;
                si (noeud->Genre == 14) {

                    nom = "$destructeur";
                    taille = 12;
                }
                naturel64 index = 0;
                tantque (index < taille) {

                    hachage = AjouterOctetSemantique(hachage, convertir<octet>(nom[index]));
                    index = index + 1;
                }
                retourner hachage;
            }
            retourner AjouterNomNoeudSemantique(etat, hachage, symbole->IndexNoeud);
        }
        retourner HacherNomCompletSemantique(etat, symbole->IndexNoeud);
    }

    structure RechercheNomUtiliseSemantique {

        naturel64 Debut;
        naturel64 Fin;
        naturel64 Hachage;
        naturel64 Espace;
        naturel64 Premier;
        naturel64 Niveau;
        booléen Active;
        booléen Ambigue;
        booléen Qualifie;
    };

    externe ErreurAnalyseSemantique SignalerErreurSemantique(
        EtatAnalyseSemantique* etat, ErreurAnalyseSemantique erreur, naturel64 indexNoeud, naturel32 detail);

    naturel64 IndexEspaceUtiliseSemantique(EtatAnalyseSemantique* etat, naturel64 nom) {

        naturel64 index = 0;
        tantque (index < etat->NombreEspacesUtilises) {
            si (etat->NomsEspacesUtilises[index] == nom) retourner index;
            index = index + 1;
        }
        retourner 0;
    }

    booléen EspaceContientUtiliseSemantique(EtatAnalyseSemantique* etat, naturel64 espaceParent, naturel64 enfant) {

        tantque (enfant != espaceParent && enfant != 0) enfant = etat->ParentsEspacesUtilises[enfant];
        retourner enfant == espaceParent;
    }

    naturel64 HacherRechercheUtiliseeSemantique(
        EtatAnalyseSemantique* etat, RechercheNomUtiliseSemantique* recherche, naturel64 prefixe) {

        naturel64 hachage = prefixe;
        si (hachage != HachageVideSemantique())
            hachage = AjouterOctetSemantique(AjouterOctetSemantique(hachage, 58), 58);
        naturel64 jeton = 0;
        tantque (jeton < etat->NombreJetonsTypes && etat->JetonsTypes[jeton].Debut < recherche->Fin) {
            si (etat->JetonsTypes[jeton].Debut >= recherche->Debut)
                hachage = AjouterTrancheTypeJetonsSemantique(etat, hachage, &etat->JetonsTypes[jeton]);
            jeton = jeton + 1;
        }
        retourner hachage;
    }

    /** <résumé>Indexe les espaces, leurs ancêtres et les cibles des directives sans modifier l'AST public.</résumé> **/
    /**
     * <résumé>Indexe les portées nommées et les imports, même sans directive utilisant.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Jetons et AST privés de cette analyse.
     * @Retourner(ErreurAnalyseSemantique) Réussite ou premier refus d'import/allocation.
     **/
    ErreurAnalyseSemantique InitialiserPorteesNommeesSemantiques(EtatAnalyseSemantique* etat) {

        naturel64 index = 0;
        si (etat->Requete->NombreNoeuds > 2_305_843_009_213_693_951
            || etat->NombreJetonsTypes > 2_305_843_009_213_693_951 - etat->Requete->NombreNoeuds)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
        naturel64 capaciteEspaces = etat->NombreJetonsTypes + etat->Requete->NombreNoeuds;
        naturel64 taille = capaciteEspaces * 8;
        etat->NomsEspacesUtilises = convertir<naturel64*>(GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, taille, 8));
        etat->ParentsEspacesUtilises = convertir<naturel64*>(GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, taille, 8));
        etat->PositionsEspacesUtilises = convertir<naturel64*>(GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, taille, 8));
        etat->FileEspacesUtilises = convertir<naturel64*>(GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, taille, 8));
        etat->VisitesEspacesUtilises = convertir<octet*>(GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, capaciteEspaces, 1));
        etat->CiblesEspacesUtilises = convertir<naturel64*>(GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, etat->Requete->NombreNoeuds * 8, 8));
        naturel64* pile = convertir<naturel64*>(GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, taille, 8));
        si (etat->NomsEspacesUtilises == NulNaturelsDispositionSemantique
            || etat->ParentsEspacesUtilises == NulNaturelsDispositionSemantique
            || etat->PositionsEspacesUtilises == NulNaturelsDispositionSemantique
            || etat->FileEspacesUtilises == NulNaturelsDispositionSemantique
            || etat->VisitesEspacesUtilises == NulEtatsDispositionSemantique
            || etat->CiblesEspacesUtilises == NulNaturelsDispositionSemantique
            || pile == NulNaturelsDispositionSemantique)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
        etat->NombreEspacesUtilises = 1;
        etat->NomsEspacesUtilises[0] = HachageVideSemantique();
        etat->ParentsEspacesUtilises[0] = 0;
        etat->PositionsEspacesUtilises[0] = 0;
        naturel64 courant = 0;
        naturel64 profondeur = 0;
        index = 0;
        tantque (index < etat->NombreJetonsTypes) {
            naturel32 genre = etat->JetonsTypes[index].Genre;
            si (genre == 4 && (index == 0 || etat->JetonsTypes[index - 1].Genre != 76)) {
                pile[profondeur] = courant;
                profondeur = profondeur + 1;
                index = index + 1;
                tantque (index < etat->NombreJetonsTypes && etat->JetonsTypes[index].Genre == 1) {
                    naturel64 nomDeclare = etat->NomsEspacesUtilises[courant];
                    si (courant != 0) nomDeclare = AjouterOctetSemantique(AjouterOctetSemantique(nomDeclare, 58), 58);
                    nomDeclare = AjouterTrancheTypeJetonsSemantique(etat, nomDeclare, &etat->JetonsTypes[index]);
                    naturel64 enfant = IndexEspaceUtiliseSemantique(etat, nomDeclare);
                    si (enfant == 0) {
                        enfant = etat->NombreEspacesUtilises;
                        etat->NombreEspacesUtilises = enfant + 1;
                        etat->NomsEspacesUtilises[enfant] = nomDeclare;
                        etat->ParentsEspacesUtilises[enfant] = courant;
                        etat->PositionsEspacesUtilises[enfant] = etat->JetonsTypes[index].Debut;
                    }
                    courant = enfant;
                    index = index + 1;
                    si (index < etat->NombreJetonsTypes && etat->JetonsTypes[index].Genre == 44) index = index + 1;
                }
                si (index >= etat->NombreJetonsTypes || etat->JetonsTypes[index].Genre != 36)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, 0, 0);
            }
            sinon si (genre == 36) {
                pile[profondeur] = courant;
                profondeur = profondeur + 1;
            }
            sinon si (genre == 37) {
                si (profondeur == 0) retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, 0, 0);
                profondeur = profondeur - 1;
                courant = pile[profondeur];
            }
            index = index + 1;
        }
        /** <résumé>Ajoute les portées de classes pour les signatures et corps de méthodes, sans les rendre importables.</résumé> **/
        index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* porteeClasse = &etat->Requete->Noeuds[index];
            si (porteeClasse->Genre == 6) {
                naturel64 nomClasse = HacherNomCompletSemantique(etat, index);
                si (IndexEspaceUtiliseSemantique(etat, nomClasse) == 0) {
                    naturel64 indexClasse = etat->NombreEspacesUtilises;
                    etat->NombreEspacesUtilises = indexClasse + 1;
                    etat->NomsEspacesUtilises[indexClasse] = nomClasse;
                    etat->ParentsEspacesUtilises[indexClasse] = IndexEspaceUtiliseSemantique(etat, porteeClasse->HachageEspace);
                    etat->PositionsEspacesUtilises[indexClasse] = 18_446_744_073_709_551_615;
                }
            }
            index = index + 1;
        }
        index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud = &etat->Requete->Noeuds[index];
            etat->CiblesEspacesUtilises[index] = 0;
            si (noeud->Genre == 36) {
                RechercheNomUtiliseSemantique recherche = {
                    noeud->DebutNom, noeud->DebutNom + noeud->TailleNom, noeud->HachageNom,
                    noeud->HachageEspace, 0, 0, faux, faux, faux};
                courant = IndexEspaceUtiliseSemantique(etat, noeud->HachageEspace);
                booléen continuer = vrai;
                tantque (continuer) {
                    naturel64 nom = HacherRechercheUtiliseeSemantique(etat, &recherche, etat->NomsEspacesUtilises[courant]);
                    naturel64 cible = IndexEspaceUtiliseSemantique(etat, nom);
                    si (cible != 0 && etat->PositionsEspacesUtilises[cible] < noeud->DebutNom) {
                        etat->CiblesEspacesUtilises[index] = cible;
                        continuer = faux;
                    }
                    sinon si (courant == 0) continuer = faux;
                    sinon courant = etat->ParentsEspacesUtilises[courant];
                }
                si (etat->CiblesEspacesUtilises[index] == 0)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::EspaceUtiliseIntrouvable, index, 0);
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 NomSymboleUtiliseSemantique(EtatAnalyseSemantique* etat, naturel64 index) {

        SymboleSemantique* symbole = &etat->SymbolesTravail[index];
        si (symbole->Genre == 7) {
            naturel64 indexParent = etat->Requete->Noeuds[symbole->IndexNoeud].Parent;
            naturel64 nom = HacherNomCompletSemantique(etat, indexParent);
            nom = AjouterOctetSemantique(AjouterOctetSemantique(nom, 58), 58);
            retourner AjouterNomNoeudSemantique(etat, nom, symbole->IndexNoeud);
        }
        retourner HacherNomDeclarationAliasSemantique(etat, symbole);
    }

    /** <résumé>Parcourt les imports transitifs au niveau de leur ancêtre commun, avec une file bornée.</résumé> **/
    booléen CorrespondNiveauUtiliseSemantique(
        EtatAnalyseSemantique* etat, RechercheNomUtiliseSemantique* recherche, naturel64 nom) {

        si (nom == HacherRechercheUtiliseeSemantique(etat, recherche, etat->NomsEspacesUtilises[recherche->Niveau])) retourner vrai;
        naturel64 espaceRecherche = IndexEspaceUtiliseSemantique(etat, recherche->Espace);
        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* utilisation = &etat->Requete->Noeuds[index];
            naturel64 declarant = IndexEspaceUtiliseSemantique(etat, utilisation->HachageEspace);
            si (utilisation->Genre == 36 && utilisation->DebutNom < recherche->Debut
                && EspaceContientUtiliseSemantique(etat, declarant, espaceRecherche)) {
                naturel64 effacer = 0;
                tantque (effacer < etat->NombreEspacesUtilises) {
                    etat->VisitesEspacesUtilises[effacer] = 0;
                    effacer = effacer + 1;
                }
                naturel64 tete = 0;
                naturel64 fin = 1;
                naturel64 cible = etat->CiblesEspacesUtilises[index];
                etat->FileEspacesUtilises[0] = cible;
                etat->VisitesEspacesUtilises[cible] = 1;
                tantque (tete < fin) {
                    cible = etat->FileEspacesUtilises[tete];
                    tete = tete + 1;
                    naturel64 commun = declarant;
                    tantque (!EspaceContientUtiliseSemantique(etat, commun, cible)) commun = etat->ParentsEspacesUtilises[commun];
                    si (commun == recherche->Niveau
                        && nom == HacherRechercheUtiliseeSemantique(etat, recherche, etat->NomsEspacesUtilises[cible])) retourner vrai;
                    naturel64 transitif = 0;
                    tantque (transitif < etat->Requete->NombreNoeuds) {
                        constante NoeudDeclaration* suivant = &etat->Requete->Noeuds[transitif];
                        si (suivant->Genre == 36 && suivant->DebutNom < recherche->Debut
                            && suivant->HachageEspace == etat->NomsEspacesUtilises[cible]) {
                            naturel64 enfant = etat->CiblesEspacesUtilises[transitif];
                            si (etat->VisitesEspacesUtilises[enfant] == 0) {
                                etat->VisitesEspacesUtilises[enfant] = 1;
                                etat->FileEspacesUtilises[fin] = enfant;
                                fin = fin + 1;
                            }
                        }
                        transitif = transitif + 1;
                    }
                }
            }
            index = index + 1;
        }
        retourner faux;
    }

    /** <résumé>Recherche les noms lexicaux et importés au premier niveau contenant une déclaration.</résumé> **/
    vide ChercherNomUtiliseSemantique(EtatAnalyseSemantique* etat, RechercheNomUtiliseSemantique* recherche) {

        recherche->Premier = etat->NombreSymboles;
        recherche->Active = vrai;
        recherche->Ambigue = faux;
        recherche->Qualifie = faux;
        naturel64 espaceRecherche = IndexEspaceUtiliseSemantique(etat, recherche->Espace);
        naturel64 index = 0;
        tantque (index < etat->NombreJetonsTypes) {
            si (etat->JetonsTypes[index].Debut >= recherche->Debut && etat->JetonsTypes[index].Debut < recherche->Fin
                && etat->JetonsTypes[index].Genre == 44) recherche->Qualifie = vrai;
            index = index + 1;
        }
        si (recherche->Qualifie) {
            index = 0;
            tantque (index < etat->NombreSymboles) {
                naturel32 genreQualifie = etat->SymbolesTravail[index].Genre;
                si ((genreQualifie >= 1 && genreQualifie <= 4)
                    || (genreQualifie == 7
                        && etat->Requete->Noeuds[etat->SymbolesTravail[index].IndexNoeud].DebutNom < recherche->Debut)) {
                    si (NomSymboleUtiliseSemantique(etat, index) == recherche->Hachage) {
                        recherche->Premier = index;
                        retourner;
                    }
                }
                index = index + 1;
            }
        }
        recherche->Qualifie = faux;
        recherche->Niveau = espaceRecherche;
        booléen continuer = vrai;
        tantque (continuer) {
            naturel64 premierNom = 0;
            booléen fonctions = vrai;
            index = 0;
            tantque (index < etat->NombreSymboles) {
                naturel32 genre = etat->SymbolesTravail[index].Genre;
                si ((genre >= 1 && genre <= 4)
                    || (genre == 7
                        && etat->Requete->Noeuds[etat->SymbolesTravail[index].IndexNoeud].DebutNom < recherche->Debut)) {
                    naturel64 nom = NomSymboleUtiliseSemantique(etat, index);
                    si (CorrespondNiveauUtiliseSemantique(etat, recherche, nom)) {
                        naturel32 famille = genre;
                        si (genre == 4 && etat->EtatsAliasesRacines[index] == 2)
                            famille = etat->SymbolesTravail[etat->CiblesAliasesRacines[index]].Genre;
                        si (recherche->Premier >= etat->NombreSymboles) {
                            recherche->Premier = index;
                            premierNom = nom;
                        }
                        sinon si (nom != premierNom && (!fonctions || famille != 2)) recherche->Ambigue = vrai;
                        si (famille != 2) fonctions = faux;
                    }
                }
                index = index + 1;
            }
            si (recherche->Premier < etat->NombreSymboles || recherche->Niveau == 0) continuer = faux;
            sinon recherche->Niveau = etat->ParentsEspacesUtilises[recherche->Niveau];
        }
    }

    /**
     * <résumé>Commence la recherche à la classe d'une méthode ou de l'initialiseur de champ actif.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST et contexte privé de constructeur.
     * @Paramètre(constante NoeudDeclaration*: noeud) Référence dont l'espace public reste inchangé.
     * @Retourner(RechercheNomUtiliseSemantique) Recherche lexicale avec la portée effective du bootstrap.
     **/
    RechercheNomUtiliseSemantique RechercheDepuisNoeudUtiliseSemantique(
        EtatAnalyseSemantique* etat, constante NoeudDeclaration* noeud) {

        naturel64 espaceRecherche = noeud->HachageEspace;
        naturel64 contexte = noeud->Parent;
        si (etat->ConstructeurChampActif < etat->Requete->NombreNoeuds)
            contexte = etat->ConstructeurChampActif;
        tantque (contexte != 0 && contexte < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* ancetre = &etat->Requete->Noeuds[contexte];
            si (ancetre->Genre >= 12 && ancetre->Genre <= 15
                && etat->Requete->Noeuds[ancetre->Parent].Genre == 6) {
                espaceRecherche = HacherNomCompletSemantique(etat, ancetre->Parent);
                contexte = 0;
            }
            sinon contexte = ancetre->Parent;
        }
        retourner {noeud->DebutNom, noeud->DebutNom + noeud->TailleNom,
            noeud->HachageNom, espaceRecherche, 0, 0, faux, faux, faux};
    }

    booléen ReferenceUtiliseEspacesSemantique(EtatAnalyseSemantique* etat, constante NoeudDeclaration* noeud) {

        RechercheNomUtiliseSemantique recherche = RechercheDepuisNoeudUtiliseSemantique(etat, noeud);
        ChercherNomUtiliseSemantique(etat, &recherche);
        retourner recherche.Active;
    }

    RechercheNomUtiliseSemantique RechercheCibleAliasUtiliseSemantique(
        EtatAnalyseSemantique* etat, constante NoeudDeclaration* noeud) {

        RechercheNomUtiliseSemantique recherche = RechercheDepuisNoeudUtiliseSemantique(etat, noeud);
        naturel64 jeton = 0;
        tantque (jeton < etat->NombreJetonsTypes && etat->JetonsTypes[jeton].Debut < recherche.Fin) jeton = jeton + 1;
        tantque (jeton < etat->NombreJetonsTypes && etat->JetonsTypes[jeton].Genre != 45) jeton = jeton + 1;
        jeton = jeton + 1;
        si (jeton < etat->NombreJetonsTypes) recherche.Debut = etat->JetonsTypes[jeton].Debut;
        tantque (jeton < etat->NombreJetonsTypes && etat->JetonsTypes[jeton].Genre != 40) jeton = jeton + 1;
        si (jeton < etat->NombreJetonsTypes) recherche.Fin = etat->JetonsTypes[jeton].Debut;
        recherche.Hachage = noeud->HachageType;
        ChercherNomUtiliseSemantique(etat, &recherche);
        retourner recherche;
    }

    /**
     * <résumé>Construit la cible relative d'un alias à partir de ses lexèmes, sans espaces ni commentaires.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Source et jetons privés de cette analyse.
     * @Paramètre(naturel64: indexAlias) Symbole de l'alias racine.
     * @Retourner(naturel64) Empreinte de la cible préfixée par l'espace déclarant.
     **/
    naturel64 HacherCibleRelativeAliasSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAlias) {

        SymboleSemantique* aliasCourant = &etat->SymbolesTravail[indexAlias];
        si (aliasCourant->HachageEspace == HachageVideSemantique()) retourner aliasCourant->HachageType;
        constante NoeudDeclaration* noeud = &etat->Requete->Noeuds[aliasCourant->IndexNoeud];
        naturel64 hachage = AjouterOctetSemantique(
            AjouterOctetSemantique(aliasCourant->HachageEspace, 58), 58);
        naturel64 jeton = 0;
        tantque (jeton < etat->NombreJetonsTypes
            && etat->JetonsTypes[jeton].Debut < noeud->DebutNom + noeud->TailleNom)
            jeton = jeton + 1;
        tantque (jeton < etat->NombreJetonsTypes && etat->JetonsTypes[jeton].Genre != 45)
            jeton = jeton + 1;
        jeton = jeton + 1;
        tantque (jeton < etat->NombreJetonsTypes && etat->JetonsTypes[jeton].Genre != 40) {

            hachage = AjouterTrancheTypeJetonsSemantique(etat, hachage, &etat->JetonsTypes[jeton]);
            jeton = jeton + 1;
        }
        retourner hachage;
    }

    externe ErreurAnalyseSemantique SignalerErreurSemantique(
        EtatAnalyseSemantique* etat, ErreurAnalyseSemantique erreur, naturel64 indexNoeud, naturel32 detail);

    /**
     * <résumé>Valide les alias racines, même inutilisés, et mémorise leurs déclarations canoniques.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Index brut, sans introduire les alias dans les familles de symboles.
     * @Retourner(ErreurAnalyseSemantique) Premier refus dans l'ordre du bootstrap, ou réussite.
     * @etc. Le parcours itératif à trois états détecte les cycles et comprime les chaînes ;
     * l'AST et les symboles d'alias publics conservent leurs empreintes d'origine.
     **/
    ErreurAnalyseSemantique ResoudreAliasesRacinesSemantiques(EtatAnalyseSemantique* etat) {

        naturel64 entree = 0;
        tantque (entree < etat->NombreSymboles) {

            si (etat->SymbolesTravail[entree].Genre == 4 && etat->EtatsAliasesRacines[entree] != 2) {

                naturel64 courant = entree;
                naturel64 canonique = etat->NombreSymboles;
                tantque (canonique >= etat->NombreSymboles) {

                    SymboleSemantique* aliasCourant = &etat->SymbolesTravail[courant];
                    si (etat->EtatsAliasesRacines[courant] == 2) canonique = etat->CiblesAliasesRacines[courant];
                    sinon {

                        si (etat->EtatsAliasesRacines[courant] == 1)
                            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::CycleAlias,
                                aliasCourant->IndexNoeud, convertir<naturel32>(entree));
                        etat->EtatsAliasesRacines[courant] = 1;
                        naturel64 cible = etat->NombreSymboles;
                        naturel32 familles = 0;
                        naturel64 fonctions = 0;
                        RechercheNomUtiliseSemantique recherche = RechercheCibleAliasUtiliseSemantique(
                            etat, &etat->Requete->Noeuds[aliasCourant->IndexNoeud]);
                        si (recherche.Ambigue)
                            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::NomImporteAmbigu, aliasCourant->IndexNoeud, 0);
                        naturel32 passe = 0;
                        tantque (passe < 2 && cible >= etat->NombreSymboles) {

                            naturel64 nom = aliasCourant->HachageType;
                            si (passe == 1) nom = HacherCibleRelativeAliasSemantique(etat, courant);
                            naturel64 index = 0;
                            tantque (index < etat->NombreSymboles) {

                                SymboleSemantique* candidat = &etat->SymbolesTravail[index];
                                naturel32 famille = 0;
                                si (candidat->Genre == 1 && etat->Requete->Noeuds[candidat->IndexNoeud].Genre != 8) famille = 1;
                                si (candidat->Genre == 2) famille = 2;
                                si (candidat->Genre == 3) famille = 4;
                                si (candidat->Genre == 4) famille = 8;
                                naturel64 nomCandidat = HacherNomDeclarationAliasSemantique(etat, candidat);
                                booléen correspond = nomCandidat == nom;
                                si (recherche.Active) {
                                    correspond = recherche.Premier < etat->NombreSymboles
                                        && CorrespondNiveauUtiliseSemantique(etat, &recherche, nomCandidat);
                                    si (recherche.Qualifie) correspond = nomCandidat == recherche.Hachage;
                                }
                                si (famille != 0 && correspond) {

                                    si (cible >= etat->NombreSymboles) cible = index;
                                    familles = familles | famille;
                                    si (famille == 2) fonctions = fonctions + 1;
                                }
                                index = index + 1;
                            }
                            passe = passe + 1;
                            si (recherche.Active) passe = 2;
                        }
                        si (cible >= etat->NombreSymboles)
                            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::CibleAliasIntrouvable,
                                aliasCourant->IndexNoeud, 0);
                        si ((familles & (familles - 1)) != 0)
                            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::CibleAliasAmbigue,
                                aliasCourant->IndexNoeud, familles);
                        si (fonctions > 1)
                            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AliasFonctionSurchargeeAmbigu,
                                aliasCourant->IndexNoeud, convertir<naturel32>(fonctions));
                        etat->CiblesAliasesRacines[courant] = cible;
                        si (etat->SymbolesTravail[cible].Genre == 4) courant = cible;
                        sinon canonique = cible;
                    }
                }
                courant = entree;
                tantque (etat->SymbolesTravail[courant].Genre == 4 && etat->EtatsAliasesRacines[courant] != 2) {

                    naturel64 suivant = etat->CiblesAliasesRacines[courant];
                    etat->CiblesAliasesRacines[courant] = canonique;
                    etat->EtatsAliasesRacines[courant] = 2;
                    courant = suivant;
                }
            }
            entree = entree + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Résout un nom dans l'espace de sa déclaration, avec priorité au nom complet écrit.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Source et espaces associés aux jetons de type.
     * @Paramètre(naturel64: debut) Premier jeton du nom, sans qualificatifs.
     * @Paramètre(naturel64: fin) Fin exclusive du nom qualifié.
     * @Paramètre(naturel64: hachage) Empreinte du nom écrit.
     * @Retourner(naturel64) Empreinte canonique, ou empreinte écrite si le type est absent.
     **/
    naturel64 ResoudreNomTypeJetonsSemantique(
        EtatAnalyseSemantique* etat, naturel64 debut, naturel64 fin, naturel64 hachage) {

        RechercheNomUtiliseSemantique recherche = {
            etat->JetonsTypes[debut].Debut, etat->JetonsTypes[fin - 1].Debut + etat->JetonsTypes[fin - 1].TailleSource,
            hachage, etat->EspacesJetonsTypes[debut], 0, 0, faux, faux, faux};
        ChercherNomUtiliseSemantique(etat, &recherche);
        si (recherche.Ambigue) {
            etat->ErreurTypeDeclare = ErreurAnalyseSemantique::NomImporteAmbigu;
            retourner hachage;
        }
        si (recherche.Active && recherche.Premier < etat->NombreSymboles) {
            naturel64 cibleImportee = recherche.Premier;
            si (etat->SymbolesTravail[cibleImportee].Genre == 4 && etat->EtatsAliasesRacines[cibleImportee] == 2)
                cibleImportee = etat->CiblesAliasesRacines[cibleImportee];
            si (etat->SymbolesTravail[cibleImportee].Genre == 1)
                retourner HacherNomCompletSemantique(etat, etat->SymbolesTravail[cibleImportee].IndexNoeud);
        }
        si (etat->ErreurTypeDeclare == ErreurAnalyseSemantique::Reussite)
            etat->ErreurTypeDeclare = ErreurAnalyseSemantique::TypeNommeIntrouvable;
        retourner hachage;
    }

    /**
     * <résumé>Distingue un retour d'agrégat par valeur d'un enum, pointeur ou référence.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Déclarations des types nommés.
     * @Paramètre(DescriptionTypeJetonsSemantique*: type) Type canonique sans dimensions.
     * @Retourner(booléen) Vrai pour une structure, union ou classe passée par valeur.
     **/
    booléen EstDescriptionStructureValeurSemantique(
        EtatAnalyseSemantique* etat, DescriptionTypeJetonsSemantique* type) {

        si (type->Genre != 13 || type->NiveauPointeur != 0 || (type->Qualificatifs & 4) != 0)
            retourner faux;
        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {

            naturel32 genre = etat->Requete->Noeuds[index].Genre;
            si (genre >= 4 && genre <= 6
                && HacherNomCompletSemantique(etat, index) == type->HachageNom)
                retourner vrai;
            index = index + 1;
        }
        retourner faux;
    }

    naturel64 HacherSoiSemantique() {
        naturel64 hachage = HachageVideSemantique();
        hachage = AjouterOctetSemantique(hachage, 115);
        hachage = AjouterOctetSemantique(hachage, 111);
        retourner AjouterOctetSemantique(hachage, 105);
    }

    booléen EstGenreFonctionSemantique(naturel32 genre) {
        retourner genre == 1
            || genre == 12
            || genre == 13
            || genre == 14
            || genre == 15;
    }

    naturel32 GenreSymboleDepuisNoeudSemantique(naturel32 genre) {
        si (genre == 4 || genre == 5 || genre == 6 || genre == 8)
            retourner 1;
        si (EstGenreFonctionSemantique(genre)) retourner 2;
        si (genre == 3) retourner 3;
        si (genre == 10) retourner 4;
        si (genre == 7) retourner 5;
        si (genre == 11) retourner 6;
        si (genre == 9) retourner 7;
        si (genre == 2) retourner 8;
        si (genre == 19) retourner 9;
        retourner 0;
    }

    ErreurAnalyseSemantique SignalerErreurSemantique(
        EtatAnalyseSemantique* etat,
        ErreurAnalyseSemantique erreur,
        naturel64 indexNoeud,
        naturel32 detail) {
        si (etat->Requete->Resultat.Erreur == ErreurAnalyseSemantique::NomImporteAmbigu)
            retourner etat->Requete->Resultat.Erreur;
        etat->Requete->Resultat.Erreur = erreur;
        etat->Requete->Resultat.Detail = detail;
        si (indexNoeud < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[indexNoeud];
            etat->Requete->Resultat.LigneErreur = noeud->Ligne;
            etat->Requete->Resultat.ColonneErreur = noeud->Colonne;
        }
        sinon {
            etat->Requete->Resultat.LigneErreur = 1;
            etat->Requete->Resultat.ColonneErreur = 1;
        }
        retourner erreur;
    }

    /**
     * <résumé>Normalise les types dans une copie privée sans modifier l'AST de l'appelant.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Requête privée et arène de cette analyse.
     * @Retourner(ErreurAnalyseSemantique) État de résolution des types déclarés et imbriqués.
     * @etc. Les refus des conversions et types locaux attendent leur visite dans le corps.
     **/
    ErreurAnalyseSemantique ResoudreTypesDeclaresSemantiques(EtatAnalyseSemantique* etat) {

        naturel64 nombre = etat->Requete->NombreNoeuds;
        si (nombre > 288_230_376_151_711_743
            || etat->NombreJetonsTypes > 2_305_843_009_213_693_951)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
        NoeudDeclaration* copie = convertir<NoeudDeclaration*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, nombre * 64, 8));
        naturel64* debuts = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, nombre * 8, 8));
        naturel64* espaces = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, etat->NombreJetonsTypes * 8, 8));
        si (convertir<constante NoeudDeclaration*>(copie) == NulNoeudsSemantiques || debuts == NulCiblesExpressionsSemantiques
            || espaces == NulCiblesExpressionsSemantiques)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
        naturel64 index = 0;
        tantque (index < etat->NombreJetonsTypes) {

            espaces[index] = HachageVideSemantique();
            index = index + 1;
        }
        index = 0;
        tantque (index < nombre) {

            copie[index] = etat->Requete->Noeuds[index];
            debuts[index] = etat->NombreJetonsTypes;
            naturel32 genre = copie[index].Genre;
            si (genre == 1 || genre == 2 || genre == 3 || genre == 7
                || genre == 12 || genre == 15 || genre == 19 || genre == 31) {

                naturel64 espaceType = copie[index].HachageEspace;
                naturel64 ancetre = index;
                tantque (ancetre != 0) {

                    constante NoeudDeclaration* contexte = &etat->Requete->Noeuds[ancetre];
                    si (contexte->Genre >= 12 && contexte->Genre <= 15
                        && etat->Requete->Noeuds[contexte->Parent].Genre == 6) {

                        espaceType = HacherNomCompletSemantique(etat, contexte->Parent);
                        ancetre = 0;
                    }
                    sinon si (genre == 31 && contexte->Genre == 7
                        && etat->Requete->Noeuds[contexte->Parent].Genre == 6) {

                        /**
                         * <résumé>La conversion d'un champ par défaut utilise la portée du constructeur,
                         * pas celle du type déclaré du champ.</résumé>
                         **/
                        espaceType = HacherNomCompletSemantique(etat, contexte->Parent);
                        ancetre = 0;
                    }
                    sinon ancetre = contexte->Parent;
                }
                DescriptionTypeJetonsSemantique type;
                si (LireTypeNoeudSemantique(etat, index, &type)) {

                    debuts[index] = type.DebutType;
                    CurseurTypeJetonsSemantique curseur = {type.DebutType, faux};
                    si (AnalyserTypeJetonsSemantique(etat, &curseur, &type)) {

                        naturel64 jeton = type.DebutType;
                        tantque (jeton < curseur.Index) {

                            espaces[jeton] = espaceType;
                            jeton = jeton + 1;
                        }
                    }
                }
            }
            index = index + 1;
        }
        etat->Requete->Noeuds = convertir<constante NoeudDeclaration*>(copie);
        etat->EspacesJetonsTypes = espaces;
        index = 0;
        tantque (index < nombre) {

            si (debuts[index] < etat->NombreJetonsTypes) {

                CurseurTypeJetonsSemantique curseurCanonique = {debuts[index], faux};
                DescriptionTypeJetonsSemantique typeCanonique;
                etat->ErreurTypeDeclare = ErreurAnalyseSemantique::Reussite;
                si (AnalyserTypeJetonsSemantique(etat, &curseurCanonique, &typeCanonique)) {

                    DescriptionHachageTypeSemantique dimensions;
                    LireDimensionsNoeudSemantique(etat, index, &dimensions);
                    si ((typeCanonique.Qualificatifs & 4) != 0 && dimensions.NombreDimensions != 0
                        && copie[index].Genre != 19)
                        retourner SignalerErreurSemantique(
                            etat, ErreurAnalyseSemantique::ReferenceTableauInterdite, index, 0);
                    si (etat->ErreurTypeDeclare != ErreurAnalyseSemantique::Reussite) {

                        si (copie[index].Genre == 31 || copie[index].Genre == 19)
                            etat->ErreurTypeDeclare = ErreurAnalyseSemantique::Reussite;
                        sinon retourner SignalerErreurSemantique(etat, etat->ErreurTypeDeclare, index, 0);
                    }
                    naturel32 genreDeclaration = copie[index].Genre;
                    si ((genreDeclaration == 1 || genreDeclaration == 12 || genreDeclaration == 15)
                        && (typeCanonique.Qualificatifs & 4) != 0)
                        retourner SignalerErreurSemantique(
                            etat, ErreurAnalyseSemantique::RetourReferenceInterdit, index, 0);
                    si (genreDeclaration == 2
                        && (dimensions.NombreDimensions != 0
                            || (typeCanonique.Genre == 12 && typeCanonique.NiveauPointeur == 0)))
                        retourner SignalerErreurSemantique(
                            etat, ErreurAnalyseSemantique::ParametreFonctionInvalide, index, 0);
                    dimensions.HachageNom = typeCanonique.HachageNom;
                    copie[index].HachageType = HacherTypeCompletSemantique(
                        typeCanonique.Genre, typeCanonique.Qualificatifs, typeCanonique.NiveauPointeur, &dimensions);
                }
            }
            index = index + 1;
        }
        index = 0;
        tantque (index < etat->NombreSymboles) {

            SymboleSemantique* symbole = &etat->SymbolesTravail[index];
            symbole->HachageType = copie[symbole->IndexNoeud].HachageType;
            index = index + 1;
        }
        si (!InitialiserTypesComposesSemantiques(etat))
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    booléen ValiderAstSemantique(EtatAnalyseSemantique* etat) {
        si (etat->Requete->NombreNoeuds == 0
            || etat->Requete->Noeuds == NulNoeudsSemantiques) {
            SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::AstInvalide, 0, 0);
            retourner faux;
        }
        si (etat->Requete->Noeuds[0].Genre != 0) {
            SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::AstInvalide, 0, 1);
            retourner faux;
        }

        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[index];
            si (index != 0 && noeud->Parent >= index) {
                SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    index,
                    2);
                retourner faux;
            }
            si (noeud->TailleNom != 0
                && (noeud->DebutNom > etat->Requete->TailleSource
                    || noeud->TailleNom
                        > etat->Requete->TailleSource - noeud->DebutNom)) {
                SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    index,
                    3);
                retourner faux;
            }
            index = index + 1;
        }
        retourner vrai;
    }

    booléen AjouterSymboleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        constante NoeudDeclaration* noeud =
            &etat->Requete->Noeuds[indexNoeud];
        naturel32 genre = GenreSymboleDepuisNoeudSemantique(noeud->Genre);
        si (genre == 0) retourner vrai;
        SymboleSemantique symbole = {
            indexNoeud,
            noeud->Parent,
            noeud->HachageNom,
            noeud->HachageEspace,
            noeud->HachageType,
            genre,
            noeud->Drapeaux};
        etat->SymbolesTravail[etat->NombreSymboles] = symbole;
        etat->NombreSymboles = etat->NombreSymboles + 1;
        si (genre == 4) etat->NombreAliasesRacines = etat->NombreAliasesRacines + 1;
        retourner vrai;
    }

    booléen MemesNomsCompletsSemantiques(
        EtatAnalyseSemantique* etat, SymboleSemantique* gauche, SymboleSemantique* droite) {
        retourner HacherNomDeclarationAliasSemantique(etat, gauche)
            == HacherNomDeclarationAliasSemantique(etat, droite);
    }

    booléen MemesNomsPorteeSemantiques(
        SymboleSemantique* gauche, SymboleSemantique* droite) {
        retourner gauche->IndexPortee == droite->IndexPortee
            && gauche->HachageNom == droite->HachageNom;
    }

    booléen EstAncetreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 ancetre,
        naturel64 descendant) {
        naturel64 courant = descendant;
        tantque (courant != 0 && courant < etat->Requete->NombreNoeuds) {
            si (courant == ancetre) retourner vrai;
            courant = etat->Requete->Noeuds[courant].Parent;
        }
        retourner ancetre == 0;
    }

    naturel64 TrouverFonctionAncetreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        si (etat->ConstructeurChampActif < etat->Requete->NombreNoeuds)
            retourner etat->ConstructeurChampActif;
        naturel64 courant = indexNoeud;
        tantque (courant != 0 && courant < etat->Requete->NombreNoeuds) {
            si (EstGenreFonctionSemantique(
                    etat->Requete->Noeuds[courant].Genre))
                retourner courant;
            courant = etat->Requete->Noeuds[courant].Parent;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    ErreurAnalyseSemantique VerifierConflitsRacinesSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 index = 0;

        /**
         * Le bootstrap indexe d'abord les énumérations, puis les autres types.
         * Cet ordre reste stable même si les déclarations sont entrelacées dans
         * le fichier source.
         **/
        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantEnumeration =
                &etat->SymbolesTravail[index];
            si (courantEnumeration->Genre == 1
                && etat->Requete->Noeuds[
                    courantEnumeration->IndexNoeud].Genre == 8) {
                naturel64 precedentEnumeration = 0;
                tantque (precedentEnumeration < index) {
                    SymboleSemantique* autreEnumeration =
                        &etat->SymbolesTravail[precedentEnumeration];
                    si (autreEnumeration->Genre == 1
                        && etat->Requete->Noeuds[
                            autreEnumeration->IndexNoeud].Genre == 8
                        && MemesNomsCompletsSemantiques(
                            etat, courantEnumeration, autreEnumeration))
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::TypeDeclarePlusieursFois,
                            courantEnumeration->IndexNoeud,
                            convertir<naturel32>(
                                autreEnumeration->IndexNoeud));
                    precedentEnumeration = precedentEnumeration + 1;
                }
            }
            index = index + 1;
        }

        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantType = &etat->SymbolesTravail[index];
            naturel32 genreNoeud =
                etat->Requete->Noeuds[courantType->IndexNoeud].Genre;
            si (courantType->Genre == 1 && genreNoeud != 8) {
                naturel64 precedentType = 0;
                tantque (precedentType < etat->NombreSymboles) {
                    SymboleSemantique* autreType =
                        &etat->SymbolesTravail[precedentType];
                    si (autreType->Genre == 1
                        && autreType->IndexNoeud != courantType->IndexNoeud
                        && MemesNomsCompletsSemantiques(
                            etat, courantType, autreType)) {
                        naturel32 genreAutre =
                            etat->Requete->Noeuds[
                                autreType->IndexNoeud].Genre;
                        si (genreAutre == 8)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::NomTypeEnConflit,
                                courantType->IndexNoeud,
                                convertir<naturel32>(
                                    autreType->IndexNoeud));
                        si (autreType->IndexNoeud < courantType->IndexNoeud)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::TypeDeclarePlusieursFois,
                                courantType->IndexNoeud,
                                convertir<naturel32>(
                                    autreType->IndexNoeud));
                    }
                    precedentType = precedentType + 1;
                }
            }
            index = index + 1;
        }

        // Les fonctions sont ensuite confrontées aux noms de types.
        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantFonction =
                &etat->SymbolesTravail[index];
            si (courantFonction->Genre == 2) {
                naturel64 precedentFonction = 0;
                tantque (precedentFonction < etat->NombreSymboles) {
                    SymboleSemantique* autreFonction =
                        &etat->SymbolesTravail[precedentFonction];
                    si (autreFonction->Genre == 1
                        && MemesNomsCompletsSemantiques(
                            etat, courantFonction, autreFonction))
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::NomTypeEnConflit,
                            courantFonction->IndexNoeud,
                            convertir<naturel32>(
                                autreFonction->IndexNoeud));
                    precedentFonction = precedentFonction + 1;
                }
            }
            index = index + 1;
        }

        // Les globales sont indexées après les fonctions et les types.
        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantGlobale =
                &etat->SymbolesTravail[index];
            si (courantGlobale->Genre == 3
                && courantGlobale->IndexPortee == 0) {
                naturel64 precedentGlobale = 0;
                tantque (precedentGlobale < etat->NombreSymboles) {
                    SymboleSemantique* autreGlobale =
                        &etat->SymbolesTravail[precedentGlobale];
                    si ((autreGlobale->IndexPortee == 0 || autreGlobale->Genre == 2)
                        && MemesNomsCompletsSemantiques(
                            etat, courantGlobale, autreGlobale)) {
                        si (autreGlobale->Genre == 3
                            && autreGlobale->IndexNoeud
                                < courantGlobale->IndexNoeud)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::GlobaleDeclareePlusieursFois,
                                courantGlobale->IndexNoeud,
                                convertir<naturel32>(
                                    autreGlobale->IndexNoeud));
                        si (autreGlobale->Genre == 1
                            || autreGlobale->Genre == 2)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::NomGlobalEnConflit,
                                courantGlobale->IndexNoeud,
                                convertir<naturel32>(
                                    autreGlobale->IndexNoeud));
                    }
                    precedentGlobale = precedentGlobale + 1;
                }
            }
            index = index + 1;
        }

        // Les alias ferment l'index des déclarations racines.
        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantAlias =
                &etat->SymbolesTravail[index];
            si (courantAlias->Genre == 4
                && courantAlias->IndexPortee == 0) {
                naturel64 precedentAlias = 0;
                tantque (precedentAlias < etat->NombreSymboles) {
                    SymboleSemantique* autreAlias =
                        &etat->SymbolesTravail[precedentAlias];
                    si ((autreAlias->IndexPortee == 0 || autreAlias->Genre == 2)
                        && autreAlias->IndexNoeud
                            != courantAlias->IndexNoeud
                        && MemesNomsCompletsSemantiques(
                            etat, courantAlias, autreAlias)) {
                        si (autreAlias->Genre == 4) {
                            si (autreAlias->IndexNoeud
                                < courantAlias->IndexNoeud)
                                retourner SignalerErreurSemantique(
                                    etat,
                                    ErreurAnalyseSemantique::AliasDeclarePlusieursFois,
                                    courantAlias->IndexNoeud,
                                    convertir<naturel32>(
                                        autreAlias->IndexNoeud));
                        }
                        sinon
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::AliasEnConflit,
                                courantAlias->IndexNoeud,
                                convertir<naturel32>(
                                    autreAlias->IndexNoeud));
                    }
                    precedentAlias = precedentAlias + 1;
                }
            }
            index = index + 1;
        }

        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique VerifierConflitsSemantiques(EtatAnalyseSemantique* etat) {

        ErreurAnalyseSemantique erreur = VerifierConflitsRacinesSemantiques(etat);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
        booléen fonctionPresente = faux;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            si (etat->SymbolesTravail[index].Genre == 2) fonctionPresente = vrai;
            index = index + 1;
        }
        // Les conflits de membres suivent l'ordre lexical ; les locaux attendent leur visite.
        index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* courantPortee =
                &etat->SymbolesTravail[index];
            naturel64 precedentPortee = 0;
            tantque (precedentPortee < index) {
                SymboleSemantique* autrePortee =
                    &etat->SymbolesTravail[precedentPortee];
                booléen memePorteeLocale = MemesNomsPorteeSemantiques(
                    courantPortee, autrePortee);
                si (courantPortee->Genre == 5 && memePorteeLocale
                    && (autrePortee->Genre == 5 || autrePortee->Genre == 6)) {
                    si (autrePortee->Genre == 5)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::ChampDeclarePlusieursFois,
                            courantPortee->IndexNoeud,
                            convertir<naturel32>(autrePortee->IndexNoeud));
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AliasChampEnConflit,
                        courantPortee->IndexNoeud,
                        convertir<naturel32>(autrePortee->IndexNoeud));
                }
                sinon si (courantPortee->Genre == 6 && memePorteeLocale
                    && (autrePortee->Genre == 5 || autrePortee->Genre == 6)) {
                    si (autrePortee->Genre == 6)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::AliasChampDeclarePlusieursFois,
                            courantPortee->IndexNoeud,
                            convertir<naturel32>(autrePortee->IndexNoeud));
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AliasChampEnConflit,
                        courantPortee->IndexNoeud,
                        convertir<naturel32>(autrePortee->IndexNoeud));
                }
                sinon si (courantPortee->Genre == 7
                    && autrePortee->Genre == 7 && memePorteeLocale)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::EnumerateurDeclarePlusieursFois,
                        courantPortee->IndexNoeud,
                        convertir<naturel32>(autrePortee->IndexNoeud));
                precedentPortee = precedentPortee + 1;
            }
            index = index + 1;
        }
        si (!fonctionPresente)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::FonctionAbsente,
                0,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 TrouverSymboleNoeudSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            si (etat->SymbolesTravail[index].IndexNoeud == indexNoeud)
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    booléen ReferenceCorrespondSymboleSemantique(
        EtatAnalyseSemantique* etat,
        constante NoeudDeclaration* reference,
        SymboleSemantique* symbole) {
        RechercheNomUtiliseSemantique recherche = RechercheDepuisNoeudUtiliseSemantique(etat, reference);
        ChercherNomUtiliseSemantique(etat, &recherche);
        si (recherche.Active) {
            si (recherche.Ambigue || recherche.Premier >= etat->NombreSymboles) retourner faux;
            naturel64 nom = HacherNomDeclarationAliasSemantique(etat, symbole);
            booléen correspond = CorrespondNiveauUtiliseSemantique(etat, &recherche, nom);
            si (recherche.Qualifie) correspond = nom == recherche.Hachage;
            si (correspond) retourner vrai;
            naturel64 indexAlias = 0;
            tantque (indexAlias < etat->NombreSymboles) {
                si (etat->SymbolesTravail[indexAlias].Genre == 4 && etat->EtatsAliasesRacines[indexAlias] == 2
                    && HacherNomDeclarationAliasSemantique(etat, &etat->SymbolesTravail[etat->CiblesAliasesRacines[indexAlias]]) == nom) {
                    naturel64 nomAlias = HacherNomDeclarationAliasSemantique(etat, &etat->SymbolesTravail[indexAlias]);
                    booléen aliasCorrespond = CorrespondNiveauUtiliseSemantique(etat, &recherche, nomAlias);
                    si (recherche.Qualifie) aliasCorrespond = nomAlias == recherche.Hachage;
                    si (aliasCorrespond) retourner vrai;
                }
                indexAlias = indexAlias + 1;
            }
            retourner faux;
        }
        si (reference->HachageNom == symbole->HachageNom
            && reference->HachageEspace == symbole->HachageEspace)
            retourner vrai;
        naturel64 complet = HacherNomCompletSemantique(
            etat, symbole->IndexNoeud);
        retourner reference->HachageNom == complet;
    }

    externe naturel64 SansReferenceTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType);

    booléen AjouterResolutionSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel64 indexSymbole,
        naturel32 drapeaux) {
        SymboleSemantique* symbole = &etat->SymbolesTravail[indexSymbole];
        ResolutionSemantique resolution = {
            indexNoeud,
            indexSymbole,
            symbole->HachageType,
            symbole->Genre,
            drapeaux};
        si (etat->NombreResolutions < etat->Requete->CapaciteResolutions
            && etat->Requete->Resolutions != NulResolutionsSemantiques)
            etat->Requete->Resolutions[etat->NombreResolutions] = resolution;
        si (etat->CiblesExpressions != NulCiblesExpressionsSemantiques
            && indexNoeud < etat->Requete->NombreNoeuds)
            etat->CiblesExpressions[indexNoeud] = indexSymbole;
        etat->NombreResolutions = etat->NombreResolutions + 1;
        retourner vrai;
    }

    booléen AjouterEtapeDureeVieSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel64 indexSymbole,
        DescriptionEtapeDureeVieSemantique* description) {
        SymboleSemantique* symbole = &etat->SymbolesTravail[indexSymbole];
        ResolutionSemantique resolution = {
            indexNoeud,
            indexSymbole,
            description->Decalage,
            symbole->Genre,
            description->Drapeaux | 32_768};
        si (etat->NombreResolutions < etat->Requete->CapaciteResolutions
            && etat->Requete->Resolutions != NulResolutionsSemantiques)
            etat->Requete->Resolutions[etat->NombreResolutions] = resolution;
        etat->NombreResolutions = etat->NombreResolutions + 1;
        retourner vrai;
    }

    naturel64 HachageTypeResolutionExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds
            || etat->CiblesExpressions == NulCiblesExpressionsSemantiques)
            retourner 0;
        naturel64 cible = etat->CiblesExpressions[indexExpression];
        si (cible >= etat->NombreSymboles) retourner 0;
        retourner SansReferenceTypeSemantique(
            etat, etat->SymbolesTravail[cible].HachageType);
    }

    naturel64 TrouverRecepteurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        naturel64 fonction = TrouverFonctionAncetreSemantique(
            etat, indexReference);
        si (fonction >= etat->Requete->NombreNoeuds)
            retourner etat->NombreSymboles;
        constante NoeudDeclaration* noeudFonction =
            &etat->Requete->Noeuds[fonction];
        si (!EstGenreFonctionSemantique(noeudFonction->Genre)
            || noeudFonction->Parent == 0)
            retourner etat->NombreSymboles;
        si (etat->Requete->Noeuds[noeudFonction->Parent].Genre != 6)
            retourner etat->NombreSymboles;
        retourner TrouverSymboleNoeudSemantique(
            etat, noeudFonction->Parent);
    }

    naturel64 TrouverBaseSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        naturel64 recepteur = TrouverRecepteurSemantique(
            etat, indexReference);
        si (recepteur >= etat->NombreSymboles)
            retourner recepteur;
        constante NoeudDeclaration* typeClasse = &etat->Requete->Noeuds[
            etat->SymbolesTravail[recepteur].IndexNoeud];
        si (typeClasse->HachageType == 0) retourner etat->NombreSymboles;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1
                && (typeClasse->HachageType == candidat->HachageNom
                    || typeClasse->HachageType == HacherNomCompletSemantique(
                        etat, candidat->IndexNoeud)))
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    /**
     * <résumé>Délimite la portée d'une variable, y compris une branche sans bloc explicite.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST préordonné privé.
     * @Paramètre(naturel64: indexVariable) Déclaration locale déjà visitée.
     * @Paramètre(naturel64: indexReference) Référence ou déclaration à contrôler.
     * @Retourner(booléen) Vrai si la variable appartient encore à la portée active.
     * @etc. Une déclaration directement sous si/tantque reste visible dans son initialiseur, pas dans l'autre branche.
     **/
    booléen VariableLocaleVisibleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexVariable, naturel64 indexReference) {

        naturel64 portee = etat->Requete->Noeuds[indexVariable].Parent;
        si (portee < etat->Requete->NombreNoeuds
            && (etat->Requete->Noeuds[portee].Genre == 20 || etat->Requete->Noeuds[portee].Genre == 21))
            retourner EstAncetreSemantique(etat, indexVariable, indexReference);
        retourner EstAncetreSemantique(etat, portee, indexReference);
    }

    naturel64 TrouverVariableSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        naturel64 fonction = TrouverFonctionAncetreSemantique(
            etat, indexReference);
        naturel64 index = etat->NombreSymboles;
        tantque (index != 0) {
            index = index - 1;
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si ((candidat->IndexNoeud < indexReference
                    || (etat->ConstructeurChampActif < etat->Requete->NombreNoeuds
                        && candidat->Genre == 8))
                && candidat->HachageNom == reference->HachageNom) {
                si (candidat->Genre == 9
                    && TrouverFonctionAncetreSemantique(
                        etat, candidat->IndexNoeud) == fonction
                    && VariableLocaleVisibleSemantique(etat, candidat->IndexNoeud, indexReference))
                    retourner index;
                si (candidat->Genre == 8
                    && candidat->IndexPortee == fonction)
                    retourner index;
            }
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverDeclarationRacineSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        RechercheNomUtiliseSemantique recherche = RechercheDepuisNoeudUtiliseSemantique(etat, reference);
        ChercherNomUtiliseSemantique(etat, &recherche);
        si (recherche.Active) {
            si (recherche.Ambigue) {
                SignalerErreurSemantique(etat, ErreurAnalyseSemantique::NomImporteAmbigu, indexReference, 0);
                retourner etat->NombreSymboles;
            }
            naturel64 cible = recherche.Premier;
            si (cible < etat->NombreSymboles && etat->SymbolesTravail[cible].Genre == 4
                && etat->EtatsAliasesRacines[cible] == 2) cible = etat->CiblesAliasesRacines[cible];
            si (cible < etat->NombreSymboles && etat->SymbolesTravail[cible].Genre == 1) retourner etat->NombreSymboles;
            retourner cible;
        }
        /** <résumé>Avec des alias, le nom complet écrit précède la recherche relative, comme dans le bootstrap.</résumé> **/
        si (etat->NombreAliasesRacines != 0) {

            naturel32 passe = 0;
            tantque (passe < 2) {

                naturel64 indexRacine = 0;
                tantque (indexRacine < etat->NombreSymboles) {

                    SymboleSemantique* racine = &etat->SymbolesTravail[indexRacine];
                    booléen nomFonctionComplet = racine->Genre == 2
                        && reference->HachageNom == HacherNomDeclarationAliasSemantique(etat, racine);
                    booléen correspond = reference->HachageNom == HacherNomCompletSemantique(etat, racine->IndexNoeud);
                    si (nomFonctionComplet) correspond = vrai;
                    si (passe == 1) correspond = ReferenceCorrespondSymboleSemantique(etat, reference, racine);
                    si ((racine->IndexPortee == 0 || nomFonctionComplet) && correspond
                        && (racine->Genre == 2 || racine->Genre == 3 || racine->Genre == 4)) {

                        si (racine->Genre != 4) retourner indexRacine;
                        si (etat->EtatsAliasesRacines[indexRacine] == 2) {

                            naturel64 canonique = etat->CiblesAliasesRacines[indexRacine];
                            naturel32 genre = etat->SymbolesTravail[canonique].Genre;
                            si (genre == 2 || genre == 3) retourner canonique;
                        }
                        retourner etat->NombreSymboles;
                    }
                    indexRacine = indexRacine + 1;
                }
                passe = passe + 1;
            }
        }
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            booléen correspondance = candidat->Genre != 7
                && ReferenceCorrespondSymboleSemantique(
                    etat, reference, candidat);
            si (candidat->Genre == 7) {
                naturel64 indexEnumeration = etat->Requete->Noeuds[
                    candidat->IndexNoeud].Parent;
                si (indexEnumeration < etat->Requete->NombreNoeuds
                    && etat->Requete->Noeuds[indexEnumeration].Genre == 8) {
                    naturel64 nomEnumerateur = HacherNomCompletSemantique(
                        etat, indexEnumeration);
                    nomEnumerateur = AjouterOctetSemantique(
                        nomEnumerateur, 58);
                    nomEnumerateur = AjouterOctetSemantique(
                        nomEnumerateur, 58);
                    nomEnumerateur = AjouterNomNoeudSemantique(
                        etat, nomEnumerateur, candidat->IndexNoeud);
                    si (reference->HachageNom == nomEnumerateur)
                        correspondance = vrai;
                    si (!correspondance && reference->HachageEspace
                            == etat->Requete->Noeuds[indexEnumeration].HachageEspace) {

                        naturel64 nomRelatif = etat->Requete->Noeuds[indexEnumeration].HachageNom;
                        nomRelatif = AjouterOctetSemantique(nomRelatif, 58);
                        nomRelatif = AjouterOctetSemantique(nomRelatif, 58);
                        nomRelatif = AjouterNomNoeudSemantique(
                            etat, nomRelatif, candidat->IndexNoeud);
                        correspondance = reference->HachageNom == nomRelatif;
                    }
                }
            }
            si (candidat->Genre == 2 && reference->HachageNom == HacherNomDeclarationAliasSemantique(etat, candidat))
                correspondance = vrai;
            si ((candidat->IndexPortee == 0
                    || (candidat->Genre == 2
                        && reference->HachageNom == HacherNomDeclarationAliasSemantique(etat, candidat))
                    || candidat->Genre == 7)
                && (candidat->Genre == 2
                    || candidat->Genre == 3
                    || (candidat->Genre == 4 && etat->NombreAliasesRacines == 0)
                    || candidat->Genre == 7)
                && correspondance
                && (candidat->Genre != 7
                    || candidat->IndexNoeud < indexReference))
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverEnfantDirectSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexParent,
        naturel64 position) {
        naturel64 nombre = 0;
        naturel64 index = indexParent + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            si (etat->Requete->Noeuds[index].Parent == indexParent) {
                si (nombre == position) retourner index;
                nombre = nombre + 1;
            }
            index = index + 1;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    naturel64 CompterEnfantsDirectsSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexParent) {
        naturel64 nombre = 0;
        naturel64 index = indexParent + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            si (etat->Requete->Noeuds[index].Parent == indexParent)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 TrouverParametreFonctionSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexFonction,
        naturel64 position) {
        naturel64 nombre = 0;
        naturel64 index = indexFonction + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[index];
            si (noeud->Parent == indexFonction && noeud->Genre == 2) {
                si (nombre == position) retourner index;
                nombre = nombre + 1;
            }
            index = index + 1;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    naturel64 CompterParametresFonctionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexFonction) {
        naturel64 nombre = 0;
        naturel64 index = indexFonction + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[index];
            si (noeud->Parent == indexFonction && noeud->Genre == 2)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    /**
     * <résumé>Décrit le récepteur implicite d'une méthode comme une référence mutable vers sa classe déclarante.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Déclarations canoniques privées.
     * @Paramètre(naturel64: indexFonction) Nœud de la fonction ou méthode.
     * @Retourner(naturel64) Empreinte de Classe&, ou zéro pour une fonction libre.
     **/
    naturel64 HachageTypeRecepteurFonctionSemantique(EtatAnalyseSemantique* etat, naturel64 indexFonction) {

        si (indexFonction >= etat->Requete->NombreNoeuds) retourner 0;
        constante NoeudDeclaration* fonction = &etat->Requete->Noeuds[indexFonction];
        si (fonction->Genre < 12 || fonction->Genre > 15 || fonction->Parent == 0
            || etat->Requete->Noeuds[fonction->Parent].Genre != 6) retourner 0;
        retourner HacherTypeNommeSemantique(HacherNomCompletSemantique(etat, fonction->Parent), 4, 0);
    }

    /**
     * <résumé>Compte les paramètres de la signature non liée, sans ajouter de nœud de récepteur à l'AST public.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Déclarations privées.
     * @Paramètre(naturel64: indexFonction) Fonction libre ou méthode canonique.
     * @Retourner(naturel64) Paramètres explicites, plus le récepteur d'une méthode.
     **/
    naturel64 CompterParametresSignatureFonctionSemantique(EtatAnalyseSemantique* etat, naturel64 indexFonction) {

        naturel64 nombre = CompterParametresFonctionSemantique(etat, indexFonction);
        si (HachageTypeRecepteurFonctionSemantique(etat, indexFonction) != 0) nombre = nombre + 1;
        retourner nombre;
    }

    /**
     * <résumé>Lit un paramètre de la signature non liée, avec le récepteur implicite à la première position.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types canoniques privés de l'analyse.
     * @Paramètre(naturel64: indexFonction) Fonction libre ou méthode.
     * @Paramètre(naturel64: position) Position dans la signature non liée.
     * @Retourner(naturel64) Empreinte du type canonique, ou zéro hors de la signature.
     * @etc. Le récepteur d'une méthode se compare comme un paramètre explicite Classe& d'une fonction libre.
     **/
    naturel64 HachageTypeParametreSignatureFonctionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexFonction, naturel64 position) {

        si (indexFonction >= etat->Requete->NombreNoeuds) retourner 0;
        naturel64 recepteur = HachageTypeRecepteurFonctionSemantique(etat, indexFonction);
        si (recepteur != 0) {

            si (position == 0) retourner recepteur;
            position = position - 1;
        }
        naturel64 parametre = TrouverParametreFonctionSemantique(etat, indexFonction, position);
        si (parametre >= etat->Requete->NombreNoeuds) retourner 0;
        retourner etat->Requete->Noeuds[parametre].HachageType;
    }

    naturel64 TrouverTypeDepuisHachageSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachageType,
        naturel32 niveauPointeur) {
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1) {
                naturel64 nomSimple = candidat->HachageNom;
                naturel64 nomComplet = HacherNomCompletSemantique(
                    etat, candidat->IndexNoeud);
                si (etat->EspacesJetonsTypes != NulCiblesExpressionsSemantiques) nomSimple = nomComplet;
                naturel32 qualificatifs = 0;
                tantque (qualificatifs < 8) {
                    si (hachageType == HacherTypeNommeSemantique(
                            nomSimple, qualificatifs, niveauPointeur)
                        || hachageType == HacherTypeNommeSemantique(
                            nomComplet, qualificatifs, niveauPointeur))
                        retourner index;
                    qualificatifs = qualificatifs + 1;
                }
            }
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 HachageElementFinalTableauSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        DescriptionHachageTypeSemantique dimensions;
        si (!LireDimensionsNoeudSemantique(
                etat,
                indexNoeud,
                &dimensions))
            retourner 0;
        naturel64 hachageType = etat->Requete->Noeuds[
            indexNoeud].HachageType;

        DescriptionTypeJetonsSemantique typeElement;
        si (LireTypeNoeudSemantique(etat, indexNoeud, &typeElement))
            retourner typeElement.HachageType;

        naturel32 genre = 1;
        tantque (genre <= 12) {
            naturel32 qualificatifs = 0;
            tantque (qualificatifs < 8) {
                naturel32 pointeurs = 0;
                tantque (pointeurs <= 2) {
                    si (hachageType == HacherTypeTableauSimpleSemantique(
                            genre,
                            qualificatifs,
                            pointeurs,
                            &dimensions))
                        retourner HacherTypeSimpleSemantique(
                            genre, qualificatifs, pointeurs);
                    pointeurs = pointeurs + 1;
                }
                qualificatifs = qualificatifs + 1;
            }
            genre = genre + 1;
        }

        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1) {
                naturel64 nomSimple = candidat->HachageNom;
                naturel64 nomComplet = HacherNomCompletSemantique(
                    etat, candidat->IndexNoeud);
                naturel32 qualificatifsNommes = 0;
                tantque (qualificatifsNommes < 8) {
                    naturel32 pointeursNommes = 0;
                    tantque (pointeursNommes <= 2) {
                        si (hachageType == HacherTypeTableauNommeSemantique(
                                nomSimple,
                                qualificatifsNommes,
                                pointeursNommes,
                                &dimensions))
                            retourner HacherTypeNommeSemantique(
                                nomSimple,
                                qualificatifsNommes,
                                pointeursNommes);
                        si (hachageType == HacherTypeTableauNommeSemantique(
                                nomComplet,
                                qualificatifsNommes,
                                pointeursNommes,
                                &dimensions))
                            retourner HacherTypeNommeSemantique(
                                nomComplet,
                                qualificatifsNommes,
                                pointeursNommes);
                        pointeursNommes = pointeursNommes + 1;
                    }
                    qualificatifsNommes = qualificatifsNommes + 1;
                }
            }
            index = index + 1;
        }
        retourner 0;
    }

    naturel64 TrouverTypeElementFinalTableauSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        naturel64 hachageElement = HachageElementFinalTableauSemantique(
            etat, indexNoeud);
        si (hachageElement == 0) retourner etat->NombreSymboles;
        retourner TrouverTypeDepuisHachageSemantique(
            etat, hachageElement, 0);
    }

    /**
     * <résumé>Reconnaît constante ou volatile dans une empreinte de type privée.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types nommés et signatures composées.
     * @Paramètre(naturel64: hachageType) Type à reconnaître sans modifier sa signature.
     * @Paramètre(naturel32: masque) Bit constante ou volatile recherché.
     * @Retourner(booléen) Vrai si le qualificateur recherché est présent.
     **/
    booléen EstTypeQualifieSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType, naturel32 masque) {
        naturel32 genre = 1;
        tantque (genre <= 12) {
            naturel32 qualificatifs = 1;
            tantque (qualificatifs < 8) {
                si ((qualificatifs & masque) != 0) {
                    naturel32 pointeurs = 0;
                    tantque (pointeurs <= 2) {
                        si (hachageType == HacherTypeSimpleSemantique(
                                genre, qualificatifs, pointeurs))
                            retourner vrai;
                        pointeurs = pointeurs + 1;
                    }
                }
                qualificatifs = qualificatifs + 1;
            }
            genre = genre + 1;
        }

        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1) {
                naturel64 nomSimple = candidat->HachageNom;
                naturel64 nomComplet = HacherNomCompletSemantique(
                    etat, candidat->IndexNoeud);
                naturel32 qualificatifsNommes = 1;
                tantque (qualificatifsNommes < 8) {
                    si ((qualificatifsNommes & masque) != 0) {
                        naturel32 pointeursNommes = 0;
                        tantque (pointeursNommes <= 2) {
                            si (hachageType == HacherTypeNommeSemantique(
                                    nomSimple,
                                    qualificatifsNommes,
                                    pointeursNommes)
                                || hachageType == HacherTypeNommeSemantique(
                                    nomComplet,
                                    qualificatifsNommes,
                                    pointeursNommes))
                                retourner vrai;
                            pointeursNommes = pointeursNommes + 1;
                        }
                    }
                    qualificatifsNommes = qualificatifsNommes + 1;
                }
            }
            index = index + 1;
        }
        DescriptionTypeJetonsSemantique typeCompose;
        retourner DecrireTypeComposeSemantique(etat, hachageType, &typeCompose)
            && (typeCompose.Qualificatifs & masque) != 0;
    }

    booléen EstTypeConstantSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType) {

        retourner EstTypeQualifieSemantique(etat, hachageType, 1);
    }

    naturel64 SansReferenceTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType) {
        naturel32 genre = 1;
        tantque (genre <= 12) {
            naturel32 qualificatifs = 0;
            tantque (qualificatifs < 4) {
                naturel32 pointeurs = 0;
                tantque (pointeurs <= 2) {
                    si (hachageType == HacherTypeSimpleSemantique(
                            genre, qualificatifs | 4, pointeurs))
                        retourner HacherTypeSimpleSemantique(
                            genre, qualificatifs, pointeurs);
                    pointeurs = pointeurs + 1;
                }
                qualificatifs = qualificatifs + 1;
            }
            genre = genre + 1;
        }

        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1) {
                naturel64 nomSimple = candidat->HachageNom;
                naturel64 nomComplet = HacherNomCompletSemantique(
                    etat, candidat->IndexNoeud);
                naturel32 qualificatifsNommes = 0;
                tantque (qualificatifsNommes < 4) {
                    naturel32 pointeursNommes = 0;
                    tantque (pointeursNommes <= 2) {
                        si (hachageType == HacherTypeNommeSemantique(
                                nomSimple,
                                qualificatifsNommes | 4,
                                pointeursNommes))
                            retourner HacherTypeNommeSemantique(
                                nomSimple,
                                qualificatifsNommes,
                                pointeursNommes);
                        si (hachageType == HacherTypeNommeSemantique(
                                nomComplet,
                                qualificatifsNommes | 4,
                                pointeursNommes))
                            retourner HacherTypeNommeSemantique(
                                nomComplet,
                                qualificatifsNommes,
                                pointeursNommes);
                        pointeursNommes = pointeursNommes + 1;
                    }
                    qualificatifsNommes = qualificatifsNommes + 1;
                }
            }
            index = index + 1;
        }
        DescriptionTypeJetonsSemantique typeCompose;
        si (DecrireTypeComposeSemantique(etat, hachageType, &typeCompose)) {

            typeCompose.Qualificatifs = typeCompose.Qualificatifs & 3;
            retourner HacherDescriptionTypeJetonsSemantique(&typeCompose);
        }
        retourner hachageType;
    }

    naturel64 SansQualificatifsValeurSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType) {
        naturel32 genre = 1;
        tantque (genre <= 12) {
            naturel32 qualificatifs = 0;
            tantque (qualificatifs < 4) {
                naturel32 pointeurs = 0;
                tantque (pointeurs <= 2) {
                    si (hachageType == HacherTypeSimpleSemantique(
                            genre, qualificatifs, pointeurs))
                        retourner HacherTypeSimpleSemantique(
                            genre, 0, pointeurs);
                    pointeurs = pointeurs + 1;
                }
                qualificatifs = qualificatifs + 1;
            }
            genre = genre + 1;
        }

        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1) {
                naturel64 nomSimple = candidat->HachageNom;
                naturel64 nomComplet = HacherNomCompletSemantique(
                    etat, candidat->IndexNoeud);
                naturel32 qualificatifsNommes = 0;
                tantque (qualificatifsNommes < 4) {
                    naturel32 pointeursNommes = 0;
                    tantque (pointeursNommes <= 2) {
                        si (hachageType == HacherTypeNommeSemantique(
                                nomSimple,
                                qualificatifsNommes,
                                pointeursNommes))
                            retourner HacherTypeNommeSemantique(
                                nomSimple, 0, pointeursNommes);
                        si (hachageType == HacherTypeNommeSemantique(
                                nomComplet,
                                qualificatifsNommes,
                                pointeursNommes))
                            retourner HacherTypeNommeSemantique(
                                nomComplet, 0, pointeursNommes);
                        pointeursNommes = pointeursNommes + 1;
                    }
                    qualificatifsNommes = qualificatifsNommes + 1;
                }
            }
            index = index + 1;
        }
        DescriptionTypeJetonsSemantique typeCompose;
        si (DecrireTypeComposeSemantique(etat, hachageType, &typeCompose)) {

            typeCompose.Qualificatifs = typeCompose.Qualificatifs & 4;
            retourner HacherDescriptionTypeJetonsSemantique(&typeCompose);
        }
        retourner hachageType;
    }

    booléen EstTypeAdresseSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType) {
        naturel32 genre = 1;
        tantque (genre <= 12) {
            naturel32 qualificatifs = 0;
            tantque (qualificatifs < 4) {
                naturel32 pointeurs = 1;
                tantque (pointeurs <= 2) {
                    si (hachageType == HacherTypeSimpleSemantique(
                            genre, qualificatifs, pointeurs))
                        retourner vrai;
                    pointeurs = pointeurs + 1;
                }
                qualificatifs = qualificatifs + 1;
            }
            genre = genre + 1;
        }

        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1) {
                naturel64 nomSimple = candidat->HachageNom;
                naturel64 nomComplet = HacherNomCompletSemantique(
                    etat, candidat->IndexNoeud);
                naturel32 qualificatifsNommes = 0;
                tantque (qualificatifsNommes < 4) {
                    naturel32 pointeursNommes = 1;
                    tantque (pointeursNommes <= 2) {
                        si (hachageType == HacherTypeNommeSemantique(
                                nomSimple,
                                qualificatifsNommes,
                                pointeursNommes)
                            || hachageType == HacherTypeNommeSemantique(
                                nomComplet,
                                qualificatifsNommes,
                                pointeursNommes))
                            retourner vrai;
                        pointeursNommes = pointeursNommes + 1;
                    }
                    qualificatifsNommes = qualificatifsNommes + 1;
                }
            }
            index = index + 1;
        }
        DescriptionTypeJetonsSemantique typeCompose;
        retourner DecrireTypeComposeSemantique(etat, hachageType, &typeCompose)
            && (typeCompose.Qualificatifs & 4) == 0
            && (typeCompose.NiveauPointeur != 0 || typeCompose.Genre == 14);
    }

    booléen TypesValeurEgauxSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 gauche,
        naturel64 droite) {
        si (EstTypeAdresseSemantique(etat, gauche)
            || EstTypeAdresseSemantique(etat, droite))
            retourner gauche == droite;
        si (SansQualificatifsValeurSemantique(etat, gauche)
            == SansQualificatifsValeurSemantique(etat, droite))
            retourner vrai;
        naturel64 typeGauche = TrouverTypeDepuisHachageSemantique(etat, gauche, 0);
        retourner typeGauche < etat->NombreSymboles
            && typeGauche == TrouverTypeDepuisHachageSemantique(etat, droite, 0);
    }

    booléen EstTypeScalaireSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType) {
        naturel32 genre = 1;
        tantque (genre <= 12) {
            naturel32 qualificatifs = 0;
            tantque (qualificatifs < 4) {
                naturel32 pointeurs = 0;
                tantque (pointeurs <= 2) {
                    si ((genre <= 11 || pointeurs != 0)
                        && hachageType == HacherTypeSimpleSemantique(
                            genre, qualificatifs, pointeurs))
                        retourner vrai;
                    pointeurs = pointeurs + 1;
                }
                qualificatifs = qualificatifs + 1;
            }
            genre = genre + 1;
        }

        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1) {
                naturel64 nomSimple = candidat->HachageNom;
                naturel64 nomComplet = HacherNomCompletSemantique(
                    etat, candidat->IndexNoeud);
                naturel32 qualificatifsNommes = 0;
                tantque (qualificatifsNommes < 4) {
                    naturel32 pointeursNommes = 0;
                    tantque (pointeursNommes <= 2) {
                        booléen typeEnumeration = etat->Requete->Noeuds[
                            candidat->IndexNoeud].Genre == 8;
                        si ((typeEnumeration || pointeursNommes != 0)
                            && (hachageType == HacherTypeNommeSemantique(
                                    nomSimple,
                                    qualificatifsNommes,
                                    pointeursNommes)
                                || hachageType == HacherTypeNommeSemantique(
                                    nomComplet,
                                    qualificatifsNommes,
                                    pointeursNommes)))
                            retourner vrai;
                        pointeursNommes = pointeursNommes + 1;
                    }
                    qualificatifsNommes = qualificatifsNommes + 1;
                }
            }
            index = index + 1;
        }
        DescriptionTypeJetonsSemantique typeCompose;
        retourner DecrireTypeComposeSemantique(etat, hachageType, &typeCompose)
            && (typeCompose.Qualificatifs & 4) == 0
            && (typeCompose.NiveauPointeur != 0 || typeCompose.Genre == 14);
    }

    booléen EstTypeReferenceSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType) {
        retourner SansReferenceTypeSemantique(etat, hachageType)
            != hachageType;
    }

    naturel64 TrouverSymboleNoeudSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel32 genreSymbole) {
        naturel64 indexSymboleNoeud = 0;
        tantque (indexSymboleNoeud < etat->NombreSymboles) {
            SymboleSemantique* symboleNoeud =
                &etat->SymbolesTravail[indexSymboleNoeud];
            si (symboleNoeud->IndexNoeud == indexNoeud
                && symboleNoeud->Genre == genreSymbole)
                retourner indexSymboleNoeud;
            indexSymboleNoeud = indexSymboleNoeud + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 HacherSignatureFonctionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexFonction) {
        si (indexFonction >= etat->Requete->NombreNoeuds)
            retourner 0;
        naturel64 signatureFonction = AjouterNaturel64Semantique(
            HachageVideSemantique(),
            etat->Requete->Noeuds[indexFonction].HachageType);
        naturel32 nombreParametresSignature = 0;
        naturel64 typeRecepteurSignature = HachageTypeRecepteurFonctionSemantique(etat, indexFonction);
        si (typeRecepteurSignature != 0) {

            signatureFonction = AjouterNaturel64Semantique(signatureFonction, typeRecepteurSignature);
            nombreParametresSignature = 1;
        }
        naturel64 indexParametreSignature = indexFonction + 1;
        tantque (indexParametreSignature < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* parametreSignature =
                &etat->Requete->Noeuds[indexParametreSignature];
            si (parametreSignature->Parent == indexFonction
                && parametreSignature->Genre == 2) {
                signatureFonction = AjouterNaturel64Semantique(
                    signatureFonction,
                    parametreSignature->HachageType);
                nombreParametresSignature = nombreParametresSignature + 1;
            }
            indexParametreSignature = indexParametreSignature + 1;
        }
        retourner AjouterNaturel32Semantique(
            signatureFonction, nombreParametresSignature);
    }

    naturel64 HacherPointeurFonctionSemantique(
        naturel64 hachageSignature,
        naturel32 qualificatifs,
        naturel32 niveauPointeur,
        DescriptionHachageTypeSemantique* dimensions) {
        DescriptionHachageTypeSemantique descriptionFonction = {
            dimensions->NombreDimensions,
            0,
            hachageSignature,
            dimensions->HachageDimensions};
        retourner HacherTypeCompletSemantique(
            14,
            qualificatifs,
            niveauPointeur,
            &descriptionFonction);
    }

    naturel64 HacherPointeurFonctionDeclarationSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexFonction) {
        naturel64 signatureDeclarationFonction =
            HacherSignatureFonctionSemantique(etat, indexFonction);
        si (signatureDeclarationFonction == 0) retourner 0;
        DescriptionHachageTypeSemantique dimensionsDeclarationFonction = {
            0,
            0,
            HachageVideSemantique(),
            HachageVideSemantique()};
        retourner HacherPointeurFonctionSemantique(
            signatureDeclarationFonction,
            0,
            0,
            &dimensionsDeclarationFonction);
    }

    naturel64 TrouverCibleSymboleExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds
            || etat->CiblesExpressions == NulCiblesExpressionsSemantiques)
            retourner etat->NombreSymboles;
        naturel64 cibleSymboleExpression =
            etat->CiblesExpressions[indexExpression];
        si (cibleSymboleExpression >= etat->NombreSymboles)
            retourner etat->NombreSymboles;
        retourner cibleSymboleExpression;
    }

    externe naturel64 TrouverOrigineTypeExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression);

    naturel64 TrouverOrigineTypeExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner etat->Requete->NombreNoeuds;
        constante NoeudDeclaration* expressionOrigine =
            &etat->Requete->Noeuds[indexExpression];
        si (expressionOrigine->Genre == 31)
            retourner indexExpression;
        si (expressionOrigine->Genre == 24
            || expressionOrigine->Genre == 29) {
            naturel64 cibleOrigine = TrouverCibleSymboleExpressionSemantique(
                etat, indexExpression);
            si (cibleOrigine < etat->NombreSymboles)
                retourner etat->SymbolesTravail[cibleOrigine].IndexNoeud;
            retourner etat->Requete->NombreNoeuds;
        }
        si (expressionOrigine->Genre == 25
            || expressionOrigine->Genre == 26
            || expressionOrigine->Genre == 27
            || expressionOrigine->Genre == 30) {
            naturel64 enfantOrigine = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner TrouverOrigineTypeExpressionSemantique(
                etat, enfantOrigine);
        }
        si (expressionOrigine->Genre == 28) {
            naturel64 cibleAppelOrigine = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            naturel64 symboleAppelOrigine =
                TrouverCibleSymboleExpressionSemantique(
                    etat, cibleAppelOrigine);
            si (symboleAppelOrigine < etat->NombreSymboles
                && etat->SymbolesTravail[symboleAppelOrigine].Genre == 2)
                retourner etat->SymbolesTravail[
                    symboleAppelOrigine].IndexNoeud;
            retourner TrouverOrigineTypeExpressionSemantique(
                etat, cibleAppelOrigine);
        }
        retourner etat->Requete->NombreNoeuds;
    }

    naturel64 TransformerPointeurSimpleSemantique(
        naturel64 hachageType,
        booléen ajouter) {
        naturel32 genreTransformationSimple = 1;
        tantque (genreTransformationSimple <= 12) {
            naturel32 qualificatifsTransformationSimple = 0;
            tantque (qualificatifsTransformationSimple < 8) {
                naturel32 pointeursTransformationSimple = 0;
                tantque (pointeursTransformationSimple <= 4) {
                    si (hachageType == HacherTypeSimpleSemantique(
                            genreTransformationSimple,
                            qualificatifsTransformationSimple,
                            pointeursTransformationSimple)) {
                        si (ajouter)
                            retourner HacherTypeSimpleSemantique(
                                genreTransformationSimple,
                                qualificatifsTransformationSimple,
                                pointeursTransformationSimple + 1);
                        si (pointeursTransformationSimple != 0)
                            retourner HacherTypeSimpleSemantique(
                                genreTransformationSimple,
                                qualificatifsTransformationSimple,
                                pointeursTransformationSimple - 1);
                        retourner 0;
                    }
                    pointeursTransformationSimple =
                        pointeursTransformationSimple + 1;
                }
                qualificatifsTransformationSimple =
                    qualificatifsTransformationSimple + 1;
            }
            genreTransformationSimple = genreTransformationSimple + 1;
        }
        retourner 0;
    }

    naturel64 TransformerPointeurNommeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachageType,
        booléen ajouter) {
        naturel64 indexTypeTransformationNommee = 0;
        tantque (indexTypeTransformationNommee < etat->NombreSymboles) {
            SymboleSemantique* typeTransformationNommee =
                &etat->SymbolesTravail[indexTypeTransformationNommee];
            si (typeTransformationNommee->Genre == 1) {
                naturel64 nomSimpleTransformation =
                    typeTransformationNommee->HachageNom;
                naturel64 nomCompletTransformation =
                    HacherNomCompletSemantique(
                        etat, typeTransformationNommee->IndexNoeud);
                naturel32 qualificatifsTransformationNommee = 0;
                tantque (qualificatifsTransformationNommee < 8) {
                    naturel32 pointeursTransformationNommee = 0;
                    tantque (pointeursTransformationNommee <= 4) {
                        naturel64 nomTransformationCourant =
                            nomSimpleTransformation;
                        naturel32 varianteNomTransformation = 0;
                        tantque (varianteNomTransformation < 2) {
                            si (hachageType == HacherTypeNommeSemantique(
                                    nomTransformationCourant,
                                    qualificatifsTransformationNommee,
                                    pointeursTransformationNommee)) {
                                si (ajouter)
                                    retourner HacherTypeNommeSemantique(
                                        nomTransformationCourant,
                                        qualificatifsTransformationNommee,
                                        pointeursTransformationNommee + 1);
                                si (pointeursTransformationNommee != 0)
                                    retourner HacherTypeNommeSemantique(
                                        nomTransformationCourant,
                                        qualificatifsTransformationNommee,
                                        pointeursTransformationNommee - 1);
                                retourner 0;
                            }
                            nomTransformationCourant =
                                nomCompletTransformation;
                            varianteNomTransformation =
                                varianteNomTransformation + 1;
                        }
                        pointeursTransformationNommee =
                            pointeursTransformationNommee + 1;
                    }
                    qualificatifsTransformationNommee =
                        qualificatifsTransformationNommee + 1;
                }
            }
            indexTypeTransformationNommee =
                indexTypeTransformationNommee + 1;
        }
        retourner 0;
    }

    naturel64 TransformerPointeurFonctionTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachageType,
        naturel64 indexOrigine,
        booléen ajouter) {
        DescriptionHachageTypeSemantique dimensionsFonctionTransformation = {
            0,
            0,
            HachageVideSemantique(),
            HachageVideSemantique()};
        DescriptionTypeJetonsSemantique typeFonctionTransformation;
        booléen origineTypeFonction = LireTypePointeurFonctionNoeudSemantique(
            etat, indexOrigine, &typeFonctionTransformation);
        naturel64 signatureTransformationFonction = 0;
        naturel32 qualificatifsTransformationFonction = 0;
        naturel32 pointeursTransformationFonction = 0;
        si (origineTypeFonction) {
            signatureTransformationFonction =
                typeFonctionTransformation.HachageNom;
            qualificatifsTransformationFonction =
                typeFonctionTransformation.Qualificatifs;
            pointeursTransformationFonction =
                typeFonctionTransformation.NiveauPointeur;
        }
        sinon si (TrouverSymboleNoeudSemantique(
                etat, indexOrigine, 2) < etat->NombreSymboles) {
            signatureTransformationFonction =
                HacherSignatureFonctionSemantique(etat, indexOrigine);
        }
        sinon retourner 0;

        naturel64 typeFonctionOrigine = HacherPointeurFonctionSemantique(
            signatureTransformationFonction,
            qualificatifsTransformationFonction,
            pointeursTransformationFonction,
            &dimensionsFonctionTransformation);
        si (hachageType != typeFonctionOrigine) retourner 0;
        si (ajouter)
            pointeursTransformationFonction =
                pointeursTransformationFonction + 1;
        sinon si (pointeursTransformationFonction != 0)
            pointeursTransformationFonction =
                pointeursTransformationFonction - 1;
        sinon retourner hachageType;
        retourner HacherPointeurFonctionSemantique(
            signatureTransformationFonction,
            qualificatifsTransformationFonction,
            pointeursTransformationFonction,
            &dimensionsFonctionTransformation);
    }

    naturel64 TransformerPointeurTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachageType,
        naturel64 indexOrigine,
        booléen ajouter) {
        DescriptionTypeJetonsSemantique typeCompose;
        si (DecrireTypeComposeSemantique(etat, hachageType, &typeCompose)) {

            si (ajouter) typeCompose.NiveauPointeur = typeCompose.NiveauPointeur + 1;
            sinon si (typeCompose.NiveauPointeur != 0)
                typeCompose.NiveauPointeur = typeCompose.NiveauPointeur - 1;
            sinon si (typeCompose.Genre != 14) retourner 0;
            retourner HacherDescriptionTypeJetonsSemantique(&typeCompose);
        }
        naturel64 transformationSimple = TransformerPointeurSimpleSemantique(
            hachageType, ajouter);
        si (transformationSimple != 0) retourner transformationSimple;
        naturel64 transformationNommee = TransformerPointeurNommeSemantique(
            etat, hachageType, ajouter);
        si (transformationNommee != 0) retourner transformationNommee;
        retourner TransformerPointeurFonctionTypeSemantique(
            etat, hachageType, indexOrigine, ajouter);
    }

    booléen LireDimensionsRestantesSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel32 nombreIgnore,
        DescriptionHachageTypeSemantique* description) {
        DescriptionHachageTypeSemantique dimensionsCompletesRestantes;
        si (!LireDimensionsNoeudSemantique(
                etat, indexNoeud, &dimensionsCompletesRestantes))
            retourner faux;
        description->NombreDimensions = 0;
        description->Reserve = 0;
        description->HachageNom = HachageVideSemantique();
        description->HachageDimensions = HachageVideSemantique();
        naturel32 indexDimensionRestante = nombreIgnore;
        tantque (indexDimensionRestante
            < dimensionsCompletesRestantes.NombreDimensions) {
            naturel64 valeurDimensionRestante = 0;
            si (!LireDimensionNoeudSemantique(
                    etat,
                    indexNoeud,
                    indexDimensionRestante,
                    &valeurDimensionRestante))
                retourner faux;
            description->HachageDimensions = AjouterNaturel64Semantique(
                description->HachageDimensions,
                valeurDimensionRestante);
            description->NombreDimensions =
                description->NombreDimensions + 1;
            indexDimensionRestante = indexDimensionRestante + 1;
        }
        retourner vrai;
    }

    booléen LireDescriptionPointeurFonctionNoeudSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel64 hachagePointeurFonction,
        DescriptionTypeJetonsSemantique* description) {
        si (DecrireTypeComposeSemantique(etat, hachagePointeurFonction, description))
            retourner description->Genre == 14 && (description->Qualificatifs & 4) == 0;
        si (indexNoeud >= etat->Requete->NombreNoeuds
            || etat->JetonsTypes == NulJetonsTypesSemantiques)
            retourner faux;
        constante NoeudDeclaration* noeudPointeurFonction =
            &etat->Requete->Noeuds[indexNoeud];
        naturel64 indexNomPointeurFonction = 0;
        naturel64 debutPointeurFonction = 0;
        si (noeudPointeurFonction->Genre == 31) {

            DescriptionTypeJetonsSemantique cibleConversion;
            si (!LireTypeConversionSemantique(etat, indexNoeud, &cibleConversion)
                || cibleConversion.Genre != 14)
                retourner faux;
            debutPointeurFonction = cibleConversion.DebutType;
            CurseurTypeJetonsSemantique finConversion = {cibleConversion.DebutType, faux};
            si (!AnalyserTypeJetonsSemantique(etat, &finConversion, &cibleConversion))
                retourner faux;
            indexNomPointeurFonction = finConversion.Index;
        }
        sinon {

            tantque (indexNomPointeurFonction < etat->NombreJetonsTypes
                && etat->JetonsTypes[indexNomPointeurFonction].Debut
                    != noeudPointeurFonction->DebutNom)
                indexNomPointeurFonction = indexNomPointeurFonction + 1;
            si (indexNomPointeurFonction >= etat->NombreJetonsTypes)
                retourner faux;
        }

        tantque (debutPointeurFonction < indexNomPointeurFonction) {
            naturel32 genreDebutPointeur =
                etat->JetonsTypes[debutPointeurFonction].Genre;
            si (genreDebutPointeur == 26
                || genreDebutPointeur == 12
                || genreDebutPointeur == 13) {
                CurseurTypeJetonsSemantique curseurPointeurFonction = {
                    debutPointeurFonction, faux};
                DescriptionTypeJetonsSemantique typePointeurFonctionLu;
                si (AnalyserTypeJetonsSemantique(
                        etat,
                        &curseurPointeurFonction,
                        &typePointeurFonctionLu)
                    && typePointeurFonctionLu.Genre == 14) {
                    naturel32 niveauPointeurCourant = 0;
                    tantque (niveauPointeurCourant <= 4) {
                        DescriptionTypeJetonsSemantique typeCourant =
                            typePointeurFonctionLu;
                        typeCourant.NiveauPointeur = niveauPointeurCourant;
                        typeCourant.Qualificatifs =
                            typeCourant.Qualificatifs & 3;
                        typeCourant.HachageType =
                            HacherDescriptionTypeJetonsSemantique(&typeCourant);
                        si (typeCourant.HachageType
                            == hachagePointeurFonction) {
                            typeCourant.DebutType =
                                debutPointeurFonction;
                            *description = typeCourant;
                            retourner vrai;
                        }
                        niveauPointeurCourant = niveauPointeurCourant + 1;
                    }
                }
            }
            debutPointeurFonction = debutPointeurFonction + 1;
        }
        retourner faux;
    }

    booléen LireRetourPointeurFonctionNoeudSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel64 hachagePointeurFonction,
        naturel64* hachageRetour) {
        DescriptionTypeJetonsSemantique descriptionPointeurFonction;
        si (!LireDescriptionPointeurFonctionNoeudSemantique(
                etat,
                indexNoeud,
                hachagePointeurFonction,
                &descriptionPointeurFonction))
            retourner faux;
        *hachageRetour = descriptionPointeurFonction.HachageRetourFonction;
        retourner vrai;
    }

    externe naturel64 HachageTypeExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression);

    naturel64 HachageTypeIndexationSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        naturel64 courantIndexation = indexExpression;
        naturel32 profondeurIndexation = 0;
        tantque (courantIndexation < etat->Requete->NombreNoeuds
            && etat->Requete->Noeuds[courantIndexation].Genre == 30) {
            profondeurIndexation = profondeurIndexation + 1;
            courantIndexation = TrouverEnfantDirectSemantique(
                etat, courantIndexation, 0);
        }
        naturel64 origineIndexation = TrouverOrigineTypeExpressionSemantique(
            etat, indexExpression);
        si (origineIndexation < etat->Requete->NombreNoeuds) {
            DescriptionHachageTypeSemantique dimensionsIndexationCompletes;
            si (LireDimensionsNoeudSemantique(
                    etat,
                    origineIndexation,
                    &dimensionsIndexationCompletes)
                && profondeurIndexation
                    <= dimensionsIndexationCompletes.NombreDimensions) {
                DescriptionHachageTypeSemantique dimensionsIndexationRestantes;
                si (!LireDimensionsRestantesSemantique(
                        etat,
                        origineIndexation,
                        profondeurIndexation,
                        &dimensionsIndexationRestantes))
                    retourner 0;
                naturel64 typeTableauOrigine = etat->Requete->Noeuds[
                    origineIndexation].HachageType;

                DescriptionTypeJetonsSemantique typeElementIndexe;
                si (LireTypeNoeudSemantique(
                        etat, origineIndexation, &typeElementIndexe)) {
                    dimensionsIndexationCompletes.HachageNom =
                        typeElementIndexe.HachageNom;
                    si (typeTableauOrigine == HacherTypeCompletSemantique(
                            typeElementIndexe.Genre,
                            typeElementIndexe.Qualificatifs,
                            typeElementIndexe.NiveauPointeur,
                            &dimensionsIndexationCompletes)) {
                        dimensionsIndexationRestantes.HachageNom =
                            typeElementIndexe.HachageNom;
                        retourner HacherTypeCompletSemantique(
                            typeElementIndexe.Genre,
                            typeElementIndexe.Qualificatifs,
                            typeElementIndexe.NiveauPointeur,
                            &dimensionsIndexationRestantes);
                    }
                    dimensionsIndexationCompletes.HachageNom = HachageVideSemantique();
                }

                naturel32 genreTableauIndexe = 1;
                tantque (genreTableauIndexe <= 12) {
                    naturel32 qualificatifsTableauIndexe = 0;
                    tantque (qualificatifsTableauIndexe < 8) {
                        naturel32 pointeursTableauIndexe = 0;
                        tantque (pointeursTableauIndexe <= 4) {
                            si (typeTableauOrigine
                                == HacherTypeTableauSimpleSemantique(
                                    genreTableauIndexe,
                                    qualificatifsTableauIndexe,
                                    pointeursTableauIndexe,
                                    &dimensionsIndexationCompletes))
                                retourner HacherTypeTableauSimpleSemantique(
                                    genreTableauIndexe,
                                    qualificatifsTableauIndexe,
                                    pointeursTableauIndexe,
                                    &dimensionsIndexationRestantes);
                            pointeursTableauIndexe =
                                pointeursTableauIndexe + 1;
                        }
                        qualificatifsTableauIndexe =
                            qualificatifsTableauIndexe + 1;
                    }
                    genreTableauIndexe = genreTableauIndexe + 1;
                }

                naturel64 symboleTypeTableauIndexe = 0;
                tantque (symboleTypeTableauIndexe < etat->NombreSymboles) {
                    SymboleSemantique* typeTableauIndexe =
                        &etat->SymbolesTravail[symboleTypeTableauIndexe];
                    si (typeTableauIndexe->Genre == 1) {
                        naturel64 nomsTypeTableau[2] = {
                            typeTableauIndexe->HachageNom,
                            HacherNomCompletSemantique(
                                etat, typeTableauIndexe->IndexNoeud)};
                        naturel32 varianteTypeTableau = 0;
                        tantque (varianteTypeTableau < 2) {
                            naturel32 qualificatifsTypeTableau = 0;
                            tantque (qualificatifsTypeTableau < 8) {
                                naturel32 pointeursTypeTableau = 0;
                                tantque (pointeursTypeTableau <= 4) {
                                    si (typeTableauOrigine
                                        == HacherTypeTableauNommeSemantique(
                                            nomsTypeTableau[varianteTypeTableau],
                                            qualificatifsTypeTableau,
                                            pointeursTypeTableau,
                                            &dimensionsIndexationCompletes))
                                        retourner HacherTypeTableauNommeSemantique(
                                            nomsTypeTableau[varianteTypeTableau],
                                            qualificatifsTypeTableau,
                                            pointeursTypeTableau,
                                            &dimensionsIndexationRestantes);
                                    pointeursTypeTableau =
                                        pointeursTypeTableau + 1;
                                }
                                qualificatifsTypeTableau =
                                    qualificatifsTypeTableau + 1;
                            }
                            varianteTypeTableau = varianteTypeTableau + 1;
                        }
                    }
                    symboleTypeTableauIndexe =
                        symboleTypeTableauIndexe + 1;
                }

                DescriptionTypeJetonsSemantique typeFonctionTableauIndexe;
                si (LireTypePointeurFonctionNoeudSemantique(
                        etat,
                        origineIndexation,
                        &typeFonctionTableauIndexe)) {
                    naturel64 typeFonctionTableauOrigine =
                        HacherPointeurFonctionSemantique(
                            typeFonctionTableauIndexe.HachageNom,
                            typeFonctionTableauIndexe.Qualificatifs,
                            typeFonctionTableauIndexe.NiveauPointeur,
                            &dimensionsIndexationCompletes);
                    si (typeTableauOrigine == typeFonctionTableauOrigine)
                        retourner HacherPointeurFonctionSemantique(
                            typeFonctionTableauIndexe.HachageNom,
                            typeFonctionTableauIndexe.Qualificatifs,
                            typeFonctionTableauIndexe.NiveauPointeur,
                            &dimensionsIndexationRestantes);
                }
            }
        }

        naturel64 objetIndexation = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 typeObjetIndexation = HachageTypeExpressionSemantique(
            etat, objetIndexation);
        retourner TransformerPointeurTypeSemantique(
            etat,
            typeObjetIndexation,
            TrouverOrigineTypeExpressionSemantique(
                etat, objetIndexation),
            faux);
    }

    naturel64 HachageTypeReferenceSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        si ((reference->Drapeaux & 65_536) != 0) {
            naturel64 base = TrouverBaseSemantique(
                etat, indexReference);
            si (base >= etat->NombreSymboles) retourner 0;
            retourner HacherTypeNommeSemantique(
                HacherNomCompletSemantique(
                    etat, etat->SymbolesTravail[base].IndexNoeud),
                0,
                0);
        }
        si (reference->HachageNom == HacherSoiSemantique()) {
            naturel64 recepteur = TrouverRecepteurSemantique(
                etat, indexReference);
            si (recepteur >= etat->NombreSymboles) retourner 0;
            retourner HacherTypeNommeSemantique(
                HacherNomCompletSemantique(
                    etat,
                    etat->SymbolesTravail[recepteur].IndexNoeud),
                0,
                0);
        }
        naturel64 cible = TrouverVariableSemantique(
            etat, indexReference);
        si (cible >= etat->NombreSymboles)
            cible = TrouverDeclarationRacineSemantique(
                etat, indexReference);
        si (cible >= etat->NombreSymboles) retourner 0;
        si (etat->SymbolesTravail[cible].Genre == 2)
            retourner HacherPointeurFonctionDeclarationSemantique(
                etat, etat->SymbolesTravail[cible].IndexNoeud);
        si (etat->SymbolesTravail[cible].Genre == 7) {
            naturel64 indexEnumeration = etat->Requete->Noeuds[
                etat->SymbolesTravail[cible].IndexNoeud].Parent;
            si (indexEnumeration < etat->Requete->NombreNoeuds
                && etat->Requete->Noeuds[indexEnumeration].Genre == 8)
                retourner HacherTypeNommeSemantique(
                    HacherNomCompletSemantique(etat, indexEnumeration),
                    0,
                    0);
            retourner 0;
        }
        DescriptionTypeJetonsSemantique typeReferenceFonction;
        si (LireTypePointeurFonctionNoeudSemantique(
                etat,
                etat->SymbolesTravail[cible].IndexNoeud,
                &typeReferenceFonction)
            && (typeReferenceFonction.Qualificatifs & 4) != 0) {
            DescriptionHachageTypeSemantique dimensionsReferenceFonction = {
                0,
                0,
                HachageVideSemantique(),
                HachageVideSemantique()};
            retourner HacherPointeurFonctionSemantique(
                typeReferenceFonction.HachageNom,
                typeReferenceFonction.Qualificatifs & 3,
                typeReferenceFonction.NiveauPointeur,
                &dimensionsReferenceFonction);
        }
        retourner SansReferenceTypeSemantique(
            etat, etat->SymbolesTravail[cible].HachageType);
    }

    externe naturel64 HachageTypeMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre);

    /**
     * <résumé>Recueille les qualifications de la valeur et celles héritées de son objet.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types privés et déclarations canoniques.
     * @Paramètre(naturel64: indexExpression) Valeur, champ ou élément éventuellement imbriqué.
     * @Retourner(naturel32) Bits constante et volatile, sans qualifier le pointeur stocké d'un champ.
     **/
    naturel32 QualificatifsValeurExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {

        si (indexExpression >= etat->Requete->NombreNoeuds) retourner 0;
        naturel64 typeValeurQualifiee = HachageTypeExpressionSemantique(etat, indexExpression);
        naturel32 qualificatifsValeur = 0;
        si (EstTypeQualifieSemantique(etat, typeValeurQualifiee, 1))
            qualificatifsValeur = qualificatifsValeur | 1;
        si (EstTypeQualifieSemantique(etat, typeValeurQualifiee, 2))
            qualificatifsValeur = qualificatifsValeur | 2;
        constante NoeudDeclaration* expressionQualifiee = &etat->Requete->Noeuds[indexExpression];
        si (expressionQualifiee->Genre == 24 || expressionQualifiee->Genre == 29
            || expressionQualifiee->Genre == 30) {

            naturel64 origineValeurQualifiee = TrouverOrigineTypeExpressionSemantique(etat, indexExpression);
            DescriptionTypeJetonsSemantique descriptionValeurQualifiee;
            si (LireTypeNoeudSemantique(etat, origineValeurQualifiee, &descriptionValeurQualifiee))
                qualificatifsValeur = qualificatifsValeur | (descriptionValeurQualifiee.Qualificatifs & 3);
        }
        si (expressionQualifiee->Genre == 30
            || (expressionQualifiee->Genre == 29 && !EstTypeAdresseSemantique(etat, typeValeurQualifiee))) {

            naturel64 objetValeurQualifiee = TrouverEnfantDirectSemantique(etat, indexExpression, 0);
            qualificatifsValeur = qualificatifsValeur
                | QualificatifsValeurExpressionSemantique(etat, objetValeurQualifiee);
        }
        retourner qualificatifsValeur;
    }

    /**
     * <résumé>Conserve constante et volatile du stockage d'un champ ou élément avant sa prise d'adresse.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types privés et origine de l'expression.
     * @Paramètre(naturel64: indexExpression) Valeur adressée, éventuellement issue d'un callback.
     * @Paramètre(naturel64: hachageType) Type de valeur déjà résolu.
     * @Retourner(naturel64) Type qualifié sans modifier les qualifications du pointeur stocké.
     **/
    naturel64 QualifierValeurAdresseSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression, naturel64 hachageType) {

        si (EstTypeAdresseSemantique(etat, hachageType))
            retourner hachageType;
        naturel32 qualificatifsAdresse = QualificatifsValeurExpressionSemantique(etat, indexExpression);
        si (qualificatifsAdresse == 0) retourner hachageType;
        naturel64 origineValeurAdresse = TrouverOrigineTypeExpressionSemantique(
            etat, indexExpression);
        DescriptionTypeJetonsSemantique typeValeurAdresse;
        si (!LireTypeNoeudSemantique(etat, origineValeurAdresse, &typeValeurAdresse))
            retourner hachageType;
        typeValeurAdresse.Qualificatifs = typeValeurAdresse.Qualificatifs & 3;
        si (SansQualificatifsValeurSemantique(etat,
                HacherDescriptionTypeJetonsSemantique(&typeValeurAdresse))
            != SansQualificatifsValeurSemantique(etat, hachageType))
            retourner hachageType;
        typeValeurAdresse.Qualificatifs = typeValeurAdresse.Qualificatifs | qualificatifsAdresse;
        retourner HacherDescriptionTypeJetonsSemantique(&typeValeurAdresse);
    }

    naturel64 HacherOperateurExpressionSemantique(
        octet premier, octet second) {
        naturel64 hachage = AjouterOctetSemantique(
            HachageVideSemantique(), premier);
        si (second != 0)
            hachage = AjouterOctetSemantique(hachage, second);
        retourner hachage;
    }

    booléen EstOperateurComparaisonExpressionSemantique(
        constante NoeudDeclaration* expression) {
        naturel64 nom = expression->HachageNom;
        retourner nom == HacherOperateurExpressionSemantique(61, 61)
            || nom == HacherOperateurExpressionSemantique(33, 61)
            || nom == HacherOperateurExpressionSemantique(60, 0)
            || nom == HacherOperateurExpressionSemantique(60, 61)
            || nom == HacherOperateurExpressionSemantique(62, 0)
            || nom == HacherOperateurExpressionSemantique(62, 61);
    }

    booléen EstOperateurLogiqueExpressionSemantique(
        constante NoeudDeclaration* expression) {
        naturel64 nom = expression->HachageNom;
        retourner nom == HacherOperateurExpressionSemantique(33, 0)
            || nom == HacherOperateurExpressionSemantique(38, 38)
            || nom == HacherOperateurExpressionSemantique(124, 124);
    }

    booléen EstOperateurDecalageExpressionSemantique(
        constante NoeudDeclaration* expression) {
        naturel64 nom = expression->HachageNom;
        retourner nom == HacherOperateurExpressionSemantique(60, 60)
            || nom == HacherOperateurExpressionSemantique(62, 62);
    }

    externe booléen ConstanteExpressionCompatibleTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 hachageType);

    naturel64 HachageTypeOperateurIntrinsequeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        constante NoeudDeclaration* expressionOperateurType =
            &etat->Requete->Noeuds[indexExpression];
        si (EstOperateurComparaisonExpressionSemantique(
                expressionOperateurType)
            || EstOperateurLogiqueExpressionSemantique(
                expressionOperateurType))
            retourner HacherTypeSimpleSemantique(9, 0, 0);

        naturel64 operandeGaucheType = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 hachageGaucheType = HachageTypeExpressionSemantique(
            etat, operandeGaucheType);
        si (expressionOperateurType->Genre == 25) {
            naturel64 operateurAdresseType =
                HacherOperateurExpressionSemantique(38, 0);
            naturel64 operateurDereferencementType =
                HacherOperateurExpressionSemantique(42, 0);
            si (expressionOperateurType->HachageNom
                == operateurAdresseType) {
                naturel64 symboleOperandeAdresseType =
                    TrouverCibleSymboleExpressionSemantique(
                        etat, operandeGaucheType);
                si (symboleOperandeAdresseType < etat->NombreSymboles
                    && etat->SymbolesTravail[
                        symboleOperandeAdresseType].Genre == 2)
                    retourner hachageGaucheType;
                retourner TransformerPointeurTypeSemantique(
                    etat,
                    QualifierValeurAdresseSemantique(etat, operandeGaucheType, hachageGaucheType),
                    TrouverOrigineTypeExpressionSemantique(
                        etat, operandeGaucheType),
                    vrai);
            }
            si (expressionOperateurType->HachageNom
                == operateurDereferencementType)
                retourner TransformerPointeurTypeSemantique(
                    etat,
                    hachageGaucheType,
                    TrouverOrigineTypeExpressionSemantique(
                        etat, operandeGaucheType),
                    faux);
            naturel64 operateurMoinsType =
                HacherOperateurExpressionSemantique(45, 0);
            si (expressionOperateurType->HachageNom == operateurMoinsType
                && operandeGaucheType < etat->Requete->NombreNoeuds
                && etat->Requete->Noeuds[operandeGaucheType].Genre == 22
                && etat->Requete->Noeuds[operandeGaucheType].HachageType
                    == 9_223_372_036_854_775_808)
                retourner HacherTypeSimpleSemantique(4, 0, 0);
            retourner SansQualificatifsValeurSemantique(
                etat, hachageGaucheType);
        }

        naturel64 operandeDroiteType = TrouverEnfantDirectSemantique(
            etat, indexExpression, 1);
        naturel64 hachageDroiteType = HachageTypeExpressionSemantique(
            etat, operandeDroiteType);
        si (!EstOperateurDecalageExpressionSemantique(
                expressionOperateurType)
            && !TypesValeurEgauxSemantique(
                etat, hachageGaucheType, hachageDroiteType)) {
            naturel64 cibleGaucheType =
                SansQualificatifsValeurSemantique(
                    etat, hachageDroiteType);
            naturel64 cibleDroiteType =
                SansQualificatifsValeurSemantique(
                    etat, hachageGaucheType);
            si (ConstanteExpressionCompatibleTypeSemantique(
                    etat, operandeGaucheType, cibleGaucheType))
                hachageGaucheType = cibleGaucheType;
            sinon si (ConstanteExpressionCompatibleTypeSemantique(
                    etat, operandeDroiteType, cibleDroiteType))
                hachageDroiteType = cibleDroiteType;
        }
        retourner SansQualificatifsValeurSemantique(
            etat, hachageGaucheType);
    }

    naturel64 HachageTypeAppelSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAppel) {
        naturel64 cibleAppelType = TrouverEnfantDirectSemantique(
            etat, indexAppel, 0);
        naturel64 symboleCibleAppel = TrouverCibleSymboleExpressionSemantique(
            etat, cibleAppelType);
        si (symboleCibleAppel < etat->NombreSymboles
            && etat->SymbolesTravail[symboleCibleAppel].Genre == 2)
            retourner SansReferenceTypeSemantique(
                etat,
                etat->SymbolesTravail[symboleCibleAppel].HachageType);

        naturel64 typeCibleAppel = HachageTypeExpressionSemantique(
            etat, cibleAppelType);
        naturel64 origineCibleAppel =
            TrouverOrigineTypeExpressionSemantique(
                etat, cibleAppelType);
        naturel64 symboleOrigineCibleAppel =
            TrouverSymboleNoeudSemantique(
                etat, origineCibleAppel, 2);
        si (symboleOrigineCibleAppel < etat->NombreSymboles
            && typeCibleAppel
                == HacherPointeurFonctionDeclarationSemantique(
                    etat, origineCibleAppel))
            retourner SansReferenceTypeSemantique(
                etat,
                etat->SymbolesTravail[
                    symboleOrigineCibleAppel].HachageType);
        naturel64 retourCibleAppel = 0;
        si (LireRetourPointeurFonctionNoeudSemantique(
                etat,
                origineCibleAppel,
                typeCibleAppel,
                &retourCibleAppel))
            retourner SansReferenceTypeSemantique(
                etat, retourCibleAppel);
        retourner 0;
    }

    naturel64 HachageTypeExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner 0;
        si (etat->TypesConversionsImplicites[indexExpression] != 0)
            retourner etat->TypesConversionsImplicites[indexExpression];
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];

        si (expression->Genre == 22) {
            si ((expression->Drapeaux & 16_384) != 0)
                retourner HacherTypeSimpleSemantique(9, 0, 0);
            si (expression->HachageType <= 2_147_483_647)
                retourner HacherTypeSimpleSemantique(3, 0, 0);
            si (expression->HachageType
                <= 9_223_372_036_854_775_807)
                retourner HacherTypeSimpleSemantique(4, 0, 0);
            retourner HacherTypeSimpleSemantique(8, 0, 0);
        }
        si (expression->Genre == 23)
            retourner HacherTypeSimpleSemantique(11, 1, 1);
        si (expression->Genre == 24)
            retourner HachageTypeReferenceSemantique(
                etat, indexExpression);
        si (expression->Genre == 28)
            retourner HachageTypeAppelSemantique(etat, indexExpression);
        si (expression->Genre == 29) {
            naturel64 cibleSymboleMembre =
                TrouverCibleSymboleExpressionSemantique(
                    etat, indexExpression);
            si (cibleSymboleMembre < etat->NombreSymboles
                && etat->SymbolesTravail[cibleSymboleMembre].Genre == 2)
                retourner HacherPointeurFonctionDeclarationSemantique(
                    etat,
                    etat->SymbolesTravail[cibleSymboleMembre].IndexNoeud);
            naturel64 typeResolutionMembre =
                HachageTypeResolutionExpressionSemantique(
                    etat, indexExpression);
            si (typeResolutionMembre != 0) retourner typeResolutionMembre;
            retourner HachageTypeMembreSemantique(
                etat, indexExpression);
        }
        si (expression->Genre == 31) {

            DescriptionTypeJetonsSemantique cibleConversion;
            si (!LireTypeConversionSemantique(etat, indexExpression, &cibleConversion))
                retourner 0;
            cibleConversion.Qualificatifs = cibleConversion.Qualificatifs & 3;
            retourner HacherDescriptionTypeJetonsSemantique(&cibleConversion);
        }
        si (expression->Genre == 30)
            retourner HachageTypeIndexationSemantique(
                etat, indexExpression);
        si (expression->Genre == 25 || expression->Genre == 26) {
            naturel64 typeResolutionOperateur =
                HachageTypeResolutionExpressionSemantique(
                    etat, indexExpression);
            si (typeResolutionOperateur != 0)
                retourner typeResolutionOperateur;
            retourner HachageTypeOperateurIntrinsequeSemantique(
                etat, indexExpression);
        }
        si (expression->Genre == 27) {
            naturel64 enfant = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner HachageTypeExpressionSemantique(etat, enfant);
        }
        retourner 0;
    }

    /**
     * <résumé>Préfixe le nom écrit de la base par l'espace déclarant, à partir des lexèmes.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Jetons privés, sans commentaires ni espaces.
     * @Paramètre(constante NoeudDeclaration*: type) Classe portant une clause d'héritage.
     * @Retourner(naturel64) Empreinte relative, y compris pour une base qualifiée.
     **/
    naturel64 HacherNomBaseRelatifSemantique(
        EtatAnalyseSemantique* etat, constante NoeudDeclaration* type) {

        si (type->HachageEspace == HachageVideSemantique()) retourner type->HachageType;
        naturel64 hachage = AjouterOctetSemantique(
            AjouterOctetSemantique(type->HachageEspace, 58), 58);
        naturel64 jeton = 0;
        tantque (jeton < etat->NombreJetonsTypes
            && etat->JetonsTypes[jeton].Debut < type->DebutNom + type->TailleNom)
            jeton = jeton + 1;
        si (jeton < etat->NombreJetonsTypes && etat->JetonsTypes[jeton].Genre == 73)
            jeton = jeton + 1;
        si (jeton < etat->NombreJetonsTypes
            && (etat->JetonsTypes[jeton].Genre == 10
                || etat->JetonsTypes[jeton].Genre == 67
                || etat->JetonsTypes[jeton].Genre == 11))
            jeton = jeton + 1;
        tantque (jeton < etat->NombreJetonsTypes && etat->JetonsTypes[jeton].Genre != 36
            && etat->JetonsTypes[jeton].Genre != 0) {

            hachage = AjouterTrancheTypeJetonsSemantique(etat, hachage, &etat->JetonsTypes[jeton]);
            jeton = jeton + 1;
        }
        retourner hachage;
    }

    /**
     * <résumé>Valide toutes les bases, même inutilisées, avant les types des champs et signatures.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Index et alias racines déjà résolus.
     * @Retourner(ErreurAnalyseSemantique) Premier refus, à la position de la classe comme dans le bootstrap.
     * @etc. Un nom qualifié complet reste prioritaire ; sinon la recherche remonte les espaces parents.
     * Les bases canoniques restent dans un cache privé.
     * Les cycles indirects suivent ensuite le contrôle existant des dispositions par valeur.
     **/
    ErreurAnalyseSemantique ResoudreHeritageSemantique(EtatAnalyseSemantique* etat) {

        naturel64 indexType = 0;
        tantque (indexType < etat->NombreSymboles) {

            SymboleSemantique* symboleType = &etat->SymbolesTravail[indexType];
            constante NoeudDeclaration* type = &etat->Requete->Noeuds[symboleType->IndexNoeud];
            si (symboleType->Genre == 1 && type->Genre == 6 && (type->Drapeaux & 32) != 0) {

                si ((type->Drapeaux & 1) == 0)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::HeritageNonPublic,
                        symboleType->IndexNoeud, 0);
                naturel64 baseCanonique = etat->NombreSymboles;
                RechercheNomUtiliseSemantique recherche = RechercheDepuisNoeudUtiliseSemantique(etat, type);
                naturel64 jetonBase = 0;
                tantque (jetonBase < etat->NombreJetonsTypes && etat->JetonsTypes[jetonBase].Debut < recherche.Fin)
                    jetonBase = jetonBase + 1;
                si (jetonBase < etat->NombreJetonsTypes && etat->JetonsTypes[jetonBase].Genre == 73) jetonBase = jetonBase + 1;
                si (jetonBase < etat->NombreJetonsTypes && (etat->JetonsTypes[jetonBase].Genre == 10
                    || etat->JetonsTypes[jetonBase].Genre == 11 || etat->JetonsTypes[jetonBase].Genre == 67)) jetonBase = jetonBase + 1;
                si (jetonBase < etat->NombreJetonsTypes) recherche.Debut = etat->JetonsTypes[jetonBase].Debut;
                tantque (jetonBase < etat->NombreJetonsTypes && etat->JetonsTypes[jetonBase].Genre != 36) jetonBase = jetonBase + 1;
                si (jetonBase < etat->NombreJetonsTypes) recherche.Fin = etat->JetonsTypes[jetonBase].Debut;
                recherche.Hachage = type->HachageType;
                ChercherNomUtiliseSemantique(etat, &recherche);
                si (recherche.Ambigue)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::NomImporteAmbigu, symboleType->IndexNoeud, 0);
                baseCanonique = recherche.Premier;
                si (baseCanonique < etat->NombreSymboles && etat->SymbolesTravail[baseCanonique].Genre == 4
                    && etat->EtatsAliasesRacines[baseCanonique] == 2) baseCanonique = etat->CiblesAliasesRacines[baseCanonique];
                si (baseCanonique >= etat->NombreSymboles)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::TypeNommeIntrouvable,
                        symboleType->IndexNoeud, 0);
                si (etat->SymbolesTravail[baseCanonique].Genre != 1)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::TypeNommeIntrouvable,
                        symboleType->IndexNoeud, 0);
                si (etat->Requete->Noeuds[etat->SymbolesTravail[baseCanonique].IndexNoeud].Genre != 6)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::BaseClasseInvalide,
                        symboleType->IndexNoeud, convertir<naturel32>(baseCanonique));
                si (baseCanonique == indexType)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AutoHeritageClasse,
                        symboleType->IndexNoeud, 0);
                etat->TypesBases[indexType] = baseCanonique;
            }
            indexType = indexType + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 TrouverTypeBaseSymboleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {

        si (indexType >= etat->NombreSymboles) retourner etat->NombreSymboles;
        retourner etat->TypesBases[indexType];
    }

    booléen EstTypeDeriveSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexSource,
        naturel64 indexDestination) {
        naturel64 courant = indexSource;
        naturel64 profondeur = 0;
        tantque (courant < etat->NombreSymboles
            && profondeur < etat->NombreSymboles) {
            courant = TrouverTypeBaseSymboleSemantique(etat, courant);
            si (courant == indexDestination) retourner vrai;
            profondeur = profondeur + 1;
        }
        retourner faux;
    }

    booléen AccesMembreAutoriseSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexMembre,
        naturel64 indexUtilisation) {
        si (indexMembre >= etat->NombreSymboles) retourner faux;
        SymboleSemantique* membre = &etat->SymbolesTravail[indexMembre];
        constante NoeudDeclaration* declaration =
            &etat->Requete->Noeuds[membre->IndexNoeud];
        si ((declaration->Drapeaux & 1) != 0) retourner vrai;

        naturel64 typeDeclarant = TrouverSymboleNoeudSemantique(
            etat, membre->IndexPortee);
        naturel64 typeContexte = TrouverRecepteurSemantique(
            etat, indexUtilisation);
        si (typeDeclarant >= etat->NombreSymboles
            || typeContexte >= etat->NombreSymboles)
            retourner faux;
        si (typeContexte == typeDeclarant) retourner vrai;
        retourner (declaration->Drapeaux & 8) != 0
            && EstTypeDeriveSemantique(
                etat, typeContexte, typeDeclarant);
    }

    booléen ConversionHeritageSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 source,
        naturel64 destination,
        booléen liaisonReference) {
        si (EstTypeConstantSemantique(etat, source)
            && !EstTypeConstantSemantique(etat, destination))
            retourner faux;
        naturel32 niveauPointeur = 0;
        tantque (niveauPointeur <= 1) {
            si (niveauPointeur != 0 || liaisonReference) {
                naturel64 typeSource = TrouverTypeDepuisHachageSemantique(
                    etat, source, niveauPointeur);
                naturel64 typeDestination = TrouverTypeDepuisHachageSemantique(
                    etat, destination, niveauPointeur);
                si (typeSource < etat->NombreSymboles
                    && typeDestination < etat->NombreSymboles
                    && typeSource != typeDestination
                    && EstTypeDeriveSemantique(
                        etat, typeSource, typeDestination))
                    retourner vrai;
            }
            niveauPointeur = niveauPointeur + 1;
        }
        retourner faux;
    }

    externe booléen EstValeurGaucheSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression);

    externe booléen EstExpressionValeurConstanteSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression);

    externe booléen LiaisonReferenceCompatibleSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 typeReference);

    externe booléen EstExpressionConstanteGlobaleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression);

    externe booléen DecrireTypeNumeriqueSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachageType,
        DescriptionTypeNumeriqueSemantique* description);

    externe ErreurAnalyseSemantique EvaluerConstanteNumeriqueSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64* valeur);

    externe booléen ValeurDansTypeNumeriqueSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 valeur,
        naturel64 typeSource,
        naturel64 typeDestination);

    /**
     * <résumé>Teste l'adaptation implicite d'une expression constante entière.</résumé>
     * @Paramètre(naturel64: indexExpression) Expression source, simple ou composée.
     * @Retourner(booléen) Vrai si la valeur calculée est représentable dans le type cible.
     * @etc. Un dépassement exclut une surcharge sans produire de diagnostic ;
     * les erreurs du calcul lui-même sont conservées pour l'appelant.
     **/
    booléen ConstanteExpressionCompatibleTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 typeDestination) {

        etat->ConstanteHorsPlage = 0;
        si (!EstExpressionConstanteGlobaleSemantique(etat, indexExpression))
            retourner faux;
        naturel64 typeSource = HachageTypeExpressionSemantique(etat, indexExpression);
        DescriptionTypeNumeriqueSemantique descriptionSource;
        DescriptionTypeNumeriqueSemantique descriptionDestination;
        si (!DecrireTypeNumeriqueSemantique(
                etat, typeSource, &descriptionSource)
            || !DecrireTypeNumeriqueSemantique(
                etat, typeDestination, &descriptionDestination)
            || descriptionSource.Booleen != 0
            || descriptionSource.Enumeration != 0
            || descriptionDestination.Booleen != 0
            || descriptionDestination.Enumeration != 0)
            retourner faux;

        naturel64 valeurConstante = 0;
        ErreurAnalyseSemantique erreurConstante =
            EvaluerConstanteNumeriqueSemantique(
                etat, indexExpression, &valeurConstante);
        si (erreurConstante != ErreurAnalyseSemantique::Reussite)
            retourner faux;
        si (!ValeurDansTypeNumeriqueSemantique(
                etat,
                valeurConstante,
                typeSource,
                typeDestination)) {
            etat->ConstanteHorsPlage = 1;
            retourner faux;
        }
        retourner vrai;
    }

    booléen InitialiseurCompatibleTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 typeDestination) {

        etat->ConstanteHorsPlage = 0;
        naturel64 typeSource = HachageTypeExpressionSemantique(etat, indexExpression);
        si (typeSource == 0) retourner vrai;
        typeSource = SansReferenceTypeSemantique(etat, typeSource);
        typeDestination = SansReferenceTypeSemantique(etat, typeDestination);
        si (TypesValeurEgauxSemantique(etat, typeSource, typeDestination))
            retourner vrai;
        si (ConversionHeritageSemantique(etat, typeSource, typeDestination, faux))
            retourner vrai;
        retourner ConstanteExpressionCompatibleTypeSemantique(
            etat, indexExpression, typeDestination);
    }

    booléen InitialiserDestinationInitialiseurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeudDeclaration,
        DestinationInitialiseurSemantique* destination) {
        si (indexNoeudDeclaration >= etat->Requete->NombreNoeuds)
            retourner faux;
        destination->IndexNoeudDeclaration = indexNoeudDeclaration;
        destination->ProfondeurTableau = 0;
        destination->Globale = 0;
        si (etat->Requete->Noeuds[indexNoeudDeclaration].Genre == 3)
            destination->Globale = 1;
        destination->Reserve = 0;
        DescriptionHachageTypeSemantique dimensions;
        si (LireDimensionsNoeudSemantique(
                etat, indexNoeudDeclaration, &dimensions)) {
            destination->NombreDimensions = dimensions.NombreDimensions;
            destination->HachageElement =
                HachageElementFinalTableauSemantique(
                    etat, indexNoeudDeclaration);
            retourner destination->HachageElement != 0;
        }
        destination->NombreDimensions = 0;
        destination->HachageElement = etat->Requete->Noeuds[
            indexNoeudDeclaration].HachageType;
        retourner destination->HachageElement != 0;
    }

    booléen EstDestinationClasseSemantique(
        EtatAnalyseSemantique* etat,
        DestinationInitialiseurSemantique* destination) {
        naturel64 type = TrouverTypeDepuisHachageSemantique(
            etat, destination->HachageElement, 0);
        retourner type < etat->NombreSymboles
            && etat->Requete->Noeuds[
                etat->SymbolesTravail[type].IndexNoeud].Genre == 6;
    }

    /**
     * <résumé>Contrôle les limites ABI des fonctions, récepteur implicite compris.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Symboles et types canoniques de l'analyse.
     * @Retourner(ErreurAnalyseSemantique) Première signature dépassant les limites du bootstrap.
     **/
    ErreurAnalyseSemantique ValiderSignaturesFonctionsSemantiques(EtatAnalyseSemantique* etat) {

        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {

            constante NoeudDeclaration* fonction = &etat->Requete->Noeuds[index];
            si (EstGenreFonctionSemantique(fonction->Genre)) {

                naturel64 nombre = CompterParametresFonctionSemantique(etat, index);
                si (fonction->Parent != 0 && etat->Requete->Noeuds[fonction->Parent].Genre == 6)
                    nombre = nombre + 1;
                naturel64 maximum = 4;
                naturel64 typeRetour = TrouverTypeDepuisHachageSemantique(etat, fonction->HachageType, 0);
                si (typeRetour < etat->NombreSymboles) {

                    naturel32 genreRetour = etat->Requete->Noeuds[etat->SymbolesTravail[typeRetour].IndexNoeud].Genre;
                    si (genreRetour >= 4 && genreRetour <= 6) maximum = 3;
                }
                si (nombre > maximum)
                    retourner SignalerErreurSemantique(
                        etat, ErreurAnalyseSemantique::AriteSignatureFonctionInvalide, index, convertir<naturel32>(nombre));
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Compare les paramètres canoniques d'une surcharge, sans son retour ni les noms des paramètres.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Copie privée des types résolus.
     * @Paramètre(naturel64: gauche) Nœud de la première fonction.
     * @Paramètre(naturel64: droite) Nœud de la seconde fonction.
     * @Retourner(booléen) Mêmes paramètres ordonnés de la signature non liée, récepteur compris.
     **/
    booléen MemesParametresSurchargeSemantique(
        EtatAnalyseSemantique* etat, naturel64 gauche, naturel64 droite) {

        naturel64 nombre = CompterParametresSignatureFonctionSemantique(etat, gauche);
        si (nombre != CompterParametresSignatureFonctionSemantique(etat, droite)) retourner faux;
        naturel64 position = 0;
        tantque (position < nombre) {

            si (HachageTypeParametreSignatureFonctionSemantique(etat, gauche, position)
                != HachageTypeParametreSignatureFonctionSemantique(etat, droite, position)) retourner faux;
            position = position + 1;
        }
        retourner vrai;
    }

    /**
     * <résumé>Refuse les surcharges répétées avant les remplacements virtuels et les corps de fonctions.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Symboles et signatures canoniques déjà validés.
     * @Retourner(ErreurAnalyseSemantique) Refus à la seconde déclaration de la première paire identique.
     * @etc. Le parcours des paires au sein d'un même nom respecte celui du bootstrap.
     **/
    ErreurAnalyseSemantique ValiderDoublonsSurchargesSemantiques(EtatAnalyseSemantique* etat) {

        naturel64 gauche = 0;
        tantque (gauche < etat->NombreSymboles) {

            SymboleSemantique* fonctionGauche = &etat->SymbolesTravail[gauche];
            si (fonctionGauche->Genre == 2) {

                naturel64 droite = gauche + 1;
                tantque (droite < etat->NombreSymboles) {

                    SymboleSemantique* fonctionDroite = &etat->SymbolesTravail[droite];
                    si (fonctionDroite->Genre == 2
                        && MemesNomsCompletsSemantiques(etat, fonctionGauche, fonctionDroite)
                        && MemesParametresSurchargeSemantique(
                            etat, fonctionGauche->IndexNoeud, fonctionDroite->IndexNoeud))
                        retourner SignalerErreurSemantique(etat,
                            ErreurAnalyseSemantique::SurchargeDeclareePlusieursFois,
                            fonctionDroite->IndexNoeud, convertir<naturel32>(fonctionGauche->IndexNoeud));
                    droite = droite + 1;
                }
            }
            gauche = gauche + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Ajoute un texte canonique à l'empreinte de liaison, octet par octet.</résumé>
     * @Paramètre(naturel64: hachage) Empreinte courante du bootstrap.
     * @Paramètre(constante caractère*: texte) Littéral canonique terminé par zéro.
     * @Retourner(naturel64) Empreinte après les octets UTF-8 du texte.
     **/
    naturel64 AjouterTexteNomLiaisonSemantique(naturel64 hachage, constante caractère* texte) {

        naturel64 index = 0;
        tantque (texte[index] != 0) {

            hachage = AjouterOctetSemantique(hachage, convertir<octet>(texte[index]));
            index = index + 1;
        }
        retourner hachage;
    }

    /**
     * <résumé>Retrouve les noms lisibles des espaces sans ajouter de nœud à l'AST public.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Jetons de la source déjà analysée.
     * @Retourner(ErreurAnalyseSemantique) Réussite, allocation impossible ou source incohérente.
     **/
    ErreurAnalyseSemantique InitialiserContextesNomsLiaisonSemantiques(EtatAnalyseSemantique* etat) {

        naturel64 nombre = etat->NombreJetonsTypes;
        si (nombre > 461_168_601_842_738_790)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
        etat->ContextesNomsLiaison = convertir<ContexteNomLiaisonSemantique*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, nombre * 24, 8));
        etat->EspacesNomsLiaisonJetons = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, nombre * 8, 8));
        naturel64* pile = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, nombre * 8, 8));
        si (etat->ContextesNomsLiaison == NulContextesNomsLiaisonSemantiques
            || etat->EspacesNomsLiaisonJetons == NulNaturelsDispositionSemantique
            || pile == NulNaturelsDispositionSemantique)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
        naturel64 index = 0;
        tantque (index < nombre) {

            etat->EspacesNomsLiaisonJetons[index] = 0;
            index = index + 1;
        }
        naturel64 contexte = 0;
        naturel64 nombreContextes = 1;
        naturel64 profondeur = 0;
        index = 0;
        tantque (index < nombre) {

            etat->EspacesNomsLiaisonJetons[index] = contexte;
            naturel32 genre = etat->JetonsTypes[index].Genre;
            si (genre == 4 && (index == 0 || etat->JetonsTypes[index - 1].Genre != 76)) {

                naturel64 fin = index + 1;
                tantque (fin < nombre && (etat->JetonsTypes[fin].Genre == 1
                    || etat->JetonsTypes[fin].Genre == 44)) fin = fin + 1;
                si (fin >= nombre || etat->JetonsTypes[fin].Genre != 36)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, 0, 0);
                etat->ContextesNomsLiaison[nombreContextes] = {contexte, index + 1, fin};
                pile[profondeur] = contexte;
                profondeur = profondeur + 1;
                contexte = nombreContextes;
                nombreContextes = nombreContextes + 1;
                index = fin;
            }
            sinon si (genre == 36) {

                pile[profondeur] = contexte;
                profondeur = profondeur + 1;
            }
            sinon si (genre == 37) {

                si (profondeur == 0)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, 0, 0);
                profondeur = profondeur - 1;
                contexte = pile[profondeur];
            }
            index = index + 1;
        }
        si (profondeur != 0)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, 0, 0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Ajoute les espaces parents et leurs noms qualifiés à l'empreinte canonique.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Contextes privés de la source.
     * @Paramètre(naturel64: hachage) Empreinte courante.
     * @Paramètre(naturel64: indexContexte) Espace courant, zéro pour la racine.
     * @Retourner(naturel64) Empreinte du préfixe qualifié, sans séparateur final.
     **/
    naturel64 AjouterEspaceNomLiaisonSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachage, naturel64 indexContexte) {

        si (indexContexte == 0) retourner hachage;
        ContexteNomLiaisonSemantique* contexte = &etat->ContextesNomsLiaison[indexContexte];
        hachage = AjouterEspaceNomLiaisonSemantique(etat, hachage, contexte->Parent);
        si (contexte->Parent != 0) hachage = AjouterTexteNomLiaisonSemantique(hachage, "::");
        naturel64 index = contexte->DebutNom;
        tantque (index < contexte->FinNom) {

            hachage = AjouterTrancheTypeJetonsSemantique(etat, hachage, &etat->JetonsTypes[index]);
            index = index + 1;
        }
        retourner hachage;
    }

    /**
     * <résumé>Ajoute le nom complet d'une déclaration canonique, espaces lisibles compris.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST privé et contextes des jetons.
     * @Paramètre(naturel64: hachage) Empreinte courante.
     * @Paramètre(naturel64: indexNoeud) Déclaration du type canonique.
     * @Retourner(naturel64) Empreinte après le nom complet de la déclaration.
     **/
    naturel64 AjouterNomCanoniqueLiaisonSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachage, naturel64 indexNoeud) {

        naturel64 jeton = 0;
        tantque (jeton < etat->NombreJetonsTypes
            && etat->JetonsTypes[jeton].Debut != etat->Requete->Noeuds[indexNoeud].DebutNom)
            jeton = jeton + 1;
        si (jeton < etat->NombreJetonsTypes) {

            naturel64 contexte = etat->EspacesNomsLiaisonJetons[jeton];
            hachage = AjouterEspaceNomLiaisonSemantique(etat, hachage, contexte);
            si (contexte != 0) hachage = AjouterTexteNomLiaisonSemantique(hachage, "::");
        }
        retourner AjouterNomNoeudSemantique(etat, hachage, indexNoeud);
    }

    /**
     * <résumé>Hache l'affichage canonique d'un type, comme TypeGs::Afficher dans le bootstrap.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types nommés et alias déjà résolus.
     * @Paramètre(CurseurTypeJetonsSemantique*: curseur) Début du type, avancé après sa lecture.
     * @Paramètre(naturel64*: hachage) Empreinte de liaison alimentée sans construire de chaîne.
     * @Retourner(booléen) Vrai si le type canonique a pu être lu.
     * @etc. Les paramètres tableaux ont déjà été refusés par les contrôles de signatures.
     **/
    booléen AjouterTypeNomLiaisonSemantique(
        EtatAnalyseSemantique* etat, CurseurTypeJetonsSemantique* curseur, naturel64* hachage) {

        CurseurTypeJetonsSemantique fin = *curseur;
        DescriptionTypeJetonsSemantique type;
        si (!AnalyserTypeJetonsSemantique(etat, &fin, &type)) retourner faux;
        si ((type.Qualificatifs & 1) != 0)
            *hachage = AjouterTexteNomLiaisonSemantique(*hachage, "constante ");
        si ((type.Qualificatifs & 2) != 0)
            *hachage = AjouterTexteNomLiaisonSemantique(*hachage, "volatile ");
        si (type.Genre >= 1 && type.Genre <= 12) {

            constante caractère* nom = "vide";
            si (type.Genre == 1) nom = "entier8";
            si (type.Genre == 2) nom = "entier16";
            si (type.Genre == 3) nom = "entier32";
            si (type.Genre == 4) nom = "entier64";
            si (type.Genre == 5) nom = "naturel8";
            si (type.Genre == 6) nom = "naturel16";
            si (type.Genre == 7) nom = "naturel32";
            si (type.Genre == 8) nom = "naturel64";
            si (type.Genre == 9) nom = "booléen";
            si (type.Genre == 10) nom = "octet";
            si (type.Genre == 11) nom = "caractère";
            *hachage = AjouterTexteNomLiaisonSemantique(*hachage, nom);
        }
        sinon si (type.Genre == 13) {

            naturel64 cible = 0;
            tantque (cible < etat->NombreSymboles && !(etat->SymbolesTravail[cible].Genre == 1
                && HacherNomCompletSemantique(etat, etat->SymbolesTravail[cible].IndexNoeud) == type.HachageNom))
                cible = cible + 1;
            si (cible >= etat->NombreSymboles) retourner faux;
            *hachage = AjouterNomCanoniqueLiaisonSemantique(
                etat, *hachage, etat->SymbolesTravail[cible].IndexNoeud);
        }
        sinon si (type.Genre == 14) {

            CurseurTypeJetonsSemantique signature = *curseur;
            tantque (GenreCourantTypeJetonsSemantique(etat, &signature) == 12
                || GenreCourantTypeJetonsSemantique(etat, &signature) == 13)
                AvancerTypeJetonsSemantique(&signature);
            si (!AccepterTypeJetonsSemantique(etat, &signature, 26)
                || !AccepterTypeJetonsSemantique(etat, &signature, 48)) retourner faux;
            *hachage = AjouterTexteNomLiaisonSemantique(*hachage, "pointeur_fonction<");
            si (!AjouterTypeNomLiaisonSemantique(etat, &signature, hachage)) retourner faux;
            si (!AccepterTypeJetonsSemantique(etat, &signature, 34)) retourner faux;
            *hachage = AjouterOctetSemantique(*hachage, 40);
            booléen premier = vrai;
            tantque (GenreCourantTypeJetonsSemantique(etat, &signature) != 35) {

                si (!premier) {

                    si (!AccepterTypeJetonsSemantique(etat, &signature, 41)) retourner faux;
                    *hachage = AjouterTexteNomLiaisonSemantique(*hachage, ", ");
                }
                si (!AjouterTypeNomLiaisonSemantique(etat, &signature, hachage)) retourner faux;
                premier = faux;
            }
            si (!AccepterTypeJetonsSemantique(etat, &signature, 35)
                || !AccepterFermetureTypeJetonsSemantique(etat, &signature)) retourner faux;
            *hachage = AjouterTexteNomLiaisonSemantique(*hachage, ")>");
        }
        sinon retourner faux;
        naturel32 niveau = 0;
        tantque (niveau < type.NiveauPointeur) {

            *hachage = AjouterOctetSemantique(*hachage, 42);
            niveau = niveau + 1;
        }
        si ((type.Qualificatifs & 4) != 0) *hachage = AjouterOctetSemantique(*hachage, 38);
        *curseur = fin;
        retourner vrai;
    }

    /**
     * <résumé>Reproduit l'empreinte 64 bits du suffixe de surcharge du bootstrap, récepteur compris.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Signatures et noms canoniques privés.
     * @Paramètre(naturel64: indexFonction) Fonction dont le nom est surchargé.
     * @Paramètre(naturel64*: hachage) Empreinte calculée en sortie.
     * @Retourner(booléen) Vrai si tous les paramètres ont pu être rendus.
     **/
    booléen HacherSuffixeSurchargeLiaisonSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexFonction, naturel64* hachage) {

        *hachage = 1_469_598_103_934_665_603;
        si (HachageTypeRecepteurFonctionSemantique(etat, indexFonction) != 0) {

            *hachage = AjouterNomCanoniqueLiaisonSemantique(
                etat, *hachage, etat->Requete->Noeuds[indexFonction].Parent);
            *hachage = AjouterTexteNomLiaisonSemantique(*hachage, "&;");
        }
        naturel64 nombre = CompterParametresFonctionSemantique(etat, indexFonction);
        naturel64 position = 0;
        tantque (position < nombre) {

            naturel64 indexParametre = TrouverParametreFonctionSemantique(etat, indexFonction, position);
            DescriptionTypeJetonsSemantique type;
            si (!LireTypeNoeudSemantique(etat, indexParametre, &type)) retourner faux;
            CurseurTypeJetonsSemantique curseur = {type.DebutType, faux};
            si (!AjouterTypeNomLiaisonSemantique(etat, &curseur, hachage)) retourner faux;
            *hachage = AjouterOctetSemantique(*hachage, 59);
            position = position + 1;
        }
        retourner vrai;
    }

    /**
     * <résumé>Refuse les empreintes de liaison identiques de surcharges sources distinctes.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Doublons de signatures déjà refusés.
     * @Retourner(ErreurAnalyseSemantique) Collision à la première fonction dont le symbole est déjà présent.
     * @etc. Le séparateur $ des noms calculés n'est pas autorisé dans les identifiants sources.
     **/
    ErreurAnalyseSemantique ValiderCollisionsSymbolesFonctionsSemantiques(EtatAnalyseSemantique* etat) {

        booléen surchargePresente = faux;
        naturel64 droite = 0;
        tantque (droite < etat->NombreSymboles && !surchargePresente) {

            naturel64 precedentRecherche = 0;
            tantque (precedentRecherche < droite && !surchargePresente) {

                si (etat->SymbolesTravail[droite].Genre == 2 && etat->SymbolesTravail[precedentRecherche].Genre == 2
                    && MemesNomsCompletsSemantiques(etat, &etat->SymbolesTravail[precedentRecherche], &etat->SymbolesTravail[droite]))
                    surchargePresente = vrai;
                precedentRecherche = precedentRecherche + 1;
            }
            droite = droite + 1;
        }
        si (!surchargePresente) retourner ErreurAnalyseSemantique::Reussite;
        ErreurAnalyseSemantique erreur = InitialiserContextesNomsLiaisonSemantiques(etat);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
        si (etat->NombreSymboles > 2_305_843_009_213_693_951)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
        naturel64* empreintes = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, etat->NombreSymboles * 8, 8));
        si (empreintes == NulNaturelsDispositionSemantique)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
        droite = 0;
        tantque (droite < etat->NombreSymboles) {

            SymboleSemantique* fonction = &etat->SymbolesTravail[droite];
            si (fonction->Genre == 2) {

                si (!HacherSuffixeSurchargeLiaisonSemantique(etat, fonction->IndexNoeud, &empreintes[droite]))
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, fonction->IndexNoeud, 0);
                naturel64 gauche = 0;
                tantque (gauche < droite) {

                    si (etat->SymbolesTravail[gauche].Genre == 2 && empreintes[gauche] == empreintes[droite]
                        && MemesNomsCompletsSemantiques(etat, &etat->SymbolesTravail[gauche], fonction))
                        retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::CollisionSymboleFonction,
                            fonction->IndexNoeud, convertir<naturel32>(etat->SymbolesTravail[gauche].IndexNoeud));
                    gauche = gauche + 1;
                }
            }
            droite = droite + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Compare une clé virtuelle canonique, sans le récepteur implicite.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Copie privée des types résolus.
     * @Paramètre(naturel64: gauche) Nœud de la méthode déclarée.
     * @Paramètre(naturel64: droite) Nœud de la méthode virtuelle héritée.
     * @Retourner(booléen) Même nom, mêmes paramètres explicites et même type de retour.
     * @etc. Tous les destructeurs partagent le nom source du bootstrap, quelle que soit leur classe.
     **/
    booléen MemesClesMethodesVirtuellesSemantiques(
        EtatAnalyseSemantique* etat, naturel64 gauche, naturel64 droite) {

        constante NoeudDeclaration* methodeGauche = &etat->Requete->Noeuds[gauche];
        constante NoeudDeclaration* methodeDroite = &etat->Requete->Noeuds[droite];
        si (methodeGauche->Genre != methodeDroite->Genre
            || methodeGauche->HachageType != methodeDroite->HachageType)
            retourner faux;
        si (methodeGauche->Genre != 14 && methodeGauche->HachageNom != methodeDroite->HachageNom)
            retourner faux;
        naturel64 nombre = CompterParametresFonctionSemantique(etat, gauche);
        si (nombre != CompterParametresFonctionSemantique(etat, droite)) retourner faux;
        naturel64 position = 0;
        tantque (position < nombre) {

            naturel64 parametreGauche = TrouverParametreFonctionSemantique(etat, gauche, position);
            naturel64 parametreDroite = TrouverParametreFonctionSemantique(etat, droite, position);
            si (etat->Requete->Noeuds[parametreGauche].HachageType
                != etat->Requete->Noeuds[parametreDroite].HachageType)
                retourner faux;
            position = position + 1;
        }
        retourner vrai;
    }

    /**
     * <résumé>Contrôle les remplacements d'une classe dont les ancêtres ont déjà été validés.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Bases canoniques et signatures privées.
     * @Paramètre(naturel64: indexType) Symbole de la classe à contrôler.
     * @Retourner(ErreurAnalyseSemantique) Premier refus à la position de la méthode, ou réussite.
     **/
    ErreurAnalyseSemantique ValiderRemplacementsClasseSemantiques(
        EtatAnalyseSemantique* etat, naturel64 indexType) {

        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {

            SymboleSemantique* symbole = &etat->SymbolesTravail[index];
            constante NoeudDeclaration* methode = &etat->Requete->Noeuds[symbole->IndexNoeud];
            si (symbole->Genre == 2 && symbole->IndexPortee == indexNoeudType
                && (methode->Genre == 12 || methode->Genre == 14 || methode->Genre == 15)) {

                booléen existe = faux;
                naturel64 base = etat->TypesBases[indexType];
                tantque (base < etat->NombreSymboles && !existe) {

                    naturel64 indexNoeudBase = etat->SymbolesTravail[base].IndexNoeud;
                    naturel64 candidat = 0;
                    tantque (candidat < etat->NombreSymboles && !existe) {

                        SymboleSemantique* symboleBase = &etat->SymbolesTravail[candidat];
                        constante NoeudDeclaration* methodeBase = &etat->Requete->Noeuds[symboleBase->IndexNoeud];
                        si (symboleBase->Genre == 2 && symboleBase->IndexPortee == indexNoeudBase
                            && (methodeBase->Drapeaux & 64) != 0
                            && MemesClesMethodesVirtuellesSemantiques(etat, symbole->IndexNoeud, symboleBase->IndexNoeud))
                            existe = vrai;
                        candidat = candidat + 1;
                    }
                    base = etat->TypesBases[base];
                }
                si ((methode->Drapeaux & 128) != 0 && !existe)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::RemplacementVirtuelIncompatible,
                        symbole->IndexNoeud, 0);
                si ((methode->Drapeaux & 128) == 0 && existe)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::RemplacementVirtuelRequis,
                        symbole->IndexNoeud, 0);
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Valide les méthodes virtuelles dans l'ordre base puis dérivée du bootstrap.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Dispositions déjà calculées et hiérarchies sans cycle.
     * @Retourner(ErreurAnalyseSemantique) État du contrôle de toutes les classes, même inutilisées.
     * @etc. La pile et les états sont privés à l'arène ; aucun nœud ni symbole public n'est modifié.
     **/
    ErreurAnalyseSemantique ValiderRemplacementsVirtuelsSemantiques(EtatAnalyseSemantique* etat) {

        octet* etats = convertir<octet*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, etat->NombreSymboles, 1));
        naturel64* pile = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(&etat->Arene, etat->NombreSymboles * 8, 8));
        si (etats == NulEtatsDispositionSemantique || pile == NulNaturelsDispositionSemantique)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {

            etats[index] = 0;
            index = index + 1;
        }
        index = 0;
        tantque (index < etat->NombreSymboles) {

            SymboleSemantique* symbole = &etat->SymbolesTravail[index];
            si (symbole->Genre == 1 && etat->Requete->Noeuds[symbole->IndexNoeud].Genre == 6 && etats[index] == 0) {

                naturel64 sommet = 0;
                naturel64 courant = index;
                tantque (courant < etat->NombreSymboles && etats[courant] == 0) {

                    etats[courant] = 1;
                    pile[sommet] = courant;
                    sommet = sommet + 1;
                    courant = etat->TypesBases[courant];
                }
                si (courant < etat->NombreSymboles && etats[courant] == 1)
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::CycleTypeParValeur,
                        etat->SymbolesTravail[courant].IndexNoeud, 0);
                tantque (sommet != 0) {

                    sommet = sommet - 1;
                    courant = pile[sommet];
                    ErreurAnalyseSemantique erreur = ValiderRemplacementsClasseSemantiques(etat, courant);
                    si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
                    etats[courant] = 2;
                }
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Contrôle une déclaration globale avant son initialiseur et avant la globale suivante.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST et types canoniques privés.
     * @Paramètre(naturel64: index) Déclaration globale analysée dans l'ordre source.
     * @Retourner(ErreurAnalyseSemantique) Premier refus structurel de cette déclaration.
     **/
    ErreurAnalyseSemantique ValiderGlobaleSemantique(
        EtatAnalyseSemantique* etat, naturel64 index) {

        constante NoeudDeclaration* globale = &etat->Requete->Noeuds[index];
        DescriptionTypeJetonsSemantique typeGlobale;
        si (!LireTypeNoeudSemantique(etat, index, &typeGlobale))
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, index, 46);
        booléen estReference = (typeGlobale.Qualificatifs & 4) != 0;
        si (typeGlobale.Genre == 13 && typeGlobale.NiveauPointeur == 0 && !estReference) {

            naturel64 type = TrouverTypeDepuisHachageSemantique(etat, typeGlobale.HachageType, 0);
            si (type < etat->NombreSymboles
                && etat->Requete->Noeuds[etat->SymbolesTravail[type].IndexNoeud].Genre == 6)
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::ObjetClasseGlobalInterdit, index, convertir<naturel32>(type));
        }
        si (estReference)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::ReferenceGlobaleInterdite, index, 0);
        si (typeGlobale.Genre == 12 && typeGlobale.NiveauPointeur == 0)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::GlobaleVideInterdite, index, 0);
        si ((globale->Drapeaux & 2) != 0) {

            si ((globale->Drapeaux & 1) != 0)
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::GlobaleExternePubliqueInterdite, index, 0);
        }
        sinon si ((typeGlobale.Qualificatifs & 1) != 0
            && typeGlobale.NiveauPointeur == 0 && typeGlobale.Genre != 14 && (globale->Drapeaux & 4) == 0)
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::GlobaleConstanteNonInitialisee, index, 0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 CompterChampsTypeAgregeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        si (indexType >= etat->NombreSymboles)
            retourner 0;
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 nombre = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 5
                && candidat->IndexPortee == indexNoeudType)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 TrouverChampTypeAgregeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 position) {
        si (indexType >= etat->NombreSymboles)
            retourner etat->NombreSymboles;
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 nombre = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 5
                && candidat->IndexPortee == indexNoeudType) {
                si (nombre == position) retourner index;
                nombre = nombre + 1;
            }
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    externe ErreurAnalyseSemantique ResoudreExpressionsSemantiques(
        EtatAnalyseSemantique* etat, naturel64 debut, naturel64 fin);

    externe ErreurAnalyseSemantique
        ValiderInitialiseurDestinationSemantique(
            EtatAnalyseSemantique* etat,
            naturel64 indexExpression,
            DestinationInitialiseurSemantique* destination);

    ErreurAnalyseSemantique ValiderInitialiseurDestinationSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        DestinationInitialiseurSemantique* destination) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                destination->IndexNoeudDeclaration,
                42);
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];

        /** <résumé>Le contexte typé contrôle la forme agrégée avant de résoudre chaque feuille.</résumé> **/
        si ((destination->Reserve & 1) != 0 && expression->Genre != 32) {

            naturel64 finExpression = indexExpression + 1;
            tantque (finExpression < etat->Requete->NombreNoeuds
                && etat->Requete->Noeuds[finExpression].Parent >= indexExpression)
                finExpression = finExpression + 1;
            ErreurAnalyseSemantique erreurResolution = ResoudreExpressionsSemantiques(
                etat, indexExpression, finExpression);
            si (erreurResolution != ErreurAnalyseSemantique::Reussite) retourner erreurResolution;
        }

        si (EstTypeReferenceSemantique(
                etat, destination->HachageElement)) {
            si (expression->Genre == 32
                || !LiaisonReferenceCompatibleSemantique(
                    etat,
                    indexExpression,
                    destination->HachageElement))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::LiaisonReferenceIncompatible,
                    indexExpression,
                    0);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (destination->ProfondeurTableau
            < destination->NombreDimensions) {
            si (expression->Genre != 32)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        TypeElementInitialiseurAgregeIncompatible,
                    indexExpression,
                    destination->ProfondeurTableau);
            naturel64 capaciteTableau = 0;
            si (!LireDimensionNoeudSemantique(
                    etat,
                    destination->IndexNoeudDeclaration,
                    destination->ProfondeurTableau,
                    &capaciteTableau))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    destination->IndexNoeudDeclaration,
                    43);
            naturel64 nombreElementsTableau =
                CompterEnfantsDirectsSemantique(
                etat, indexExpression);
            si (nombreElementsTableau > capaciteTableau)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        TropElementsInitialiseurTableau,
                    indexExpression,
                    convertir<naturel32>(nombreElementsTableau));
            DestinationInitialiseurSemantique destinationElement =
                *destination;
            destinationElement.ProfondeurTableau =
                destinationElement.ProfondeurTableau + 1;
            naturel64 indexElementTableau = 0;
            tantque (indexElementTableau < nombreElementsTableau) {
                naturel64 elementTableau = TrouverEnfantDirectSemantique(
                    etat, indexExpression, indexElementTableau);
                ErreurAnalyseSemantique erreurElementTableau =
                    ValiderInitialiseurDestinationSemantique(
                        etat, elementTableau, &destinationElement);
                si (erreurElementTableau
                    != ErreurAnalyseSemantique::Reussite)
                    retourner erreurElementTableau;
                indexElementTableau = indexElementTableau + 1;
            }
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (expression->Genre == 32) {
            naturel64 type = TrouverTypeDepuisHachageSemantique(
                etat, destination->HachageElement, 0);
            si (type < etat->NombreSymboles) {
                naturel32 genreType = etat->Requete->Noeuds[
                    etat->SymbolesTravail[type].IndexNoeud].Genre;
                si (genreType == 6)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::InitialiseurClasseInterdit,
                        indexExpression,
                        convertir<naturel32>(type));
                si (genreType == 4 || genreType == 5) {
                    naturel64 nombreChamps =
                        CompterChampsTypeAgregeSemantique(etat, type);
                    naturel64 capaciteStructure = nombreChamps;
                    si (genreType == 5 && capaciteStructure > 1)
                        capaciteStructure = 1;
                    naturel64 nombreElementsStructure =
                        CompterEnfantsDirectsSemantique(
                            etat, indexExpression);
                    si (nombreElementsStructure > capaciteStructure)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                TropElementsInitialiseurStructure,
                            indexExpression,
                            convertir<naturel32>(
                                nombreElementsStructure));
                    naturel64 indexElementStructure = 0;
                    tantque (indexElementStructure
                        < nombreElementsStructure) {
                        naturel64 champ = TrouverChampTypeAgregeSemantique(
                            etat, type, indexElementStructure);
                        si (champ >= etat->NombreSymboles)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::AstInvalide,
                                indexExpression,
                                44);
                        DestinationInitialiseurSemantique destinationChamp;
                        si (InitialiserDestinationInitialiseurSemantique(
                                etat,
                                etat->SymbolesTravail[champ].IndexNoeud,
                                &destinationChamp)) {
                            destinationChamp.Globale = destination->Globale;
                            destinationChamp.Reserve = destination->Reserve;
                            naturel64 elementStructure =
                                TrouverEnfantDirectSemantique(
                                    etat,
                                    indexExpression,
                                    indexElementStructure);
                            ErreurAnalyseSemantique erreurChamp =
                                ValiderInitialiseurDestinationSemantique(
                                    etat,
                                    elementStructure,
                                    &destinationChamp);
                            si (erreurChamp
                                != ErreurAnalyseSemantique::Reussite)
                                retourner erreurChamp;
                        }
                        indexElementStructure =
                            indexElementStructure + 1;
                    }
                    retourner ErreurAnalyseSemantique::Reussite;
                }
            }

            naturel64 nombreValeurs = CompterEnfantsDirectsSemantique(
                etat, indexExpression);
            si (nombreValeurs > 1)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        TropElementsInitialiseurScalaire,
                    indexExpression,
                    convertir<naturel32>(nombreValeurs));
            si (nombreValeurs == 1) {
                naturel64 valeur = TrouverEnfantDirectSemantique(
                    etat, indexExpression, 0);
                retourner ValiderInitialiseurDestinationSemantique(
                    etat, valeur, destination);
            }
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (!InitialiseurCompatibleTypeSemantique(
                etat, indexExpression, destination->HachageElement)) {
            si (etat->Requete->Resultat.Erreur
                != ErreurAnalyseSemantique::Reussite)
                retourner etat->Requete->Resultat.Erreur;
            si ((destination->Globale != 0 || (destination->Reserve & 1) != 0)
                && etat->ConstanteHorsPlage != 0)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::ConstanteHorsPlageType,
                    indexExpression,
                    0);
            /**
             * <résumé>Seule l'incompatibilité avec le champ devient 37 ; les refus internes
             * déjà signalés pendant la résolution de l'expression conservent leur origine.</résumé>
             **/
            si ((destination->Reserve & 2) != 0)
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::TypeInitialiseurChampIncompatible,
                    indexExpression, convertir<naturel32>(TrouverSymboleNoeudSemantique(
                        etat, destination->IndexNoeudDeclaration, 5)));
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::
                    TypeElementInitialiseurAgregeIncompatible,
                indexExpression,
                0);
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderInitialiseurDeclarationSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexDeclaration,
        naturel64 indexExpression) {
        DestinationInitialiseurSemantique destination;
        si (!InitialiserDestinationInitialiseurSemantique(
                etat, indexDeclaration, &destination))
            retourner ErreurAnalyseSemantique::Reussite;
        si (destination.NombreDimensions != 0
            && etat->Requete->Noeuds[indexExpression].Genre != 32)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::InitialiseurTableauNonAgrege,
                indexDeclaration,
                destination.NombreDimensions);
        retourner ValiderInitialiseurDestinationSemantique(
            etat, indexExpression, &destination);
    }

    ErreurAnalyseSemantique ValiderInitialiseursAgregesSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[index];
            si ((noeud->Genre == 3
                    || noeud->Genre == 19)
                && (noeud->Drapeaux & 4) != 0) {
                naturel64 expressionDeclaration =
                    TrouverEnfantDirectSemantique(
                    etat, index, 0);
                si (expressionDeclaration >= etat->Requete->NombreNoeuds)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AstInvalide,
                        index,
                        45);
                DestinationInitialiseurSemantique destinationDeclaration;
                si (InitialiserDestinationInitialiseurSemantique(
                        etat, index, &destinationDeclaration)) {
                    si (!(noeud->Genre == 3
                            && EstDestinationClasseSemantique(
                                etat, &destinationDeclaration))) {
                        ErreurAnalyseSemantique erreurDeclaration =
                            ValiderInitialiseurDeclarationSemantique(
                                etat, index, expressionDeclaration);
                        si (erreurDeclaration
                            != ErreurAnalyseSemantique::Reussite)
                            retourner erreurDeclaration;
                    }
                }
            }
            sinon si (noeud->Genre == 35) {
                naturel64 cible = etat->CiblesInitialiseurs[index];
                si (cible < etat->NombreSymboles
                    && etat->SymbolesTravail[cible].Genre == 5) {
                    naturel64 indexChamp = etat->SymbolesTravail[
                        cible].IndexNoeud;
                    naturel64 expressionChamp =
                        TrouverEnfantDirectSemantique(
                        etat, index, 0);
                    DestinationInitialiseurSemantique destinationChamp;
                    si (expressionChamp < etat->Requete->NombreNoeuds
                        && InitialiserDestinationInitialiseurSemantique(
                            etat, indexChamp, &destinationChamp)
                        && !EstDestinationClasseSemantique(
                            etat, &destinationChamp)
                        && (destinationChamp.NombreDimensions != 0
                            || etat->Requete->Noeuds[
                                expressionChamp].Genre == 32)) {
                        ErreurAnalyseSemantique erreurInitialiseurChamp =
                            ValiderInitialiseurDestinationSemantique(
                                etat,
                                expressionChamp,
                                &destinationChamp);
                        si (erreurInitialiseurChamp
                            != ErreurAnalyseSemantique::Reussite)
                            retourner erreurInitialiseurChamp;
                    }
                }
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * Vérifie la forme constante d'une expression globale sans encore
     * calculer sa valeur numérique.
     * @Paramètre(EtatAnalyseSemantique*: etat) État sémantique courant.
     * @Paramètre(naturel64: indexExpression) Expression à examiner.
     * @Retourner(booléen) Vrai pour une forme constante structurelle.
     **/
    booléen EstExpressionConstanteGlobaleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner faux;
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        si (expression->Genre == 22) retourner vrai;
        si (expression->Genre == 24) {
            naturel64 cible = TrouverCibleSymboleExpressionSemantique(
                etat, indexExpression);
            retourner cible < etat->NombreSymboles
                && etat->SymbolesTravail[cible].Genre == 7;
        }
        si (expression->Genre == 25) {
            si (expression->HachageNom
                    != HacherOperateurExpressionSemantique(43, 0)
                && expression->HachageNom
                    != HacherOperateurExpressionSemantique(45, 0)
                && expression->HachageNom
                    != HacherOperateurExpressionSemantique(33, 0)
                && expression->HachageNom
                    != HacherOperateurExpressionSemantique(126, 0))
                retourner faux;
            naturel64 operande = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner EstExpressionConstanteGlobaleSemantique(
                etat, operande);
        }
        si (expression->Genre == 26) {
            naturel64 gauche = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            naturel64 droite = TrouverEnfantDirectSemantique(
                etat, indexExpression, 1);
            retourner EstExpressionConstanteGlobaleSemantique(etat, gauche)
                && EstExpressionConstanteGlobaleSemantique(etat, droite);
        }
        si (expression->Genre == 31) {
            naturel64 valeur = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner EstExpressionConstanteGlobaleSemantique(
                etat, valeur);
        }
        retourner faux;
    }

    booléen DecrireTypeNumeriqueSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachageType,
        DescriptionTypeNumeriqueSemantique* description) {
        description->Largeur = 0;
        description->Signe = 0;
        description->Booleen = 0;
        description->Enumeration = 0;

        naturel32 genre = 1;
        tantque (genre <= 11) {
            naturel32 qualificatifs = 0;
            tantque (qualificatifs < 4) {
                si (hachageType == HacherTypeSimpleSemantique(
                        genre, qualificatifs, 0)) {
                    si (genre == 1 || genre == 5 || genre == 9
                        || genre == 10 || genre == 11)
                        description->Largeur = 8;
                    sinon si (genre == 2 || genre == 6)
                        description->Largeur = 16;
                    sinon si (genre == 3 || genre == 7)
                        description->Largeur = 32;
                    sinon description->Largeur = 64;
                    si (genre <= 4 || genre == 11)
                        description->Signe = 1;
                    si (genre == 9) description->Booleen = 1;
                    retourner vrai;
                }
                qualificatifs = qualificatifs + 1;
            }
            genre = genre + 1;
        }

        naturel64 type = TrouverTypeDepuisHachageSemantique(
            etat, hachageType, 0);
        si (type < etat->NombreSymboles
            && etat->Requete->Noeuds[
                etat->SymbolesTravail[type].IndexNoeud].Genre == 8) {
            description->Largeur = 32;
            description->Signe = 1;
            description->Enumeration = 1;
            retourner vrai;
        }
        retourner faux;
    }

    naturel64 NormaliserValeurNumeriqueSemantique(
        naturel64 valeur,
        DescriptionTypeNumeriqueSemantique* description) {
        si (description->Largeur == 0 || description->Largeur == 64)
            retourner valeur;
        retourner valeur
            & ((convertir<naturel64>(1) << description->Largeur) - 1);
    }

    entier64 InterpreterSigneNumeriqueSemantique(
        naturel64 valeur,
        DescriptionTypeNumeriqueSemantique* description) {
        valeur = NormaliserValeurNumeriqueSemantique(
            valeur, description);
        si (description->Largeur == 64) {
            si (valeur <= 9_223_372_036_854_775_807)
                retourner convertir<entier64>(valeur);
            retourner -1 - convertir<entier64>(
                18_446_744_073_709_551_615 - valeur);
        }
        naturel64 signe = convertir<naturel64>(1)
            << (description->Largeur - 1);
        si ((valeur & signe) == 0)
            retourner convertir<entier64>(valeur);
        naturel64 masque = (convertir<naturel64>(1)
            << description->Largeur) - 1;
        naturel64 magnitude = ((~valeur) & masque) + 1;
        retourner -convertir<entier64>(magnitude);
    }

    naturel64 ConvertirSigneEnNaturelSemantique(entier64 valeur) {
        si (valeur >= 0) retourner convertir<naturel64>(valeur);
        retourner 0 - convertir<naturel64>(-(valeur + 1)) - 1;
    }

    naturel64 ConvertirBooleenEnNaturelSemantique(booléen valeur) {
        si (valeur) retourner 1;
        retourner 0;
    }

    booléen ValeurDansTypeNumeriqueSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 valeur,
        naturel64 typeSource,
        naturel64 typeDestination) {
        DescriptionTypeNumeriqueSemantique source;
        DescriptionTypeNumeriqueSemantique destination;
        si (!DecrireTypeNumeriqueSemantique(
                etat, typeSource, &source)
            || !DecrireTypeNumeriqueSemantique(
                etat, typeDestination, &destination))
            retourner faux;

        si (destination.Booleen != 0) {
            si (source.Signe != 0) {
                entier64 signeeBooleenne =
                    InterpreterSigneNumeriqueSemantique(
                    valeur, &source);
                retourner signeeBooleenne == 0
                    || signeeBooleenne == 1;
            }
            naturel64 nonSigneeBooleenne =
                NormaliserValeurNumeriqueSemantique(
                valeur, &source);
            retourner nonSigneeBooleenne == 0
                || nonSigneeBooleenne == 1;
        }

        si (source.Signe != 0) {
            entier64 signeeSource = InterpreterSigneNumeriqueSemantique(
                valeur, &source);
            si (destination.Signe == 0) {
                si (signeeSource < 0) retourner faux;
                naturel64 maximumNonSigne =
                    18_446_744_073_709_551_615;
                si (destination.Largeur != 64)
                    maximumNonSigne = (convertir<naturel64>(1)
                        << destination.Largeur) - 1;
                retourner convertir<naturel64>(signeeSource)
                    <= maximumNonSigne;
            }
            si (destination.Largeur == 64) retourner vrai;
            entier64 maximumSigne = convertir<entier64>(
                (convertir<naturel64>(1)
                    << (destination.Largeur - 1)) - 1);
            entier64 minimumSigne = -maximumSigne - 1;
            retourner signeeSource >= minimumSigne
                && signeeSource <= maximumSigne;
        }

        naturel64 nonSigneeSource = NormaliserValeurNumeriqueSemantique(
            valeur, &source);
        si (destination.Signe != 0) {
            naturel64 maximumSigneDestination =
                9_223_372_036_854_775_807;
            si (destination.Largeur != 64)
                maximumSigneDestination = (convertir<naturel64>(1)
                    << (destination.Largeur - 1)) - 1;
            retourner nonSigneeSource <= maximumSigneDestination;
        }
        naturel64 maximumDestination =
            18_446_744_073_709_551_615;
        si (destination.Largeur != 64)
            maximumDestination = (convertir<naturel64>(1)
                << destination.Largeur) - 1;
        retourner nonSigneeSource <= maximumDestination;
    }

    ErreurAnalyseSemantique EvaluerConstanteNumeriqueSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64* valeur) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexExpression,
                50);
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        si (expression->Genre == 22) {
            *valeur = expression->HachageType;
            retourner ErreurAnalyseSemantique::Reussite;
        }
        si (expression->Genre == 24) {
            naturel64 cible = TrouverCibleSymboleExpressionSemantique(
                etat, indexExpression);
            si (cible < etat->NombreSymboles
                && etat->SymbolesTravail[cible].Genre == 7) {
                naturel64 indexEnumerateur = etat->SymbolesTravail[
                    cible].IndexNoeud;
                si (indexEnumerateur < etat->Requete->NombreNoeuds
                    && etat->EtatsEnumerateurs[indexEnumerateur] == 2) {
                    *valeur = etat->ValeursEnumerateurs[indexEnumerateur];
                    retourner ErreurAnalyseSemantique::Reussite;
                }
            }
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexExpression,
                51);
        }
        si (expression->Genre == 25) {
            naturel64 operande = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            naturel64 valeurOperande = 0;
            ErreurAnalyseSemantique erreurOperande =
                EvaluerConstanteNumeriqueSemantique(
                    etat, operande, &valeurOperande);
            si (erreurOperande != ErreurAnalyseSemantique::Reussite)
                retourner erreurOperande;
            DescriptionTypeNumeriqueSemantique typeExpression;
            si (!DecrireTypeNumeriqueSemantique(
                    etat,
                    HachageTypeExpressionSemantique(
                        etat, indexExpression),
                    &typeExpression))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    indexExpression,
                    52);
            si (expression->HachageNom
                == HacherOperateurExpressionSemantique(43, 0))
                *valeur = NormaliserValeurNumeriqueSemantique(
                    valeurOperande, &typeExpression);
            sinon si (expression->HachageNom
                == HacherOperateurExpressionSemantique(45, 0))
                *valeur = NormaliserValeurNumeriqueSemantique(
                    0 - valeurOperande, &typeExpression);
            sinon si (expression->HachageNom
                == HacherOperateurExpressionSemantique(33, 0)) {
                si (valeurOperande == 0) *valeur = 1;
                sinon *valeur = 0;
            }
            sinon si (expression->HachageNom
                == HacherOperateurExpressionSemantique(126, 0))
                *valeur = NormaliserValeurNumeriqueSemantique(
                    ~valeurOperande, &typeExpression);
            sinon retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexExpression,
                53);
            retourner ErreurAnalyseSemantique::Reussite;
        }
        si (expression->Genre == 26) {
            naturel64 gauche = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            naturel64 droite = TrouverEnfantDirectSemantique(
                etat, indexExpression, 1);
            naturel64 valeurGauche = 0;
            ErreurAnalyseSemantique erreurGauche =
                EvaluerConstanteNumeriqueSemantique(
                    etat, gauche, &valeurGauche);
            si (erreurGauche != ErreurAnalyseSemantique::Reussite)
                retourner erreurGauche;

            si (expression->HachageNom
                == HacherOperateurExpressionSemantique(38, 38)) {
                si (valeurGauche == 0) {
                    *valeur = 0;
                    retourner ErreurAnalyseSemantique::Reussite;
                }
            }
            sinon si (expression->HachageNom
                == HacherOperateurExpressionSemantique(124, 124)) {
                si (valeurGauche != 0) {
                    *valeur = 1;
                    retourner ErreurAnalyseSemantique::Reussite;
                }
            }

            naturel64 valeurDroite = 0;
            ErreurAnalyseSemantique erreurDroite =
                EvaluerConstanteNumeriqueSemantique(
                    etat, droite, &valeurDroite);
            si (erreurDroite != ErreurAnalyseSemantique::Reussite)
                retourner erreurDroite;
            si (expression->HachageNom
                == HacherOperateurExpressionSemantique(38, 38)) {
                si (valeurDroite != 0) *valeur = 1;
                sinon *valeur = 0;
                retourner ErreurAnalyseSemantique::Reussite;
            }
            si (expression->HachageNom
                == HacherOperateurExpressionSemantique(124, 124)) {
                si (valeurDroite != 0) *valeur = 1;
                sinon *valeur = 0;
                retourner ErreurAnalyseSemantique::Reussite;
            }

            DescriptionTypeNumeriqueSemantique typeGauche;
            DescriptionTypeNumeriqueSemantique typeDroite;
            DescriptionTypeNumeriqueSemantique typeExpressionBinaire;
            si (!DecrireTypeNumeriqueSemantique(
                    etat,
                    HachageTypeExpressionSemantique(etat, gauche),
                    &typeGauche)
                || !DecrireTypeNumeriqueSemantique(
                    etat,
                    HachageTypeExpressionSemantique(etat, droite),
                    &typeDroite)
                || !DecrireTypeNumeriqueSemantique(
                    etat,
                    HachageTypeExpressionSemantique(
                        etat, indexExpression),
                    &typeExpressionBinaire))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    indexExpression,
                    54);

            naturel64 hachageOperateur = expression->HachageNom;
            si (hachageOperateur
                == HacherOperateurExpressionSemantique(43, 0))
                *valeur = NormaliserValeurNumeriqueSemantique(
                    valeurGauche + valeurDroite,
                    &typeExpressionBinaire);
            sinon si (hachageOperateur
                == HacherOperateurExpressionSemantique(45, 0))
                *valeur = NormaliserValeurNumeriqueSemantique(
                    valeurGauche - valeurDroite,
                    &typeExpressionBinaire);
            sinon si (hachageOperateur
                == HacherOperateurExpressionSemantique(42, 0))
                *valeur = NormaliserValeurNumeriqueSemantique(
                    valeurGauche * valeurDroite,
                    &typeExpressionBinaire);
            sinon si (hachageOperateur
                == HacherOperateurExpressionSemantique(38, 0))
                *valeur = NormaliserValeurNumeriqueSemantique(
                    valeurGauche & valeurDroite,
                    &typeExpressionBinaire);
            sinon si (hachageOperateur
                == HacherOperateurExpressionSemantique(124, 0))
                *valeur = NormaliserValeurNumeriqueSemantique(
                    valeurGauche | valeurDroite,
                    &typeExpressionBinaire);
            sinon si (hachageOperateur
                == HacherOperateurExpressionSemantique(94, 0))
                *valeur = NormaliserValeurNumeriqueSemantique(
                    valeurGauche ^ valeurDroite,
                    &typeExpressionBinaire);
            sinon si (hachageOperateur
                    == HacherOperateurExpressionSemantique(60, 60)
                || hachageOperateur
                    == HacherOperateurExpressionSemantique(62, 62)) {
                naturel64 distance = valeurDroite
                    & convertir<naturel64>(typeGauche.Largeur - 1);
                si (hachageOperateur
                    == HacherOperateurExpressionSemantique(60, 60))
                    *valeur = NormaliserValeurNumeriqueSemantique(
                        NormaliserValeurNumeriqueSemantique(
                            valeurGauche, &typeGauche) << distance,
                        &typeExpressionBinaire);
                sinon si (typeGauche.Signe != 0) {
                    entier64 gaucheSigneeDecalage =
                        InterpreterSigneNumeriqueSemantique(
                            valeurGauche, &typeGauche);
                    *valeur = NormaliserValeurNumeriqueSemantique(
                        ConvertirSigneEnNaturelSemantique(
                            gaucheSigneeDecalage >> distance),
                        &typeExpressionBinaire);
                }
                sinon *valeur = NormaliserValeurNumeriqueSemantique(
                    NormaliserValeurNumeriqueSemantique(
                        valeurGauche, &typeGauche) >> distance,
                    &typeExpressionBinaire);
            }
            sinon si (hachageOperateur
                    == HacherOperateurExpressionSemantique(47, 0)
                || hachageOperateur
                    == HacherOperateurExpressionSemantique(37, 0)) {
                naturel64 droiteNormaliseeDivision =
                    NormaliserValeurNumeriqueSemantique(
                        valeurDroite, &typeGauche);
                si (droiteNormaliseeDivision == 0)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::DivisionConstanteParZero,
                        indexExpression,
                        0);
                naturel64 resultatDivision = 0;
                si (typeGauche.Signe != 0) {
                    naturel64 gaucheNormaliseeDivision =
                        NormaliserValeurNumeriqueSemantique(
                            valeurGauche, &typeGauche);
                    si (typeGauche.Largeur == 64
                        && gaucheNormaliseeDivision
                            == 9_223_372_036_854_775_808
                        && droiteNormaliseeDivision
                            == 18_446_744_073_709_551_615) {
                        si (hachageOperateur
                            == HacherOperateurExpressionSemantique(47, 0))
                            resultatDivision = gaucheNormaliseeDivision;
                        sinon resultatDivision = 0;
                    }
                    sinon {
                        entier64 gaucheSigneeDivision =
                            InterpreterSigneNumeriqueSemantique(
                                valeurGauche, &typeGauche);
                        entier64 droiteSigneeDivision =
                            InterpreterSigneNumeriqueSemantique(
                                valeurDroite, &typeGauche);
                        entier64 resultatSigne = 0;
                        si (hachageOperateur
                            == HacherOperateurExpressionSemantique(47, 0))
                            resultatSigne = gaucheSigneeDivision
                                / droiteSigneeDivision;
                        sinon resultatSigne = gaucheSigneeDivision
                            % droiteSigneeDivision;
                        resultatDivision =
                            ConvertirSigneEnNaturelSemantique(
                                resultatSigne);
                    }
                }
                sinon {
                    naturel64 gaucheNonSigneeDivision =
                        NormaliserValeurNumeriqueSemantique(
                            valeurGauche, &typeGauche);
                    si (hachageOperateur
                        == HacherOperateurExpressionSemantique(47, 0))
                        resultatDivision =
                            gaucheNonSigneeDivision
                                / droiteNormaliseeDivision;
                    sinon resultatDivision =
                        gaucheNonSigneeDivision
                            % droiteNormaliseeDivision;
                }
                *valeur = NormaliserValeurNumeriqueSemantique(
                    resultatDivision, &typeExpressionBinaire);
            }
            sinon si (hachageOperateur
                    == HacherOperateurExpressionSemantique(61, 61)
                || hachageOperateur
                    == HacherOperateurExpressionSemantique(33, 61)) {
                naturel64 gaucheNormaliseeEgalite =
                    NormaliserValeurNumeriqueSemantique(
                        valeurGauche, &typeGauche);
                naturel64 droiteNormaliseeEgalite =
                    NormaliserValeurNumeriqueSemantique(
                        valeurDroite, &typeDroite);
                si (hachageOperateur
                    == HacherOperateurExpressionSemantique(61, 61))
                    *valeur = ConvertirBooleenEnNaturelSemantique(
                        gaucheNormaliseeEgalite
                            == droiteNormaliseeEgalite);
                sinon *valeur = ConvertirBooleenEnNaturelSemantique(
                    gaucheNormaliseeEgalite
                        != droiteNormaliseeEgalite);
            }
            sinon si (typeGauche.Signe != 0) {
                entier64 gaucheSigneeComparaison =
                    InterpreterSigneNumeriqueSemantique(
                        valeurGauche, &typeGauche);
                entier64 droiteSigneeComparaison =
                    InterpreterSigneNumeriqueSemantique(
                        valeurDroite, &typeDroite);
                si (hachageOperateur
                    == HacherOperateurExpressionSemantique(60, 0))
                    *valeur = ConvertirBooleenEnNaturelSemantique(
                        gaucheSigneeComparaison
                            < droiteSigneeComparaison);
                sinon si (hachageOperateur
                    == HacherOperateurExpressionSemantique(60, 61))
                    *valeur = ConvertirBooleenEnNaturelSemantique(
                        gaucheSigneeComparaison
                            <= droiteSigneeComparaison);
                sinon si (hachageOperateur
                    == HacherOperateurExpressionSemantique(62, 0))
                    *valeur = ConvertirBooleenEnNaturelSemantique(
                        gaucheSigneeComparaison
                            > droiteSigneeComparaison);
                sinon si (hachageOperateur
                    == HacherOperateurExpressionSemantique(62, 61))
                    *valeur = ConvertirBooleenEnNaturelSemantique(
                        gaucheSigneeComparaison
                            >= droiteSigneeComparaison);
                sinon retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    indexExpression,
                    55);
            }
            sinon {
                naturel64 gaucheNonSigneeComparaison =
                    NormaliserValeurNumeriqueSemantique(
                        valeurGauche, &typeGauche);
                naturel64 droiteNonSigneeComparaison =
                    NormaliserValeurNumeriqueSemantique(
                        valeurDroite, &typeDroite);
                si (hachageOperateur
                    == HacherOperateurExpressionSemantique(60, 0))
                    *valeur = ConvertirBooleenEnNaturelSemantique(
                        gaucheNonSigneeComparaison
                            < droiteNonSigneeComparaison);
                sinon si (hachageOperateur
                    == HacherOperateurExpressionSemantique(60, 61))
                    *valeur = ConvertirBooleenEnNaturelSemantique(
                        gaucheNonSigneeComparaison
                            <= droiteNonSigneeComparaison);
                sinon si (hachageOperateur
                    == HacherOperateurExpressionSemantique(62, 0))
                    *valeur = ConvertirBooleenEnNaturelSemantique(
                        gaucheNonSigneeComparaison
                            > droiteNonSigneeComparaison);
                sinon si (hachageOperateur
                    == HacherOperateurExpressionSemantique(62, 61))
                    *valeur = ConvertirBooleenEnNaturelSemantique(
                        gaucheNonSigneeComparaison
                            >= droiteNonSigneeComparaison);
                sinon retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    indexExpression,
                    56);
            }
            retourner ErreurAnalyseSemantique::Reussite;
        }
        si (expression->Genre == 31) {
            naturel64 indexValeur = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            naturel64 valeurSource = 0;
            ErreurAnalyseSemantique erreurValeur =
                EvaluerConstanteNumeriqueSemantique(
                    etat, indexValeur, &valeurSource);
            si (erreurValeur != ErreurAnalyseSemantique::Reussite)
                retourner erreurValeur;
            DescriptionTypeNumeriqueSemantique sourceConversion;
            DescriptionTypeNumeriqueSemantique cibleConversion;
            /** <résumé>Le type écrit du cast reste distinct de son adaptation implicite ultérieure.</résumé> **/
            DescriptionTypeJetonsSemantique typeCibleConversion;
            si (!LireTypeConversionSemantique(etat, indexExpression, &typeCibleConversion))
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::AstInvalide, indexExpression, 57);
            typeCibleConversion.Qualificatifs = typeCibleConversion.Qualificatifs & 3;
            naturel64 hachageCibleConversion = HacherDescriptionTypeJetonsSemantique(
                &typeCibleConversion);
            si (!DecrireTypeNumeriqueSemantique(
                    etat,
                    HachageTypeExpressionSemantique(etat, indexValeur),
                    &sourceConversion)
                || !DecrireTypeNumeriqueSemantique(
                    etat, hachageCibleConversion, &cibleConversion))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    indexExpression,
                    57);
            naturel64 valeurEtendue =
                NormaliserValeurNumeriqueSemantique(
                    valeurSource, &sourceConversion);
            si (sourceConversion.Signe != 0)
                valeurEtendue = ConvertirSigneEnNaturelSemantique(
                    InterpreterSigneNumeriqueSemantique(
                        valeurSource, &sourceConversion));
            si (cibleConversion.Booleen != 0) {
                si (valeurEtendue != 0) *valeur = 1;
                sinon *valeur = 0;
            }
            sinon *valeur = NormaliserValeurNumeriqueSemantique(
                valeurEtendue, &cibleConversion);
            si (cibleConversion.Booleen == 0
                && !ValeurDansTypeNumeriqueSemantique(etat, valeurSource,
                    HachageTypeExpressionSemantique(etat, indexValeur),
                    hachageCibleConversion))
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::ConstanteConversionHorsPlage,
                    indexExpression, 0);
            retourner ErreurAnalyseSemantique::Reussite;
        }
        retourner SignalerErreurSemantique(
            etat,
            ErreurAnalyseSemantique::InitialiseurGlobalNonConstant,
            indexExpression,
            0);
    }

    booléen ExisteEnumerateurSuivantSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexEnumerateur,
        naturel64 indexEnumeration) {
        naturel64 index = indexEnumerateur + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* candidat =
                &etat->Requete->Noeuds[index];
            si (candidat->Genre == 9
                && candidat->Parent == indexEnumeration)
                retourner vrai;
            index = index + 1;
        }
        retourner faux;
    }

    ErreurAnalyseSemantique CalculerEnumerationsSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 enumerationCourante = etat->Requete->NombreNoeuds;
        entier64 prochaineValeur = 0;
        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* enumerateur =
                &etat->Requete->Noeuds[index];
            si (enumerateur->Genre == 9) {
                si (enumerateur->Parent != enumerationCourante) {
                    enumerationCourante = enumerateur->Parent;
                    prochaineValeur = 0;
                }
                entier64 valeurSignee = prochaineValeur;
                si ((enumerateur->Drapeaux & 4) != 0) {
                    naturel64 expression = TrouverEnfantDirectSemantique(
                        etat, index, 0);
                    /** <résumé>Résout chaque initialiseur dans l'ordre avant de calculer les constantes utilisées par les appels.</résumé> **/
                    naturel64 finExpression = index + 1;
                    tantque (finExpression < etat->Requete->NombreNoeuds
                        && etat->Requete->Noeuds[finExpression].Parent >= index)
                        finExpression = finExpression + 1;
                    ErreurAnalyseSemantique erreurResolution = ResoudreExpressionsSemantiques(
                        etat, index + 1, finExpression);
                    si (erreurResolution != ErreurAnalyseSemantique::Reussite)
                        retourner erreurResolution;
                    DescriptionTypeNumeriqueSemantique typeExpression;
                    si (expression >= etat->Requete->NombreNoeuds
                        || !DecrireTypeNumeriqueSemantique(
                            etat,
                            HachageTypeExpressionSemantique(
                                etat, expression),
                            &typeExpression)
                        || typeExpression.Booleen != 0
                        || typeExpression.Enumeration != 0)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                ValeurEnumerationNonEntiere,
                            index,
                            0);
                    si (!EstExpressionConstanteGlobaleSemantique(
                            etat, expression))
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                ValeurEnumerationNonConstante,
                            index,
                            0);
                    naturel64 valeurExpression = 0;
                    ErreurAnalyseSemantique erreurExpression =
                        EvaluerConstanteNumeriqueSemantique(
                            etat, expression, &valeurExpression);
                    si (erreurExpression
                        != ErreurAnalyseSemantique::Reussite)
                        retourner erreurExpression;
                    si (typeExpression.Signe != 0)
                        valeurSignee = InterpreterSigneNumeriqueSemantique(
                            valeurExpression, &typeExpression);
                    sinon {
                        naturel64 valeurNonSignee =
                            NormaliserValeurNumeriqueSemantique(
                                valeurExpression, &typeExpression);
                        si (valeurNonSignee > 2_147_483_647)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::
                                    ValeurEnumerationHorsPlage,
                                index,
                                0);
                        valeurSignee = convertir<entier64>(
                            valeurNonSignee);
                    }
                }
                si (valeurSignee < -2_147_483_648
                    || valeurSignee > 2_147_483_647)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::
                            ValeurEnumerationHorsPlage,
                        index,
                        0);
                etat->ValeursEnumerateurs[index] =
                    ConvertirSigneEnNaturelSemantique(valeurSignee);
                etat->EtatsEnumerateurs[index] = 2;
                si (ExisteEnumerateurSuivantSemantique(
                        etat, index, enumerationCourante)
                    && valeurSignee == 2_147_483_647)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::
                            DebordementEnumerationSuivante,
                        index,
                        0);
                prochaineValeur = valeurSignee + 1;
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel32 GenrePointeurFonctionDestinationGlobaleSemantique(
        EtatAnalyseSemantique* etat,
        DestinationInitialiseurSemantique* destination) {
        DescriptionTypeJetonsSemantique typeDestination;
        si (!LireTypePointeurFonctionNoeudSemantique(
                etat,
                destination->IndexNoeudDeclaration,
                &typeDestination))
            retourner 0;
        si (typeDestination.NiveauPointeur == 0) retourner 1;
        retourner 2;
    }

    externe ErreurAnalyseSemantique
        ValiderInitialiseurGlobalDestinationSemantique(
            EtatAnalyseSemantique* etat,
            naturel64 indexExpression,
            DestinationInitialiseurSemantique* destination);

    /**
     * Applique récursivement les contraintes des initialiseurs émis dans la
     * zone de données globale du bootstrap.
     * @Paramètre(EtatAnalyseSemantique*: etat) État sémantique courant.
     * @Paramètre(naturel64: indexExpression) Expression à valider.
     * @Paramètre(DestinationInitialiseurSemantique*: destination) Type visé.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic rencontré.
     **/
    ErreurAnalyseSemantique ValiderInitialiseurGlobalDestinationSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        DestinationInitialiseurSemantique* destination) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                destination->IndexNoeudDeclaration,
                47);
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];

        si (expression->Genre == 32) {
            naturel64 nombreElements = CompterEnfantsDirectsSemantique(
                etat, indexExpression);
            si (destination->ProfondeurTableau
                < destination->NombreDimensions) {
                DestinationInitialiseurSemantique destinationElement =
                    *destination;
                destinationElement.ProfondeurTableau =
                    destinationElement.ProfondeurTableau + 1;
                naturel64 positionElement = 0;
                tantque (positionElement < nombreElements) {
                    naturel64 element = TrouverEnfantDirectSemantique(
                        etat, indexExpression, positionElement);
                    ErreurAnalyseSemantique erreurElement =
                        ValiderInitialiseurGlobalDestinationSemantique(
                            etat, element, &destinationElement);
                    si (erreurElement
                        != ErreurAnalyseSemantique::Reussite)
                        retourner erreurElement;
                    positionElement = positionElement + 1;
                }
                retourner ErreurAnalyseSemantique::Reussite;
            }

            naturel64 type = TrouverTypeDepuisHachageSemantique(
                etat, destination->HachageElement, 0);
            si (type < etat->NombreSymboles) {
                naturel32 genreType = etat->Requete->Noeuds[
                    etat->SymbolesTravail[type].IndexNoeud].Genre;
                si (genreType == 4 || genreType == 5) {
                    naturel64 positionChamp = 0;
                    tantque (positionChamp < nombreElements) {
                        naturel64 champ = TrouverChampTypeAgregeSemantique(
                            etat, type, positionChamp);
                        si (champ >= etat->NombreSymboles)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::AstInvalide,
                                indexExpression,
                                48);
                        DestinationInitialiseurSemantique destinationChamp;
                        si (InitialiserDestinationInitialiseurSemantique(
                                etat,
                                etat->SymbolesTravail[champ].IndexNoeud,
                                &destinationChamp)) {
                            destinationChamp.Globale = 1;
                            naturel64 elementChamp =
                                TrouverEnfantDirectSemantique(
                                    etat,
                                    indexExpression,
                                    positionChamp);
                            ErreurAnalyseSemantique erreurChamp =
                                ValiderInitialiseurGlobalDestinationSemantique(
                                    etat,
                                    elementChamp,
                                    &destinationChamp);
                            si (erreurChamp
                                != ErreurAnalyseSemantique::Reussite)
                                retourner erreurChamp;
                        }
                        positionChamp = positionChamp + 1;
                    }
                    retourner ErreurAnalyseSemantique::Reussite;
                }
            }

            si (nombreElements == 0)
                retourner ErreurAnalyseSemantique::Reussite;
            naturel64 valeurScalaire = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner ValiderInitialiseurGlobalDestinationSemantique(
                etat, valeurScalaire, destination);
        }

        naturel64 typeAgrege = TrouverTypeDepuisHachageSemantique(
            etat, destination->HachageElement, 0);
        si (typeAgrege < etat->NombreSymboles) {
            naturel32 genreAgrege = etat->Requete->Noeuds[
                etat->SymbolesTravail[typeAgrege].IndexNoeud].Genre;
            si (genreAgrege == 4 || genreAgrege == 5)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        InitialiseurGlobalAgregeRequis,
                    indexExpression,
                    convertir<naturel32>(typeAgrege));
        }

        naturel32 genrePointeurFonction =
            GenrePointeurFonctionDestinationGlobaleSemantique(
                etat, destination);
        si (genrePointeurFonction == 1) {
            naturel64 cibleExpression = indexExpression;
            si (expression->Genre == 25
                && expression->HachageNom
                    == HacherOperateurExpressionSemantique(38, 0))
                cibleExpression = TrouverEnfantDirectSemantique(
                    etat, indexExpression, 0);
            si (cibleExpression < etat->Requete->NombreNoeuds
                && etat->Requete->Noeuds[cibleExpression].Genre == 24) {
                naturel64 cibleFonction =
                    TrouverCibleSymboleExpressionSemantique(
                        etat, cibleExpression);
                si (cibleFonction < etat->NombreSymboles
                    && etat->SymbolesTravail[
                        cibleFonction].Genre == 2)
                    retourner ErreurAnalyseSemantique::Reussite;
            }
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::
                    CiblePointeurFonctionGlobalInvalide,
                indexExpression,
                0);
        }
        si (genrePointeurFonction == 2
            || EstTypeAdresseSemantique(
                etat, destination->HachageElement))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::
                    InitialiseurPointeurDonneesGlobalInterdit,
                indexExpression,
                0);
        si (!EstExpressionConstanteGlobaleSemantique(
                etat, indexExpression))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::InitialiseurGlobalNonConstant,
                indexExpression,
                0);
        naturel64 valeurConstante = 0;
        ErreurAnalyseSemantique erreurConstante =
            EvaluerConstanteNumeriqueSemantique(
                etat, indexExpression, &valeurConstante);
        si (erreurConstante != ErreurAnalyseSemantique::Reussite)
            retourner erreurConstante;
        naturel64 typeSource = HachageTypeExpressionSemantique(
            etat, indexExpression);
        si (!ValeurDansTypeNumeriqueSemantique(
                etat,
                valeurConstante,
                typeSource,
                destination->HachageElement))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ConstanteHorsPlageType,
                indexExpression,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Valide entièrement une globale avant les suivantes, en séparant types et valeurs constantes.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Résolutions et destinations privées ; AST public inchangé.
     * @Paramètre(naturel64: index) Déclaration globale dans l'ordre source.
     * @Retourner(ErreurAnalyseSemantique) Premier refus de déclaration, forme, type puis valeur constante.
     * @etc. Toutes les feuilles sont typées avant la passe constante ; aucune sortie d'émission n'est écrite ici.
     **/
    ErreurAnalyseSemantique ValiderInitialiseurGlobalContextuelSemantique(
        EtatAnalyseSemantique* etat, naturel64 index) {

        ErreurAnalyseSemantique erreur = ValiderGlobaleSemantique(etat, index);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
        constante NoeudDeclaration* globale = &etat->Requete->Noeuds[index];
        si ((globale->Drapeaux & 4) == 0 || (globale->Drapeaux & 2) != 0)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 expression = TrouverEnfantDirectSemantique(etat, index, 0);
        si (expression >= etat->Requete->NombreNoeuds)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, index, 49);
        DestinationInitialiseurSemantique destination;
        si (!InitialiserDestinationInitialiseurSemantique(etat, index, &destination))
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, index, 49);
        si (destination.NombreDimensions != 0 && etat->Requete->Noeuds[expression].Genre != 32)
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::InitialiseurTableauNonAgrege, index, destination.NombreDimensions);
        destination.Reserve = 1;
        erreur = ValiderInitialiseurDestinationSemantique(etat, expression, &destination);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
        retourner ValiderInitialiseurGlobalDestinationSemantique(etat, expression, &destination);
    }

    booléen EstValeurGaucheSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner faux;
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        si (expression->Genre == 24) {
            si (expression->HachageNom == HacherSoiSemantique())
                retourner vrai;
            naturel64 cibleValeurGauche =
                TrouverCibleSymboleExpressionSemantique(
                    etat, indexExpression);
            si (cibleValeurGauche >= etat->NombreSymboles)
                retourner faux;
            naturel32 genreValeurGauche = etat->SymbolesTravail[
                cibleValeurGauche].Genre;
            retourner genreValeurGauche != 2 && genreValeurGauche != 7;
        }
        si (expression->Genre == 29 || expression->Genre == 30)
            retourner vrai;
        si (expression->Genre == 25)
            retourner expression->HachageNom
                == HacherOperateurExpressionSemantique(42, 0);
        si (expression->Genre == 28) {
            naturel64 cibleAppelValeurGauche =
                TrouverEnfantDirectSemantique(etat, indexExpression, 0);
            naturel64 symboleAppelValeurGauche =
                TrouverCibleSymboleExpressionSemantique(
                    etat, cibleAppelValeurGauche);
            si (symboleAppelValeurGauche < etat->NombreSymboles
                && etat->SymbolesTravail[
                    symboleAppelValeurGauche].Genre == 2)
                retourner EstTypeReferenceSemantique(
                    etat,
                    etat->SymbolesTravail[
                        symboleAppelValeurGauche].HachageType);
            naturel64 typeCibleValeurGauche =
                HachageTypeExpressionSemantique(
                    etat, cibleAppelValeurGauche);
            naturel64 origineCibleValeurGauche =
                TrouverOrigineTypeExpressionSemantique(
                    etat, cibleAppelValeurGauche);
            DescriptionTypeJetonsSemantique descriptionAppelValeurGauche;
            si (LireDescriptionPointeurFonctionNoeudSemantique(
                    etat,
                    origineCibleValeurGauche,
                    typeCibleValeurGauche,
                    &descriptionAppelValeurGauche))
                retourner EstTypeReferenceSemantique(
                    etat,
                    descriptionAppelValeurGauche.HachageRetourFonction);
        }
        retourner faux;
    }

    booléen EstExpressionValeurConstanteSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (!EstValeurGaucheSemantique(etat, indexExpression))
            retourner faux;
        naturel64 typeExpressionConstante =
            HachageTypeExpressionSemantique(etat, indexExpression);
        si (EstTypeConstantSemantique(etat, typeExpressionConstante)
            && !EstTypeAdresseSemantique(etat, typeExpressionConstante))
            retourner vrai;

        constante NoeudDeclaration* expressionConstante =
            &etat->Requete->Noeuds[indexExpression];
        si (expressionConstante->Genre == 29
            || expressionConstante->Genre == 30) {
            naturel64 objetExpressionConstante =
                TrouverEnfantDirectSemantique(
                    etat, indexExpression, 0);
            naturel64 typeObjetExpressionConstante =
                HachageTypeExpressionSemantique(
                    etat, objetExpressionConstante);
            si (EstTypeConstantSemantique(
                    etat, typeObjetExpressionConstante))
                retourner vrai;
            retourner EstExpressionValeurConstanteSemantique(
                etat, objetExpressionConstante);
        }
        retourner faux;
    }

    booléen LiaisonReferenceCompatibleSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 typeReference) {
        si (!EstValeurGaucheSemantique(etat, indexExpression))
            retourner faux;
        naturel64 typeSourceReference =
            HachageTypeExpressionSemantique(etat, indexExpression);
        naturel64 typeDestinationReference =
            SansReferenceTypeSemantique(etat, typeReference);
        si (!TypesValeurEgauxSemantique(
                etat,
                typeSourceReference,
                typeDestinationReference)
            && !ConversionHeritageSemantique(
                etat,
                typeSourceReference,
                typeDestinationReference,
                vrai))
            retourner faux;
        si (!EstTypeConstantSemantique(
                etat, typeDestinationReference)
            && EstExpressionValeurConstanteSemantique(
                etat, indexExpression))
            retourner faux;
        retourner vrai;
    }

    booléen EstMembreDuGenreSemantique(
        EtatAnalyseSemantique* etat,
        SymboleSemantique* symbole,
        naturel32 masque) {
        si ((masque & 1) != 0
            && (symbole->Genre == 5 || symbole->Genre == 6))
            retourner vrai;
        si ((masque & 2) != 0 && symbole->Genre == 2) {
            naturel32 genreNoeud = etat->Requete->Noeuds[
                symbole->IndexNoeud].Genre;
            retourner genreNoeud == 12 || genreNoeud == 15;
        }
        retourner faux;
    }

    naturel64 CompterMembresTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageNom,
        naturel32 masque) {
        naturel64 nombre = 0;
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->IndexPortee == indexNoeudType
                && candidat->HachageNom == hachageNom
                && EstMembreDuGenreSemantique(etat, candidat, masque))
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 TrouverTypeDeclarantMembreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageNom,
        naturel32 masque) {
        naturel64 courant = indexType;
        naturel64 profondeur = 0;
        tantque (courant < etat->NombreSymboles
            && profondeur < etat->NombreSymboles) {
            si (CompterMembresTypeSemantique(
                    etat, courant, hachageNom, masque) != 0)
                retourner courant;
            courant = TrouverTypeBaseSymboleSemantique(etat, courant);
            profondeur = profondeur + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverPremierMembreTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageNom,
        naturel32 masque) {
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->IndexPortee == indexNoeudType
                && candidat->HachageNom == hachageNom
                && EstMembreDuGenreSemantique(etat, candidat, masque))
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverTypeObjetMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre) {
        naturel64 objet = TrouverEnfantDirectSemantique(
            etat, indexMembre, 0);
        naturel64 hachageType = HachageTypeExpressionSemantique(
            etat, objet);
        naturel32 niveauPointeur = 0;
        si ((etat->Requete->Noeuds[indexMembre].Drapeaux & 32_768) != 0)
            niveauPointeur = 1;
        retourner TrouverTypeDepuisHachageSemantique(
            etat, hachageType, niveauPointeur);
    }

    /**
     * <résumé>Normalise une chaîne d'alias vers le champ de stockage direct.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Index privé et diagnostics.
     * @Paramètre(naturel64: indexAlias) Symbole de départ, champ ou alias.
     * @Paramètre(naturel64: indexType) Type déclarant, sans recherche dans ses bases.
     * @Retourner(naturel64) Champ canonique, ou NombreSymboles après un refus.
     * @etc. Le parcours itératif détecte les cycles sans empiler les alias.
     * Les cibles intermédiaires sont mémorisées puis remplacées par la cible
     * canonique ; ni l'AST public ni les symboles d'alias ne sont modifiés.
     **/
    naturel64 ResoudreAliasChampSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexAlias,
        naturel64 indexType) {

        si (indexAlias >= etat->NombreSymboles
            || indexType >= etat->NombreSymboles)
            retourner etat->NombreSymboles;
        si (etat->SymbolesTravail[indexAlias].Genre != 6)
            retourner indexAlias;

        naturel64 courant = indexAlias;
        naturel64 cibleCanonique = etat->NombreSymboles;
        tantque (cibleCanonique >= etat->NombreSymboles) {

            si (etat->EtatsAliasesChamps[courant] == 2) {

                cibleCanonique = etat->CiblesAliasesChamps[courant];
            }
            sinon {

                SymboleSemantique* aliasCourant =
                    &etat->SymbolesTravail[courant];
                si (etat->EtatsAliasesChamps[courant] == 1) {

                    SignalerErreurSemantique(
                        etat, ErreurAnalyseSemantique::CycleAliasChamp,
                        aliasCourant->IndexNoeud,
                        convertir<naturel32>(indexAlias));
                    retourner etat->NombreSymboles;
                }
                etat->EtatsAliasesChamps[courant] = 1;
                naturel64 cible = TrouverPremierMembreTypeSemantique(
                    etat, indexType, aliasCourant->HachageType, 1);
                si (cible >= etat->NombreSymboles) {

                    SignalerErreurSemantique(
                        etat, ErreurAnalyseSemantique::CibleAliasChampIntrouvable,
                        aliasCourant->IndexNoeud, 0);
                    retourner etat->NombreSymboles;
                }
                etat->CiblesAliasesChamps[courant] = cible;
                si (etat->SymbolesTravail[cible].Genre == 5)
                    cibleCanonique = cible;
                sinon courant = cible;
            }
        }

        courant = indexAlias;
        tantque (etat->SymbolesTravail[courant].Genre == 6
            && etat->EtatsAliasesChamps[courant] != 2) {

            naturel64 suivant = etat->CiblesAliasesChamps[courant];
            etat->CiblesAliasesChamps[courant] = cibleCanonique;
            etat->EtatsAliasesChamps[courant] = 2;
            courant = suivant;
        }
        retourner cibleCanonique;
    }

    naturel64 HachageTypeMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre) {
        si (indexMembre >= etat->Requete->NombreNoeuds) retourner 0;
        constante NoeudDeclaration* membre =
            &etat->Requete->Noeuds[indexMembre];
        naturel64 typeObjet = TrouverTypeObjetMembreSemantique(
            etat, indexMembre);
        si (typeObjet >= etat->NombreSymboles) retourner 0;
        naturel64 typeDeclarant = TrouverTypeDeclarantMembreSemantique(
            etat, typeObjet, membre->HachageNom, 3);
        si (typeDeclarant >= etat->NombreSymboles) retourner 0;
        naturel64 cible = TrouverPremierMembreTypeSemantique(
            etat, typeDeclarant, membre->HachageNom, 3);
        si (cible >= etat->NombreSymboles) retourner 0;
        cible = ResoudreAliasChampSemantique(
            etat, cible, typeDeclarant);
        si (cible >= etat->NombreSymboles) retourner 0;
        retourner SansReferenceTypeSemantique(
            etat, etat->SymbolesTravail[cible].HachageType);
    }

    /**
     * <résumé>Positions privées et limite du préfixe d'arguments explicites déjà résolu.</résumé>
     **/
    structure TrancheArgumentsFonctionSemantique {

        naturel64 PremierArgument;
        naturel64 PremierParametre;
        naturel64 LimiteArguments;
    };

    /**
     * <résumé>Évalue une tranche de paramètres explicites sans fabriquer de nœuds de récepteur.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types privés et diagnostics.
     * @Paramètre(naturel64: indexParent) Appel ou liste d'arguments.
     * @Paramètre(naturel64: indexFonction) Déclaration candidate.
     * @Paramètre(TrancheArgumentsFonctionSemantique*: tranche) Positions et limite du préfixe à comparer.
     * @Retourner(naturel32) Score compatible, ou 4_294_967_295 en cas de refus.
     **/
    naturel32 EvaluerTrancheArgumentsFonctionSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexParent,
        naturel64 indexFonction,
        TrancheArgumentsFonctionSemantique* tranche) {
        naturel64 premierArgument = tranche->PremierArgument;
        naturel64 premierParametre = tranche->PremierParametre;
        naturel64 nombreEnfants = CompterEnfantsDirectsSemantique(
            etat, indexParent);
        si (nombreEnfants < premierArgument)
            retourner 4_294_967_295;
        naturel64 nombreArguments = nombreEnfants - premierArgument;
        naturel64 nombreParametres = CompterParametresFonctionSemantique(etat, indexFonction);
        si (nombreParametres < premierParametre || nombreParametres - premierParametre != nombreArguments)
            retourner 4_294_967_295;

        naturel32 score = 0;
        naturel64 indexArgument = 0;
        tantque (indexArgument < nombreArguments && indexArgument < tranche->LimiteArguments) {
            naturel64 argument = TrouverEnfantDirectSemantique(
                etat,
                indexParent,
                indexArgument + premierArgument);
            naturel64 parametre = TrouverParametreFonctionSemantique(
                etat, indexFonction, indexArgument + premierParametre);
            si (argument >= etat->Requete->NombreNoeuds
                || parametre >= etat->Requete->NombreNoeuds)
                retourner 4_294_967_295;
            naturel64 typeArgument = HachageTypeExpressionSemantique(
                etat, argument);
            naturel64 typeParametre =
                etat->Requete->Noeuds[parametre].HachageType;
            booléen parametreReference = EstTypeReferenceSemantique(
                etat, typeParametre);
            typeParametre = SansReferenceTypeSemantique(
                etat, typeParametre);

            si (etat->Requete->Noeuds[argument].Genre == 32) {
                si (parametreReference) retourner 4_294_967_295;
                score = score + 2;
            }
            sinon si (parametreReference) {
                si (!LiaisonReferenceCompatibleSemantique(
                        etat, argument, typeParametre))
                    retourner 4_294_967_295;
                si (!TypesValeurEgauxSemantique(
                        etat, typeArgument, typeParametre))
                    score = score + 1;
            }
            sinon si (!TypesValeurEgauxSemantique(
                    etat, typeArgument, typeParametre)) {
                si (ConversionHeritageSemantique(
                        etat,
                        typeArgument,
                        typeParametre,
                        faux))
                    score = score + 1;
                sinon {
                    si (!ConstanteExpressionCompatibleTypeSemantique(
                            etat, argument, typeParametre))
                        retourner 4_294_967_295;
                    score = score + 1;
                }
            }
            indexArgument = indexArgument + 1;
        }
        retourner score;
    }

    naturel32 EvaluerArgumentsFonctionSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexParent,
        naturel64 indexFonction,
        naturel64 premierArgument) {

        TrancheArgumentsFonctionSemantique tranche = {premierArgument, 0, etat->Requete->NombreNoeuds};
        retourner EvaluerTrancheArgumentsFonctionSemantique(etat, indexParent, indexFonction, &tranche);
    }

    /**
     * <résumé>Évalue un appel de méthode non liée : récepteur explicite en premier, puis paramètres déclarés.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types et conversions du bootstrap.
     * @Paramètre(naturel64: indexParent) Appel contenant les arguments.
     * @Paramètre(naturel64: indexFonction) Méthode canonique.
     * @Paramètre(naturel64: premierArgument) Position du récepteur parmi les enfants directs.
     * @Retourner(naturel32) Score compatible, ou 4_294_967_295 en cas de refus.
     **/
    naturel32 EvaluerArgumentsMethodeNonLieeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexParent, naturel64 indexFonction, naturel64 premierArgument) {

        naturel64 typeRecepteur = HachageTypeRecepteurFonctionSemantique(etat, indexFonction);
        naturel64 recepteur = TrouverEnfantDirectSemantique(etat, indexParent, premierArgument);
        si (typeRecepteur == 0 || recepteur >= etat->Requete->NombreNoeuds
            || !LiaisonReferenceCompatibleSemantique(etat, recepteur, typeRecepteur)) retourner 4_294_967_295;
        naturel32 score = EvaluerArgumentsFonctionSemantique(etat, indexParent, indexFonction, premierArgument + 1);
        si (score != 4_294_967_295 && !TypesValeurEgauxSemantique(etat,
            HachageTypeExpressionSemantique(etat, recepteur), SansReferenceTypeSemantique(etat, typeRecepteur)))
            score = score + 1;
        retourner score;
    }

    naturel64 SelectionnerSurchargeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexReference,
        naturel64 indexAppel) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        naturel64 meilleure = etat->NombreSymboles;
        naturel32 meilleurScore = 4_294_967_295;
        naturel32 nombreMeilleures = 0;
        naturel64 cibleRacine = TrouverDeclarationRacineSemantique(etat, indexReference);
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            booléen correspond = ReferenceCorrespondSymboleSemantique(etat, reference, candidat);
            si (cibleRacine < etat->NombreSymboles && !ReferenceUtiliseEspacesSemantique(etat, reference)) correspond = HacherNomDeclarationAliasSemantique(etat, candidat)
                == HacherNomDeclarationAliasSemantique(etat, &etat->SymbolesTravail[cibleRacine]);
            si (candidat->Genre == 2 && correspond) {
                naturel32 score = 0;
                si (HachageTypeRecepteurFonctionSemantique(etat, candidat->IndexNoeud) != 0)
                    score = EvaluerArgumentsMethodeNonLieeSemantique(etat, indexAppel, candidat->IndexNoeud, 1);
                sinon score = EvaluerArgumentsFonctionSemantique(etat, indexAppel, candidat->IndexNoeud, 1);
                si (score != 4_294_967_295) {
                    si (score < meilleurScore) {
                        meilleure = index;
                        meilleurScore = score;
                        nombreMeilleures = 1;
                    }
                    sinon si (score == meilleurScore)
                        nombreMeilleures = nombreMeilleures + 1;
                }
            }
            index = index + 1;
        }

        si (etat->Requete->Resultat.Erreur != ErreurAnalyseSemantique::Reussite)
            retourner etat->NombreSymboles;
        si (meilleure >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexReference,
                convertir<naturel32>(
                    CompterEnfantsDirectsSemantique(etat, indexAppel) - 1));
            retourner etat->NombreSymboles;
        }
        si (nombreMeilleures > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexReference,
                nombreMeilleures);
            retourner etat->NombreSymboles;
        }
        retourner meilleure;
    }

    /**
     * <résumé>Compte tout le groupe de liaison visible depuis un type, fonctions libres homonymes comprises.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Déclarations canoniques privées.
     * @Paramètre(naturel64: indexType) Type propriétaire du nom recherché.
     * @Paramètre(naturel64: indexMembre) Expression portant le nom appelé.
     * @Retourner(naturel64) Nombre de fonctions du groupe complet.
     **/
    naturel64 CompterFonctionsAppelMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType, naturel64 indexMembre) {

        naturel64 nom = HacherNomCompletSemantique(etat, etat->SymbolesTravail[indexType].IndexNoeud);
        nom = AjouterNomNoeudSemantique(etat, AjouterOctetSemantique(AjouterOctetSemantique(nom, 58), 58), indexMembre);
        naturel64 nombre = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {

            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2 && HacherNomDeclarationAliasSemantique(etat, candidat) == nom) nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    /**
     * <résumé>Trouve le premier groupe de fonctions dans le type appelé ou ses bases, sans fusionner les groupes masqués.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Bases canoniques et noms complets.
     * @Paramètre(naturel64: indexType) Type statique du récepteur.
     * @Paramètre(naturel64: indexMembre) Expression portant le nom appelé.
     * @Retourner(naturel64) Type déclarant, ou NombreSymboles en l'absence de groupe.
     **/
    naturel64 TrouverTypeDeclarantAppelMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType, naturel64 indexMembre) {

        naturel64 courant = indexType;
        naturel64 profondeur = 0;
        tantque (courant < etat->NombreSymboles && profondeur < etat->NombreSymboles) {

            si (CompterFonctionsAppelMembreSemantique(etat, courant, indexMembre) != 0) retourner courant;
            courant = TrouverTypeBaseSymboleSemantique(etat, courant);
            profondeur = profondeur + 1;
        }
        retourner etat->NombreSymboles;
    }

    /**
     * <résumé>Évalue le récepteur synthétique d'un appel par point ou flèche sans modifier l'AST.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types, qualifications et héritage privés.
     * @Paramètre(naturel64: indexMembre) Objet appelé, éventuellement via pointeur.
     * @Paramètre(naturel64: typeParametre) Premier paramètre non lié de la candidate.
     * @Retourner(naturel32) Score de conversion du récepteur, ou 4_294_967_295 en cas de refus.
     **/
    naturel32 EvaluerRecepteurAppelMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre, naturel64 typeParametre) {

        naturel64 objet = TrouverEnfantDirectSemantique(etat, indexMembre, 0);
        naturel64 typeObjet = HachageTypeExpressionSemantique(etat, objet);
        booléen viaPointeur = (etat->Requete->Noeuds[indexMembre].Drapeaux & 32_768) != 0;
        si (viaPointeur) typeObjet = TransformerPointeurTypeSemantique(
            etat, typeObjet, TrouverOrigineTypeExpressionSemantique(etat, objet), faux);
        si (typeObjet == 0) retourner 4_294_967_295;
        booléen reference = EstTypeReferenceSemantique(etat, typeParametre);
        naturel64 destination = SansReferenceTypeSemantique(etat, typeParametre);
        si (reference) {

            si (!viaPointeur && !EstValeurGaucheSemantique(etat, objet)) retourner 4_294_967_295;
            booléen valeurConstante = EstTypeConstantSemantique(etat, typeObjet);
            si (!viaPointeur && EstExpressionValeurConstanteSemantique(etat, objet)) valeurConstante = vrai;
            si (valeurConstante && !EstTypeConstantSemantique(etat, destination)) retourner 4_294_967_295;
        }
        si (TypesValeurEgauxSemantique(etat, typeObjet, destination)) retourner 0;
        si (ConversionHeritageSemantique(etat, typeObjet, destination, reference)) retourner 1;
        retourner 4_294_967_295;
    }

    /**
     * <résumé>Compare une méthode ou fonction libre au récepteur synthétique puis aux arguments déclarés.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types privés et diagnostics.
     * @Paramètre(naturel64: indexMembre) Expression appelée par point ou flèche.
     * @Paramètre(naturel64: indexAppel) Appel contenant les arguments explicites.
     * @Paramètre(naturel64: indexFonction) Déclaration du groupe complet à évaluer.
     * @Retourner(naturel32) Score total compatible, ou 4_294_967_295 en cas de refus.
     **/
    naturel32 EvaluerSurchargeAppelMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre, naturel64 indexAppel, naturel64 indexFonction) {

        naturel64 typeRecepteur = HachageTypeRecepteurFonctionSemantique(etat, indexFonction);
        naturel64 premierParametre = 0;
        si (typeRecepteur == 0) {

            si (CompterParametresFonctionSemantique(etat, indexFonction) == 0) retourner 4_294_967_295;
            naturel64 parametre = TrouverParametreFonctionSemantique(etat, indexFonction, 0);
            typeRecepteur = etat->Requete->Noeuds[parametre].HachageType;
            premierParametre = 1;
        }
        naturel32 score = EvaluerRecepteurAppelMembreSemantique(etat, indexMembre, typeRecepteur);
        si (score == 4_294_967_295) retourner score;
        TrancheArgumentsFonctionSemantique tranche = {1, premierParametre, etat->Requete->NombreNoeuds};
        naturel32 scoreArguments = EvaluerTrancheArgumentsFonctionSemantique(etat, indexAppel, indexFonction, &tranche);
        si (scoreArguments == 4_294_967_295) retourner scoreArguments;
        retourner score + scoreArguments;
    }

    naturel64 SelectionnerSurchargeMembreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexMembre,
        naturel64 indexAppel,
        naturel64 indexTypeDeclarant) {
        naturel64 nomGroupe = HacherNomCompletSemantique(etat, etat->SymbolesTravail[indexTypeDeclarant].IndexNoeud);
        nomGroupe = AjouterNomNoeudSemantique(
            etat, AjouterOctetSemantique(AjouterOctetSemantique(nomGroupe, 58), 58), indexMembre);
        naturel64 meilleure = etat->NombreSymboles;
        naturel32 meilleurScore = 4_294_967_295;
        naturel32 nombreMeilleures = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2 && HacherNomDeclarationAliasSemantique(etat, candidat) == nomGroupe) {
                naturel32 score = EvaluerSurchargeAppelMembreSemantique(etat, indexMembre, indexAppel, candidat->IndexNoeud);
                si (score != 4_294_967_295) {
                    si (score < meilleurScore) {
                        meilleure = index;
                        meilleurScore = score;
                        nombreMeilleures = 1;
                    }
                    sinon si (score == meilleurScore)
                        nombreMeilleures = nombreMeilleures + 1;
                }
            }
            index = index + 1;
        }

        si (etat->Requete->Resultat.Erreur != ErreurAnalyseSemantique::Reussite)
            retourner etat->NombreSymboles;
        si (meilleure >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexMembre,
                convertir<naturel32>(
                    CompterEnfantsDirectsSemantique(etat, indexAppel) - 1));
            retourner etat->NombreSymboles;
        }
        si (nombreMeilleures > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexMembre,
                nombreMeilleures);
            retourner etat->NombreSymboles;
        }
        retourner meilleure;
    }

    ErreurAnalyseSemantique ResoudreMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre) {
        constante NoeudDeclaration* membre =
            &etat->Requete->Noeuds[indexMembre];
        si (membre->Genre != 29)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 typeObjet = TrouverTypeObjetMembreSemantique(
            etat, indexMembre);
        si (typeObjet >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::RecepteurMembreInvalide,
                indexMembre,
                0);

        constante NoeudDeclaration* noeudParentMembre =
            &etat->Requete->Noeuds[membre->Parent];
        booléen cibleAppel = noeudParentMembre->Genre == 28
            && indexMembre == membre->Parent + 1;
        naturel64 typeDeclarant = etat->NombreSymboles;
        si (cibleAppel) typeDeclarant = TrouverTypeDeclarantAppelMembreSemantique(etat, typeObjet, indexMembre);
        sinon typeDeclarant = TrouverTypeDeclarantMembreSemantique(etat, typeObjet, membre->HachageNom, 1);
        si (cibleAppel && typeDeclarant >= etat->NombreSymboles) {

            cibleAppel = faux;
            typeDeclarant = TrouverTypeDeclarantMembreSemantique(
                etat, typeObjet, membre->HachageNom, 1);
        }
        si (typeDeclarant >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::MembreIntrouvable,
                indexMembre,
                0);

        naturel64 cible = etat->NombreSymboles;
        naturel32 drapeaux = 8;
        si (typeDeclarant != typeObjet) drapeaux = drapeaux | 16;
        si (cibleAppel) {
            cible = SelectionnerSurchargeMembreSemantique(
                etat, indexMembre, membre->Parent, typeDeclarant);
            si (cible >= etat->NombreSymboles)
                retourner etat->Requete->Resultat.Erreur;
            si (HachageTypeRecepteurFonctionSemantique(etat, etat->SymbolesTravail[cible].IndexNoeud) != 0)
                drapeaux = drapeaux | 32;
            si (CompterFonctionsAppelMembreSemantique(etat, typeDeclarant, indexMembre) > 1)
                drapeaux = drapeaux | 1;
        }
        sinon {
            cible = TrouverPremierMembreTypeSemantique(
                etat, typeDeclarant, membre->HachageNom, 1);
            cible = ResoudreAliasChampSemantique(
                etat, cible, typeDeclarant);
        }
        si (cible >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::MembreIntrouvable,
                indexMembre,
                0);
        booléen controleAcces = !cibleAppel || HachageTypeRecepteurFonctionSemantique(etat, etat->SymbolesTravail[cible].IndexNoeud) != 0;
        si (controleAcces && !AccesMembreAutoriseSemantique(etat, cible, indexMembre))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::MembreInaccessible,
                indexMembre,
                convertir<naturel32>(cible));
        AjouterResolutionSemantique(
            etat, indexMembre, cible, drapeaux);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 CompterConstructeursTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        naturel64 nombre = 0;
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 13)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

