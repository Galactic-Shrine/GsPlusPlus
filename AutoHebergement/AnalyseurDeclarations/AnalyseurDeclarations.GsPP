                &unaire, 25, jetonOperateur->Ligne, jetonOperateur->Colonne);
            unaire.DebutNom = jetonOperateur->Debut;
            unaire.TailleNom = jetonOperateur->TailleSource;
            unaire.HachageNom = jetonOperateur->HachageTexte;
            naturel64 indexUnaire =
                AjouterExpressionInterneDeclaration(etat, unaire);
            si (indexUnaire == IndexExpressionNulDeclaration())
                retourner indexUnaire;
            AjouterEnfantExpressionDeclaration(
                etat, indexUnaire, operande);
            retourner indexUnaire;
