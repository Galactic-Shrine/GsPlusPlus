        naturel32 genre = JetonCourantDeclaration(etat)->Genre;
        si (genre == 61 || genre == 62 || genre == 52
            || genre == 58 || genre == 55 || genre == 63) {
            JetonLexe* jetonOperateur = JetonCourantDeclaration(etat);
            etat->Position = etat->Position + 1;
            naturel64 operande = AnalyserUnaireExpressionDeclaration(etat);
            si (operande == IndexExpressionNulDeclaration())
