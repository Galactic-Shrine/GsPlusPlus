publique entier32 CompteurTableauObjets = 0;
publique entier32 TraceDestructionTableauObjets = 0;

classe ElementTableauObjet
{
    publique:
        entier32 Valeur;

        constructeur()
        {
            CompteurTableauObjets = CompteurTableauObjets + 1;
            soi.Valeur = CompteurTableauObjets;
        }

        destructeur()
        {
            TraceDestructionTableauObjets =
                TraceDestructionTableauObjets * 10 + soi.Valeur;
        }
};

classe ConteneurTableauObjets
{
    privée:
        ElementTableauObjet Valeurs[2][2];

    publique:
        constructeur() : Valeurs() {}
        destructeur() {}

        entier32 Somme()
        {
            retourner soi.Valeurs[0][0].Valeur
                + soi.Valeurs[0][1].Valeur
                + soi.Valeurs[1][0].Valeur
                + soi.Valeurs[1][1].Valeur;
        }
};

entier32 ConstruireTableauObjets()
{
    ConteneurTableauObjets objet;
    si (CompteurTableauObjets != 4) retourner 97;
    retourner objet.Somme();
}

publique entier32 Principal()
{
    entier32 resultat = ConstruireTableauObjets();
    si (TraceDestructionTableauObjets != 4321) retourner 99;
    retourner resultat;
}
