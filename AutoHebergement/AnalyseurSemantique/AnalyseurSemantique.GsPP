    booléen TypesValeurEgauxSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 gauche,
        naturel64 droite) {
        si (EstTypeAdresseSemantique(etat, gauche)
            || EstTypeAdresseSemantique(etat, droite))
            retourner gauche == droite;
        retourner SansQualificatifsValeurSemantique(etat, gauche)
            == SansQualificatifsValeurSemantique(etat, droite);
    }

    booléen EstTypeScalaireSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType) {
        naturel32 genre = 1;
        tantque (genre <= 12) {
            naturel32 qualificatifs = 0;
            tantque (qualificatifs < 4) {
                naturel32 pointeurs = 0;
                tantque (pointeurs <= 2) {
                    si ((genre <= 11 || pointeurs != 0)
                        && hachageType == HacherTypeSimpleSemantique(
                            genre, qualificatifs, pointeurs))
                        retourner vrai;
                    pointeurs = pointeurs + 1;
                }
                qualificatifs = qualificatifs + 1;
            }
            genre = genre + 1;
        }

        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1) {
                naturel64 nomSimple = candidat->HachageNom;
                naturel64 nomComplet = HacherNomCompletSemantique(
                    etat, candidat->IndexNoeud);
                naturel32 qualificatifsNommes = 0;
                tantque (qualificatifsNommes < 4) {
                    naturel32 pointeursNommes = 0;
                    tantque (pointeursNommes <= 2) {
                        booléen typeEnumeration = etat->Requete->Noeuds[
                            candidat->IndexNoeud].Genre == 8;
                        si ((typeEnumeration || pointeursNommes != 0)
                            && (hachageType == HacherTypeNommeSemantique(
                                    nomSimple,
                                    qualificatifsNommes,
                                    pointeursNommes)
                                || hachageType == HacherTypeNommeSemantique(
                                    nomComplet,
                                    qualificatifsNommes,
                                    pointeursNommes)))
                            retourner vrai;
                        pointeursNommes = pointeursNommes + 1;
                    }
                    qualificatifsNommes = qualificatifsNommes + 1;
                }
            }
            index = index + 1;
        }
        retourner faux;
    }

    booléen EstTypeReferenceSemantique(
        EtatAnalyseSemantique* etat, naturel64 hachageType) {
        retourner SansReferenceTypeSemantique(etat, hachageType)
            != hachageType;
    }

    naturel64 TrouverSymboleNoeudSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel32 genreSymbole) {
        naturel64 indexSymboleNoeud = 0;
        tantque (indexSymboleNoeud < etat->NombreSymboles) {
            SymboleSemantique* symboleNoeud =
                &etat->SymbolesTravail[indexSymboleNoeud];
            si (symboleNoeud->IndexNoeud == indexNoeud
                && symboleNoeud->Genre == genreSymbole)
                retourner indexSymboleNoeud;
            indexSymboleNoeud = indexSymboleNoeud + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 HacherSignatureFonctionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexFonction) {
        si (indexFonction >= etat->Requete->NombreNoeuds)
            retourner 0;
        naturel64 signatureFonction = AjouterNaturel64Semantique(
            HachageVideSemantique(),
            etat->Requete->Noeuds[indexFonction].HachageType);
        naturel32 nombreParametresSignature = 0;
        naturel64 indexParametreSignature = indexFonction + 1;
        tantque (indexParametreSignature < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* parametreSignature =
                &etat->Requete->Noeuds[indexParametreSignature];
            si (parametreSignature->Parent == indexFonction
                && parametreSignature->Genre == 2) {
                signatureFonction = AjouterNaturel64Semantique(
                    signatureFonction,
                    parametreSignature->HachageType);
                nombreParametresSignature = nombreParametresSignature + 1;
            }
            indexParametreSignature = indexParametreSignature + 1;
        }
        retourner AjouterNaturel32Semantique(
            signatureFonction, nombreParametresSignature);
    }

    naturel64 HacherPointeurFonctionSemantique(
        naturel64 hachageSignature,
        naturel32 qualificatifs,
        naturel32 niveauPointeur,
        DescriptionHachageTypeSemantique* dimensions) {
        DescriptionHachageTypeSemantique descriptionFonction = {
            dimensions->NombreDimensions,
            0,
            hachageSignature,
            dimensions->HachageDimensions};
        retourner HacherTypeCompletSemantique(
            14,
            qualificatifs,
            niveauPointeur,
            &descriptionFonction);
    }

    naturel64 HacherPointeurFonctionDeclarationSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexFonction) {
        naturel64 signatureDeclarationFonction =
            HacherSignatureFonctionSemantique(etat, indexFonction);
        si (signatureDeclarationFonction == 0) retourner 0;
        DescriptionHachageTypeSemantique dimensionsDeclarationFonction = {
            0,
            0,
            HachageVideSemantique(),
            HachageVideSemantique()};
        retourner HacherPointeurFonctionSemantique(
            signatureDeclarationFonction,
            0,
            0,
            &dimensionsDeclarationFonction);
    }

    naturel64 TrouverCibleSymboleExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds
            || etat->CiblesExpressions == NulCiblesExpressionsSemantiques)
            retourner etat->NombreSymboles;
        naturel64 cibleSymboleExpression =
            etat->CiblesExpressions[indexExpression];
        si (cibleSymboleExpression >= etat->NombreSymboles)
            retourner etat->NombreSymboles;
        retourner cibleSymboleExpression;
    }

    externe naturel64 TrouverOrigineTypeExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression);

    naturel64 TrouverOrigineTypeExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner etat->Requete->NombreNoeuds;
        constante NoeudDeclaration* expressionOrigine =
            &etat->Requete->Noeuds[indexExpression];
        si (expressionOrigine->Genre == 24
            || expressionOrigine->Genre == 29) {
            naturel64 cibleOrigine = TrouverCibleSymboleExpressionSemantique(
                etat, indexExpression);
            si (cibleOrigine < etat->NombreSymboles)
                retourner etat->SymbolesTravail[cibleOrigine].IndexNoeud;
            retourner etat->Requete->NombreNoeuds;
        }
        si (expressionOrigine->Genre == 25
            || expressionOrigine->Genre == 26
            || expressionOrigine->Genre == 27
            || expressionOrigine->Genre == 30) {
            naturel64 enfantOrigine = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner TrouverOrigineTypeExpressionSemantique(
                etat, enfantOrigine);
        }
        si (expressionOrigine->Genre == 28) {
            naturel64 cibleAppelOrigine = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            naturel64 symboleAppelOrigine =
                TrouverCibleSymboleExpressionSemantique(
                    etat, cibleAppelOrigine);
            si (symboleAppelOrigine < etat->NombreSymboles
                && etat->SymbolesTravail[symboleAppelOrigine].Genre == 2)
                retourner etat->SymbolesTravail[
                    symboleAppelOrigine].IndexNoeud;
            retourner TrouverOrigineTypeExpressionSemantique(
                etat, cibleAppelOrigine);
        }
        retourner etat->Requete->NombreNoeuds;
    }

    naturel64 TransformerPointeurSimpleSemantique(
        naturel64 hachageType,
        booléen ajouter) {
        naturel32 genreTransformationSimple = 1;
        tantque (genreTransformationSimple <= 12) {
            naturel32 qualificatifsTransformationSimple = 0;
            tantque (qualificatifsTransformationSimple < 8) {
                naturel32 pointeursTransformationSimple = 0;
                tantque (pointeursTransformationSimple <= 4) {
                    si (hachageType == HacherTypeSimpleSemantique(
                            genreTransformationSimple,
                            qualificatifsTransformationSimple,
                            pointeursTransformationSimple)) {
                        si (ajouter)
                            retourner HacherTypeSimpleSemantique(
                                genreTransformationSimple,
                                qualificatifsTransformationSimple,
                                pointeursTransformationSimple + 1);
                        si (pointeursTransformationSimple != 0)
                            retourner HacherTypeSimpleSemantique(
                                genreTransformationSimple,
                                qualificatifsTransformationSimple,
                                pointeursTransformationSimple - 1);
                        retourner 0;
                    }
                    pointeursTransformationSimple =
                        pointeursTransformationSimple + 1;
                }
                qualificatifsTransformationSimple =
                    qualificatifsTransformationSimple + 1;
            }
            genreTransformationSimple = genreTransformationSimple + 1;
        }
        retourner 0;
    }

    naturel64 TransformerPointeurNommeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachageType,
        booléen ajouter) {
        naturel64 indexTypeTransformationNommee = 0;
        tantque (indexTypeTransformationNommee < etat->NombreSymboles) {
            SymboleSemantique* typeTransformationNommee =
                &etat->SymbolesTravail[indexTypeTransformationNommee];
            si (typeTransformationNommee->Genre == 1) {
                naturel64 nomSimpleTransformation =
                    typeTransformationNommee->HachageNom;
                naturel64 nomCompletTransformation =
                    HacherNomCompletSemantique(
                        etat, typeTransformationNommee->IndexNoeud);
                naturel32 qualificatifsTransformationNommee = 0;
                tantque (qualificatifsTransformationNommee < 8) {
                    naturel32 pointeursTransformationNommee = 0;
                    tantque (pointeursTransformationNommee <= 4) {
                        naturel64 nomTransformationCourant =
                            nomSimpleTransformation;
                        naturel32 varianteNomTransformation = 0;
                        tantque (varianteNomTransformation < 2) {
                            si (hachageType == HacherTypeNommeSemantique(
                                    nomTransformationCourant,
                                    qualificatifsTransformationNommee,
                                    pointeursTransformationNommee)) {
                                si (ajouter)
                                    retourner HacherTypeNommeSemantique(
                                        nomTransformationCourant,
                                        qualificatifsTransformationNommee,
                                        pointeursTransformationNommee + 1);
                                si (pointeursTransformationNommee != 0)
                                    retourner HacherTypeNommeSemantique(
                                        nomTransformationCourant,
                                        qualificatifsTransformationNommee,
                                        pointeursTransformationNommee - 1);
                                retourner 0;
                            }
                            nomTransformationCourant =
                                nomCompletTransformation;
                            varianteNomTransformation =
                                varianteNomTransformation + 1;
                        }
                        pointeursTransformationNommee =
                            pointeursTransformationNommee + 1;
                    }
                    qualificatifsTransformationNommee =
                        qualificatifsTransformationNommee + 1;
                }
            }
            indexTypeTransformationNommee =
                indexTypeTransformationNommee + 1;
        }
        retourner 0;
    }

    naturel64 TransformerPointeurFonctionTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachageType,
        naturel64 indexOrigine,
        booléen ajouter) {
        DescriptionHachageTypeSemantique dimensionsFonctionTransformation = {
            0,
            0,
            HachageVideSemantique(),
            HachageVideSemantique()};
        DescriptionTypeJetonsSemantique typeFonctionTransformation;
        booléen origineTypeFonction = LireTypePointeurFonctionNoeudSemantique(
            etat, indexOrigine, &typeFonctionTransformation);
        naturel64 signatureTransformationFonction = 0;
        naturel32 qualificatifsTransformationFonction = 0;
        naturel32 pointeursTransformationFonction = 0;
        si (origineTypeFonction) {
            signatureTransformationFonction =
                typeFonctionTransformation.HachageNom;
            qualificatifsTransformationFonction =
                typeFonctionTransformation.Qualificatifs;
            pointeursTransformationFonction =
                typeFonctionTransformation.NiveauPointeur;
        }
        sinon si (TrouverSymboleNoeudSemantique(
                etat, indexOrigine, 2) < etat->NombreSymboles) {
            signatureTransformationFonction =
                HacherSignatureFonctionSemantique(etat, indexOrigine);
        }
        sinon retourner 0;

        naturel64 typeFonctionOrigine = HacherPointeurFonctionSemantique(
            signatureTransformationFonction,
            qualificatifsTransformationFonction,
            pointeursTransformationFonction,
            &dimensionsFonctionTransformation);
        si (hachageType != typeFonctionOrigine) retourner 0;
        si (ajouter)
            pointeursTransformationFonction =
                pointeursTransformationFonction + 1;
        sinon si (pointeursTransformationFonction != 0)
            pointeursTransformationFonction =
                pointeursTransformationFonction - 1;
        sinon retourner hachageType;
        retourner HacherPointeurFonctionSemantique(
            signatureTransformationFonction,
            qualificatifsTransformationFonction,
            pointeursTransformationFonction,
            &dimensionsFonctionTransformation);
    }

    naturel64 TransformerPointeurTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 hachageType,
        naturel64 indexOrigine,
        booléen ajouter) {
        naturel64 transformationSimple = TransformerPointeurSimpleSemantique(
            hachageType, ajouter);
        si (transformationSimple != 0) retourner transformationSimple;
        naturel64 transformationNommee = TransformerPointeurNommeSemantique(
            etat, hachageType, ajouter);
        si (transformationNommee != 0) retourner transformationNommee;
        retourner TransformerPointeurFonctionTypeSemantique(
            etat, hachageType, indexOrigine, ajouter);
    }

    booléen LireDimensionsRestantesSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel32 nombreIgnore,
        DescriptionHachageTypeSemantique* description) {
        DescriptionHachageTypeSemantique dimensionsCompletesRestantes;
        si (!LireDimensionsNoeudSemantique(
                etat, indexNoeud, &dimensionsCompletesRestantes))
            retourner faux;
        description->NombreDimensions = 0;
        description->Reserve = 0;
        description->HachageNom = HachageVideSemantique();
        description->HachageDimensions = HachageVideSemantique();
        naturel32 indexDimensionRestante = nombreIgnore;
        tantque (indexDimensionRestante
            < dimensionsCompletesRestantes.NombreDimensions) {
            naturel64 valeurDimensionRestante = 0;
            si (!LireDimensionNoeudSemantique(
                    etat,
                    indexNoeud,
                    indexDimensionRestante,
                    &valeurDimensionRestante))
                retourner faux;
            description->HachageDimensions = AjouterNaturel64Semantique(
                description->HachageDimensions,
                valeurDimensionRestante);
            description->NombreDimensions =
                description->NombreDimensions + 1;
            indexDimensionRestante = indexDimensionRestante + 1;
        }
        retourner vrai;
    }

    booléen LireDescriptionPointeurFonctionNoeudSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel64 hachagePointeurFonction,
        DescriptionTypeJetonsSemantique* description) {
        si (indexNoeud >= etat->Requete->NombreNoeuds
            || etat->JetonsTypes == NulJetonsTypesSemantiques)
            retourner faux;
        constante NoeudDeclaration* noeudPointeurFonction =
            &etat->Requete->Noeuds[indexNoeud];
        naturel64 indexNomPointeurFonction = 0;
        tantque (indexNomPointeurFonction < etat->NombreJetonsTypes
            && etat->JetonsTypes[indexNomPointeurFonction].Debut
                != noeudPointeurFonction->DebutNom)
            indexNomPointeurFonction = indexNomPointeurFonction + 1;
        si (indexNomPointeurFonction >= etat->NombreJetonsTypes)
            retourner faux;

        naturel64 debutPointeurFonction = 0;
        tantque (debutPointeurFonction < indexNomPointeurFonction) {
            naturel32 genreDebutPointeur =
                etat->JetonsTypes[debutPointeurFonction].Genre;
            si (genreDebutPointeur == 26
                || genreDebutPointeur == 12
                || genreDebutPointeur == 13) {
                CurseurTypeJetonsSemantique curseurPointeurFonction = {
                    debutPointeurFonction, faux};
                DescriptionTypeJetonsSemantique typePointeurFonctionLu;
                si (AnalyserTypeJetonsSemantique(
                        etat,
                        &curseurPointeurFonction,
                        &typePointeurFonctionLu)
                    && typePointeurFonctionLu.Genre == 14) {
                    naturel32 niveauPointeurCourant = 0;
                    tantque (niveauPointeurCourant <= 4) {
                        DescriptionTypeJetonsSemantique typeCourant =
                            typePointeurFonctionLu;
                        typeCourant.NiveauPointeur = niveauPointeurCourant;
                        typeCourant.Qualificatifs =
                            typeCourant.Qualificatifs & 3;
                        typeCourant.HachageType =
                            HacherDescriptionTypeJetonsSemantique(&typeCourant);
                        si (typeCourant.HachageType
                            == hachagePointeurFonction) {
                            typeCourant.DebutType =
                                debutPointeurFonction;
                            *description = typeCourant;
                            retourner vrai;
                        }
                        niveauPointeurCourant = niveauPointeurCourant + 1;
                    }
                }
            }
            debutPointeurFonction = debutPointeurFonction + 1;
        }
        retourner faux;
    }

    booléen LireRetourPointeurFonctionNoeudSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel64 hachagePointeurFonction,
        naturel64* hachageRetour) {
        DescriptionTypeJetonsSemantique descriptionPointeurFonction;
        si (!LireDescriptionPointeurFonctionNoeudSemantique(
                etat,
                indexNoeud,
                hachagePointeurFonction,
                &descriptionPointeurFonction))
            retourner faux;
        *hachageRetour = descriptionPointeurFonction.HachageRetourFonction;
        retourner vrai;
    }

    externe naturel64 HachageTypeExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression);

    naturel64 HachageTypeIndexationSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        naturel64 courantIndexation = indexExpression;
        naturel32 profondeurIndexation = 0;
        tantque (courantIndexation < etat->Requete->NombreNoeuds
            && etat->Requete->Noeuds[courantIndexation].Genre == 30) {
            profondeurIndexation = profondeurIndexation + 1;
            courantIndexation = TrouverEnfantDirectSemantique(
                etat, courantIndexation, 0);
        }
        naturel64 origineIndexation = TrouverOrigineTypeExpressionSemantique(
            etat, indexExpression);
        si (origineIndexation < etat->Requete->NombreNoeuds) {
            DescriptionHachageTypeSemantique dimensionsIndexationCompletes;
            si (LireDimensionsNoeudSemantique(
                    etat,
                    origineIndexation,
                    &dimensionsIndexationCompletes)
                && profondeurIndexation
                    <= dimensionsIndexationCompletes.NombreDimensions) {
                DescriptionHachageTypeSemantique dimensionsIndexationRestantes;
                si (!LireDimensionsRestantesSemantique(
                        etat,
                        origineIndexation,
                        profondeurIndexation,
                        &dimensionsIndexationRestantes))
                    retourner 0;
                naturel64 typeTableauOrigine = etat->Requete->Noeuds[
                    origineIndexation].HachageType;

                naturel32 genreTableauIndexe = 1;
                tantque (genreTableauIndexe <= 12) {
                    naturel32 qualificatifsTableauIndexe = 0;
                    tantque (qualificatifsTableauIndexe < 8) {
                        naturel32 pointeursTableauIndexe = 0;
                        tantque (pointeursTableauIndexe <= 4) {
                            si (typeTableauOrigine
                                == HacherTypeTableauSimpleSemantique(
                                    genreTableauIndexe,
                                    qualificatifsTableauIndexe,
                                    pointeursTableauIndexe,
                                    &dimensionsIndexationCompletes))
                                retourner HacherTypeTableauSimpleSemantique(
                                    genreTableauIndexe,
                                    qualificatifsTableauIndexe,
                                    pointeursTableauIndexe,
                                    &dimensionsIndexationRestantes);
                            pointeursTableauIndexe =
                                pointeursTableauIndexe + 1;
                        }
                        qualificatifsTableauIndexe =
                            qualificatifsTableauIndexe + 1;
                    }
                    genreTableauIndexe = genreTableauIndexe + 1;
                }

                naturel64 symboleTypeTableauIndexe = 0;
                tantque (symboleTypeTableauIndexe < etat->NombreSymboles) {
                    SymboleSemantique* typeTableauIndexe =
                        &etat->SymbolesTravail[symboleTypeTableauIndexe];
                    si (typeTableauIndexe->Genre == 1) {
                        naturel64 nomsTypeTableau[2] = {
                            typeTableauIndexe->HachageNom,
                            HacherNomCompletSemantique(
                                etat, typeTableauIndexe->IndexNoeud)};
                        naturel32 varianteTypeTableau = 0;
                        tantque (varianteTypeTableau < 2) {
                            naturel32 qualificatifsTypeTableau = 0;
                            tantque (qualificatifsTypeTableau < 8) {
                                naturel32 pointeursTypeTableau = 0;
                                tantque (pointeursTypeTableau <= 4) {
                                    si (typeTableauOrigine
                                        == HacherTypeTableauNommeSemantique(
                                            nomsTypeTableau[varianteTypeTableau],
                                            qualificatifsTypeTableau,
                                            pointeursTypeTableau,
                                            &dimensionsIndexationCompletes))
                                        retourner HacherTypeTableauNommeSemantique(
                                            nomsTypeTableau[varianteTypeTableau],
                                            qualificatifsTypeTableau,
                                            pointeursTypeTableau,
                                            &dimensionsIndexationRestantes);
                                    pointeursTypeTableau =
                                        pointeursTypeTableau + 1;
                                }
                                qualificatifsTypeTableau =
                                    qualificatifsTypeTableau + 1;
                            }
                            varianteTypeTableau = varianteTypeTableau + 1;
                        }
                    }
                    symboleTypeTableauIndexe =
                        symboleTypeTableauIndexe + 1;
                }

                DescriptionTypeJetonsSemantique typeFonctionTableauIndexe;
                si (LireTypePointeurFonctionNoeudSemantique(
                        etat,
                        origineIndexation,
                        &typeFonctionTableauIndexe)) {
                    naturel64 typeFonctionTableauOrigine =
                        HacherPointeurFonctionSemantique(
                            typeFonctionTableauIndexe.HachageNom,
                            typeFonctionTableauIndexe.Qualificatifs,
                            typeFonctionTableauIndexe.NiveauPointeur,
                            &dimensionsIndexationCompletes);
                    si (typeTableauOrigine == typeFonctionTableauOrigine)
                        retourner HacherPointeurFonctionSemantique(
                            typeFonctionTableauIndexe.HachageNom,
                            typeFonctionTableauIndexe.Qualificatifs,
                            typeFonctionTableauIndexe.NiveauPointeur,
                            &dimensionsIndexationRestantes);
                }
            }
        }

        naturel64 objetIndexation = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 typeObjetIndexation = HachageTypeExpressionSemantique(
            etat, objetIndexation);
        retourner TransformerPointeurTypeSemantique(
            etat,
            typeObjetIndexation,
            TrouverOrigineTypeExpressionSemantique(
                etat, objetIndexation),
            faux);
    }

    naturel64 HachageTypeReferenceSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        si ((reference->Drapeaux & 65_536) != 0) {
            naturel64 base = TrouverBaseSemantique(
                etat, indexReference);
            si (base >= etat->NombreSymboles) retourner 0;
            retourner HacherTypeNommeSemantique(
                HacherNomCompletSemantique(
                    etat, etat->SymbolesTravail[base].IndexNoeud),
                0,
                0);
        }
        si (reference->HachageNom == HacherSoiSemantique()) {
            naturel64 recepteur = TrouverRecepteurSemantique(
                etat, indexReference);
            si (recepteur >= etat->NombreSymboles) retourner 0;
            retourner HacherTypeNommeSemantique(
                HacherNomCompletSemantique(
                    etat,
                    etat->SymbolesTravail[recepteur].IndexNoeud),
                0,
                0);
        }
        naturel64 cible = TrouverVariableSemantique(
            etat, indexReference);
        si (cible >= etat->NombreSymboles)
            cible = TrouverDeclarationRacineSemantique(
                etat, indexReference);
        si (cible >= etat->NombreSymboles) retourner 0;
        si (etat->SymbolesTravail[cible].Genre == 2)
            retourner HacherPointeurFonctionDeclarationSemantique(
                etat, etat->SymbolesTravail[cible].IndexNoeud);
        si (etat->SymbolesTravail[cible].Genre == 7) {
            naturel64 indexEnumeration = etat->Requete->Noeuds[
                etat->SymbolesTravail[cible].IndexNoeud].Parent;
            si (indexEnumeration < etat->Requete->NombreNoeuds
                && etat->Requete->Noeuds[indexEnumeration].Genre == 8)
                retourner HacherTypeNommeSemantique(
                    HacherNomCompletSemantique(etat, indexEnumeration),
                    0,
                    0);
            retourner 0;
        }
        DescriptionTypeJetonsSemantique typeReferenceFonction;
        si (LireTypePointeurFonctionNoeudSemantique(
                etat,
                etat->SymbolesTravail[cible].IndexNoeud,
                &typeReferenceFonction)
            && (typeReferenceFonction.Qualificatifs & 4) != 0) {
            DescriptionHachageTypeSemantique dimensionsReferenceFonction = {
                0,
                0,
                HachageVideSemantique(),
                HachageVideSemantique()};
            retourner HacherPointeurFonctionSemantique(
                typeReferenceFonction.HachageNom,
                typeReferenceFonction.Qualificatifs & 3,
                typeReferenceFonction.NiveauPointeur,
                &dimensionsReferenceFonction);
        }
        retourner SansReferenceTypeSemantique(
            etat, etat->SymbolesTravail[cible].HachageType);
    }

