        TypeAffectationIncompatible = 73,
        IncompatibleAssignmentType = 73,
        ValeurRetourAttendue = 74,
        ReturnValueExpected = 74,
        TypeRetourIncompatible = 75,
        IncompatibleReturnType = 75,
        ObjetClasseGlobalInterdit = 76,
        GlobalClassObjectForbidden = 76,
        ReferenceGlobaleInterdite = 77,
        GlobalReferenceForbidden = 77,
        GlobaleVideInterdite = 78,
        VoidGlobalForbidden = 78,
        GlobaleExternePubliqueInterdite = 79,
        PublicExternalGlobalForbidden = 79,
        GlobaleConstanteNonInitialisee = 80,
        UninitializedConstGlobal = 80,
        InitialiseurGlobalAgregeRequis = 81,
        AggregateGlobalInitializerRequired = 81,
        CiblePointeurFonctionGlobalInvalide = 82,
        InvalidGlobalFunctionPointerTarget = 82,
        InitialiseurPointeurDonneesGlobalInterdit = 83,
        GlobalDataPointerInitializerForbidden = 83,
        InitialiseurGlobalNonConstant = 84,
        NonConstantGlobalInitializer = 84,
        ValeurEnumerationNonEntiere = 85,
        NonIntegerEnumeratorValue = 85,
        ValeurEnumerationNonConstante = 86,
        NonConstantEnumeratorValue = 86,
        ValeurEnumerationHorsPlage = 87,
        EnumeratorValueOutOfRange = 87,
        DebordementEnumerationSuivante = 88,
        NextEnumeratorValueOverflow = 88,
        DivisionConstanteParZero = 89,
        ConstantDivisionByZero = 89,
        ConstanteHorsPlageType = 90,
        ConstantOutsideTypeRange = 90,
        CapaciteGlobalesInsuffisante = 91,
        InsufficientGlobalCapacity = 91,
        CapaciteDonneesGlobalesInsuffisante = 92,
        InsufficientGlobalDataCapacity = 92,
        CapaciteRelocalisationsGlobalesInsuffisante = 93,
        InsufficientGlobalRelocationCapacity = 93,
        CibleConversionNonScalaire = 94,
        NonScalarCastTarget = 94,
        SourceConversionNonScalaire = 95,
        NonScalarCastSource = 95,
        ConversionPointeurEntierInterdite = 96,
        PointerIntegerCastForbidden = 96,
        SignatureConversionIncompatible = 97,
        IncompatibleCastSignature = 97,
        ConstanteConversionHorsPlage = 98,
        ConstantCastOutOfRange = 98,
        TypeConversionIntrouvable = 99,
        UnknownCastType = 99,
    };

    /**
     * <résumé>Catégories de symboles sémantiques.</résumé>
     * @etc. Les symboles sémantiques sont utilisés pour représenter les entités déclarées dans le code source.
     **/
    énumération GenreSymboleSemantique {

        Inconnu = 0,
        Unknown = 0,
        Type = 1,
        Fonction = 2,
        Function = 2,
        VariableGlobale = 3,
        GlobalVariable = 3,
        Alias = 4,
        Champ = 5,
        Field = 5,
        AliasChamp = 6,
        FieldAlias = 6,
        Enumerateur = 7,
        Enumerator = 7,
        Parametre = 8,
        Parameter = 8,
        VariableLocale = 9,
        LocalVariable = 9,
    };

    /**
     * <résumé>Drapeaux de résolution sémantique.</résumé>
     * @etc. Les drapeaux de résolution sémantique sont utilisés pour indiquer les propriétés des résolutions.
     **/
    énumération DrapeauResolutionSemantique {

        Aucun = 0,
        None = 0,
        GroupeSurcharges = 1,
        OverloadGroup = 1,
        RecepteurClasse = 2,
        ClassReceiver = 2,
        RecepteurBase = 4,
        BaseReceiver = 4,
        Membre = 8,
        Member = 8,
        MembreHerite = 16,
        InheritedMember = 16,
        Methode = 32,
        Method = 32,
        Constructeur = 64,
        Constructor = 64,
        ConstructionExplicite = 128,
        ExplicitConstruction = 128,
        Operateur = 256,
        Operator = 256,
        DelegationConstructeur = 512,
        ConstructorDelegation = 512,
        InitialisationBase = 1024,
        BaseInitialization = 1024,
        InitialisationChamp = 2048,
        FieldInitialization = 2048,
        InitialisationImplicite = 4096,
        ImplicitInitialization = 4096,
        InitialisationTableau = 8192,
        ArrayInitialization = 8192,
        ValeurChampParDefaut = 16384,
        DefaultFieldValue = 16384,
        EtapeDureeVie = 32768,
        LifetimeStep = 32768,
        ConstructionPlanifiee = 65536,
        PlannedConstruction = 65536,
        DestructionPlanifiee = 131072,
        PlannedDestruction = 131072,
        InitialisationTableVirtuelle = 262144,
        VirtualTableInitialization = 262144,
        SousObjetBase = 524288,
        BaseSubobject = 524288,
        SousObjetChamp = 1048576,
        FieldSubobject = 1048576,
        ElementTableau = 2097152,
        ArrayElement = 2097152,
    };

    /**
     * <résumé>Décrit un symbole déclaré dans le code source.</résumé>
     * @etc. Les symboles sémantiques sont utilisés pour représenter les entités déclarées dans le code source.
     **/
    structure SymboleSemantique {

        naturel64 IndexNoeud;
        naturel64 IndexPortee;
        naturel64 HachageNom;
        naturel64 HachageEspace;
        naturel64 HachageType;
        naturel32 Genre;
        naturel32 Drapeaux;
    };

    /**
     * <résumé>Décrit une cible résolue ou une étape ordonnée de durée de vie.</résumé>
     * @etc. Lorsque EtapeDureeVie est présent, HachageType contient le
     * décalage relatif en octets et non un hachage de type.
     **/
    structure ResolutionSemantique {

        naturel64 IndexNoeud;
        naturel64 IndexSymbole;
        naturel64 HachageType;
        naturel32 GenreCible;
        naturel32 Drapeaux;
    };

    /**
     * <résumé>Résultats de l'analyse sémantique.</résumé>
     * @etc. Les résultats de l'analyse sémantique incluent les erreurs, les statistiques et les capacités requises.
     **/
    structure ResultatAnalyseSemantique {

        ErreurAnalyseSemantique Erreur;
        naturel32 LigneErreur;
        naturel32 ColonneErreur;
        naturel32 Detail;
        naturel64 NombreSymboles;
        naturel64 CapaciteSymbolesRequise;
        naturel64 NombreResolutions;
        naturel64 CapaciteResolutionsRequise;
        naturel64 NombreOctetsArene;
    };

    /**
     * <résumé>Requête pour l'analyse sémantique.</résumé>
     * @etc. La requête pour l'analyse sémantique contient les entrées et sorties de la passe.
     **/
    structure RequeteAnalyseSemantique {

        constante caractère* Source;
        naturel64 TailleSource;
        constante NoeudDeclaration* Noeuds;
        naturel64 NombreNoeuds;
        SymboleSemantique* Symboles;
        naturel64 CapaciteSymboles;
        ResolutionSemantique* Resolutions;
        naturel64 CapaciteResolutions;
        ResultatAnalyseSemantique Resultat;
    };

    /**
     * <résumé>Indexe les symboles et résout les types de la tranche auto-hébergée.</résumé>
     * @Paramètre(RequeteAnalyseSemantique*: requete) Entrée et sorties de la passe.
     * @Retourner(ErreurAnalyseSemantique) État final ou capacité requise.
     **/
    publique ErreurAnalyseSemantique AnalyserSemantique(RequeteAnalyseSemantique* requete);

    alias SemanticSymbol = SymboleSemantique;
    alias SemanticResolution = ResolutionSemantique;
    alias SemanticAnalysisResult = ResultatAnalyseSemantique;
    alias SemanticAnalysisRequest = RequeteAnalyseSemantique;
    alias AnalyzeSemantics = AnalyserSemantique;

    /**
     * <résumé>Stockage d'une globale définie, dans les données ou la zone zéro.</résumé>
     * @etc. Decalage est relatif à la zone choisie par Initialisee (bit 0).
     * Le bit 1 indique une globale publique. Les imports n'occupent aucun stockage.
     **/
    structure GlobaleEmise {

        naturel64 IndexNoeud;
        naturel64 IndexSymbole;
        naturel64 Decalage;
        naturel64 Taille;
        naturel64 Alignement;
        naturel32 Drapeaux;
        naturel32 Reserve;
    };

    /**
     * <résumé>Adresse de fonction à résoudre par le futur éditeur de liens.</résumé>
     * @etc. Decalage est relatif à la globale désignée par IndexNoeudGlobale.
     * IndexSymboleCible désigne la même table que AnalyserSemantique.
     * Genre vaut 1 pour une adresse absolue de 64 bits ; les huit octets sont nuls.
     **/
    structure RelocalisationGlobale {

        naturel64 IndexNoeudGlobale;
        naturel64 Decalage;
        naturel64 IndexSymboleCible;
        naturel32 Genre;
        naturel32 Reserve;
    };

    /**
     * <résumé>Diagnostic et capacités exactes de l'émission des globales.</résumé>
     * @etc. Les nombres indiquent les besoins même lorsque les tampons sont trop petits.
     * NombreOctetsZero décrit un stockage à réserver, sans tampon associé.
     **/
    structure ResultatEmissionGlobales {

        ErreurAnalyseSemantique Erreur;
        naturel32 LigneErreur;
        naturel32 ColonneErreur;
        naturel32 Detail;
        naturel64 NombreGlobales;
        naturel64 NombreOctetsDonnees;
        naturel64 NombreOctetsZero;
        naturel64 NombreRelocalisations;
        naturel64 NombreOctetsArene;
    };

    /**
     * <résumé>Entrées et tampons appartenant à l'appelant pour l'émission des globales.</résumé>
     * @etc. Une capacité nulle permet d'interroger les besoins avec un pointeur nul.
     * Aucun tampon n'est écrit tant que les trois capacités ne sont pas suffisantes.
     * Les tampons de sortie doivent être distincts et ne pas recouvrir les entrées.
     **/
    structure RequeteEmissionGlobales {

        constante caractère* Source;
        naturel64 TailleSource;
        constante NoeudDeclaration* Noeuds;
        naturel64 NombreNoeuds;
        GlobaleEmise* Globales;
        naturel64 CapaciteGlobales;
        octet* Donnees;
        naturel64 CapaciteDonnees;
        RelocalisationGlobale* Relocalisations;
        naturel64 CapaciteRelocalisations;
        ResultatEmissionGlobales Resultat;
    };

    /**
     * <résumé>Analyse puis émet les données et relocalisations des globales.</résumé>
     * @Paramètre(RequeteEmissionGlobales*: requete) Source, AST et sorties bornées.
     * @Retourner(ErreurAnalyseSemantique) Diagnostic ou succès de l'émission.
     **/
    publique ErreurAnalyseSemantique EmettreGlobales(RequeteEmissionGlobales* requete);

    alias EmittedGlobal = GlobaleEmise;
    alias GlobalRelocation = RelocalisationGlobale;
    alias GlobalEmissionResult = ResultatEmissionGlobales;
    alias GlobalEmissionRequest = RequeteEmissionGlobales;
    alias EmitGlobals = EmettreGlobales;
}
