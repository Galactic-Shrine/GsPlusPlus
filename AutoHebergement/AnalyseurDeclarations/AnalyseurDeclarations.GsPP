    naturel64 AnalyserAffectationExpressionDeclaration(
        EtatAnalyseDeclarations* etat) {
        naturel64 cible = AnalyserOuLogiqueExpressionDeclaration(etat);
        si (cible == IndexExpressionNulDeclaration()) retourner cible;
        si (!AccepterJetonDeclaration(etat, 45)) retourner cible;
        naturel64 valeur = AnalyserAffectationExpressionDeclaration(etat);
        si (valeur == IndexExpressionNulDeclaration()) retourner valeur;
        NoeudExpressionInterne affectation;
        NoeudExpressionInterne* position = &etat->ExpressionsTravail[cible];
        InitialiserExpressionInterneDeclaration(
            &affectation, 27, position->Ligne, position->Colonne);
        naturel64 indexAffectation =
            AjouterExpressionInterneDeclaration(etat, affectation);
        si (indexAffectation == IndexExpressionNulDeclaration())
            retourner indexAffectation;
        AjouterEnfantExpressionDeclaration(
            etat, indexAffectation, cible);
        AjouterEnfantExpressionDeclaration(
            etat, indexAffectation, valeur);
        retourner indexAffectation;
    }

    naturel64 AnalyserExpressionInterneDeclaration(
        EtatAnalyseDeclarations* etat) {
        retourner AnalyserAffectationExpressionDeclaration(etat);
    }

    booléen EmettreExpressionDeclaration(
        EtatAnalyseDeclarations* etat,
        naturel64 indexExpression,
        naturel64 indexParent,
        naturel64 hachageEspace) {
        NoeudExpressionInterne* expression =
            &etat->ExpressionsTravail[indexExpression];
        naturel64 indexSortie = etat->NombreNoeuds;
        NoeudDeclaration noeud = {
            expression->Genre,
            expression->Ligne,
            expression->Colonne,
            expression->Drapeaux,
            indexParent,
            expression->DebutNom,
            expression->TailleNom,
            expression->HachageNom,
            hachageEspace,
            expression->HachageType};
        si (!AjouterNoeudDeclaration(etat, noeud)) retourner faux;
        naturel64 enfant = expression->PremierEnfant;
        tantque (enfant != IndexExpressionNulDeclaration()) {
            naturel64 suivant =
                etat->ExpressionsTravail[enfant].EnfantSuivant;
            si (!EmettreExpressionDeclaration(
                    etat, enfant, indexSortie, hachageEspace))
                retourner faux;
            enfant = suivant;
        }
        retourner vrai;
    }

    booléen AnalyserEtEmettreExpressionDeclaration(
        EtatAnalyseDeclarations* etat,
        naturel64 indexParent,
        naturel64 hachageEspace) {
        etat->NombreExpressions = 0;
        naturel64 expression = AnalyserExpressionInterneDeclaration(etat);
        si (expression == IndexExpressionNulDeclaration()) retourner faux;
        retourner EmettreExpressionDeclaration(
            etat, expression, indexParent, hachageEspace);
    }

    booléen AnalyserArgumentsExpressionsDeclaration(
        EtatAnalyseDeclarations* etat,
        naturel64 indexParent,
        naturel64 hachageEspace) {
        si (!ExigerJetonDeclaration(
                etat,
                34,
                ErreurAnalyseDeclarations::ParentheseOuvranteAttendue))
            retourner faux;
        si (!EstJetonDeclaration(etat, 35)) {
            booléen continuer = vrai;
            tantque (continuer) {
                si (!AnalyserEtEmettreExpressionDeclaration(
                        etat, indexParent, hachageEspace))
                    retourner faux;
                si (!AccepterJetonDeclaration(etat, 41))
                    continuer = faux;
            }
        }
        retourner ExigerJetonDeclaration(
            etat,
            35,
            ErreurAnalyseDeclarations::ParentheseFermanteAttendue);
    }

    booléen DebuteDeclarationVariableDeclaration(
        EtatAnalyseDeclarations* etat) {
        naturel32 genre = JetonCourantDeclaration(etat)->Genre;
        si (genre == 12 || genre == 13
            || (genre >= 14 && genre <= 25))
            retourner vrai;
        si (genre != 1) retourner faux;

        naturel64 positionSauvee = etat->Position;
        TypeDeclarationInterne typeTeste;
        booléen resultat = faux;
        si (AnalyserTypeDeclaration(etat, &typeTeste)
            && EstJetonDeclaration(etat, 1))
            resultat = vrai;
        etat->Position = positionSauvee;
        retourner resultat;
    }

    booléen AnalyserInstructionDeclaration(
        EtatAnalyseDeclarations* etat,
        ContexteInstructionDeclaration* contexte) {
        JetonLexe position = *JetonCourantDeclaration(etat);
        si (EstJetonDeclaration(etat, 36)) {
            etat->Position = etat->Position + 1;
            naturel64 indexBloc = etat->NombreNoeuds;
            NoeudDeclaration bloc = {
                16,
                position.Ligne,
                position.Colonne,
                0,
                contexte->Parent,
                0,
                0,
                0,
                contexte->Espace->Hachage,
                0};
            si (!AjouterNoeudDeclaration(etat, bloc)) retourner faux;
            ContexteInstructionDeclaration enfant = {
                contexte->Espace, indexBloc};
            tantque (!EstJetonDeclaration(etat, 37)) {
                JetonLexe* courantBloc = JetonCourantDeclaration(etat);
                si (courantBloc->Genre == 0) {
                    SignalerErreurDeclaration(
                        etat,
                        ErreurAnalyseDeclarations::AccoladeFermanteAttendue,
                        courantBloc->Ligne,
                        courantBloc->Colonne);
                    retourner faux;
                }
                si (!AnalyserInstructionDeclaration(etat, &enfant))
                    retourner faux;
            }
            retourner ExigerJetonDeclaration(
                etat,
                37,
                ErreurAnalyseDeclarations::AccoladeFermanteAttendue);
        }

        si (AccepterJetonDeclaration(etat, 28)) {
            naturel32 drapeauxRetour = 0;
            si (!EstJetonDeclaration(etat, 40)) drapeauxRetour = 2048;
            naturel64 indexRetour = etat->NombreNoeuds;
            NoeudDeclaration retour = {
                17,
                position.Ligne,
                position.Colonne,
                drapeauxRetour,
                contexte->Parent,
                0,
                0,
                0,
                contexte->Espace->Hachage,
                0};
            si (!AjouterNoeudDeclaration(etat, retour)) retourner faux;
            si (drapeauxRetour != 0
                && !AnalyserEtEmettreExpressionDeclaration(
                    etat, indexRetour, contexte->Espace->Hachage))
                retourner faux;
            retourner ExigerJetonDeclaration(
                etat,
                40,
                ErreurAnalyseDeclarations::PointVirguleAttendu);
        }

        si (AccepterJetonDeclaration(etat, 29)) {
            si (!ExigerJetonDeclaration(
                    etat,
                    34,
                    ErreurAnalyseDeclarations::ParentheseOuvranteAttendue))
                retourner faux;
            naturel64 indexConditionnelle = etat->NombreNoeuds;
            NoeudDeclaration conditionnelle = {
                20,
                position.Ligne,
                position.Colonne,
                2048,
                contexte->Parent,
                0,
                0,
                0,
                contexte->Espace->Hachage,
                0};
            si (!AjouterNoeudDeclaration(etat, conditionnelle))
                retourner faux;
            si (!AnalyserEtEmettreExpressionDeclaration(
                    etat,
                    indexConditionnelle,
                    contexte->Espace->Hachage))
                retourner faux;
            si (!ExigerJetonDeclaration(
                    etat,
                    35,
                    ErreurAnalyseDeclarations::ParentheseFermanteAttendue))
                retourner faux;
            ContexteInstructionDeclaration branche = {
                contexte->Espace, indexConditionnelle};
            si (!AnalyserInstructionDeclaration(etat, &branche))
                retourner faux;
            si (AccepterJetonDeclaration(etat, 30)) {
                etat->NoeudsTravail[indexConditionnelle].Drapeaux =
                    2048 | 4096;
                si (!AnalyserInstructionDeclaration(etat, &branche))
                    retourner faux;
            }
            retourner vrai;
        }

        si (AccepterJetonDeclaration(etat, 31)) {
            si (!ExigerJetonDeclaration(
                    etat,
                    34,
                    ErreurAnalyseDeclarations::ParentheseOuvranteAttendue))
                retourner faux;
            naturel64 indexBoucle = etat->NombreNoeuds;
            NoeudDeclaration boucle = {
                21,
                position.Ligne,
                position.Colonne,
                2048,
                contexte->Parent,
                0,
                0,
                0,
                contexte->Espace->Hachage,
                0};
            si (!AjouterNoeudDeclaration(etat, boucle)) retourner faux;
            si (!AnalyserEtEmettreExpressionDeclaration(
                    etat, indexBoucle, contexte->Espace->Hachage))
                retourner faux;
            si (!ExigerJetonDeclaration(
                    etat,
                    35,
                    ErreurAnalyseDeclarations::ParentheseFermanteAttendue))
                retourner faux;
            ContexteInstructionDeclaration corpsBoucle = {
                contexte->Espace, indexBoucle};
            retourner AnalyserInstructionDeclaration(etat, &corpsBoucle);
        }

        si (DebuteDeclarationVariableDeclaration(etat)) {
            TypeDeclarationInterne typeVariable;
            si (!AnalyserTypeDeclaration(etat, &typeVariable))
                retourner faux;
            JetonLexe* nomVariable = JetonCourantDeclaration(etat);
            si (!ExigerJetonDeclaration(
                    etat,
                    1,
                    ErreurAnalyseDeclarations::IdentifiantAttendu))
                retourner faux;
            si (!AnalyserDimensionsDeclaration(etat, &typeVariable))
                retourner faux;
            naturel32 drapeauxVariable = 0;
            si (EstJetonDeclaration(etat, 45))
                drapeauxVariable = 4 | 2048;
            sinon si (EstJetonDeclaration(etat, 34))
                drapeauxVariable = 8192;
            naturel64 indexVariable = etat->NombreNoeuds;
            NoeudDeclaration variable = {
                19,
                position.Ligne,
                position.Colonne,
                drapeauxVariable,
                contexte->Parent,
                nomVariable->Debut,
                nomVariable->TailleSource,
                nomVariable->HachageTexte,
                contexte->Espace->Hachage,
                HacherTypeDeclaration(&typeVariable)};
            si (!AjouterNoeudDeclaration(etat, variable)) retourner faux;
            si (AccepterJetonDeclaration(etat, 45)) {
                si (!AnalyserEtEmettreExpressionDeclaration(
                        etat,
                        indexVariable,
                        contexte->Espace->Hachage))
                    retourner faux;
            }
            sinon si (EstJetonDeclaration(etat, 34)) {
                si (!AnalyserArgumentsExpressionsDeclaration(
                        etat,
                        indexVariable,
                        contexte->Espace->Hachage))
                    retourner faux;
            }
            retourner ExigerJetonDeclaration(
                etat,
                40,
                ErreurAnalyseDeclarations::PointVirguleAttendu);
        }

        naturel64 indexExpression = etat->NombreNoeuds;
        NoeudDeclaration expression = {
            18,
            position.Ligne,
            position.Colonne,
            2048,
            contexte->Parent,
            0,
            0,
            0,
            contexte->Espace->Hachage,
            0};
        si (!AjouterNoeudDeclaration(etat, expression)) retourner faux;
        si (!AnalyserEtEmettreExpressionDeclaration(
                etat, indexExpression, contexte->Espace->Hachage))
            retourner faux;
        retourner ExigerJetonDeclaration(
            etat,
            40,
            ErreurAnalyseDeclarations::PointVirguleAttendu);
    }

    booléen AnalyserBlocInstructionDeclaration(
        EtatAnalyseDeclarations* etat,
        ContexteInstructionDeclaration* contexte) {
        si (!EstJetonDeclaration(etat, 36)) {
            JetonLexe* ouverture = JetonCourantDeclaration(etat);
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::AccoladeOuvranteAttendue,
                ouverture->Ligne,
                ouverture->Colonne);
            retourner faux;
        }
        retourner AnalyserInstructionDeclaration(etat, contexte);
    }

    booléen AnalyserFonctionDeclaration(
        EtatAnalyseDeclarations* etat,
        ContexteEspaceDeclaration* contexte) {
        JetonLexe position = *JetonCourantDeclaration(etat);
        booléen estPublique = faux;
        booléen estExterne = faux;
        booléen continuer = vrai;
        tantque (continuer) {
            si (AccepterJetonDeclaration(etat, 10)) estPublique = vrai;
            sinon si (AccepterJetonDeclaration(etat, 11)) estPublique = faux;
            sinon si (AccepterJetonDeclaration(etat, 9)) estExterne = vrai;
            sinon continuer = faux;
        }

        TypeDeclarationInterne typeRetour;
        si (!AnalyserTypeDeclaration(etat, &typeRetour)) retourner faux;
        JetonLexe* nom = JetonCourantDeclaration(etat);
        si (!ExigerJetonDeclaration(
                etat,
                1,
                ErreurAnalyseDeclarations::IdentifiantAttendu))
            retourner faux;
        si (!AnalyserDimensionsDeclaration(etat, &typeRetour)) retourner faux;
        si (!EstJetonDeclaration(etat, 34)) {
            naturel32 drapeauxGlobale = 0;
            si (estPublique) drapeauxGlobale = drapeauxGlobale | 1;
            si (estExterne) drapeauxGlobale = drapeauxGlobale | 2;
            si (EstJetonDeclaration(etat, 45)) {
                si (estExterne) {
                    SignalerErreurDeclaration(
                        etat,
                        ErreurAnalyseDeclarations::InitialiseurExterneInterdit,
                        position.Ligne,
                        position.Colonne);
                    retourner faux;
                }
                drapeauxGlobale = drapeauxGlobale | 4;
            }
            naturel64 indexGlobale = etat->NombreNoeuds;
            NoeudDeclaration noeudGlobale = {
                3,
                position.Ligne,
                position.Colonne,
                drapeauxGlobale,
                0,
                nom->Debut,
                nom->TailleSource,
                nom->HachageTexte,
                contexte->Hachage,
                HacherTypeDeclaration(&typeRetour)};
            si (!AjouterNoeudDeclaration(etat, noeudGlobale)) retourner faux;
            si (AccepterJetonDeclaration(etat, 45)
                && !AnalyserEtEmettreExpressionDeclaration(
                    etat, indexGlobale, contexte->Hachage))
                retourner faux;
            retourner ExigerJetonDeclaration(
                etat,
                40,
                ErreurAnalyseDeclarations::PointVirguleAttendu);
        }
        si (typeRetour.NombreDimensions != 0) {
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::DeclarationNonPriseEnCharge,
                position.Ligne,
                position.Colonne);
            retourner faux;
        }

        naturel64 indexFonction = etat->NombreNoeuds;
        naturel32 drapeaux = 0;
        si (estPublique) drapeaux = drapeaux | 1;
        si (estExterne) drapeaux = drapeaux | 2;
        si (!estExterne) drapeaux = drapeaux | 4;
        NoeudDeclaration noeudFonction = {
            1,
            position.Ligne,
            position.Colonne,
            drapeaux,
            0,
            nom->Debut,
            nom->TailleSource,
            nom->HachageTexte,
            contexte->Hachage,
            HacherTypeDeclaration(&typeRetour)};
        si (!AjouterNoeudDeclaration(etat, noeudFonction)) retourner faux;

        etat->Position = etat->Position + 1;
        si (!EstJetonDeclaration(etat, 35)) {
            booléen continuerParametres = vrai;
            tantque (continuerParametres) {
                JetonLexe positionParametre = *JetonCourantDeclaration(etat);
                TypeDeclarationInterne typeParametre;
                si (!AnalyserTypeDeclaration(etat, &typeParametre))
                    retourner faux;
                JetonLexe* nomParametre = JetonCourantDeclaration(etat);
                si (!ExigerJetonDeclaration(
                        etat,
                        1,
                        ErreurAnalyseDeclarations::IdentifiantAttendu))
                    retourner faux;
                si (!AnalyserDimensionsDeclaration(etat, &typeParametre))
                    retourner faux;
                NoeudDeclaration noeudParametre = {
                    2,
                    positionParametre.Ligne,
                    positionParametre.Colonne,
                    0,
                    indexFonction,
                    nomParametre->Debut,
                    nomParametre->TailleSource,
                    nomParametre->HachageTexte,
                    contexte->Hachage,
                    HacherTypeDeclaration(&typeParametre)};
                si (!AjouterNoeudDeclaration(etat, noeudParametre))
                    retourner faux;
                si (!AccepterJetonDeclaration(etat, 41))
                    continuerParametres = faux;
            }
        }
        si (!ExigerJetonDeclaration(
                etat,
                35,
                ErreurAnalyseDeclarations::ParentheseFermanteAttendue))
            retourner faux;

        si (estExterne)
            retourner ExigerJetonDeclaration(
                etat,
                40,
                ErreurAnalyseDeclarations::PointVirguleAttendu);
        ContexteInstructionDeclaration contexteCorps = {
            contexte,
            indexFonction};
        retourner AnalyserBlocInstructionDeclaration(etat, &contexteCorps);
    }

    booléen AnalyserMembreClasseDeclaration(
        EtatAnalyseDeclarations* etat,
        ContexteMembreClasseDeclaration* contexte) {
        JetonLexe position = *JetonCourantDeclaration(etat);
        booléen estVirtuelle = faux;
        booléen estRemplacement = faux;
        booléen continuerModificateurs = vrai;
        tantque (continuerModificateurs) {
            si (AccepterJetonDeclaration(etat, 68)) {
                si (estVirtuelle) {
                    SignalerErreurDeclaration(
                        etat,
                        ErreurAnalyseDeclarations::ModificateurMembreDuplique,
                        position.Ligne,
                        position.Colonne);
                    retourner faux;
                }
                estVirtuelle = vrai;
            }
            sinon si (AccepterJetonDeclaration(etat, 74)) {
                si (estRemplacement) {
                    SignalerErreurDeclaration(
                        etat,
                        ErreurAnalyseDeclarations::ModificateurMembreDuplique,
                        position.Ligne,
                        position.Colonne);
                    retourner faux;
                }
                estRemplacement = vrai;
                estVirtuelle = vrai;
            }
            sinon continuerModificateurs = faux;
        }

        naturel32 genre = 12;
        TypeDeclarationInterne typeRetour;
        JetonLexe* nomMembre = contexte->NomClasse;
        booléen estConstructeur = faux;
        booléen estDestructeur = faux;
        si (AccepterJetonDeclaration(etat, 69)) {
            si (estVirtuelle || estRemplacement) {
                SignalerErreurDeclaration(
                    etat,
                    ErreurAnalyseDeclarations::ModificateurConstructeurInterdit,
                    position.Ligne,
                    position.Colonne);
                retourner faux;
            }
            genre = 13;
            estConstructeur = vrai;
            InitialiserTypeVideDeclaration(&typeRetour);
        }
        sinon si (AccepterJetonDeclaration(etat, 70)) {
            genre = 14;
            estDestructeur = vrai;
            InitialiserTypeVideDeclaration(&typeRetour);
        }
        sinon {
            si (!AnalyserTypeDeclaration(etat, &typeRetour)) retourner faux;
            si (AccepterJetonDeclaration(etat, 71)) {
                JetonLexe* jetonOperateur = JetonCourantDeclaration(etat);
                si (!EstOperateurSurchargeableDeclaration(
                        jetonOperateur->Genre)) {
                    SignalerErreurDeclaration(
                        etat,
                        ErreurAnalyseDeclarations::OperateurSurchargeableAttendu,
                        jetonOperateur->Ligne,
                        jetonOperateur->Colonne);
                    retourner faux;
                }
                genre = 15;
                nomMembre = jetonOperateur;
                etat->Position = etat->Position + 1;
            }
            sinon {
                nomMembre = JetonCourantDeclaration(etat);
                si (!ExigerJetonDeclaration(
                        etat,
                        1,
                        ErreurAnalyseDeclarations::IdentifiantAttendu))
                    retourner faux;
            }
        }

        si (!ExigerJetonDeclaration(
                etat,
                34,
                ErreurAnalyseDeclarations::ParentheseOuvranteAttendue))
            retourner faux;

        naturel32 drapeaux = contexte->Visibilite | 4;
        si (estVirtuelle) drapeaux = drapeaux | 64;
        si (estRemplacement) drapeaux = drapeaux | 128;
        naturel64 indexMembre = etat->NombreNoeuds;
        NoeudDeclaration noeudMembre = {
            genre,
            position.Ligne,
            position.Colonne,
            drapeaux,
            contexte->IndexClasse,
            nomMembre->Debut,
            nomMembre->TailleSource,
            nomMembre->HachageTexte,
            contexte->Espace->Hachage,
            HacherTypeDeclaration(&typeRetour)};
        si (!AjouterNoeudDeclaration(etat, noeudMembre)) retourner faux;

        naturel32 nombreParametres = 0;
        si (!EstJetonDeclaration(etat, 35)) {
            booléen continuerParametres = vrai;
            tantque (continuerParametres) {
                JetonLexe positionParametre = *JetonCourantDeclaration(etat);
                TypeDeclarationInterne typeParametre;
                si (!AnalyserTypeDeclaration(etat, &typeParametre))
                    retourner faux;
                JetonLexe* nomParametre = JetonCourantDeclaration(etat);
                si (!ExigerJetonDeclaration(
                        etat,
                        1,
                        ErreurAnalyseDeclarations::IdentifiantAttendu))
                    retourner faux;
                si (!AnalyserDimensionsDeclaration(etat, &typeParametre))
                    retourner faux;
                NoeudDeclaration noeudParametre = {
                    2,
                    positionParametre.Ligne,
                    positionParametre.Colonne,
                    0,
                    indexMembre,
                    nomParametre->Debut,
                    nomParametre->TailleSource,
                    nomParametre->HachageTexte,
                    contexte->Espace->Hachage,
                    HacherTypeDeclaration(&typeParametre)};
                si (!AjouterNoeudDeclaration(etat, noeudParametre))
                    retourner faux;
                nombreParametres = nombreParametres + 1;
                si (!AccepterJetonDeclaration(etat, 41))
                    continuerParametres = faux;
            }
        }
        si (!ExigerJetonDeclaration(
                etat,
                35,
                ErreurAnalyseDeclarations::ParentheseFermanteAttendue))
            retourner faux;
        si (estDestructeur && nombreParametres != 0) {
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::ParametreDestructeurInterdit,
                position.Ligne,
                position.Colonne);
            retourner faux;
        }

        si (AccepterJetonDeclaration(etat, 73)) {
            si (!estConstructeur) {
                SignalerErreurDeclaration(
                    etat,
                    ErreurAnalyseDeclarations::ListeInitialisationInterdite,
                    position.Ligne,
                    position.Colonne);
                retourner faux;
            }
            booléen premier = vrai;
            booléen continuerInitialiseurs = vrai;
            tantque (continuerInitialiseurs) {
                JetonLexe* initialiseur = JetonCourantDeclaration(etat);
                si (AccepterJetonDeclaration(etat, 72)) {
                    si (!premier) {
                        SignalerErreurDeclaration(
                            etat,
                            ErreurAnalyseDeclarations::InitialiseurConstructeurInvalide,
                            initialiseur->Ligne,
                            initialiseur->Colonne);
                        retourner faux;
                    }
                    drapeaux = drapeaux | 512;
                    si (!AnalyserArgumentsExpressionsDeclaration(
                            etat,
                            indexMembre,
                            contexte->Espace->Hachage))
                        retourner faux;
                    si (EstJetonDeclaration(etat, 41)) {
                        JetonLexe* virguleDelegation =
                            JetonCourantDeclaration(etat);
                        SignalerErreurDeclaration(
                            etat,
                            ErreurAnalyseDeclarations::InitialiseurConstructeurInvalide,
                            virguleDelegation->Ligne,
                            virguleDelegation->Colonne);
                        retourner faux;
                    }
                    continuerInitialiseurs = faux;
                }
                sinon si (AccepterJetonDeclaration(etat, 75)) {
                    si (!premier) {
                        SignalerErreurDeclaration(
                            etat,
                            ErreurAnalyseDeclarations::InitialiseurConstructeurInvalide,
                            initialiseur->Ligne,
                            initialiseur->Colonne);
                        retourner faux;
                    }
                    drapeaux = drapeaux | 256;
                    si (!AnalyserArgumentsExpressionsDeclaration(
                            etat,
                            indexMembre,
                            contexte->Espace->Hachage))
                        retourner faux;
                }
                sinon {
                    si (!ExigerJetonDeclaration(
                            etat,
                            1,
                            ErreurAnalyseDeclarations::IdentifiantAttendu))
                        retourner faux;
                    drapeaux = drapeaux | 1024;
                    si (!AnalyserArgumentsExpressionsDeclaration(
                            etat,
                            indexMembre,
                            contexte->Espace->Hachage))
                        retourner faux;
                }
                premier = faux;
                si (continuerInitialiseurs
                    && !AccepterJetonDeclaration(etat, 41))
                    continuerInitialiseurs = faux;
            }
        }
        etat->NoeudsTravail[indexMembre].Drapeaux = drapeaux;
        ContexteInstructionDeclaration contexteCorps = {
            contexte->Espace,
            indexMembre};
        retourner AnalyserBlocInstructionDeclaration(etat, &contexteCorps);
    }

    booléen AnalyserAliasDeclaration(
        EtatAnalyseDeclarations* etat,
        ContexteEspaceDeclaration* contexte,
        naturel64 indexParent,
        booléen estAliasChamp) {
        JetonLexe position = *JetonCourantDeclaration(etat);
        etat->Position = etat->Position + 1;
        NomQualifieDeclaration nom;
        si (!AnalyserNomQualifieDeclaration(etat, &nom)) retourner faux;
        si (!ExigerJetonDeclaration(
                etat,
                45,
                ErreurAnalyseDeclarations::EgalAttendu))
            retourner faux;
        NomQualifieDeclaration cible;
        si (!AnalyserNomQualifieDeclaration(etat, &cible)) retourner faux;
        si (!ExigerJetonDeclaration(
                etat,
                40,
                ErreurAnalyseDeclarations::PointVirguleAttendu))
            retourner faux;

        naturel32 genre = 10;
        si (estAliasChamp) genre = 11;
        NoeudDeclaration noeud = {
            genre,
            position.Ligne,
            position.Colonne,
            0,
            indexParent,
            nom.Debut,
            nom.Taille,
            nom.Hachage,
            contexte->Hachage,
            cible.Hachage};
        retourner AjouterNoeudDeclaration(etat, noeud);
    }

    booléen AnalyserEnumerationDeclaration(
        EtatAnalyseDeclarations* etat,
        ContexteEspaceDeclaration* contexte) {
        etat->Position = etat->Position + 1;
        JetonLexe* nom = JetonCourantDeclaration(etat);
        si (!ExigerJetonDeclaration(
                etat,
                1,
                ErreurAnalyseDeclarations::IdentifiantAttendu))
            retourner faux;
        si (!ExigerJetonDeclaration(
                etat,
                36,
                ErreurAnalyseDeclarations::AccoladeOuvranteAttendue))
            retourner faux;

        naturel64 indexEnumeration = etat->NombreNoeuds;
        NoeudDeclaration noeudEnumeration = {
            8,
            nom->Ligne,
            nom->Colonne,
            4,
            0,
            nom->Debut,
            nom->TailleSource,
            nom->HachageTexte,
            contexte->Hachage,
            0};
        si (!AjouterNoeudDeclaration(etat, noeudEnumeration)) retourner faux;

        si (!EstJetonDeclaration(etat, 37)) {
            booléen continuerValeurs = vrai;
            tantque (continuerValeurs) {
                JetonLexe* valeur = JetonCourantDeclaration(etat);
                si (!ExigerJetonDeclaration(
                        etat,
                        1,
                        ErreurAnalyseDeclarations::IdentifiantAttendu))
                    retourner faux;
                naturel32 drapeaux = 0;
                si (EstJetonDeclaration(etat, 45)) drapeaux = 4;
                naturel64 indexEnumerateur = etat->NombreNoeuds;
                NoeudDeclaration enumerateur = {
                    9,
                    valeur->Ligne,
                    valeur->Colonne,
                    drapeaux,
                    indexEnumeration,
                    valeur->Debut,
                    valeur->TailleSource,
                    valeur->HachageTexte,
                    contexte->Hachage,
                    0};
                si (!AjouterNoeudDeclaration(etat, enumerateur))
                    retourner faux;
                si (AccepterJetonDeclaration(etat, 45)
                    && !AnalyserEtEmettreExpressionDeclaration(
                        etat, indexEnumerateur, contexte->Hachage))
                    retourner faux;
                si (AccepterJetonDeclaration(etat, 41)) {
                    si (EstJetonDeclaration(etat, 37))
                        continuerValeurs = faux;
                }
                sinon continuerValeurs = faux;
            }
        }
        si (!ExigerJetonDeclaration(
                etat,
                37,
                ErreurAnalyseDeclarations::AccoladeFermanteAttendue))
            retourner faux;
        retourner ExigerJetonDeclaration(
            etat,
            40,
            ErreurAnalyseDeclarations::PointVirguleAttendu);
    }

    booléen AnalyserStructureDeclaration(
        EtatAnalyseDeclarations* etat,
        ContexteEspaceDeclaration* contexte,
        naturel32 jetonStructure) {
        etat->Position = etat->Position + 1;
        JetonLexe* nom = JetonCourantDeclaration(etat);
        si (!ExigerJetonDeclaration(
                etat,
                1,
                ErreurAnalyseDeclarations::IdentifiantAttendu))
            retourner faux;

        naturel32 genre = 4;
        booléen estClasse = faux;
        si (jetonStructure == 6) genre = 5;
        sinon si (jetonStructure == 66) {
            genre = 6;
            estClasse = vrai;
        }
        naturel32 drapeauxStructure = 4;
        naturel64 hachageBase = 0;
        si (estClasse && AccepterJetonDeclaration(etat, 73)) {
            drapeauxStructure = drapeauxStructure | 32 | 1;
            si (AccepterJetonDeclaration(etat, 10)) {
            }
            sinon si (AccepterJetonDeclaration(etat, 67)) {
                drapeauxStructure = (drapeauxStructure & 4_294_967_294) | 8;
            }
            sinon si (AccepterJetonDeclaration(etat, 11)) {
                drapeauxStructure = (drapeauxStructure & 4_294_967_294) | 16;
            }
            NomQualifieDeclaration base;
            si (!AnalyserNomQualifieDeclaration(etat, &base)) retourner faux;
            hachageBase = base.Hachage;
        }
        si (!ExigerJetonDeclaration(
                etat,
                36,
                ErreurAnalyseDeclarations::AccoladeOuvranteAttendue))
            retourner faux;

        naturel64 indexStructure = etat->NombreNoeuds;
        NoeudDeclaration noeudStructure = {
            genre,
            nom->Ligne,
            nom->Colonne,
            drapeauxStructure,
            0,
            nom->Debut,
            nom->TailleSource,
            nom->HachageTexte,
            contexte->Hachage,
            hachageBase};
        si (!AjouterNoeudDeclaration(etat, noeudStructure)) retourner faux;

        naturel32 visibilite = 1;
        si (estClasse) visibilite = 16;
        tantque (!EstJetonDeclaration(etat, 37)) {
            JetonLexe* courant = JetonCourantDeclaration(etat);
            si (courant->Genre == 0) {
                SignalerErreurDeclaration(
                    etat,
                    ErreurAnalyseDeclarations::AccoladeFermanteAttendue,
                    courant->Ligne,
                    courant->Colonne);
                retourner faux;
            }
            si (estClasse
                && (courant->Genre == 10
                    || courant->Genre == 11
                    || courant->Genre == 67)) {
                si (courant->Genre == 10) visibilite = 1;
                sinon si (courant->Genre == 67) visibilite = 8;
                sinon visibilite = 16;
                etat->Position = etat->Position + 1;
                si (!ExigerJetonDeclaration(
                        etat,
                        73,
                        ErreurAnalyseDeclarations::DeuxPointsAttendu))
                    retourner faux;
            }
            sinon si (courant->Genre == 8) {
                si (!AnalyserAliasDeclaration(
                        etat, contexte, indexStructure, vrai))
                    retourner faux;
            }
            sinon {
                booléen estMembreExecutable = faux;
                si (estClasse) {
                    si (courant->Genre == 68
                        || courant->Genre == 69
                        || courant->Genre == 70
                        || courant->Genre == 74)
                        estMembreExecutable = vrai;
                    sinon {
                        naturel64 positionSauvee = etat->Position;
                        TypeDeclarationInterne typeTeste;
                        si (AnalyserTypeDeclaration(etat, &typeTeste)) {
                            si (EstJetonDeclaration(etat, 71))
                                estMembreExecutable = vrai;
                            sinon si (EstJetonDeclaration(etat, 1)) {
                                etat->Position = etat->Position + 1;
                                si (EstJetonDeclaration(etat, 34))
                                    estMembreExecutable = vrai;
                            }
                        }
                        etat->Position = positionSauvee;
                    }
                }
                si (estMembreExecutable) {
                    ContexteMembreClasseDeclaration contexteMembre = {
                        contexte,
                        indexStructure,
                        visibilite,
                        nom};
                    si (!AnalyserMembreClasseDeclaration(
                            etat, &contexteMembre))
                        retourner faux;
                }
                sinon {
                    JetonLexe positionChamp = *courant;
                    TypeDeclarationInterne typeChamp;
                    si (!AnalyserTypeDeclaration(etat, &typeChamp))
                        retourner faux;
                    JetonLexe* nomChamp = JetonCourantDeclaration(etat);
                    si (!ExigerJetonDeclaration(
                            etat,
                            1,
                            ErreurAnalyseDeclarations::IdentifiantAttendu))
                        retourner faux;
                    si (!AnalyserDimensionsDeclaration(etat, &typeChamp))
                        retourner faux;
                    naturel32 drapeauxChamp = visibilite;
                    si (EstJetonDeclaration(etat, 45)) {
                        si (!estClasse) {
                            SignalerErreurDeclaration(
                                etat,
                                ErreurAnalyseDeclarations::InitialiseurChampHorsClasse,
                                positionChamp.Ligne,
                                positionChamp.Colonne);
                            retourner faux;
                        }
                        drapeauxChamp = drapeauxChamp | 4;
                    }
                    naturel64 indexChamp = etat->NombreNoeuds;
                    NoeudDeclaration champ = {
                        7,
                        positionChamp.Ligne,
                        positionChamp.Colonne,
                        drapeauxChamp,
                        indexStructure,
                        nomChamp->Debut,
                        nomChamp->TailleSource,
                        nomChamp->HachageTexte,
                        contexte->Hachage,
                        HacherTypeDeclaration(&typeChamp)};
                    si (!AjouterNoeudDeclaration(etat, champ))
                        retourner faux;
                    si (AccepterJetonDeclaration(etat, 45)
                        && !AnalyserEtEmettreExpressionDeclaration(
                            etat, indexChamp, contexte->Hachage))
                        retourner faux;
                    si (!ExigerJetonDeclaration(
                            etat,
                            40,
                            ErreurAnalyseDeclarations::PointVirguleAttendu))
                        retourner faux;
                }
            }
        }

        si (!ExigerJetonDeclaration(
                etat,
                37,
                ErreurAnalyseDeclarations::AccoladeFermanteAttendue))
            retourner faux;
        retourner ExigerJetonDeclaration(
            etat,
            40,
            ErreurAnalyseDeclarations::PointVirguleAttendu);
    }

    booléen AnalyserDeclarationsDansEspace(
        EtatAnalyseDeclarations* etat,
        ContexteEspaceDeclaration* contexte,
        booléen attendreFermeture) {
        tantque (!EstJetonDeclaration(etat, 0)
            && !(attendreFermeture && EstJetonDeclaration(etat, 37))) {
            si (AccepterJetonDeclaration(etat, 4)) {
                ContexteEspaceDeclaration enfant = *contexte;
                si (!EstJetonDeclaration(etat, 1)) {
                    JetonLexe* nomEspaceManquant =
                        JetonCourantDeclaration(etat);
                    SignalerErreurDeclaration(
                        etat,
                        ErreurAnalyseDeclarations::IdentifiantAttendu,
                        nomEspaceManquant->Ligne,
                        nomEspaceManquant->Colonne);
                    retourner faux;
                }
                booléen continuerNom = vrai;
                tantque (continuerNom) {
                    JetonLexe* nom = JetonCourantDeclaration(etat);
                    si (!enfant.EstVide) {
                        enfant.Hachage = AjouterOctetDeclaration(
                            enfant.Hachage, 58);
                        enfant.Hachage = AjouterOctetDeclaration(
                            enfant.Hachage, 58);
                    }
                    enfant.Hachage = AjouterTrancheDeclaration(
                        etat, enfant.Hachage, nom);
                    enfant.EstVide = faux;
                    etat->Position = etat->Position + 1;
                    si (AccepterJetonDeclaration(etat, 44)) {
                        si (!EstJetonDeclaration(etat, 1)) {
                            JetonLexe* nomEspaceQualifieManquant =
                                JetonCourantDeclaration(etat);
                            SignalerErreurDeclaration(
                                etat,
                                ErreurAnalyseDeclarations::IdentifiantAttendu,
                                nomEspaceQualifieManquant->Ligne,
                                nomEspaceQualifieManquant->Colonne);
                            retourner faux;
                        }
                    }
                    sinon continuerNom = faux;
                }
                si (!ExigerJetonDeclaration(
                        etat,
                        36,
                        ErreurAnalyseDeclarations::AccoladeOuvranteAttendue))
                    retourner faux;
                si (!AnalyserDeclarationsDansEspace(etat, &enfant, vrai))
                    retourner faux;
                si (!ExigerJetonDeclaration(
                        etat,
                        37,
                        ErreurAnalyseDeclarations::AccoladeFermanteAttendue))
                    retourner faux;
                AccepterJetonDeclaration(etat, 40);
            }
            sinon si (EstJetonDeclaration(etat, 5)
                || EstJetonDeclaration(etat, 6)
                || EstJetonDeclaration(etat, 66)) {
                naturel32 genreStructure =
                    JetonCourantDeclaration(etat)->Genre;
                si (!AnalyserStructureDeclaration(
                        etat, contexte, genreStructure))
                    retourner faux;
            }
            sinon si (EstJetonDeclaration(etat, 7)) {
                si (!AnalyserEnumerationDeclaration(etat, contexte))
                    retourner faux;
            }
            sinon si (EstJetonDeclaration(etat, 8)) {
                si (!AnalyserAliasDeclaration(
                        etat, contexte, 0, faux))
                    retourner faux;
            }
            sinon {
                si (!AnalyserFonctionDeclaration(etat, contexte)) retourner faux;
            }
        }
        si (attendreFermeture && EstJetonDeclaration(etat, 0)) {
            JetonLexe* fermetureEspaceManquante =
                JetonCourantDeclaration(etat);
            SignalerErreurDeclaration(
                etat,
                ErreurAnalyseDeclarations::AccoladeFermanteAttendue,
                fermetureEspaceManquante->Ligne,
                fermetureEspaceManquante->Colonne);
            retourner faux;
        }
        retourner vrai;
    }

    vide InitialiserResultatDeclarations(
        ResultatAnalyseDeclarations* resultat) {
        resultat->Erreur = ErreurAnalyseDeclarations::Reussite;
        resultat->LigneErreur = 0;
        resultat->ColonneErreur = 0;
        resultat->Detail = 0;
        resultat->NombreNoeuds = 0;
        resultat->CapaciteRequise = 0;
        resultat->NombreOctetsArene = 0;
        resultat->Reserve = 0;
    }

    publique ErreurAnalyseDeclarations AnalyserDeclarationsSource(
        RequeteAnalyseDeclarations* requete) {
        si (!requete) retourner ErreurAnalyseDeclarations::ArgumentInvalide;
        InitialiserResultatDeclarations(&requete->Resultat);
        si ((!requete->Source && requete->Taille != 0)
            || (!requete->Noeuds && requete->Capacite != 0)) {
            requete->Resultat.Erreur =
                ErreurAnalyseDeclarations::ArgumentInvalide;
            requete->Resultat.LigneErreur = 1;
            requete->Resultat.ColonneErreur = 1;
            retourner requete->Resultat.Erreur;
        }

        RequeteLexage lexage = {
            requete->Source, requete->Taille,
            NulJetonsDeclarations, 0, {}};
        ErreurLexage erreurLexage = AnalyserSource(&lexage);
        si (erreurLexage != ErreurLexage::CapaciteInsuffisante) {
            requete->Resultat.Erreur =
                ErreurAnalyseDeclarations::ErreurLexicale;
            requete->Resultat.LigneErreur = lexage.Resultat.LigneErreur;
            requete->Resultat.ColonneErreur = lexage.Resultat.ColonneErreur;
            requete->Resultat.Detail = convertir<naturel32>(erreurLexage);
            retourner requete->Resultat.Erreur;
        }
        si (lexage.Resultat.CapaciteRequise == 0
            || lexage.Resultat.CapaciteRequise > 100_000_000) {
            requete->Resultat.Erreur =
                ErreurAnalyseDeclarations::AllocationImpossible;
            requete->Resultat.LigneErreur = 1;
            requete->Resultat.ColonneErreur = 1;
            retourner requete->Resultat.Erreur;
        }

        EtatAnalyseDeclarations etat;
        etat.Requete = requete;
        etat.Jetons = NulJetonsDeclarations;
        etat.NombreJetons = lexage.Resultat.CapaciteRequise;
        etat.Position = 0;
        etat.NoeudsTravail = NulNoeudsDeclarations;
        etat.NombreNoeuds = 0;
        etat.ExpressionsTravail = NulExpressionsDeclarations;
        etat.NombreExpressions = 0;
        GalacticShrine::GsPP::Hebergee::InitialiserArene(&etat.Arene, 4096);

        etat.Jetons = convertir<JetonLexe*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreJetons * 48, 8));
        etat.NoeudsTravail = convertir<NoeudDeclaration*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreJetons * 64, 8));
        etat.ExpressionsTravail = convertir<NoeudExpressionInterne*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreJetons * 72, 8));
        si (!etat.Jetons || !etat.NoeudsTravail
            || !etat.ExpressionsTravail) {
            requete->Resultat.Erreur =
                ErreurAnalyseDeclarations::AllocationImpossible;
            requete->Resultat.LigneErreur = 1;
            requete->Resultat.ColonneErreur = 1;
            requete->Resultat.NombreOctetsArene = etat.Arene.NombreOctets;
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }

        lexage.Jetons = etat.Jetons;
        lexage.Capacite = etat.NombreJetons;
        erreurLexage = AnalyserSource(&lexage);
        si (erreurLexage != ErreurLexage::Reussite) {
            requete->Resultat.Erreur =
                ErreurAnalyseDeclarations::ErreurLexicale;
            requete->Resultat.LigneErreur = lexage.Resultat.LigneErreur;
            requete->Resultat.ColonneErreur = lexage.Resultat.ColonneErreur;
            requete->Resultat.Detail = convertir<naturel32>(erreurLexage);
            requete->Resultat.NombreOctetsArene = etat.Arene.NombreOctets;
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }

        NoeudDeclaration programme = {
            0, 1, 1, 0, 0, 0, 0, 0,
            HachageVideDeclaration(), 0};
        si (!AjouterNoeudDeclaration(&etat, programme)) {
            requete->Resultat.NombreOctetsArene = etat.Arene.NombreOctets;
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        ContexteEspaceDeclaration racine = {
            HachageVideDeclaration(), vrai};
        si (!AnalyserDeclarationsDansEspace(&etat, &racine, faux)) {
            requete->Resultat.NombreOctetsArene = etat.Arene.NombreOctets;
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }

        requete->Resultat.NombreNoeuds = etat.NombreNoeuds;
        requete->Resultat.CapaciteRequise = etat.NombreNoeuds;
        requete->Resultat.NombreOctetsArene = etat.Arene.NombreOctets;
        naturel64 limite = requete->Capacite;
        si (limite > etat.NombreNoeuds) limite = etat.NombreNoeuds;
        naturel64 index = 0;
        tantque (requete->Noeuds && index < limite) {
            requete->Noeuds[index] = etat.NoeudsTravail[index];
            index = index + 1;
        }
        GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);

        si (!requete->Noeuds || requete->Capacite < etat.NombreNoeuds) {
            requete->Resultat.Erreur =
                ErreurAnalyseDeclarations::CapaciteInsuffisante;
            retourner requete->Resultat.Erreur;
        }
        requete->Resultat.Erreur = ErreurAnalyseDeclarations::Reussite;
        retourner requete->Resultat.Erreur;
    }
}
