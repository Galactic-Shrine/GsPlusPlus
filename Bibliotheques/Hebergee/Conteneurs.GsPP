espace GalacticShrine::GsPP::Hebergee
{
    publique vide InitialiserVecteurNaturels(
        VecteurNaturels* vecteur, naturel64* stockage, naturel64 capacite)
    {
        vecteur->Donnees = stockage;
        vecteur->Taille = 0;
        vecteur->Capacite = capacite;
    }

    publique booléen AjouterNaturel(
        VecteurNaturels* vecteur, naturel64 valeur)
    {
        si (vecteur->Taille >= vecteur->Capacite) retourner faux;
        vecteur->Donnees[vecteur->Taille] = valeur;
        vecteur->Taille = vecteur->Taille + 1;
        retourner vrai;
    }

    publique booléen LireNaturel(
        VecteurNaturels* vecteur, naturel64 index, naturel64* valeur)
    {
        si (index >= vecteur->Taille) retourner faux;
        *valeur = vecteur->Donnees[index];
        retourner vrai;
    }

    publique vide InitialiserTableSymboles(
        TableSymboles* table,
        EntreeTableSymboles* stockage,
        naturel64 capacite)
    {
        table->Entrees = stockage;
        table->Capacite = capacite;
        table->Nombre = 0;
        naturel64 index = 0;
        tantque (index < capacite)
        {
            table->Entrees[index].Occupee = faux;
            index = index + 1;
        }
    }

    publique booléen InsererSymbole(
        TableSymboles* table, VueTexte cle, naturel64 valeur)
    {
        si (table->Capacite == 0 || cle.Taille == 0) retourner faux;
        naturel64 position = HacherVueTexte(cle) % table->Capacite;
        naturel64 examines = 0;
        tantque (examines < table->Capacite)
        {
            EntreeTableSymboles* entree = &table->Entrees[position];
            si (!entree->Occupee)
            {
                entree->Cle = cle;
                entree->Valeur = valeur;
                entree->Occupee = vrai;
                table->Nombre = table->Nombre + 1;
                retourner vrai;
            }
            si (VuesTexteEgales(entree->Cle, cle))
            {
                entree->Valeur = valeur;
                retourner vrai;
            }
            position = (position + 1) % table->Capacite;
            examines = examines + 1;
        }
        retourner faux;
    }

    publique booléen ChercherSymbole(
        TableSymboles* table, VueTexte cle, naturel64* valeur)
    {
        si (table->Capacite == 0 || cle.Taille == 0) retourner faux;
        naturel64 position = HacherVueTexte(cle) % table->Capacite;
        naturel64 examines = 0;
        tantque (examines < table->Capacite)
        {
            EntreeTableSymboles* entree = &table->Entrees[position];
            si (!entree->Occupee) retourner faux;
            si (VuesTexteEgales(entree->Cle, cle))
            {
                *valeur = entree->Valeur;
                retourner vrai;
            }
            position = (position + 1) % table->Capacite;
            examines = examines + 1;
        }
        retourner faux;
    }
}
