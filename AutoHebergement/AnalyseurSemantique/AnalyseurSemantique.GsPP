    }

    naturel64 SelectionnerConstructeurSansArgumentSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexPosition,
        naturel64 indexType) {
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 cible = etat->NombreSymboles;
        naturel32 nombreCibles = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 13
                && CompterParametresFonctionSemantique(
                    etat, candidat->IndexNoeud) == 0) {
                si (cible >= etat->NombreSymboles) cible = index;
                nombreCibles = nombreCibles + 1;
            }
            index = index + 1;
        }
        si (cible >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexPosition,
                0);
            retourner etat->NombreSymboles;
        }
        si (nombreCibles > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexPosition,
                nombreCibles);
            retourner etat->NombreSymboles;
        }
        retourner cible;
    }

    ErreurAnalyseSemantique ValiderChampsParDefautSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 indexType = 0;
        tantque (indexType < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* type =
                &etat->Requete->Noeuds[indexType];
            si (type->Genre == 6) {
                booléen possedeValeurParDefaut = faux;
                naturel64 indexChamp = 0;
                tantque (indexChamp < etat->NombreSymboles) {
                    SymboleSemantique* symboleChamp =
                        &etat->SymbolesTravail[indexChamp];
                    si (symboleChamp->Genre == 5
                        && symboleChamp->IndexPortee == indexType) {
                        constante NoeudDeclaration* champ =
                            &etat->Requete->Noeuds[
                                symboleChamp->IndexNoeud];
                        si ((champ->Drapeaux & 4) != 0) {
                            possedeValeurParDefaut = vrai;
                            naturel64 typeChamp =
                                TrouverTypeDepuisHachageSemantique(
                                    etat, champ->HachageType, 0);
                            si (typeChamp >= etat->NombreSymboles)
                                typeChamp =
                                    TrouverTypeElementFinalTableauSemantique(
                                        etat, symboleChamp->IndexNoeud);
                            si (typeChamp < etat->NombreSymboles
                                && etat->Requete->Noeuds[
                                    etat->SymbolesTravail[
                                        typeChamp].IndexNoeud].Genre == 6)
                                retourner SignalerErreurSemantique(
                                    etat,
                                    ErreurAnalyseSemantique::
                                        ValeurChampParDefautObjetClasseInterdite,
                                    symboleChamp->IndexNoeud,
                                    convertir<naturel32>(indexChamp));
                        }
                    }
                    indexChamp = indexChamp + 1;
                }
                si (possedeValeurParDefaut) {
                    booléen constructeurDefini = faux;
                    naturel64 indexDefinition = 0;
                    tantque (indexDefinition < etat->Requete->NombreNoeuds) {
                        constante NoeudDeclaration* definition = &etat->Requete->Noeuds[indexDefinition];
                        si (definition->Genre == 13 && definition->Parent == indexType
                            && (definition->Drapeaux & 2) == 0) constructeurDefini = vrai;
                        indexDefinition = indexDefinition + 1;
                    }
                    si (!constructeurDefini)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                ClasseValeurChampParDefautSansConstructeur,
                            indexType,
                            0);
                }
            }
            indexType = indexType + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    externe ErreurAnalyseSemantique ValiderConstructionImpliciteContextuelleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType, naturel64 indexDiagnostic, naturel64 indexTypeContexte);

    externe naturel64 ResoudreArgumentsConstructeurContextuelsSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexArguments, naturel64 indexType);

    naturel64 TrouverTypeConstructeurInitialiseurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexInitialiseur) {
        si (indexInitialiseur >= etat->Requete->NombreNoeuds)
            retourner etat->NombreSymboles;
        constante NoeudDeclaration* initialiseur =
            &etat->Requete->Noeuds[indexInitialiseur];
        si (initialiseur->Parent >= etat->Requete->NombreNoeuds)
            retourner etat->NombreSymboles;
        constante NoeudDeclaration* noeudConstructeurInitialiseur =
            &etat->Requete->Noeuds[initialiseur->Parent];
        si (noeudConstructeurInitialiseur->Genre != 13
            || noeudConstructeurInitialiseur->Parent
                >= etat->Requete->NombreNoeuds)
            retourner etat->NombreSymboles;
        retourner TrouverSymboleNoeudSemantique(
            etat, noeudConstructeurInitialiseur->Parent);
    }

    naturel64 TrouverInitialiseurDelegueConstructeurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConstructeur) {
        naturel64 indexInitialiseurDelegue = indexConstructeur + 1;
        tantque (indexInitialiseurDelegue < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* candidatInitialiseurDelegue =
                &etat->Requete->Noeuds[indexInitialiseurDelegue];
            si (candidatInitialiseurDelegue->Genre == 33
                && candidatInitialiseurDelegue->Parent == indexConstructeur)
                retourner indexInitialiseurDelegue;
            indexInitialiseurDelegue = indexInitialiseurDelegue + 1;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    ErreurAnalyseSemantique ResoudreInitialiseurDelegueSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexInitialiseurDelegue) {
        naturel64 typeConstructeurDelegue =
            TrouverTypeConstructeurInitialiseurSemantique(
                etat, indexInitialiseurDelegue);
        si (typeConstructeurDelegue >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexInitialiseurDelegue,
                33);
        naturel64 cibleConstructeurDelegue =
            ResoudreArgumentsConstructeurContextuelsSemantique(
                etat,
                indexInitialiseurDelegue,
                typeConstructeurDelegue);
        si (cibleConstructeurDelegue >= etat->NombreSymboles)
            retourner etat->Requete->Resultat.Erreur;
        naturel64 indexConstructeurDelegant =
            etat->Requete->Noeuds[indexInitialiseurDelegue].Parent;
        si (etat->SymbolesTravail[
                cibleConstructeurDelegue].IndexNoeud
            == indexConstructeurDelegant)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::DelegationConstructeurDirecte,
                indexInitialiseurDelegue,
                convertir<naturel32>(cibleConstructeurDelegue));
        etat->CiblesInitialiseurs[indexInitialiseurDelegue] =
            cibleConstructeurDelegue;
        naturel32 drapeauxDelegation = 64 | 128 | 512;
        si (CompterConstructeursTypeSemantique(
                etat, typeConstructeurDelegue) > 1)
            drapeauxDelegation = drapeauxDelegation | 1;
        AjouterResolutionSemantique(
            etat,
            indexInitialiseurDelegue,
            cibleConstructeurDelegue,
            drapeauxDelegation);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ResoudreInitialiseurBaseSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexInitialiseurBase) {
        naturel64 typeConstructeurBase =
            TrouverTypeConstructeurInitialiseurSemantique(
                etat, indexInitialiseurBase);
        si (typeConstructeurBase >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexInitialiseurBase,
                34);
        naturel64 typeBaseInitialisee = TrouverTypeBaseSymboleSemantique(
            etat, typeConstructeurBase);
        si (typeBaseInitialisee >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::InitialiseurBaseSansClasseBase,
                indexInitialiseurBase,
                0);
        naturel64 nombreConstructeursBase =
            CompterConstructeursTypeSemantique(etat, typeBaseInitialisee);
        naturel64 nombreArgumentsBase = CompterEnfantsDirectsSemantique(
            etat, indexInitialiseurBase);
        si (nombreConstructeursBase == 0) {
            si (nombreArgumentsBase != 0)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::ConstructeurNonDeclare,
                    indexInitialiseurBase,
                    convertir<naturel32>(nombreArgumentsBase));
            retourner ValiderConstructionImpliciteContextuelleSemantique(
                etat, typeBaseInitialisee, etat->Requete->Noeuds[indexInitialiseurBase].Parent, typeConstructeurBase);
        }
        naturel64 cibleConstructeurBase = ResoudreArgumentsConstructeurContextuelsSemantique(
            etat, indexInitialiseurBase, typeBaseInitialisee);
        si (cibleConstructeurBase >= etat->NombreSymboles)
            retourner etat->Requete->Resultat.Erreur;
        etat->CiblesInitialiseurs[indexInitialiseurBase] =
            cibleConstructeurBase;
        naturel32 drapeauxBase = 64 | 128 | 1_024;
        si (nombreConstructeursBase > 1)
            drapeauxBase = drapeauxBase | 1;
        AjouterResolutionSemantique(
            etat,
            indexInitialiseurBase,
            cibleConstructeurBase,
            drapeauxBase);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ResoudreInitialiseurChampSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexInitialiseurChamp) {
        naturel64 typeConstructeurChamp =
            TrouverTypeConstructeurInitialiseurSemantique(
                etat, indexInitialiseurChamp);
        si (typeConstructeurChamp >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexInitialiseurChamp,
                35);
        constante NoeudDeclaration* initialiseurChamp =
            &etat->Requete->Noeuds[indexInitialiseurChamp];
        naturel64 cibleChampInitialise = TrouverPremierMembreTypeSemantique(
            etat,
            typeConstructeurChamp,
            initialiseurChamp->HachageNom,
            1);
        si (cibleChampInitialise < etat->NombreSymboles)
            cibleChampInitialise = ResoudreAliasChampSemantique(
                etat, cibleChampInitialise, typeConstructeurChamp);
        si (cibleChampInitialise >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ChampInitialiseurIntrouvable,
                indexInitialiseurChamp,
                0);

        naturel64 indexConstructeurChamp = initialiseurChamp->Parent;
        naturel64 indexInitialiseurChampPrecedent = indexConstructeurChamp + 1;
        naturel64 derniereCibleChamp = etat->NombreSymboles;
        tantque (indexInitialiseurChampPrecedent < indexInitialiseurChamp) {
            constante NoeudDeclaration* candidatChampPrecedent =
                &etat->Requete->Noeuds[indexInitialiseurChampPrecedent];
            si (candidatChampPrecedent->Genre == 35
                && candidatChampPrecedent->Parent == indexConstructeurChamp) {
                naturel64 cibleChampPrecedente = etat->CiblesInitialiseurs[
                    indexInitialiseurChampPrecedent];
                si (cibleChampPrecedente == cibleChampInitialise)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::ChampInitialisePlusieursFois,
                        indexInitialiseurChamp,
                        convertir<naturel32>(cibleChampInitialise));
                si (cibleChampPrecedente < etat->NombreSymboles)
                    derniereCibleChamp = cibleChampPrecedente;
            }
            indexInitialiseurChampPrecedent =
                indexInitialiseurChampPrecedent + 1;
        }
        si (derniereCibleChamp < etat->NombreSymboles
            && etat->SymbolesTravail[
                derniereCibleChamp].IndexNoeud
                >= etat->SymbolesTravail[
                    cibleChampInitialise].IndexNoeud)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::OrdreInitialisationChampInvalide,
                indexInitialiseurChamp,
                convertir<naturel32>(cibleChampInitialise));

        SymboleSemantique* symboleChamp = &etat->SymbolesTravail[
            cibleChampInitialise];
        naturel64 indexNoeudChamp = symboleChamp->IndexNoeud;
        naturel64 typeElementTableau = HachageElementFinalTableauSemantique(
            etat, indexNoeudChamp);
        booléen champTableau = typeElementTableau != 0;
        naturel64 typeChamp = TrouverTypeDepuisHachageSemantique(
            etat, symboleChamp->HachageType, 0);
        si (champTableau)
            typeChamp = TrouverTypeDepuisHachageSemantique(
                etat, typeElementTableau, 0);
        booléen champObjetClasse = typeChamp < etat->NombreSymboles
            && etat->Requete->Noeuds[
                etat->SymbolesTravail[typeChamp].IndexNoeud].Genre == 6;
        naturel64 nombreArgumentsChamp = CompterEnfantsDirectsSemantique(
            etat, indexInitialiseurChamp);
        naturel64 cibleConstructeurChamp = etat->NombreSymboles;

        si (champObjetClasse) {
            naturel64 nombreConstructeursChamp =
                CompterConstructeursTypeSemantique(etat, typeChamp);
            si (nombreConstructeursChamp == 0) {
                si (nombreArgumentsChamp != 0)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::ConstructeurNonDeclare,
                        indexInitialiseurChamp,
                        convertir<naturel32>(nombreArgumentsChamp));
                ErreurAnalyseSemantique erreurPlanChamp = ValiderConstructionImpliciteContextuelleSemantique(
                    etat, typeChamp, indexInitialiseurChamp, typeConstructeurChamp);
                si (erreurPlanChamp != ErreurAnalyseSemantique::Reussite) retourner erreurPlanChamp;
            }
            sinon {
                cibleConstructeurChamp = ResoudreArgumentsConstructeurContextuelsSemantique(
                    etat, indexInitialiseurChamp, typeChamp);
                si (cibleConstructeurChamp >= etat->NombreSymboles)
                    retourner etat->Requete->Resultat.Erreur;
            }
        }
        sinon si (champTableau) {
            si (nombreArgumentsChamp != 1)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AriteInitialiseurChampInvalide,
                    indexInitialiseurChamp,
                    convertir<naturel32>(nombreArgumentsChamp));
            naturel64 argumentTableau = TrouverEnfantDirectSemantique(
                etat, indexInitialiseurChamp, 0);
            si (argumentTableau >= etat->Requete->NombreNoeuds)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    indexInitialiseurChamp,
                    41);
            si (etat->Requete->Noeuds[argumentTableau].Genre != 32)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::InitialiseurChampTableauNonAgrege,
                    indexInitialiseurChamp,
                    convertir<naturel32>(cibleChampInitialise));
            DestinationInitialiseurSemantique destinationTableau;
            si (!InitialiserDestinationInitialiseurSemantique(etat, indexNoeudChamp, &destinationTableau))
                retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, indexNoeudChamp, 41);
            destinationTableau.Reserve = 1;
            ErreurAnalyseSemantique erreurTableau = ValiderInitialiseurDestinationSemantique(
                etat, argumentTableau, &destinationTableau);
            si (erreurTableau != ErreurAnalyseSemantique::Reussite) retourner erreurTableau;
        }
        sinon si (EstTypeScalaireSemantique(
                etat, symboleChamp->HachageType)) {
            si (nombreArgumentsChamp != 1)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AriteInitialiseurChampInvalide,
                    indexInitialiseurChamp,
                    convertir<naturel32>(nombreArgumentsChamp));
            naturel64 argumentChamp = TrouverEnfantDirectSemantique(
                etat, indexInitialiseurChamp, 0);
            si (argumentChamp >= etat->Requete->NombreNoeuds)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    indexInitialiseurChamp,
                    36);
            naturel64 finArgumentChamp = argumentChamp + 1;
            tantque (finArgumentChamp < etat->Requete->NombreNoeuds
                && etat->Requete->Noeuds[finArgumentChamp].Parent >= argumentChamp)
                finArgumentChamp = finArgumentChamp + 1;
            ErreurAnalyseSemantique erreurArgumentChamp = ErreurAnalyseSemantique::Reussite;
            si (etat->Requete->Noeuds[argumentChamp].Genre == 32) {
                DestinationInitialiseurSemantique destinationScalaire;
                si (!InitialiserDestinationInitialiseurSemantique(etat, indexNoeudChamp, &destinationScalaire))
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, indexNoeudChamp, 36);
                destinationScalaire.Reserve = 1;
                erreurArgumentChamp = ValiderInitialiseurDestinationSemantique(etat, argumentChamp, &destinationScalaire);
            }
            sinon erreurArgumentChamp = ResoudreExpressionsSemantiques(etat, argumentChamp, finArgumentChamp);
            si (erreurArgumentChamp != ErreurAnalyseSemantique::Reussite) retourner erreurArgumentChamp;
            si (!InitialiseurCompatibleTypeSemantique(
                    etat, argumentChamp, symboleChamp->HachageType)) {
                si (etat->Requete->Resultat.Erreur
                    != ErreurAnalyseSemantique::Reussite)
                    retourner etat->Requete->Resultat.Erreur;
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::TypeInitialiseurChampIncompatible,
                    argumentChamp,
                    convertir<naturel32>(cibleChampInitialise));
            }
        }

        sinon {
            si (nombreArgumentsChamp != 1)
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::AriteInitialiseurChampInvalide,
                    indexInitialiseurChamp, convertir<naturel32>(nombreArgumentsChamp));
            DestinationInitialiseurSemantique destinationStructure;
            si (!InitialiserDestinationInitialiseurSemantique(etat, indexNoeudChamp, &destinationStructure))
                retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, indexNoeudChamp, 36);
            destinationStructure.Reserve = 1;
            ErreurAnalyseSemantique erreurStructure = ValiderInitialiseurDestinationSemantique(
                etat, TrouverEnfantDirectSemantique(etat, indexInitialiseurChamp, 0), &destinationStructure);
            si (erreurStructure != ErreurAnalyseSemantique::Reussite) retourner erreurStructure;
        }

        etat->CiblesInitialiseurs[indexInitialiseurChamp] =
            cibleChampInitialise;
        naturel32 drapeauxChamp = 8 | 2_048;
        si (champTableau) drapeauxChamp = drapeauxChamp | 8_192;
        AjouterResolutionSemantique(
            etat,
            indexInitialiseurChamp,
            cibleChampInitialise,
            drapeauxChamp);
        si (cibleConstructeurChamp < etat->NombreSymboles) {
            naturel32 drapeauxConstructeurChamp = 64 | 128 | 2_048;
            si (champTableau)
                drapeauxConstructeurChamp =
                    drapeauxConstructeurChamp | 8_192;
            si (CompterConstructeursTypeSemantique(
                    etat, typeChamp) > 1)
                drapeauxConstructeurChamp =
                    drapeauxConstructeurChamp | 1;
            AjouterResolutionSemantique(
                etat,
                indexInitialiseurChamp,
                cibleConstructeurChamp,
                drapeauxConstructeurChamp);
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ResoudreBaseImpliciteConstructeurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConstructeur) {
        constante NoeudDeclaration* noeudConstructeur =
            &etat->Requete->Noeuds[indexConstructeur];
        si ((noeudConstructeur->Drapeaux & 256) != 0
            || (noeudConstructeur->Drapeaux & 512) != 0)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 typeConstructeur = TrouverSymboleNoeudSemantique(
            etat, noeudConstructeur->Parent);
        si (typeConstructeur >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexConstructeur,
                13);
        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(
            etat, typeConstructeur);
        si (typeBase >= etat->NombreSymboles)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 nombreConstructeursBase =
            CompterConstructeursTypeSemantique(etat, typeBase);
        si (nombreConstructeursBase == 0)
            retourner ValiderConstructionImpliciteContextuelleSemantique(
                etat, typeBase, indexConstructeur, typeConstructeur);

        naturel64 cibleConstructeurBase =
            SelectionnerConstructeurSansArgumentSemantique(
                etat, indexConstructeur, typeBase);
        si (cibleConstructeurBase >= etat->NombreSymboles)
            retourner etat->Requete->Resultat.Erreur;
        si (!AccesMembreAutoriseSemantique(
                etat, cibleConstructeurBase, indexConstructeur))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ConstructeurInaccessible,
                indexConstructeur,
                convertir<naturel32>(cibleConstructeurBase));

        naturel32 drapeauxBase = 64 | 1_024;
        si (nombreConstructeursBase > 1)
            drapeauxBase = drapeauxBase | 1;
        AjouterResolutionSemantique(
            etat,
            indexConstructeur,
            cibleConstructeurBase,
            drapeauxBase);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    booléen ChampInitialiseExplicitementSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexConstructeur,
        naturel64 indexSymboleChamp) {
        naturel64 index = indexConstructeur + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[index];
            si (noeud->Genre == 35
                && noeud->Parent == indexConstructeur
                && etat->CiblesInitialiseurs[index] == indexSymboleChamp)
                retourner vrai;
            index = index + 1;
        }
        retourner faux;
    }

    ErreurAnalyseSemantique ResoudreChampsImplicitesConstructeurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConstructeur) {
        constante NoeudDeclaration* noeudConstructeurImplicite =
            &etat->Requete->Noeuds[indexConstructeur];
        si ((noeudConstructeurImplicite->Drapeaux & 512) != 0)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 indexType = noeudConstructeurImplicite->Parent;
        si (indexType >= etat->Requete->NombreNoeuds
            || etat->Requete->Noeuds[indexType].Genre != 6)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexConstructeur,
                40);

        naturel64 indexChamp = 0;
        tantque (indexChamp < etat->NombreSymboles) {
            SymboleSemantique* symboleChamp =
                &etat->SymbolesTravail[indexChamp];
            si (symboleChamp->Genre == 5
                && symboleChamp->IndexPortee == indexType
                && !ChampInitialiseExplicitementSemantique(
                    etat, indexConstructeur, indexChamp)) {
                naturel64 indexNoeudChamp = symboleChamp->IndexNoeud;
                constante NoeudDeclaration* champ =
                    &etat->Requete->Noeuds[indexNoeudChamp];
                naturel64 typeElementTableau =
                    HachageElementFinalTableauSemantique(
                        etat, indexNoeudChamp);
                booléen champTableau = typeElementTableau != 0;
                naturel64 hachageTypeValeur = champ->HachageType;
                si (champTableau)
                    hachageTypeValeur = typeElementTableau;
                naturel64 typeChamp = TrouverTypeDepuisHachageSemantique(
                    etat, hachageTypeValeur, 0);
                booléen champObjetClasse = typeChamp < etat->NombreSymboles
                    && etat->Requete->Noeuds[
                        etat->SymbolesTravail[
                            typeChamp].IndexNoeud].Genre == 6;
                naturel32 drapeauxChamp = 8 | 2_048 | 4_096;
                si (champTableau)
                    drapeauxChamp = drapeauxChamp | 8_192;

                si ((champ->Drapeaux & 4) != 0) {
                    naturel64 expression = TrouverEnfantDirectSemantique(
                        etat, indexNoeudChamp, 0);
                    si (expression >= etat->Requete->NombreNoeuds)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::AstInvalide,
                            indexNoeudChamp,
                            41);
                    si (champTableau
                        && etat->Requete->Noeuds[expression].Genre != 32)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                InitialiseurChampTableauNonAgrege,
                            expression,
                            convertir<naturel32>(indexChamp));
                    naturel64 finExpressionChamp = expression + 1;
                    tantque (finExpressionChamp < etat->Requete->NombreNoeuds
                        && etat->Requete->Noeuds[finExpressionChamp].Parent >= expression)
                        finExpressionChamp = finExpressionChamp + 1;
                    naturel64 effacerChamp = expression;
                    tantque (effacerChamp < finExpressionChamp) {
                        etat->CiblesExpressions[effacerChamp] = etat->Requete->NombreNoeuds;
                        etat->TypesConversionsImplicites[effacerChamp] = 0;
                        effacerChamp = effacerChamp + 1;
                    }
                    DestinationInitialiseurSemantique destinationDefaut;
                    si (!InitialiserDestinationInitialiseurSemantique(etat, indexNoeudChamp, &destinationDefaut))
                        retourner SignalerErreurSemantique(
                            etat, ErreurAnalyseSemantique::AstInvalide, indexNoeudChamp, 41);
                    destinationDefaut.Reserve = 1;
                    si (!champTableau && etat->Requete->Noeuds[expression].Genre != 32)
                        destinationDefaut.Reserve = destinationDefaut.Reserve | 2;
                    etat->ConstructeurChampActif = indexConstructeur;
                    ErreurAnalyseSemantique erreurDefaut = ValiderInitialiseurDestinationSemantique(
                        etat, expression, &destinationDefaut);
                    etat->ConstructeurChampActif = etat->Requete->NombreNoeuds;
                    si (erreurDefaut != ErreurAnalyseSemantique::Reussite) retourner erreurDefaut;
                    AjouterResolutionSemantique(
                        etat,
                        indexConstructeur,
                        indexChamp,
                        drapeauxChamp | 16_384);
                }
                sinon si (champObjetClasse) {
                    AjouterResolutionSemantique(
                        etat,
                        indexConstructeur,
                        indexChamp,
                        drapeauxChamp);
                    naturel64 nombreConstructeursChamp =
                        CompterConstructeursTypeSemantique(
                            etat, typeChamp);
                    si (nombreConstructeursChamp != 0) {
                        naturel64 cibleConstructeurChamp =
                            SelectionnerConstructeurSansArgumentSemantique(
                                etat, indexNoeudChamp, typeChamp);
                        si (cibleConstructeurChamp >= etat->NombreSymboles)
                            retourner etat->Requete->Resultat.Erreur;
                        si (!AccesMembreAutoriseSemantique(
                                etat,
                                cibleConstructeurChamp,
                                indexConstructeur))
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::
                                    ConstructeurInaccessible,
                                indexNoeudChamp,
                                convertir<naturel32>(
                                    cibleConstructeurChamp));
                        naturel32 drapeauxConstructeur =
                            64 | 2_048 | 4_096;
                        si (champTableau)
                            drapeauxConstructeur =
                                drapeauxConstructeur | 8_192;
                        si (nombreConstructeursChamp > 1)
                            drapeauxConstructeur =
                                drapeauxConstructeur | 1;
                        AjouterResolutionSemantique(
                            etat,
                            indexConstructeur,
                            cibleConstructeurChamp,
                            drapeauxConstructeur);
                    }
                    sinon {
                        naturel64 typeConstructeurPlan = TrouverSymboleNoeudSemantique(etat, indexType);
                        ErreurAnalyseSemantique erreurChampRecursif = ValiderConstructionImpliciteContextuelleSemantique(
                            etat, typeChamp, indexNoeudChamp, typeConstructeurPlan);
                        si (erreurChampRecursif != ErreurAnalyseSemantique::Reussite) retourner erreurChampRecursif;
                    }
                }
                sinon {
                    booléen champConstant = EstTypeConstantSemantique(
                        etat, hachageTypeValeur);
                    booléen champAdresse = EstTypeAdresseSemantique(
                            etat, hachageTypeValeur)
                        || EstTypeReferenceSemantique(
                            etat, hachageTypeValeur);
                    si (champConstant && !champAdresse)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::ChampConstantNonInitialise,
                            indexNoeudChamp,
                            convertir<naturel32>(indexChamp));
                }
            }
            indexChamp = indexChamp + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 AlignerDispositionSemantique(
        naturel64 valeur, naturel64 alignement) {
        si (alignement <= 1) retourner valeur;
        retourner ((valeur + alignement - 1) / alignement) * alignement;
    }

    externe ErreurAnalyseSemantique CalculerDispositionTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType);

    ErreurAnalyseSemantique CalculerTailleValeurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel64* taille,
        naturel64* alignement) {
        constante NoeudDeclaration* noeud = &etat->Requete->Noeuds[indexNoeud];
        naturel64 hachageValeur = noeud->HachageType;
        DescriptionHachageTypeSemantique dimensions;
        booléen tableau = LireDimensionsNoeudSemantique(
            etat, indexNoeud, &dimensions);
        si (tableau)
            hachageValeur = HachageElementFinalTableauSemantique(
                etat, indexNoeud);

        *taille = 0;
        *alignement = 1;
        DescriptionTypeJetonsSemantique typeFonctionDisposition;
        booléen pointeurFonctionDisposition =
            LireTypePointeurFonctionNoeudSemantique(
                etat, indexNoeud, &typeFonctionDisposition)
            && typeFonctionDisposition.Genre == 14;
        si (pointeurFonctionDisposition
            || EstTypeAdresseSemantique(etat, hachageValeur)
            || EstTypeReferenceSemantique(etat, hachageValeur)) {
            *taille = 8;
            *alignement = 8;
        }
        sinon {
            naturel32 genre = 1;
            tantque (genre <= 12 && *taille == 0) {
                naturel32 qualificatifs = 0;
                tantque (qualificatifs < 8 && *taille == 0) {
                    si (hachageValeur == HacherTypeSimpleSemantique(
                            genre, qualificatifs, 0)) {
                        si (genre == 1 || genre == 5 || genre == 9
                            || genre == 10 || genre == 11) {
                            *taille = 1;
                            *alignement = 1;
                        }
                        sinon si (genre == 2 || genre == 6) {
                            *taille = 2;
                            *alignement = 2;
                        }
                        sinon si (genre == 3 || genre == 7) {
                            *taille = 4;
                            *alignement = 4;
                        }
                        sinon si (genre == 4 || genre == 8) {
                            *taille = 8;
                            *alignement = 8;
                        }
                    }
                    qualificatifs = qualificatifs + 1;
                }
                genre = genre + 1;
            }
        }

        si (*taille == 0) {
            naturel64 indexType = TrouverTypeDepuisHachageSemantique(
                etat, hachageValeur, 0);
            si (indexType < etat->NombreSymboles) {
                naturel32 genreType = etat->Requete->Noeuds[
                    etat->SymbolesTravail[indexType].IndexNoeud].Genre;
                si (genreType == 8) {
                    *taille = 4;
                    *alignement = 4;
                }
                sinon {
                    ErreurAnalyseSemantique erreurDisposition =
                        CalculerDispositionTypeSemantique(etat, indexType);
                    si (erreurDisposition != ErreurAnalyseSemantique::Reussite)
                        retourner erreurDisposition;
                    *taille = etat->TaillesTypes[indexType];
                    *alignement = etat->AlignementsTypes[indexType];
                }
            }
        }

        si (*taille == 0)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::TailleObjetInvalide,
                indexNoeud,
                0);

        si (tableau) {
            naturel32 indexDimension = 0;
            tantque (indexDimension < dimensions.NombreDimensions) {
                naturel64 valeurDimension = 0;
                si (!LireDimensionNoeudSemantique(
                        etat,
                        indexNoeud,
                        indexDimension,
                        &valeurDimension)
                    || valeurDimension == 0
                    || *taille > 4_294_967_295 / valeurDimension)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::TailleObjetInvalide,
                        indexNoeud,
                        indexDimension);
                *taille = *taille * valeurDimension;
                indexDimension = indexDimension + 1;
            }
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    booléen EstTypePolymorpheSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        si (indexType >= etat->NombreSymboles) retourner faux;
        si (etat->EtatsPolymorphisme[indexType] == 2) retourner faux;
        si (etat->EtatsPolymorphisme[indexType] == 3) retourner vrai;
        si (etat->EtatsPolymorphisme[indexType] == 1) retourner faux;
        etat->EtatsPolymorphisme[indexType] = 1;

        booléen polymorphe = faux;
        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(etat, indexType);
        si (typeBase < etat->NombreSymboles)
            polymorphe = EstTypePolymorpheSemantique(etat, typeBase);
        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles && !polymorphe) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && (etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 12
                    || etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 14
                    || etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 15)
                && (etat->Requete->Noeuds[
                        candidat->IndexNoeud].Drapeaux & (64 | 128)) != 0)
                polymorphe = vrai;
            index = index + 1;
        }
        si (polymorphe) etat->EtatsPolymorphisme[indexType] = 3;
        sinon etat->EtatsPolymorphisme[indexType] = 2;
        retourner polymorphe;
    }

    ErreurAnalyseSemantique CalculerDispositionTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        si (indexType >= etat->NombreSymboles)
            retourner ErreurAnalyseSemantique::TailleObjetInvalide;
        si (etat->EtatsDisposition[indexType] == 2)
            retourner ErreurAnalyseSemantique::Reussite;
        si (etat->EtatsDisposition[indexType] == 1)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::CycleTypeParValeur,
                etat->SymbolesTravail[indexType].IndexNoeud,
                convertir<naturel32>(indexType));
        etat->EtatsDisposition[indexType] = 1;

        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        constante NoeudDeclaration* noeudType = &etat->Requete->Noeuds[
            indexNoeudType];
        naturel64 position = 0;
        naturel64 alignement = 1;
        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(etat, indexType);
        booléen basePolymorphe = faux;
        si (typeBase < etat->NombreSymboles) {
            ErreurAnalyseSemantique erreurBase =
                CalculerDispositionTypeSemantique(etat, typeBase);
            si (erreurBase != ErreurAnalyseSemantique::Reussite)
                retourner erreurBase;
            position = etat->TaillesTypes[typeBase];
            alignement = etat->AlignementsTypes[typeBase];
            basePolymorphe = EstTypePolymorpheSemantique(etat, typeBase);
        }

        si (noeudType->Genre == 6
            && EstTypePolymorpheSemantique(etat, indexType)) {
            si (basePolymorphe)
                etat->DecalagesTablesVirtuelles[indexType] =
                    etat->DecalagesTablesVirtuelles[typeBase];
            sinon {
                position = AlignerDispositionSemantique(position, 8);
                etat->DecalagesTablesVirtuelles[indexType] = position;
                position = position + 8;
                si (alignement < 8) alignement = 8;
            }
        }

        naturel64 indexChamp = 0;
        tantque (indexChamp < etat->NombreSymboles) {
            SymboleSemantique* champ = &etat->SymbolesTravail[indexChamp];
            si (champ->Genre == 5 && champ->IndexPortee == indexNoeudType) {
                naturel64 tailleChamp = 0;
                naturel64 alignementChamp = 1;
                ErreurAnalyseSemantique erreurChamp =
                    CalculerTailleValeurSemantique(
                        etat,
                        champ->IndexNoeud,
                        &tailleChamp,
                        &alignementChamp);
                si (erreurChamp != ErreurAnalyseSemantique::Reussite)
                    retourner erreurChamp;
                si (noeudType->Genre == 5) {
                    etat->DecalagesChamps[indexChamp] = 0;
                    si (position < tailleChamp) position = tailleChamp;
                }
                sinon {
                    position = AlignerDispositionSemantique(
                        position, alignementChamp);
                    etat->DecalagesChamps[indexChamp] = position;
                    position = position + tailleChamp;
                }
                si (alignement < alignementChamp)
                    alignement = alignementChamp;
            }
            indexChamp = indexChamp + 1;
        }

        /**
         * Le bootstrap résout tous les alias après les champs du type,
         * même sans accès membre ni initialisation utilisant ces alias.
         **/
        naturel64 indexAliasChamp = 0;
        tantque (indexAliasChamp < etat->NombreSymboles) {

            SymboleSemantique* aliasChamp =
                &etat->SymbolesTravail[indexAliasChamp];
            si (aliasChamp->Genre == 6
                && aliasChamp->IndexPortee == indexNoeudType
                && ResoudreAliasChampSemantique(
                    etat, indexAliasChamp, indexType) >= etat->NombreSymboles)
                retourner etat->Requete->Resultat.Erreur;
            indexAliasChamp = indexAliasChamp + 1;
        }

        si (position == 0) position = 1;
        position = AlignerDispositionSemantique(position, alignement);
        si (position > 4_294_967_295)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::TailleObjetInvalide,
                indexNoeudType,
                0);
        etat->TaillesTypes[indexType] = position;
        etat->AlignementsTypes[indexType] = alignement;
        etat->EtatsDisposition[indexType] = 2;
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique CalculerDispositionsSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            si (etat->SymbolesTravail[index].Genre == 1) {
                naturel32 genre = etat->Requete->Noeuds[
                    etat->SymbolesTravail[index].IndexNoeud].Genre;
                si (genre == 4 || genre == 5 || genre == 6) {
                    ErreurAnalyseSemantique erreur =
                        CalculerDispositionTypeSemantique(etat, index);
                    si (erreur != ErreurAnalyseSemantique::Reussite)
                        retourner erreur;
                }
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique VerifierCyclesDelegationConstructeurSemantique(
        EtatAnalyseSemantique* etat) {
        naturel64 indexDepartDelegation = 0;
        tantque (indexDepartDelegation < etat->Requete->NombreNoeuds) {
            si (etat->Requete->Noeuds[indexDepartDelegation].Genre == 33) {
                naturel64 indexCourantDelegation = indexDepartDelegation;
                naturel64 profondeurDelegation = 0;
                tantque (indexCourantDelegation
                        < etat->Requete->NombreNoeuds
                    && profondeurDelegation < etat->NombreSymboles) {
                    naturel64 cibleCouranteDelegation =
                        etat->CiblesInitialiseurs[indexCourantDelegation];
                    si (cibleCouranteDelegation >= etat->NombreSymboles) {
                        indexCourantDelegation =
                            etat->Requete->NombreNoeuds;
                    }
                    sinon {
                        naturel64 constructeurCourantDelegation =
                            etat->SymbolesTravail[
                                cibleCouranteDelegation].IndexNoeud;
                        indexCourantDelegation =
                            TrouverInitialiseurDelegueConstructeurSemantique(
                                etat, constructeurCourantDelegation);
                        profondeurDelegation = profondeurDelegation + 1;
                    }
                }
                si (indexCourantDelegation
                    < etat->Requete->NombreNoeuds)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::CycleDelegationConstructeur,
                        indexDepartDelegation,
                        convertir<naturel32>(profondeurDelegation));
            }
            indexDepartDelegation = indexDepartDelegation + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    structure ContextePlanDureeVieSemantique {
        naturel64 IndexNoeudOrigine;
        naturel64 IndexTypeContexte;
        naturel64 Decalage;
        naturel32 Drapeaux;
        naturel64 IndexNoeudDiagnostic;
        naturel32 ValidationSeule;
    };

    booléen AccesMembreDepuisTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexMembre,
        naturel64 indexTypeContexte) {
        si (indexMembre >= etat->NombreSymboles) retourner faux;
        constante NoeudDeclaration* declaration = &etat->Requete->Noeuds[
            etat->SymbolesTravail[indexMembre].IndexNoeud];
        si ((declaration->Drapeaux & 1) != 0) retourner vrai;
        naturel64 indexTypeDeclarant = TrouverSymboleNoeudSemantique(
            etat, etat->SymbolesTravail[indexMembre].IndexPortee);
        si (indexTypeDeclarant >= etat->NombreSymboles
            || indexTypeContexte >= etat->NombreSymboles)
            retourner faux;
        si (indexTypeDeclarant == indexTypeContexte) retourner vrai;
        retourner (declaration->Drapeaux & 8) != 0
            && EstTypeDeriveSemantique(
                etat, indexTypeContexte, indexTypeDeclarant);
    }

    naturel64 TrouverDestructeurTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        si (indexType >= etat->NombreSymboles) retourner etat->NombreSymboles;
        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 14)
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverInitialiseurGenreConstructeurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexConstructeur,
        naturel32 genre) {
        naturel64 index = indexConstructeur + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* candidat = &etat->Requete->Noeuds[index];
            si (candidat->Parent == indexConstructeur
                && candidat->Genre == genre)
                retourner index;
            index = index + 1;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    naturel64 TrouverInitialiseurChampPlanSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexConstructeur,
        naturel64 indexChamp) {
        naturel64 index = indexConstructeur + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* candidat = &etat->Requete->Noeuds[index];
            si (candidat->Parent == indexConstructeur
                && candidat->Genre == 35
                && etat->CiblesInitialiseurs[index] == indexChamp)
                retourner index;
            index = index + 1;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    naturel64 CompterElementsTableauPlanSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        DescriptionHachageTypeSemantique dimensions;
        si (!LireDimensionsNoeudSemantique(etat, indexNoeud, &dimensions))
            retourner 1;
        naturel64 nombre = 1;
        naturel32 index = 0;
        tantque (index < dimensions.NombreDimensions) {
            naturel64 valeur = 0;
            si (!LireDimensionNoeudSemantique(
                    etat, indexNoeud, index, &valeur))
                retourner 0;
            nombre = nombre * valeur;
            index = index + 1;
        }
        retourner nombre;
    }

    externe ErreurAnalyseSemantique PlanifierConstructionClasseSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte);

    externe ErreurAnalyseSemantique PlanifierDestructionClasseSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte);

    ErreurAnalyseSemantique PlanifierConstructeurUniformeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeudType,
        naturel64 indexConstructeur,
        ContextePlanDureeVieSemantique* contexte) {
        naturel64 indexType = TrouverTypeElementFinalTableauSemantique(
            etat, indexNoeudType);
        si (indexType >= etat->NombreSymboles)
            indexType = TrouverTypeDepuisHachageSemantique(
                etat,
                etat->Requete->Noeuds[indexNoeudType].HachageType,
                0);
        si (indexType >= etat->NombreSymboles)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 nombre = CompterElementsTableauPlanSemantique(
            etat, indexNoeudType);
        naturel64 tailleElement = etat->TaillesTypes[indexType];
        naturel64 index = 0;
        tantque (index < nombre) {
            DescriptionEtapeDureeVieSemantique etape = {
                contexte->Decalage + index * tailleElement,
                contexte->Drapeaux | 65_536,
                0};
            si (nombre > 1) etape.Drapeaux = etape.Drapeaux | 2_097_152;
            si (contexte->ValidationSeule == 0) AjouterEtapeDureeVieSemantique(
                etat,
                contexte->IndexNoeudOrigine,
                indexConstructeur,
                &etape);
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique PlanifierConstructionObjetSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeudType,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte) {
        si (indexType >= etat->NombreSymboles
            || etat->Requete->Noeuds[
                etat->SymbolesTravail[indexType].IndexNoeud].Genre != 6)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 nombre = CompterElementsTableauPlanSemantique(
            etat, indexNoeudType);
        naturel64 tailleElement = etat->TaillesTypes[indexType];
        naturel64 index = 0;
        tantque (index < nombre) {
            ContextePlanDureeVieSemantique element = *contexte;
            element.Decalage = contexte->Decalage + index * tailleElement;
            si (nombre > 1)
                element.Drapeaux = element.Drapeaux | 2_097_152;
            ErreurAnalyseSemantique erreur = PlanifierConstructionClasseSemantique(
                etat, indexType, &element);
            si (erreur != ErreurAnalyseSemantique::Reussite)
                retourner erreur;
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique PlanifierDestructionObjetSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeudType,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte) {
        si (indexType >= etat->NombreSymboles
            || etat->Requete->Noeuds[
                etat->SymbolesTravail[indexType].IndexNoeud].Genre != 6)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 nombre = CompterElementsTableauPlanSemantique(
            etat, indexNoeudType);
        naturel64 tailleElement = etat->TaillesTypes[indexType];
        tantque (nombre > 0) {
            nombre = nombre - 1;
            ContextePlanDureeVieSemantique element = *contexte;
            element.Decalage = contexte->Decalage + nombre * tailleElement;
            si (CompterElementsTableauPlanSemantique(etat, indexNoeudType) > 1)
                element.Drapeaux = element.Drapeaux | 2_097_152;
            ErreurAnalyseSemantique erreur = PlanifierDestructionClasseSemantique(
                etat, indexType, &element);
            si (erreur != ErreurAnalyseSemantique::Reussite)
                retourner erreur;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique PlanifierConstructionClasseSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte) {
        naturel64 nombreConstructeurs = CompterConstructeursTypeSemantique(
            etat, indexType);
        si (nombreConstructeurs != 0) {
            naturel64 cibleConstructeurPlan = SelectionnerConstructeurSansArgumentSemantique(
                etat, contexte->IndexNoeudDiagnostic, indexType);
            si (cibleConstructeurPlan >= etat->NombreSymboles)
                retourner etat->Requete->Resultat.Erreur;
            si (!AccesMembreDepuisTypeSemantique(
                    etat, cibleConstructeurPlan, contexte->IndexTypeContexte))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::ConstructeurInaccessible,
                    contexte->IndexNoeudDiagnostic,
                    convertir<naturel32>(cibleConstructeurPlan));
            DescriptionEtapeDureeVieSemantique etape = {
                contexte->Decalage,
                contexte->Drapeaux | 65_536,
                0};
            si (contexte->ValidationSeule == 0) AjouterEtapeDureeVieSemantique(
                etat,
                contexte->IndexNoeudOrigine,
                cibleConstructeurPlan,
                &etape);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(etat, indexType);
        si (typeBase < etat->NombreSymboles) {
            ContextePlanDureeVieSemantique base = *contexte;
            base.IndexTypeContexte = indexType;
            base.Drapeaux = base.Drapeaux | 524_288;
            ErreurAnalyseSemantique erreurBase =
                PlanifierConstructionClasseSemantique(etat, typeBase, &base);
            si (erreurBase != ErreurAnalyseSemantique::Reussite)
                retourner erreurBase;
        }

        si (EstTypePolymorpheSemantique(etat, indexType)) {
            DescriptionEtapeDureeVieSemantique table = {
                contexte->Decalage
                    + etat->DecalagesTablesVirtuelles[indexType],
                contexte->Drapeaux | 65_536 | 262_144,
                0};
            si (contexte->ValidationSeule == 0) AjouterEtapeDureeVieSemantique(
                etat,
                contexte->IndexNoeudOrigine,
                indexType,
                &table);
        }

        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 indexChamp = 0;
        tantque (indexChamp < etat->NombreSymboles) {
            SymboleSemantique* champ = &etat->SymbolesTravail[indexChamp];
            si (champ->Genre == 5 && champ->IndexPortee == indexNoeudType) {
                naturel64 typeChamp = TrouverTypeElementFinalTableauSemantique(
                    etat, champ->IndexNoeud);
                si (typeChamp >= etat->NombreSymboles)
                    typeChamp = TrouverTypeDepuisHachageSemantique(
                        etat, champ->HachageType, 0);
                ContextePlanDureeVieSemantique sousObjet = *contexte;
                sousObjet.IndexTypeContexte = indexType;
                sousObjet.IndexNoeudDiagnostic = champ->IndexNoeud;
                sousObjet.Decalage = contexte->Decalage
                    + etat->DecalagesChamps[indexChamp];
                sousObjet.Drapeaux = sousObjet.Drapeaux | 1_048_576;
                ErreurAnalyseSemantique erreurChamp =
                    PlanifierConstructionObjetSemantique(
                        etat, champ->IndexNoeud, typeChamp, &sousObjet);
                si (erreurChamp != ErreurAnalyseSemantique::Reussite)
                    retourner erreurChamp;
            }
            indexChamp = indexChamp + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Contrôle une construction implicite à son point de visite sans publier d'étapes.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types, accès et diagnostics privés.
     * @Paramètre(naturel64: indexType) Classe de la base ou du champ objet.
     * @Paramètre(naturel64: indexDiagnostic) Origine du premier diagnostic avant récursion.
     * @Paramètre(naturel64: indexTypeContexte) Classe qui consomme la construction.
     * @Retourner(ErreurAnalyseSemantique) Premier refus récursif avant l'initialiseur suivant.
     * @etc. Le plan définitif sera produit dans l'ordre base, table virtuelle et champs déclarés.
     **/
    ErreurAnalyseSemantique ValiderConstructionImpliciteContextuelleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType, naturel64 indexDiagnostic, naturel64 indexTypeContexte) {

        ContextePlanDureeVieSemantique contexte = {
            indexDiagnostic, indexTypeContexte, 0, 0, indexDiagnostic, 1};
        retourner PlanifierConstructionClasseSemantique(etat, indexType, &contexte);
    }

    ErreurAnalyseSemantique PlanifierDestructionClasseSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte) {
        naturel64 cibleDestructeurPlan = TrouverDestructeurTypeSemantique(
            etat, indexType);
        si (cibleDestructeurPlan < etat->NombreSymboles) {
            si (!AccesMembreDepuisTypeSemantique(
                    etat, cibleDestructeurPlan, contexte->IndexTypeContexte))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::DestructeurInaccessible,
                    contexte->IndexNoeudDiagnostic,
                    convertir<naturel32>(cibleDestructeurPlan));
            DescriptionEtapeDureeVieSemantique etape = {
                contexte->Decalage,
                contexte->Drapeaux | 131_072,
                0};
            AjouterEtapeDureeVieSemantique(
                etat,
                contexte->IndexNoeudOrigine,
                cibleDestructeurPlan,
                &etape);
        }

        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 indexChamp = etat->NombreSymboles;
        tantque (indexChamp > 0) {
            indexChamp = indexChamp - 1;
            SymboleSemantique* champ = &etat->SymbolesTravail[indexChamp];
            si (champ->Genre == 5 && champ->IndexPortee == indexNoeudType) {
                naturel64 typeChamp = TrouverTypeElementFinalTableauSemantique(
                    etat, champ->IndexNoeud);
                si (typeChamp >= etat->NombreSymboles)
                    typeChamp = TrouverTypeDepuisHachageSemantique(
                        etat, champ->HachageType, 0);
                ContextePlanDureeVieSemantique sousObjet = *contexte;
                sousObjet.IndexTypeContexte = indexType;
                sousObjet.IndexNoeudDiagnostic = champ->IndexNoeud;
                sousObjet.Decalage = contexte->Decalage
                    + etat->DecalagesChamps[indexChamp];
                sousObjet.Drapeaux = sousObjet.Drapeaux | 1_048_576;
                ErreurAnalyseSemantique erreurChamp =
                    PlanifierDestructionObjetSemantique(
                        etat, champ->IndexNoeud, typeChamp, &sousObjet);
                si (erreurChamp != ErreurAnalyseSemantique::Reussite)
                    retourner erreurChamp;
            }
        }

        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(etat, indexType);
        si (typeBase < etat->NombreSymboles) {
            ContextePlanDureeVieSemantique base = *contexte;
            base.IndexTypeContexte = indexType;
            base.Drapeaux = base.Drapeaux | 524_288;
            retourner PlanifierDestructionClasseSemantique(
                etat, typeBase, &base);
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique PlanifierCorpsConstructeurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConstructeur) {
        si ((etat->Requete->Noeuds[indexConstructeur].Drapeaux & 2) != 0)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 indexType = TrouverSymboleNoeudSemantique(
            etat, etat->Requete->Noeuds[indexConstructeur].Parent);
        si (indexType >= etat->NombreSymboles)
            retourner ErreurAnalyseSemantique::AstInvalide;
        ContextePlanDureeVieSemantique contexte = {
            indexConstructeur,
            indexType,
            0,
            0,
            indexConstructeur,
            0};

        naturel64 delegation = TrouverInitialiseurGenreConstructeurSemantique(
            etat, indexConstructeur, 33);
        si (delegation < etat->Requete->NombreNoeuds) {
            naturel64 cibleDelegationPlan =
                etat->CiblesInitialiseurs[delegation];
            DescriptionEtapeDureeVieSemantique etape = {
                0, 65_536 | 512, 0};
            AjouterEtapeDureeVieSemantique(
                etat, indexConstructeur, cibleDelegationPlan, &etape);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(etat, indexType);
        si (typeBase < etat->NombreSymboles) {
            naturel64 initialiseurBase =
                TrouverInitialiseurGenreConstructeurSemantique(
                    etat, indexConstructeur, 34);
            si (initialiseurBase < etat->Requete->NombreNoeuds
                && CompterConstructeursTypeSemantique(etat, typeBase) != 0) {
                DescriptionEtapeDureeVieSemantique etapeBase = {
                    0, 65_536 | 1_024 | 524_288, 0};
                AjouterEtapeDureeVieSemantique(
                    etat,
                    indexConstructeur,
                    etat->CiblesInitialiseurs[initialiseurBase],
                    &etapeBase);
            }
            sinon {
                ContextePlanDureeVieSemantique base = contexte;
                base.Drapeaux = 524_288;
                si (initialiseurBase < etat->Requete->NombreNoeuds)
                    base.Drapeaux = base.Drapeaux | 1_024;
                ErreurAnalyseSemantique erreurBase =
                    PlanifierConstructionClasseSemantique(
                        etat, typeBase, &base);
                si (erreurBase != ErreurAnalyseSemantique::Reussite)
                    retourner erreurBase;
            }
        }

        si (EstTypePolymorpheSemantique(etat, indexType)) {
            DescriptionEtapeDureeVieSemantique table = {
                etat->DecalagesTablesVirtuelles[indexType],
                65_536 | 262_144,
                0};
            AjouterEtapeDureeVieSemantique(
                etat, indexConstructeur, indexType, &table);
        }

        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 indexChamp = 0;
        tantque (indexChamp < etat->NombreSymboles) {
            SymboleSemantique* champ = &etat->SymbolesTravail[indexChamp];
            si (champ->Genre == 5 && champ->IndexPortee == indexNoeudType) {
                naturel64 typeChamp = TrouverTypeElementFinalTableauSemantique(
                    etat, champ->IndexNoeud);
                si (typeChamp >= etat->NombreSymboles)
                    typeChamp = TrouverTypeDepuisHachageSemantique(
                        etat, champ->HachageType, 0);
                si (typeChamp < etat->NombreSymboles
                    && etat->Requete->Noeuds[
                        etat->SymbolesTravail[typeChamp].IndexNoeud].Genre == 6) {
                    ContextePlanDureeVieSemantique sousObjet = contexte;
                    sousObjet.Decalage = etat->DecalagesChamps[indexChamp];
                    sousObjet.Drapeaux = 1_048_576;
                    naturel64 initialiseur = TrouverInitialiseurChampPlanSemantique(
                        etat, indexConstructeur, indexChamp);
                    sousObjet.IndexNoeudDiagnostic = champ->IndexNoeud;
                    si (initialiseur < etat->Requete->NombreNoeuds)
                        sousObjet.IndexNoeudDiagnostic = initialiseur;
                    naturel64 nombreConstructeurs =
                        CompterConstructeursTypeSemantique(etat, typeChamp);
                    si (initialiseur < etat->Requete->NombreNoeuds
                        && nombreConstructeurs != 0) {
                        naturel64 cibleConstructeurChampPlan =
                            etat->CiblesExpressions[initialiseur];
                        si (cibleConstructeurChampPlan >= etat->NombreSymboles)
                            retourner etat->Requete->Resultat.Erreur;
                        sousObjet.Drapeaux = sousObjet.Drapeaux | 128 | 2_048;
                        ErreurAnalyseSemantique erreurChampExplicitePlan =
                            PlanifierConstructeurUniformeSemantique(
                                etat,
                                champ->IndexNoeud,
                                cibleConstructeurChampPlan,
                                &sousObjet);
                        si (erreurChampExplicitePlan
                            != ErreurAnalyseSemantique::Reussite)
                            retourner erreurChampExplicitePlan;
                    }
                    sinon {
                        si (initialiseur < etat->Requete->NombreNoeuds)
                            sousObjet.Drapeaux = sousObjet.Drapeaux | 2_048;
                        sinon sousObjet.Drapeaux = sousObjet.Drapeaux | 4_096;
                        ErreurAnalyseSemantique erreurChampImplicitePlan =
                            PlanifierConstructionObjetSemantique(
                                etat,
                                champ->IndexNoeud,
                                typeChamp,
                                &sousObjet);
                        si (erreurChampImplicitePlan
                            != ErreurAnalyseSemantique::Reussite)
                            retourner erreurChampImplicitePlan;
                    }
                }
            }
            indexChamp = indexChamp + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 CompterOperateursTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 indexExpression) {

        retourner CompterFonctionsAppelMembreSemantique(etat, indexType, indexExpression);
    }

    naturel64 TrouverTypeDeclarantOperateurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 indexExpression) {
        naturel64 courant = indexType;
        naturel64 profondeur = 0;
        tantque (courant < etat->NombreSymboles
            && profondeur < etat->NombreSymboles) {
            si (CompterOperateursTypeSemantique(
                    etat, courant, indexExpression) != 0)
                retourner courant;
            courant = TrouverTypeBaseSymboleSemantique(etat, courant);
            profondeur = profondeur + 1;
        }
        retourner etat->NombreSymboles;
    }

    /**
     * <résumé>Compare toutes les surcharges d'un opérateur canonique, récepteur explicite ou implicite compris.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Déclarations, types et conversions privés.
     * @Paramètre(naturel64: indexExpression) Opérandes sans modification de l'AST.
     * @Paramètre(naturel64: nomGroupe) Empreinte du groupe complet déjà sélectionné par la recherche de nom.
     * @Retourner(naturel64) Symbole sélectionné, ou NombreSymboles après diagnostic.
     **/
    naturel64 SelectionnerGroupeOperateurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 nomGroupe) {
        naturel64 meilleure = etat->NombreSymboles;
        naturel32 meilleurScore = 4_294_967_295;
        naturel32 nombreMeilleures = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            booléen correspondGroupe = HacherNomDeclarationAliasSemantique(etat, candidat) == nomGroupe;
            si (nomGroupe == 0) correspondGroupe = ReferenceCorrespondSymboleSemantique(
                etat, &etat->Requete->Noeuds[indexExpression], candidat);
            si (candidat->Genre == 2
                && correspondGroupe
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 15) {
                naturel32 score = 0;
                si (HachageTypeRecepteurFonctionSemantique(etat, candidat->IndexNoeud) != 0)
                    score = EvaluerArgumentsMethodeNonLieeSemantique(etat, indexExpression, candidat->IndexNoeud, 0);
                sinon score = EvaluerArgumentsFonctionSemantique(etat, indexExpression, candidat->IndexNoeud, 0);
                si (score != 4_294_967_295) {
                    si (score < meilleurScore) {
                        meilleure = index;
                        meilleurScore = score;
                        nombreMeilleures = 1;
                    }
                    sinon si (score == meilleurScore)
                        nombreMeilleures = nombreMeilleures + 1;
                }
            }
            index = index + 1;
        }

        si (etat->Requete->Resultat.Erreur != ErreurAnalyseSemantique::Reussite)
            retourner etat->NombreSymboles;
        si (meilleure >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexExpression,
                convertir<naturel32>(
                    CompterEnfantsDirectsSemantique(
                        etat, indexExpression)));
            retourner etat->NombreSymboles;
        }
        si (nombreMeilleures > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexExpression,
                nombreMeilleures);
            retourner etat->NombreSymboles;
        }
        retourner meilleure;
    }

    booléen TrouverEspaceOperateurLibreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64* hachageEspace) {
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        RechercheNomUtiliseSemantique recherche = RechercheDepuisNoeudUtiliseSemantique(etat, expression);
        ChercherNomUtiliseSemantique(etat, &recherche);
        si (recherche.Active) {
            si (recherche.Ambigue) {
                SignalerErreurSemantique(etat, ErreurAnalyseSemantique::NomImporteAmbigu, indexExpression, 0);
                retourner faux;
            }
            *hachageEspace = 0;
            retourner recherche.Premier < etat->NombreSymboles && etat->SymbolesTravail[recherche.Premier].Genre == 2;
        }
        naturel64 espaceGlobal = HachageVideSemantique();
        naturel64 nomGlobal = AjouterNomNoeudSemantique(etat, espaceGlobal, indexExpression);
        naturel64 nomCourant = HacherNomCompletSemantique(etat, indexExpression);
        booléen espaceCourantTrouve = faux;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->HachageNom == expression->HachageNom
                && etat->Requete->Noeuds[
                    candidat->IndexNoeud].Genre == 15) {
                naturel64 nom = HacherNomDeclarationAliasSemantique(etat, candidat);
                si (nom == nomGlobal) {
                    *hachageEspace = espaceGlobal;
                    retourner vrai;
                }
                si (nom == nomCourant)
                    espaceCourantTrouve = vrai;
            }
            index = index + 1;
        }
        si (espaceCourantTrouve) {
            *hachageEspace = expression->HachageEspace;
            retourner vrai;
        }
        retourner faux;
    }

    naturel64 CompterOperateursLibresSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 hachageEspace) {
        naturel64 nomGroupe = hachageEspace;
        si (nomGroupe != HachageVideSemantique())
            nomGroupe = AjouterOctetSemantique(AjouterOctetSemantique(nomGroupe, 58), 58);
        nomGroupe = AjouterNomNoeudSemantique(etat, nomGroupe, indexExpression);
        naturel64 nombre = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            booléen correspondGroupe = HacherNomDeclarationAliasSemantique(etat, candidat) == nomGroupe;
            si (hachageEspace == 0) correspondGroupe = ReferenceCorrespondSymboleSemantique(
                etat, &etat->Requete->Noeuds[indexExpression], candidat);
            si (candidat->Genre == 2
                && correspondGroupe
                && etat->Requete->Noeuds[
                    candidat->IndexNoeud].Genre == 15)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 SelectionnerOperateurLibreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 hachageEspace) {

        si (hachageEspace == 0) retourner SelectionnerGroupeOperateurSemantique(etat, indexExpression, 0);
        naturel64 nomGroupe = hachageEspace;
        si (nomGroupe != HachageVideSemantique())
            nomGroupe = AjouterOctetSemantique(AjouterOctetSemantique(nomGroupe, 58), 58);
        nomGroupe = AjouterNomNoeudSemantique(etat, nomGroupe, indexExpression);
        retourner SelectionnerGroupeOperateurSemantique(etat, indexExpression, nomGroupe);
    }

    ErreurAnalyseSemantique ValiderAritesOperateursSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* symbole = &etat->SymbolesTravail[index];
            constante NoeudDeclaration* declaration =
                &etat->Requete->Noeuds[symbole->IndexNoeud];
            si (symbole->Genre == 2 && declaration->Genre == 15) {
                booléen unaire = declaration->HachageNom
                        == HacherOperateurExpressionSemantique(33, 0)
                    || declaration->HachageNom
                        == HacherOperateurExpressionSemantique(126, 0);
                naturel64 nombreAttendu = 0;
                si (symbole->IndexPortee == 0) {
                    si (unaire) nombreAttendu = 1;
                    sinon nombreAttendu = 2;
                }
                sinon si (!unaire) nombreAttendu = 1;
                naturel64 nombreParametres =
                    CompterParametresFonctionSemantique(
                        etat, symbole->IndexNoeud);
                si (nombreParametres != nombreAttendu)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AriteOperateurInvalide,
                        symbole->IndexNoeud,
                        convertir<naturel32>(nombreParametres));
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    booléen EstOperateurUnaireIntrinsequeSemantique(
        constante NoeudDeclaration* expression) {
        naturel64 adresse = AjouterOctetSemantique(
            HachageVideSemantique(), 38);
        naturel64 dereferencement = AjouterOctetSemantique(
            HachageVideSemantique(), 42);
        retourner expression->Genre == 25
            && (expression->HachageNom == adresse
                || expression->HachageNom == dereferencement);
    }

    booléen EstTypeEntierExpressionSemantique(naturel64 hachageType) {
        naturel32 genreEntierExpression = 1;
        tantque (genreEntierExpression <= 11) {
            si (genreEntierExpression != 9) {
                naturel32 qualificatifsEntierExpression = 0;
                tantque (qualificatifsEntierExpression < 4) {
                    si (hachageType == HacherTypeSimpleSemantique(
                            genreEntierExpression,
                            qualificatifsEntierExpression,
                            0))
                        retourner vrai;
                    qualificatifsEntierExpression =
                        qualificatifsEntierExpression + 1;
                }
            }
            genreEntierExpression = genreEntierExpression + 1;
        }
        retourner faux;
    }

    booléen EstTypeVideExpressionSemantique(naturel64 hachageType) {
        naturel32 qualificatifsVideExpression = 0;
        tantque (qualificatifsVideExpression < 4) {
            si (hachageType == HacherTypeSimpleSemantique(
                    12, qualificatifsVideExpression, 0))
                retourner vrai;
            qualificatifsVideExpression = qualificatifsVideExpression + 1;
        }
        retourner faux;
    }

    booléen EstTypeBooleenExpressionSemantique(naturel64 hachageType) {
        naturel32 qualificatifsBooleensExpression = 0;
        tantque (qualificatifsBooleensExpression < 4) {
            si (hachageType == HacherTypeSimpleSemantique(
                    9, qualificatifsBooleensExpression, 0))
                retourner vrai;
            qualificatifsBooleensExpression =
                qualificatifsBooleensExpression + 1;
        }
        retourner faux;
    }

    booléen EstPointeurFonctionExpressionSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 hachageType) {
        naturel64 originePointeurFonctionExpression =
            TrouverOrigineTypeExpressionSemantique(
                etat, indexExpression);
        si (TrouverSymboleNoeudSemantique(etat, originePointeurFonctionExpression, 2)
                < etat->NombreSymboles
            && hachageType == HacherPointeurFonctionDeclarationSemantique(
                etat, originePointeurFonctionExpression))
            retourner vrai;
        DescriptionTypeJetonsSemantique descriptionPointeurFonctionExpression;
        retourner LireDescriptionPointeurFonctionNoeudSemantique(
            etat,
            originePointeurFonctionExpression,
            hachageType,
            &descriptionPointeurFonctionExpression)
            && descriptionPointeurFonctionExpression.NiveauPointeur == 0;
    }

    booléen EstExpressionScalaireIntrinsequeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 hachageType) {
        retourner EstTypeScalaireSemantique(etat, hachageType)
            || EstPointeurFonctionExpressionSemantique(
                etat, indexExpression, hachageType);
    }

    booléen EstExpressionAdresseIntrinsequeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 hachageType) {
        retourner EstTypeAdresseSemantique(etat, hachageType)
            || EstPointeurFonctionExpressionSemantique(
                etat, indexExpression, hachageType);
    }

    ErreurAnalyseSemantique ValiderUnaireIntrinsequeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        constante NoeudDeclaration* expressionUnaire =
            &etat->Requete->Noeuds[indexExpression];
        si (expressionUnaire->Genre != 25)
            retourner ErreurAnalyseSemantique::Reussite;
        si (HachageTypeResolutionExpressionSemantique(
                etat, indexExpression) != 0)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 operateurAdresseUnaire =
            HacherOperateurExpressionSemantique(38, 0);
        naturel64 operateurDereferencementUnaire =
            HacherOperateurExpressionSemantique(42, 0);
        naturel64 operateurNegationUnaire =
            HacherOperateurExpressionSemantique(33, 0);

        naturel64 operandeUnaire = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 typeOperandeUnaire = HachageTypeExpressionSemantique(
            etat, operandeUnaire);
        si (expressionUnaire->HachageNom == operateurAdresseUnaire) {
            naturel64 origineOperandeAdresseUnaire =
                TrouverOrigineTypeExpressionSemantique(
                    etat, operandeUnaire);
            naturel64 symboleOperandeAdresse =
                TrouverCibleSymboleExpressionSemantique(
                    etat, operandeUnaire);
            si (symboleOperandeAdresse < etat->NombreSymboles
                && etat->SymbolesTravail[
                    symboleOperandeAdresse].Genre == 2)
                retourner ErreurAnalyseSemantique::Reussite;
            si (!EstValeurGaucheSemantique(etat, operandeUnaire))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AdresseValeurNonAdressable,
                    indexExpression,
                    0);
            naturel64 typeAdresseResultat =
                TransformerPointeurTypeSemantique(
                    etat,
                    QualifierValeurAdresseSemantique(etat, operandeUnaire, typeOperandeUnaire),
                    origineOperandeAdresseUnaire,
                    vrai);
            si (typeAdresseResultat == 0) {
                DescriptionHachageTypeSemantique dimensionsAdresse;
                si (LireDimensionsNoeudSemantique(
                        etat,
                        origineOperandeAdresseUnaire,
                        &dimensionsAdresse))
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AdresseTableauCompletInterdite,
                        indexExpression,
                        dimensionsAdresse.NombreDimensions);
            }
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (expressionUnaire->HachageNom
            == operateurDereferencementUnaire) {
            naturel64 origineOperandeDereferenceUnaire =
                TrouverOrigineTypeExpressionSemantique(
                    etat, operandeUnaire);
            naturel64 typeDereferenceResultat =
                TransformerPointeurTypeSemantique(
                    etat,
                    typeOperandeUnaire,
                    origineOperandeDereferenceUnaire,
                    faux);
            si (typeDereferenceResultat == 0)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::DereferencementSansPointeur,
                    indexExpression,
                    0);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (expressionUnaire->HachageNom == operateurNegationUnaire) {
            si (!EstExpressionScalaireIntrinsequeSemantique(
                    etat, operandeUnaire, typeOperandeUnaire))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::NegationNonScalaire,
                    indexExpression,
                    0);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (!EstTypeEntierExpressionSemantique(typeOperandeUnaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::OperateurUnaireNonEntier,
                indexExpression,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderBinaireIntrinsequeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        constante NoeudDeclaration* expressionBinaire =
            &etat->Requete->Noeuds[indexExpression];
        si (expressionBinaire->Genre != 26)
            retourner ErreurAnalyseSemantique::Reussite;
        si (HachageTypeResolutionExpressionSemantique(
                etat, indexExpression) != 0)
            retourner ErreurAnalyseSemantique::Reussite;

        naturel64 operandeGaucheBinaire = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 operandeDroiteBinaire = TrouverEnfantDirectSemantique(
            etat, indexExpression, 1);
        naturel64 typeGaucheBinaire = HachageTypeExpressionSemantique(
            etat, operandeGaucheBinaire);
        naturel64 typeDroiteBinaire = HachageTypeExpressionSemantique(
            etat, operandeDroiteBinaire);
        naturel64 nomOperateurBinaire = expressionBinaire->HachageNom;
        booléen comparaisonBinaire =
            EstOperateurComparaisonExpressionSemantique(
                expressionBinaire);
        booléen decalageBinaire =
            EstOperateurDecalageExpressionSemantique(
                expressionBinaire);
        booléen logiqueBinaire =
            nomOperateurBinaire
                    == HacherOperateurExpressionSemantique(38, 38)
                || nomOperateurBinaire
                    == HacherOperateurExpressionSemantique(124, 124);

        si (logiqueBinaire) {
            si (!EstExpressionScalaireIntrinsequeSemantique(
                    etat,
                    operandeGaucheBinaire,
                    typeGaucheBinaire)
                || !EstExpressionScalaireIntrinsequeSemantique(
                    etat,
                    operandeDroiteBinaire,
                    typeDroiteBinaire))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::OperateurLogiqueNonScalaire,
                    indexExpression,
                    0);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (!decalageBinaire
            && !TypesValeurEgauxSemantique(
                etat, typeGaucheBinaire, typeDroiteBinaire)) {
            naturel64 cibleGaucheBinaire =
                SansQualificatifsValeurSemantique(
                    etat, typeDroiteBinaire);
            naturel64 cibleDroiteBinaire =
                SansQualificatifsValeurSemantique(
                    etat, typeGaucheBinaire);
            si (ConstanteExpressionCompatibleTypeSemantique(
                    etat,
                    operandeGaucheBinaire,
                    cibleGaucheBinaire)) {
                typeGaucheBinaire = cibleGaucheBinaire;
                etat->TypesConversionsImplicites[operandeGaucheBinaire] = cibleGaucheBinaire;
            }
            sinon si (etat->Requete->Resultat.Erreur
                != ErreurAnalyseSemantique::Reussite)
                retourner etat->Requete->Resultat.Erreur;
            sinon si (etat->ConstanteHorsPlage != 0)
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::ConstanteHorsPlageType,
                    operandeGaucheBinaire, 0);
            sinon si (ConstanteExpressionCompatibleTypeSemantique(
                    etat,
                    operandeDroiteBinaire,
                    cibleDroiteBinaire)) {
                typeDroiteBinaire = cibleDroiteBinaire;
                etat->TypesConversionsImplicites[operandeDroiteBinaire] = cibleDroiteBinaire;
            }
            sinon si (etat->Requete->Resultat.Erreur
                != ErreurAnalyseSemantique::Reussite)
                retourner etat->Requete->Resultat.Erreur;
            sinon si (etat->ConstanteHorsPlage != 0)
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::ConstanteHorsPlageType,
                    operandeDroiteBinaire, 0);
        }
        si (!decalageBinaire
            && !TypesValeurEgauxSemantique(
                etat, typeGaucheBinaire, typeDroiteBinaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::TypesOperandesDifferents,
                indexExpression,
                0);
        si (decalageBinaire
            && (!EstTypeEntierExpressionSemantique(typeGaucheBinaire)
                || !EstTypeEntierExpressionSemantique(
                    typeDroiteBinaire)))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::DecalageNonEntier,
                indexExpression,
                0);
        si (!comparaisonBinaire
            && !EstTypeEntierExpressionSemantique(typeGaucheBinaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::CalculNonEntier,
                indexExpression,
                0);
        si (comparaisonBinaire
            && !EstExpressionScalaireIntrinsequeSemantique(
                etat,
                operandeGaucheBinaire,
                typeGaucheBinaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ComparaisonTypeInvalide,
                indexExpression,
                0);

        booléen egaliteBinaire =
            nomOperateurBinaire
                    == HacherOperateurExpressionSemantique(61, 61)
                || nomOperateurBinaire
                    == HacherOperateurExpressionSemantique(33, 61);
        si (!egaliteBinaire
            && EstExpressionAdresseIntrinsequeSemantique(
                etat,
                operandeGaucheBinaire,
                typeGaucheBinaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ComparaisonPointeurInvalide,
                indexExpression,
                0);
        si (!egaliteBinaire
            && EstTypeBooleenExpressionSemantique(typeGaucheBinaire))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ComparaisonBooleenneInvalide,
                indexExpression,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderIndexationSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        naturel64 objetIndexationValidee = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 indiceIndexationValidee = TrouverEnfantDirectSemantique(
            etat, indexExpression, 1);
        naturel64 typeObjetIndexationValidee =
            HachageTypeExpressionSemantique(
                etat, objetIndexationValidee);
        naturel64 typeResultatIndexationValidee =
            HachageTypeIndexationSemantique(
                etat, indexExpression);
        naturel64 symboleObjetIndexationValidee =
            TrouverCibleSymboleExpressionSemantique(
                etat, objetIndexationValidee);
        booléen fonctionDirecteIndexee =
            symboleObjetIndexationValidee < etat->NombreSymboles
            && etat->SymbolesTravail[
                symboleObjetIndexationValidee].Genre == 2;
        naturel64 origineObjetIndexationValidee =
            TrouverOrigineTypeExpressionSemantique(
                etat, objetIndexationValidee);
        DescriptionTypeJetonsSemantique descriptionFonctionIndexee;
        booléen fonctionPureIndexee =
            LireDescriptionPointeurFonctionNoeudSemantique(
                etat,
                origineObjetIndexationValidee,
                typeObjetIndexationValidee,
                &descriptionFonctionIndexee)
            && descriptionFonctionIndexee.NiveauPointeur == 0;
        si (typeResultatIndexationValidee == 0
            || fonctionDirecteIndexee
            || fonctionPureIndexee)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::CibleIndexationInvalide,
                indexExpression,
                0);
        naturel64 typeIndiceIndexationValidee =
            HachageTypeExpressionSemantique(
                etat, indiceIndexationValidee);
        si (!EstTypeEntierExpressionSemantique(
                typeIndiceIndexationValidee))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::IndiceNonEntier,
                indiceIndexationValidee,
                0);
        si (EstTypeVideExpressionSemantique(
                typeResultatIndexationValidee))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::IndexationPointeurVide,
                indexExpression,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Résout un argument agrégé après obtention de son type attendu.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Résolutions et types privés.
     * @Paramètre(naturel64: argument) Racine de l'initialiseur agrégé différé.
     * @Paramètre(naturel64: type) Paramètre de la signature retenue.
     * @Retourner(ErreurAnalyseSemantique) Premier refus de forme ou de feuille dans l'ordre source.
     **/
    ErreurAnalyseSemantique ValiderArgumentAgregeTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 argument, naturel64 type) {

        si (etat->TypesConversionsImplicites[argument] != 0) retourner ErreurAnalyseSemantique::Reussite;
        DestinationInitialiseurSemantique destination = {type, argument, 0, 0, 0, 1};
        ErreurAnalyseSemantique erreur = ValiderInitialiseurDestinationSemantique(etat, argument, &destination);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
        etat->TypesConversionsImplicites[argument] = SansQualificatifsValeurSemantique(etat, type);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Applique les paramètres canoniques de la fonction sélectionnée aux arguments agrégés.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Cible résolue et déclarations canoniques.
     * @Paramètre(naturel64: indexAppel) Appel après sélection et visibilité.
     * @Paramètre(naturel64: indexFonction) Déclaration effectivement retenue.
     * @Retourner(ErreurAnalyseSemantique) Premier refus contextuel après la sélection.
     **/
    ErreurAnalyseSemantique ValiderArgumentsAgregesFonctionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAppel, naturel64 indexFonction) {

        naturel64 cible = TrouverEnfantDirectSemantique(etat, indexAppel, 0);
        naturel64 premierArgument = 1;
        naturel64 premierParametre = 0;
        naturel64 recepteur = HachageTypeRecepteurFonctionSemantique(etat, indexFonction);
        si (etat->Requete->Noeuds[cible].Genre == 29 && recepteur == 0) premierParametre = 1;
        sinon si (etat->Requete->Noeuds[cible].Genre != 29 && recepteur != 0) premierArgument = 2;
        naturel64 nombreArguments = CompterEnfantsDirectsSemantique(etat, indexAppel);
        naturel64 index = premierArgument;
        tantque (index < nombreArguments) {

            naturel64 argument = TrouverEnfantDirectSemantique(etat, indexAppel, index);
            si (etat->Requete->Noeuds[argument].Genre == 32) {

                naturel64 parametre = TrouverParametreFonctionSemantique(
                    etat, indexFonction, index - premierArgument + premierParametre);
                ErreurAnalyseSemantique erreur = ValiderArgumentAgregeTypeSemantique(
                    etat, argument, etat->Requete->Noeuds[parametre].HachageType);
                si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Regroupe la signature indirecte et le préfixe d'arguments à contrôler.</résumé>
     **/
    structure TrancheArgumentsAppelIndirectSemantique {

        naturel64 DebutType;
        naturel32 NombreParametres;
        naturel64 Limite;
    };

    ErreurAnalyseSemantique ValiderArgumentsAppelIndirectSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexAppel,
        TrancheArgumentsAppelIndirectSemantique* tranche) {
        naturel32 nombreParametresPointeurFonction = tranche->NombreParametres;
        CurseurTypeJetonsSemantique curseurArgumentsIndirects = {
            tranche->DebutType, faux};
        booléen continuerQualificatifsAppel = vrai;
        tantque (continuerQualificatifsAppel) {
            si (AccepterTypeJetonsSemantique(
                    etat, &curseurArgumentsIndirects, 12)) {}
            sinon si (AccepterTypeJetonsSemantique(
                    etat, &curseurArgumentsIndirects, 13)) {}
            sinon continuerQualificatifsAppel = faux;
        }
        si (!AccepterTypeJetonsSemantique(
                etat, &curseurArgumentsIndirects, 26)
            || !AccepterTypeJetonsSemantique(
                etat, &curseurArgumentsIndirects, 48))
            retourner ErreurAnalyseSemantique::AstInvalide;
        DescriptionTypeJetonsSemantique retourArgumentsIndirects;
        si (!AnalyserTypeJetonsSemantique(
                etat,
                &curseurArgumentsIndirects,
                &retourArgumentsIndirects)
            || !AccepterTypeJetonsSemantique(
                etat, &curseurArgumentsIndirects, 34))
            retourner ErreurAnalyseSemantique::AstInvalide;

        naturel32 indexArgumentIndirect = 0;
        tantque (indexArgumentIndirect
            < nombreParametresPointeurFonction
            && convertir<naturel64>(indexArgumentIndirect) < tranche->Limite) {
            DescriptionTypeJetonsSemantique parametreAppelIndirect;
            si (!AnalyserTypeJetonsSemantique(
                    etat,
                    &curseurArgumentsIndirects,
                    &parametreAppelIndirect))
                retourner ErreurAnalyseSemantique::AstInvalide;
            naturel64 argumentAppelIndirect =
                TrouverEnfantDirectSemantique(
                    etat,
                    indexAppel,
                    convertir<naturel64>(indexArgumentIndirect) + 1);
            booléen parametreIndirectReference =
                (parametreAppelIndirect.Qualificatifs & 4) != 0;
            booléen argumentIndirectCompatible = vrai;
            si (etat->Requete->Noeuds[argumentAppelIndirect].Genre == 32) {

                ErreurAnalyseSemantique erreurAgregat = ValiderArgumentAgregeTypeSemantique(
                    etat, argumentAppelIndirect, parametreAppelIndirect.HachageType);
                si (erreurAgregat != ErreurAnalyseSemantique::Reussite) retourner erreurAgregat;
            }
            sinon si (parametreIndirectReference) {
                argumentIndirectCompatible =
                    LiaisonReferenceCompatibleSemantique(
                        etat,
                        argumentAppelIndirect,
                        parametreAppelIndirect.HachageType);
            }
            sinon argumentIndirectCompatible =
                InitialiseurCompatibleTypeSemantique(
                    etat,
                    argumentAppelIndirect,
                    parametreAppelIndirect.HachageType);
            si (!argumentIndirectCompatible)
                si (etat->Requete->Resultat.Erreur
                    != ErreurAnalyseSemantique::Reussite)
                    retourner etat->Requete->Resultat.Erreur;
            si (!argumentIndirectCompatible)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        TypeArgumentAppelIndirectIncompatible,
                    argumentAppelIndirect,
                    indexArgumentIndirect);
            indexArgumentIndirect = indexArgumentIndirect + 1;
            si (indexArgumentIndirect
                < nombreParametresPointeurFonction
                && !AccepterTypeJetonsSemantique(
                    etat, &curseurArgumentsIndirects, 41))
                retourner ErreurAnalyseSemantique::AstInvalide;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderAppelIndirectSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAppel) {
        naturel64 cibleAppelIndirect = TrouverEnfantDirectSemantique(
            etat, indexAppel, 0);
        naturel64 symboleCibleAppelIndirect =
            TrouverCibleSymboleExpressionSemantique(
                etat, cibleAppelIndirect);
        si (symboleCibleAppelIndirect < etat->NombreSymboles
            && etat->SymbolesTravail[
                symboleCibleAppelIndirect].Genre == 2)
            retourner ValiderArgumentsAgregesFonctionSemantique(
                etat, indexAppel, etat->SymbolesTravail[symboleCibleAppelIndirect].IndexNoeud);

        naturel64 typeCibleAppelIndirect =
            HachageTypeExpressionSemantique(
                etat, cibleAppelIndirect);
        naturel64 origineCibleAppelIndirect =
            TrouverOrigineTypeExpressionSemantique(
                etat, cibleAppelIndirect);
        naturel64 symboleOrigineAppelIndirect =
            TrouverSymboleNoeudSemantique(
                etat, origineCibleAppelIndirect, 2);
        si (symboleOrigineAppelIndirect < etat->NombreSymboles
            && typeCibleAppelIndirect
                == HacherPointeurFonctionDeclarationSemantique(
                    etat, origineCibleAppelIndirect)) {
            naturel64 nombreEnfantsAdresseFonction =
                CompterEnfantsDirectsSemantique(etat, indexAppel);
            naturel64 nombreArgumentsAdresseFonction = 0;
            si (nombreEnfantsAdresseFonction != 0)
                nombreArgumentsAdresseFonction =
                    nombreEnfantsAdresseFonction - 1;
            si (nombreArgumentsAdresseFonction
                != CompterParametresSignatureFonctionSemantique(
                    etat, origineCibleAppelIndirect))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AriteAppelIndirectInvalide,
                    indexAppel,
                    convertir<naturel32>(nombreArgumentsAdresseFonction));
            si (HachageTypeRecepteurFonctionSemantique(etat, origineCibleAppelIndirect) != 0) {

                naturel64 indexArgument = 0;
                tantque (indexArgument < nombreArgumentsAdresseFonction) {

                    naturel64 argument = TrouverEnfantDirectSemantique(etat, indexAppel, indexArgument + 1);
                    naturel64 type = HachageTypeRecepteurFonctionSemantique(etat, origineCibleAppelIndirect);
                    si (indexArgument != 0) {

                        naturel64 parametre = TrouverParametreFonctionSemantique(etat, origineCibleAppelIndirect, indexArgument - 1);
                        type = etat->Requete->Noeuds[parametre].HachageType;
                    }
                    booléen compatible = vrai;
                    etat->ConstanteHorsPlage = 0;
                    si (EstTypeReferenceSemantique(etat, type))
                        compatible = LiaisonReferenceCompatibleSemantique(etat, argument, type);
                    sinon compatible = InitialiseurCompatibleTypeSemantique(etat, argument, type);
                    si (!compatible) {

                        si (etat->Requete->Resultat.Erreur != ErreurAnalyseSemantique::Reussite)
                            retourner etat->Requete->Resultat.Erreur;
                        si (etat->ConstanteHorsPlage != 0)
                            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::ConstanteHorsPlageType, argument, 0);
                        retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::TypeArgumentAppelIndirectIncompatible,
                            argument, convertir<naturel32>(indexArgument));
                    }
                    indexArgument = indexArgument + 1;
                }
                retourner ValiderArgumentsAgregesFonctionSemantique(etat, indexAppel, origineCibleAppelIndirect);
            }
            si (EvaluerArgumentsFonctionSemantique(
                    etat,
                    indexAppel,
                    origineCibleAppelIndirect,
                    1) == 4_294_967_295) {
                naturel64 premierArgumentAdresseFonction =
                    TrouverEnfantDirectSemantique(
                        etat, indexAppel, 1);
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        TypeArgumentAppelIndirectIncompatible,
                    premierArgumentAdresseFonction,
                    0);
            }
            retourner ValiderArgumentsAgregesFonctionSemantique(etat, indexAppel, origineCibleAppelIndirect);
        }
        DescriptionTypeJetonsSemantique descriptionAppelIndirect;
        si (!LireDescriptionPointeurFonctionNoeudSemantique(
                etat,
                origineCibleAppelIndirect,
                typeCibleAppelIndirect,
                &descriptionAppelIndirect)
            || descriptionAppelIndirect.NiveauPointeur != 0)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::CibleAppelIndirectInvalide,
                cibleAppelIndirect,
                0);

        naturel64 nombreEnfantsAppelIndirect =
            CompterEnfantsDirectsSemantique(etat, indexAppel);
        naturel64 nombreArgumentsAppelIndirect = 0;
        si (nombreEnfantsAppelIndirect != 0)
            nombreArgumentsAppelIndirect =
                nombreEnfantsAppelIndirect - 1;
        si (nombreArgumentsAppelIndirect
            != convertir<naturel64>(descriptionAppelIndirect.Reserve))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AriteAppelIndirectInvalide,
                indexAppel,
                convertir<naturel32>(nombreArgumentsAppelIndirect));
        TrancheArgumentsAppelIndirectSemantique tranche = {
            descriptionAppelIndirect.DebutType,
            descriptionAppelIndirect.Reserve,
            convertir<naturel64>(descriptionAppelIndirect.Reserve)};
        retourner ValiderArgumentsAppelIndirectSemantique(etat, indexAppel, &tranche);
    }

    ErreurAnalyseSemantique ResoudreOperateurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        si ((expression->Genre != 25 && expression->Genre != 26)
            || EstOperateurUnaireIntrinsequeSemantique(expression))
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 gauche = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 typeGauche = TrouverTypeDepuisHachageSemantique(
            etat,
            HachageTypeExpressionSemantique(etat, gauche),
            0);
        naturel32 genreGauche = 0;
        si (typeGauche < etat->NombreSymboles)
            genreGauche = etat->Requete->Noeuds[etat->SymbolesTravail[typeGauche].IndexNoeud].Genre;
        booléen objetGauche = genreGauche >= 4 && genreGauche <= 6;
        si (objetGauche) {
            naturel64 typeDeclarant =
                TrouverTypeDeclarantOperateurSemantique(
                    etat, typeGauche, indexExpression);
            si (typeDeclarant < etat->NombreSymboles) {
                naturel64 nomGroupe = HacherNomCompletSemantique(etat, etat->SymbolesTravail[typeDeclarant].IndexNoeud);
                nomGroupe = AjouterNomNoeudSemantique(etat,
                    AjouterOctetSemantique(AjouterOctetSemantique(nomGroupe, 58), 58), indexExpression);
                naturel64 cibleOperateur = SelectionnerGroupeOperateurSemantique(etat, indexExpression, nomGroupe);
                si (cibleOperateur >= etat->NombreSymboles)
                    retourner etat->Requete->Resultat.Erreur;
                booléen methode = HachageTypeRecepteurFonctionSemantique(etat,
                    etat->SymbolesTravail[cibleOperateur].IndexNoeud) != 0;
                si (methode && !AccesMembreAutoriseSemantique(
                        etat, cibleOperateur, indexExpression))
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::MembreInaccessible,
                        indexExpression,
                        convertir<naturel32>(cibleOperateur));
                naturel32 drapeauxMembre = 8 | 256;
                si (methode) drapeauxMembre = drapeauxMembre | 32;
                si (typeDeclarant != typeGauche)
                    drapeauxMembre = drapeauxMembre | 16;
                si (CompterOperateursTypeSemantique(
                        etat,
                        typeDeclarant,
                        indexExpression) > 1)
                    drapeauxMembre = drapeauxMembre | 1;
                AjouterResolutionSemantique(
                    etat,
                    indexExpression,
                    cibleOperateur,
                    drapeauxMembre);
                retourner ErreurAnalyseSemantique::Reussite;
            }
        }

        booléen objetDroite = faux;
        si (expression->Genre == 26) {
            naturel64 droite = TrouverEnfantDirectSemantique(
                etat, indexExpression, 1);
            naturel64 typeDroite = TrouverTypeDepuisHachageSemantique(
                etat,
                HachageTypeExpressionSemantique(etat, droite),
                0);
            si (typeDroite < etat->NombreSymboles) {

                naturel32 genreDroite = etat->Requete->Noeuds[etat->SymbolesTravail[typeDroite].IndexNoeud].Genre;
                objetDroite = genreDroite >= 4 && genreDroite <= 6;
            }
        }
        si (!objetGauche && !objetDroite)
            retourner ErreurAnalyseSemantique::Reussite;

        naturel64 espaceOperateurLibre = 0;
        si (!TrouverEspaceOperateurLibreSemantique(
                etat, indexExpression, &espaceOperateurLibre))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::OperateurIntrouvable,
                indexExpression,
                0);
        naturel64 cibleOperateurLibre =
            SelectionnerOperateurLibreSemantique(
                etat, indexExpression, espaceOperateurLibre);
        si (cibleOperateurLibre >= etat->NombreSymboles)
            retourner etat->Requete->Resultat.Erreur;
        naturel32 drapeauxLibres = 256;
        si (HachageTypeRecepteurFonctionSemantique(etat, etat->SymbolesTravail[cibleOperateurLibre].IndexNoeud) != 0) {

            si (!AccesMembreAutoriseSemantique(etat, cibleOperateurLibre, indexExpression))
                retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::MembreInaccessible,
                    indexExpression, convertir<naturel32>(cibleOperateurLibre));
            drapeauxLibres = drapeauxLibres | 32;
        }
        si (CompterOperateursLibresSemantique(
                etat,
                indexExpression,
                espaceOperateurLibre) > 1)
            drapeauxLibres = drapeauxLibres | 1;
        AjouterResolutionSemantique(
            etat,
            indexExpression,
            cibleOperateurLibre,
            drapeauxLibres);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 CompterFonctionsCorrespondantesSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexReference) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        naturel64 nombre = 0;
        naturel64 cibleRacine = TrouverDeclarationRacineSemantique(etat, indexReference);
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            booléen correspond = ReferenceCorrespondSymboleSemantique(etat, reference, candidat);
            si (cibleRacine < etat->NombreSymboles && !ReferenceUtiliseEspacesSemantique(etat, reference)) correspond = HacherNomDeclarationAliasSemantique(etat, candidat)
                == HacherNomDeclarationAliasSemantique(etat, &etat->SymbolesTravail[cibleRacine]);
            si (candidat->Genre == 2 && correspond)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    ErreurAnalyseSemantique ResoudreReferenceSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexNoeud];
        si (reference->Genre != 24)
            retourner ErreurAnalyseSemantique::Reussite;
        si (TrouverCibleSymboleExpressionSemantique(etat, indexNoeud) < etat->NombreSymboles)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 cible = etat->NombreSymboles;
        naturel32 drapeaux = 0;
        si ((reference->Drapeaux & 65_536) != 0) {
            cible = TrouverBaseSemantique(etat, indexNoeud);
            drapeaux = 2 | 4;
        }
        sinon si (reference->HachageNom == HacherSoiSemantique()) {
            cible = TrouverRecepteurSemantique(etat, indexNoeud);
            drapeaux = 2;
        }
        sinon {
            cible = TrouverVariableSemantique(etat, indexNoeud);
            si (cible >= etat->NombreSymboles)
                cible = TrouverDeclarationRacineSemantique(etat, indexNoeud);
        }

        si (cible >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::SymboleIntrouvable,
                indexNoeud,
                0);

        si (etat->SymbolesTravail[cible].Genre == 2) {
            naturel64 nombre = CompterFonctionsCorrespondantesSemantique(
                etat, indexNoeud);
            constante NoeudDeclaration* noeudParent =
                &etat->Requete->Noeuds[reference->Parent];
            booléen cibleAppel = noeudParent->Genre == 28
                && indexNoeud == reference->Parent + 1;
            naturel64 fonction = etat->SymbolesTravail[cible].IndexNoeud;
            si (nombre > 1 || (cibleAppel && (HachageTypeRecepteurFonctionSemantique(etat, fonction) != 0
                    || (etat->NombreAliasesRacines != 0 && nombre != 0)))) {
                si (!cibleAppel)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AdresseSurchargeAmbigue,
                        indexNoeud,
                        convertir<naturel32>(nombre));
                cible = SelectionnerSurchargeSemantique(
                    etat, indexNoeud, reference->Parent);
                si (cible >= etat->NombreSymboles)
                    retourner etat->Requete->Resultat.Erreur;
                si (nombre > 1) drapeaux = drapeaux | 1;
            }
            si (cibleAppel && HachageTypeRecepteurFonctionSemantique(etat, etat->SymbolesTravail[cible].IndexNoeud) != 0) {

                si (!AccesMembreAutoriseSemantique(etat, cible, indexNoeud))
                    retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::MembreInaccessible,
                        indexNoeud, convertir<naturel32>(cible));
                drapeaux = drapeaux | 32;
            }
        }
        AjouterResolutionSemantique(etat, indexNoeud, cible, drapeaux);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    booléen EstExpressionTableauSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        naturel64 origineTableau = TrouverOrigineTypeExpressionSemantique(
            etat, indexExpression);
        DescriptionHachageTypeSemantique dimensionsTableau;
        si (origineTableau >= etat->Requete->NombreNoeuds
            || !LireDimensionsNoeudSemantique(
                etat, origineTableau, &dimensionsTableau))
            retourner faux;
        naturel64 typeElementFinal = HachageElementFinalTableauSemantique(
            etat, origineTableau);
        naturel64 typeExpression = HachageTypeExpressionSemantique(
            etat, indexExpression);
        retourner typeElementFinal != 0
            && typeExpression != typeElementFinal;
    }

    /**
     * <résumé>Contrôle la cible déjà résolue avant d'analyser la valeur d'une affectation.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST et types déjà résolus.
     * @Paramètre(naturel64: indexAffectation) Expression d'affectation à contrôler.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic de la cible.
     **/
    ErreurAnalyseSemantique ValiderCibleAffectationSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAffectation) {
        naturel64 cibleAffectation = TrouverEnfantDirectSemantique(
            etat, indexAffectation, 0);
        si (!EstValeurGaucheSemantique(etat, cibleAffectation))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::CibleAffectationNonModifiable,
                indexAffectation,
                0);
        si (EstExpressionValeurConstanteSemantique(
                etat, cibleAffectation))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::
                    AffectationValeurConstanteInterdite,
                indexAffectation,
                0);
        si (EstExpressionTableauSemantique(etat, cibleAffectation))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AffectationTableauInterdite,
                indexAffectation,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderAffectationSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAffectation) {

        ErreurAnalyseSemantique erreur = ValiderCibleAffectationSemantique(etat, indexAffectation);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
        naturel64 cibleAffectation = TrouverEnfantDirectSemantique(etat, indexAffectation, 0);
        naturel64 valeurAffectation = TrouverEnfantDirectSemantique(etat, indexAffectation, 1);
        naturel64 typeCibleAffectation = HachageTypeExpressionSemantique(
            etat, cibleAffectation);
        si (!InitialiseurCompatibleTypeSemantique(
                etat, valeurAffectation, typeCibleAffectation)) {
            si (etat->Requete->Resultat.Erreur
                != ErreurAnalyseSemantique::Reussite)
                retourner etat->Requete->Resultat.Erreur;
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::TypeAffectationIncompatible,
                valeurAffectation,
                0);
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 TrouverFonctionContenantSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        si (indexNoeud >= etat->Requete->NombreNoeuds)
            retourner etat->Requete->NombreNoeuds;
        naturel64 courantFonction = etat->Requete->Noeuds[
            indexNoeud].Parent;
        tantque (courantFonction != 0
            && courantFonction < etat->Requete->NombreNoeuds) {
            si (EstGenreFonctionSemantique(
                    etat->Requete->Noeuds[courantFonction].Genre))
                retourner courantFonction;
            courantFonction = etat->Requete->Noeuds[
                courantFonction].Parent;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    ErreurAnalyseSemantique ValiderRetourSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexRetour) {
        naturel64 indexFonction = TrouverFonctionContenantSemantique(
            etat, indexRetour);
        si (indexFonction >= etat->Requete->NombreNoeuds)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexRetour,
                46);
        naturel64 typeRetour = etat->Requete->Noeuds[
            indexFonction].HachageType;
        booléen valeurPresente =
            (etat->Requete->Noeuds[indexRetour].Drapeaux & 2048) != 0;
        si (!valeurPresente) {
            si (!EstTypeVideExpressionSemantique(typeRetour))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::ValeurRetourAttendue,
                    indexRetour,
                    0);
            retourner ErreurAnalyseSemantique::Reussite;
        }
        naturel64 valeurRetour = TrouverEnfantDirectSemantique(
            etat, indexRetour, 0);
        si (!InitialiseurCompatibleTypeSemantique(
                etat, valeurRetour, typeRetour)) {
            si (etat->Requete->Resultat.Erreur
                != ErreurAnalyseSemantique::Reussite)
                retourner etat->Requete->Resultat.Erreur;
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::TypeRetourIncompatible,
                valeurRetour,
                0);
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Vérifie le type cible d'une conversion avant d'analyser sa source.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Tables et types résolus.
     * @Paramètre(naturel64: indexConversion) Expression convertir/cast.
     * @Paramètre(DescriptionTypeJetonsSemantique*: cible) Description privée du type cible.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic du type cible.
     **/
    ErreurAnalyseSemantique ValiderCibleConversionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConversion, DescriptionTypeJetonsSemantique* cible) {

        etat->ErreurTypeDeclare = ErreurAnalyseSemantique::Reussite;
        si (!LireTypeConversionSemantique(etat, indexConversion, cible))
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::AstInvalide, indexConversion, 64);
        si (etat->ErreurTypeDeclare != ErreurAnalyseSemantique::Reussite) {

            ErreurAnalyseSemantique erreurTypeCible = etat->ErreurTypeDeclare;
            si (erreurTypeCible == ErreurAnalyseSemantique::TypeNommeIntrouvable)
                erreurTypeCible = ErreurAnalyseSemantique::TypeConversionIntrouvable;
            retourner SignalerErreurSemantique(etat, erreurTypeCible, indexConversion, 0);
        }
        naturel64 typeNomme = etat->NombreSymboles;
        si (cible->Genre == 13) {

            typeNomme = TrouverTypeDepuisHachageSemantique(
                etat, cible->HachageType, cible->NiveauPointeur);
            si (typeNomme >= etat->NombreSymboles)
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::TypeConversionIntrouvable, indexConversion, 0);
        }
        si (cible->NiveauPointeur == 0 && (cible->Qualificatifs & 4) == 0
            && (cible->Genre == 12
                || (typeNomme < etat->NombreSymboles
                    && etat->Requete->Noeuds[etat->SymbolesTravail[typeNomme].IndexNoeud].Genre != 8)))
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::CibleConversionNonScalaire, indexConversion, 0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Vérifie source, signatures et valeur constante lors de la visite de la conversion.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST et types déjà résolus.
     * @Paramètre(naturel64: indexConversion) Expression convertir/cast à contrôler.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic de conversion.
     **/
    ErreurAnalyseSemantique ValiderConversionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConversion) {

        DescriptionTypeJetonsSemantique cible;
        ErreurAnalyseSemantique erreur = ValiderCibleConversionSemantique(etat, indexConversion, &cible);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;

        naturel64 indexSource = TrouverEnfantDirectSemantique(etat, indexConversion, 0);
        naturel64 typeSource = HachageTypeExpressionSemantique(etat, indexSource);
        si (!EstExpressionScalaireIntrinsequeSemantique(etat, indexSource, typeSource))
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::SourceConversionNonScalaire, indexConversion, 0);
        booléen sourceAdresse = EstExpressionAdresseIntrinsequeSemantique(etat, indexSource, typeSource);
        booléen cibleAdresse = (cible.NiveauPointeur != 0 || cible.Genre == 14)
            && (cible.Qualificatifs & 4) == 0;
        si (sourceAdresse != cibleAdresse)
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::ConversionPointeurEntierInterdite, indexConversion, 0);

        booléen sourceFonction = EstPointeurFonctionExpressionSemantique(etat, indexSource, typeSource);
        si (sourceFonction) {

            DescriptionTypeJetonsSemantique signatureSource;
            naturel64 origineSource = TrouverOrigineTypeExpressionSemantique(etat, indexSource);
            si (LireDescriptionPointeurFonctionNoeudSemantique(
                    etat, origineSource, typeSource, &signatureSource))
                sourceFonction = signatureSource.NiveauPointeur == 0;
        }
        booléen cibleFonction = cible.Genre == 14 && cible.NiveauPointeur == 0
            && (cible.Qualificatifs & 4) == 0;
        si ((sourceFonction || cibleFonction) && typeSource != cible.HachageType)
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::SignatureConversionIncompatible, indexConversion, 0);
        si (!cibleAdresse && EstExpressionConstanteGlobaleSemantique(etat, indexConversion)) {

            naturel64 valeur = 0;
            retourner EvaluerConstanteNumeriqueSemantique(etat, indexConversion, &valeur);
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Résout un nœud dont les enfants ont déjà été traités.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST et résolutions privées.
     * @Paramètre(naturel64: indexExpression) Nœud à résoudre sans parcourir ses enfants.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic propre au nœud.
     **/
    ErreurAnalyseSemantique ResoudreNoeudExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {

        constante NoeudDeclaration* expressionCourante =
            &etat->Requete->Noeuds[indexExpression];
        ErreurAnalyseSemantique erreurExpression =
            ErreurAnalyseSemantique::Reussite;
        si (expressionCourante->Genre == 24)
            erreurExpression = ResoudreReferenceSemantique(
                etat, indexExpression);
        sinon si (expressionCourante->Genre == 29)
            erreurExpression = ResoudreMembreSemantique(
                etat, indexExpression);
        sinon si (expressionCourante->Genre == 25
            || expressionCourante->Genre == 26)
            erreurExpression = ResoudreOperateurSemantique(
                etat, indexExpression);
        si (erreurExpression == ErreurAnalyseSemantique::Reussite
            && expressionCourante->Genre == 25)
            erreurExpression = ValiderUnaireIntrinsequeSemantique(
                etat, indexExpression);
        si (erreurExpression == ErreurAnalyseSemantique::Reussite
            && expressionCourante->Genre == 26)
            erreurExpression = ValiderBinaireIntrinsequeSemantique(
                etat, indexExpression);
        si (erreurExpression == ErreurAnalyseSemantique::Reussite
            && expressionCourante->Genre == 31)
            erreurExpression = ValiderConversionSemantique(etat, indexExpression);
        si (erreurExpression == ErreurAnalyseSemantique::Reussite
            && expressionCourante->Genre == 30)
            erreurExpression = ValiderIndexationSemantique(
                etat, indexExpression);
        si (erreurExpression == ErreurAnalyseSemantique::Reussite
            && expressionCourante->Genre == 28)
            erreurExpression = ValiderAppelIndirectSemantique(
                etat, indexExpression);
        si (erreurExpression == ErreurAnalyseSemantique::Reussite
            && expressionCourante->Genre == 27)
            erreurExpression = ValiderAffectationSemantique(
                etat, indexExpression);
        si (erreurExpression == ErreurAnalyseSemantique::Reussite
            && expressionCourante->Genre == 17)
            erreurExpression = ValiderRetourSemantique(
                etat, indexExpression);
        si (erreurExpression != ErreurAnalyseSemantique::Reussite)
            retourner erreurExpression;
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Diffère la sélection d'une cible surchargée jusqu'à la résolution des arguments.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST et résolutions privées.
     * @Paramètre(naturel64: indexCible) Premier enfant direct de l'appel.
     * @Retourner(booléen) Vrai pour une référence de fonction ou un groupe membre.
     **/
    booléen EstCibleAppelDiffereeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexCible) {

        naturel32 genre = etat->Requete->Noeuds[indexCible].Genre;
        si (genre == 24) {

            si (TrouverVariableSemantique(etat, indexCible) < etat->NombreSymboles) retourner faux;
            naturel64 cible = TrouverDeclarationRacineSemantique(etat, indexCible);
            retourner cible < etat->NombreSymboles && etat->SymbolesTravail[cible].Genre == 2;
        }
        si (genre != 29) retourner faux;
        naturel64 typeObjet = TrouverTypeObjetMembreSemantique(etat, indexCible);
        retourner typeObjet < etat->NombreSymboles
            && TrouverTypeDeclarantAppelMembreSemantique(etat, typeObjet, indexCible) < etat->NombreSymboles;
    }

    /**
     * <résumé>Contrôle l'existence d'une signature d'arité recevable avant les arguments.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Symboles canoniques et récepteur résolu.
     * @Paramètre(naturel64: indexCible) Référence ou membre appelé.
     * @Retourner(ErreurAnalyseSemantique) Refus du groupe avant toute expression d'argument.
     **/
    ErreurAnalyseSemantique PreparerGroupeAppelSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexCible) {

        naturel64 indexAppel = etat->Requete->Noeuds[indexCible].Parent;
        naturel64 nombreArguments = CompterEnfantsDirectsSemantique(etat, indexAppel) - 1;
        booléen membre = etat->Requete->Noeuds[indexCible].Genre == 29;
        naturel64 nomGroupe = 0;
        naturel64 cibleRacine = etat->NombreSymboles;
        si (membre) {

            naturel64 typeObjet = TrouverTypeObjetMembreSemantique(etat, indexCible);
            naturel64 declarant = TrouverTypeDeclarantAppelMembreSemantique(etat, typeObjet, indexCible);
            nomGroupe = HacherNomCompletSemantique(etat, etat->SymbolesTravail[declarant].IndexNoeud);
            nomGroupe = AjouterNomNoeudSemantique(etat,
                AjouterOctetSemantique(AjouterOctetSemantique(nomGroupe, 58), 58), indexCible);
        }
        sinon cibleRacine = TrouverDeclarationRacineSemantique(etat, indexCible);
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {

            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            booléen correspond = ReferenceCorrespondSymboleSemantique(etat, &etat->Requete->Noeuds[indexCible], candidat);
            si (cibleRacine < etat->NombreSymboles && !ReferenceUtiliseEspacesSemantique(etat, &etat->Requete->Noeuds[indexCible])) correspond = HacherNomDeclarationAliasSemantique(etat, candidat)
                == HacherNomDeclarationAliasSemantique(etat, &etat->SymbolesTravail[cibleRacine]);
            si (membre) correspond = HacherNomDeclarationAliasSemantique(etat, candidat) == nomGroupe;
            si (candidat->Genre == 2 && correspond) {

                naturel64 parametres = CompterParametresFonctionSemantique(etat, candidat->IndexNoeud);
                naturel64 typeRecepteur = HachageTypeRecepteurFonctionSemantique(etat, candidat->IndexNoeud);
                si (membre && typeRecepteur == 0 && parametres != 0) {

                    naturel64 premier = TrouverParametreFonctionSemantique(etat, candidat->IndexNoeud, 0);
                    typeRecepteur = etat->Requete->Noeuds[premier].HachageType;
                    parametres = parametres - 1;
                }
                sinon si (!membre && typeRecepteur != 0) parametres = parametres + 1;
                booléen recepteurCompatible = !membre || (typeRecepteur != 0
                    && EvaluerRecepteurAppelMembreSemantique(etat, indexCible, typeRecepteur) != 4_294_967_295);
                si (parametres == nombreArguments && recepteurCompatible)
                    retourner ErreurAnalyseSemantique::Reussite;
            }
            index = index + 1;
        }
        retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AucuneSurchargeCompatible,
            indexCible, convertir<naturel32>(nombreArguments));
    }

    /**
     * <résumé>Contrôle la cible indirecte et son arité avant les arguments.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Cible déjà résolue et signatures privées.
     * @Paramètre(naturel64: indexAppel) Expression d'appel.
     * @Retourner(ErreurAnalyseSemantique) Premier refus de cible ou d'arité.
     **/
    ErreurAnalyseSemantique PreparerAppelIndirectSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAppel) {

        naturel64 cible = TrouverEnfantDirectSemantique(etat, indexAppel, 0);
        naturel64 type = HachageTypeExpressionSemantique(etat, cible);
        naturel64 origine = TrouverOrigineTypeExpressionSemantique(etat, cible);
        naturel64 symboleOrigine = TrouverSymboleNoeudSemantique(etat, origine, 2);
        naturel64 nombreArguments = CompterEnfantsDirectsSemantique(etat, indexAppel) - 1;
        naturel64 nombreParametres = 0;
        si (symboleOrigine < etat->NombreSymboles
            && type == HacherPointeurFonctionDeclarationSemantique(etat, origine))
            nombreParametres = CompterParametresSignatureFonctionSemantique(etat, origine);
        sinon {

            DescriptionTypeJetonsSemantique description;
            si (!LireDescriptionPointeurFonctionNoeudSemantique(etat, origine, type, &description)
                || description.NiveauPointeur != 0)
                retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::CibleAppelIndirectInvalide, cible, 0);
            nombreParametres = convertir<naturel64>(description.Reserve);
        }
        si (nombreArguments != nombreParametres)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AriteAppelIndirectInvalide,
                indexAppel, convertir<naturel32>(nombreArguments));
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Compare seulement les arguments déjà parcourus à une signature candidate.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types privés des arguments résolus.
     * @Paramètre(naturel64: indexCible) Référence ou membre appelé.
     * @Paramètre(naturel64: indexFonction) Déclaration candidate canonique.
     * @Paramètre(naturel64: limite) Nombre d'arguments directs déjà parcourus.
     * @Retourner(naturel32) Score compatible ou 4_294_967_295 si le préfixe élimine la candidate.
     **/
    naturel32 EvaluerPrefixeGroupeAppelSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexCible, naturel64 indexFonction, naturel64 limite) {

        naturel64 indexAppel = etat->Requete->Noeuds[indexCible].Parent;
        TrancheArgumentsFonctionSemantique tranche = {1, 0, limite};
        naturel64 typeRecepteur = HachageTypeRecepteurFonctionSemantique(etat, indexFonction);
        si (etat->Requete->Noeuds[indexCible].Genre == 29) {

            si (typeRecepteur == 0) {

                si (CompterParametresFonctionSemantique(etat, indexFonction) == 0) retourner 4_294_967_295;
                naturel64 premierParametre = TrouverParametreFonctionSemantique(etat, indexFonction, 0);
                typeRecepteur = etat->Requete->Noeuds[premierParametre].HachageType;
                tranche.PremierParametre = 1;
            }
            si (EvaluerRecepteurAppelMembreSemantique(etat, indexCible, typeRecepteur) == 4_294_967_295)
                retourner 4_294_967_295;
        }
        sinon si (typeRecepteur != 0) {

            naturel64 recepteur = TrouverEnfantDirectSemantique(etat, indexAppel, 1);
            si (!LiaisonReferenceCompatibleSemantique(etat, recepteur, typeRecepteur)) retourner 4_294_967_295;
            tranche.PremierArgument = 2;
            tranche.LimiteArguments = limite - 1;
        }
        retourner EvaluerTrancheArgumentsFonctionSemantique(etat, indexAppel, indexFonction, &tranche);
    }

    /**
     * <résumé>Abandonne les candidats incompatibles avant de visiter l'argument suivant.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Groupe canonique et préfixe déjà résolu.
     * @Paramètre(naturel64: indexCible) Référence ou membre appelé.
     * @Paramètre(naturel64: limite) Nombre d'arguments directs déjà parcourus.
     * @Retourner(ErreurAnalyseSemantique) Premier refus de préfixe dans l'ordre des candidats.
     * @etc. Ne pas évaluer une candidate ultérieure tant que le préfixe de la première reste recevable.
     **/
    ErreurAnalyseSemantique ValiderPrefixeGroupeAppelSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexCible, naturel64 limite) {

        booléen membre = etat->Requete->Noeuds[indexCible].Genre == 29;
        naturel64 nomGroupe = 0;
        naturel64 cibleRacine = etat->NombreSymboles;
        si (membre) {

            naturel64 typeObjet = TrouverTypeObjetMembreSemantique(etat, indexCible);
            naturel64 declarant = TrouverTypeDeclarantAppelMembreSemantique(etat, typeObjet, indexCible);
            nomGroupe = HacherNomCompletSemantique(etat, etat->SymbolesTravail[declarant].IndexNoeud);
            nomGroupe = AjouterNomNoeudSemantique(etat,
                AjouterOctetSemantique(AjouterOctetSemantique(nomGroupe, 58), 58), indexCible);
        }
        sinon cibleRacine = TrouverDeclarationRacineSemantique(etat, indexCible);
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {

            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            booléen correspond = ReferenceCorrespondSymboleSemantique(etat, &etat->Requete->Noeuds[indexCible], candidat);
            si (cibleRacine < etat->NombreSymboles && !ReferenceUtiliseEspacesSemantique(etat, &etat->Requete->Noeuds[indexCible])) correspond = HacherNomDeclarationAliasSemantique(etat, candidat)
                == HacherNomDeclarationAliasSemantique(etat, &etat->SymbolesTravail[cibleRacine]);
            si (membre) correspond = HacherNomDeclarationAliasSemantique(etat, candidat) == nomGroupe;
            si (candidat->Genre == 2 && correspond) {

                naturel32 score = EvaluerPrefixeGroupeAppelSemantique(etat, indexCible, candidat->IndexNoeud, limite);
                si (etat->Requete->Resultat.Erreur != ErreurAnalyseSemantique::Reussite)
                    retourner etat->Requete->Resultat.Erreur;
                si (score != 4_294_967_295) retourner ErreurAnalyseSemantique::Reussite;
            }
            index = index + 1;
        }
        naturel64 indexAppel = etat->Requete->Noeuds[indexCible].Parent;
        retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AucuneSurchargeCompatible,
            indexCible, convertir<naturel32>(CompterEnfantsDirectsSemantique(etat, indexAppel) - 1));
    }

    /**
     * <résumé>Valide les paramètres déjà parcourus avant de passer à l'argument suivant.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Cible et préfixe d'arguments résolus.
     * @Paramètre(naturel64: indexAppel) Expression d'appel.
     * @Paramètre(naturel64: limite) Nombre d'arguments déjà parcourus.
     * @Retourner(ErreurAnalyseSemantique) Premier refus de groupe ou d'argument indirect.
     **/
    ErreurAnalyseSemantique ValiderPrefixeArgumentsAppelSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAppel, naturel64 limite) {

        naturel64 cible = TrouverEnfantDirectSemantique(etat, indexAppel, 0);
        si (EstCibleAppelDiffereeSemantique(etat, cible))
            retourner ValiderPrefixeGroupeAppelSemantique(etat, cible, limite);
        naturel64 type = HachageTypeExpressionSemantique(etat, cible);
        naturel64 origine = TrouverOrigineTypeExpressionSemantique(etat, cible);
        naturel64 fonction = TrouverSymboleNoeudSemantique(etat, origine, 2);
        naturel64 argument = TrouverEnfantDirectSemantique(etat, indexAppel, limite);
        si (fonction < etat->NombreSymboles && type == HacherPointeurFonctionDeclarationSemantique(etat, origine)
            && etat->Requete->Noeuds[argument].Genre == 32) {

            naturel64 typeParametre = HachageTypeRecepteurFonctionSemantique(etat, origine);
            naturel64 position = limite - 1;
            si (typeParametre == 0 || position != 0) {

                si (typeParametre != 0) position = position - 1;
                naturel64 parametre = TrouverParametreFonctionSemantique(etat, origine, position);
                typeParametre = etat->Requete->Noeuds[parametre].HachageType;
            }
            ErreurAnalyseSemantique erreurAgregat = ValiderArgumentAgregeTypeSemantique(etat, argument, typeParametre);
            si (erreurAgregat != ErreurAnalyseSemantique::Reussite) retourner erreurAgregat;
        }
        DescriptionTypeJetonsSemantique description;
        si (LireDescriptionPointeurFonctionNoeudSemantique(etat, origine, type, &description)
            && description.NiveauPointeur == 0) {

            TrancheArgumentsAppelIndirectSemantique tranche = {description.DebutType, description.Reserve, limite};
            retourner ValiderArgumentsAppelIndirectSemantique(etat, indexAppel, &tranche);
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Résout les sous-arbres dans l'ordre des opérandes, puis leurs contrôles parents.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST préordonné et résolutions privées.
     * @Paramètre(naturel64: debut) Première position du sous-arbre.
     * @Paramètre(naturel64: fin) Borne exclusive de la tranche.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic du parcours couvert.
     * @etc. Les parents servent de pile implicite ; aucun nœud ni allocation supplémentaire.
     **/
    ErreurAnalyseSemantique ResoudreExpressionsSemantiques(
        EtatAnalyseSemantique* etat, naturel64 debut, naturel64 fin) {

        naturel64 prochain = debut;
        tantque (prochain < fin) {

            naturel64 indexExpression = prochain;
            naturel64 parentExpression = etat->Requete->Noeuds[indexExpression].Parent;
            booléen argumentAgregeDiffere = etat->Requete->Noeuds[indexExpression].Genre == 32
                && parentExpression < indexExpression && etat->Requete->Noeuds[parentExpression].Genre == 28;
            si (etat->Requete->Noeuds[indexExpression].Genre == 31) {

                DescriptionTypeJetonsSemantique cible;
                ErreurAnalyseSemantique erreurCibleConversion = ValiderCibleConversionSemantique(etat, indexExpression, &cible);
                si (erreurCibleConversion != ErreurAnalyseSemantique::Reussite) retourner erreurCibleConversion;
            }
            prochain = prochain + 1;
            si (argumentAgregeDiffere)
                tantque (prochain < fin && etat->Requete->Noeuds[prochain].Parent >= indexExpression)
                    prochain = prochain + 1;
            booléen termine = prochain >= fin
                || etat->Requete->Noeuds[prochain].Parent != indexExpression;
            tantque (termine) {

                naturel64 indexParent = etat->Requete->Noeuds[indexExpression].Parent;
                booléen parentPresent = indexParent >= debut && indexParent < indexExpression;
                booléen enfantAppel = parentPresent && etat->Requete->Noeuds[indexParent].Genre == 28;
                booléen cibleAppel = enfantAppel && indexExpression == indexParent + 1;
                booléen cibleDifferee = cibleAppel && EstCibleAppelDiffereeSemantique(etat, indexExpression);
                si (etat->Requete->Noeuds[indexExpression].Genre == 28) {

                    naturel64 cibleFinale = TrouverEnfantDirectSemantique(etat, indexExpression, 0);
                    si (EstCibleAppelDiffereeSemantique(etat, cibleFinale)) {

                        ErreurAnalyseSemantique erreurSelection = ResoudreNoeudExpressionSemantique(etat, cibleFinale);
                        si (erreurSelection != ErreurAnalyseSemantique::Reussite) retourner erreurSelection;
                    }
                }
                si (!cibleDifferee) {

                    ErreurAnalyseSemantique erreurNoeud = ResoudreNoeudExpressionSemantique(etat, indexExpression);
                    si (erreurNoeud != ErreurAnalyseSemantique::Reussite) retourner erreurNoeud;
                }
                si (cibleAppel) {

                    ErreurAnalyseSemantique erreurPreparation = ErreurAnalyseSemantique::Reussite;
                    si (cibleDifferee) erreurPreparation = PreparerGroupeAppelSemantique(etat, indexExpression);
                    sinon erreurPreparation = PreparerAppelIndirectSemantique(etat, indexParent);
                    si (erreurPreparation != ErreurAnalyseSemantique::Reussite) retourner erreurPreparation;
                }
                sinon si (enfantAppel) {

                    naturel64 limiteArguments = 1;
                    tantque (TrouverEnfantDirectSemantique(etat, indexParent, limiteArguments) != indexExpression)
                        limiteArguments = limiteArguments + 1;
                    ErreurAnalyseSemantique erreurArgument = ValiderPrefixeArgumentsAppelSemantique(etat, indexParent, limiteArguments);
                    si (erreurArgument != ErreurAnalyseSemantique::Reussite) retourner erreurArgument;
                }
                si (parentPresent && etat->Requete->Noeuds[indexParent].Genre == 27
                    && indexExpression == indexParent + 1) {

                    ErreurAnalyseSemantique erreurCibleAffectation = ValiderCibleAffectationSemantique(etat, indexParent);
                    si (erreurCibleAffectation != ErreurAnalyseSemantique::Reussite) retourner erreurCibleAffectation;
                }
                termine = parentPresent && (prochain >= fin || etat->Requete->Noeuds[prochain].Parent < indexParent);
                indexExpression = indexParent;
            }
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Valide un initialiseur local avant l'instruction suivante et résout ses feuilles selon leur type.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST et types canoniques privés.
     * @Paramètre(naturel64: indexVariable) Déclaration locale possédant un initialiseur avec '='.
     * @Paramètre(naturel64: finVariable) Borne exclusive de la déclaration et de son initialiseur.
     * @Retourner(ErreurAnalyseSemantique) Premier refus de déclaration, forme ou feuille.
     **/
    ErreurAnalyseSemantique ValiderInitialiseurLocalContextuelSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexVariable, naturel64 finVariable) {

        naturel64 expression = TrouverEnfantDirectSemantique(etat, indexVariable, 0);
        si (expression >= etat->Requete->NombreNoeuds)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, indexVariable, 45);
        DestinationInitialiseurSemantique destination;
        si (!InitialiserDestinationInitialiseurSemantique(etat, indexVariable, &destination))
            retourner ResoudreExpressionsSemantiques(etat, indexVariable, finVariable);
        si (!EstTypeReferenceSemantique(etat, destination.HachageElement)
            && EstDestinationClasseSemantique(etat, &destination))
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::InitialiseurClasseInterdit, indexVariable, 0);
        si (destination.NombreDimensions != 0 && etat->Requete->Noeuds[expression].Genre != 32)
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::InitialiseurTableauNonAgrege,
                indexVariable, destination.NombreDimensions);
        destination.Reserve = 1;
        retourner ValiderInitialiseurDestinationSemantique(etat, expression, &destination);
    }

    /**
     * <résumé>Élimine les constructeurs incompatibles avec l'arité ou le préfixe déjà résolu.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Groupe de constructeurs et types privés.
     * @Paramètre(naturel64: indexArguments) Déclaration locale ou initialiseur portant les arguments directs.
     * @Paramètre(naturel64: indexType) Classe canonique à construire.
     * @Paramètre(naturel64: limite) Nombre d'arguments déjà parcourus ; zéro filtre l'arité.
     * @Retourner(ErreurAnalyseSemantique) Premier refus avant l'argument suivant.
     **/
    ErreurAnalyseSemantique ValiderPrefixeConstructeurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexArguments, naturel64 indexType, naturel64 limite) {

        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        TrancheArgumentsFonctionSemantique tranche = {0, 0, limite};
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {

            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2 && candidat->IndexPortee == indexNoeudType
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 13) {

                naturel32 score = EvaluerTrancheArgumentsFonctionSemantique(
                    etat, indexArguments, candidat->IndexNoeud, &tranche);
                si (etat->Requete->Resultat.Erreur != ErreurAnalyseSemantique::Reussite)
                    retourner etat->Requete->Resultat.Erreur;
                si (score != 4_294_967_295) retourner ErreurAnalyseSemantique::Reussite;
            }
            index = index + 1;
        }
        retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AucuneSurchargeCompatible,
            indexArguments, convertir<naturel32>(CompterEnfantsDirectsSemantique(etat, indexArguments)));
    }

    /**
     * <résumé>Résout les arguments d'un constructeur, puis sa sélection, sa visibilité et ses agrégats.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types et résolutions privés.
     * @Paramètre(naturel64: indexArguments) Variable, base, délégation ou champ explicitement initialisé.
     * @Paramètre(naturel64: indexType) Classe canonique du groupe de constructeurs.
     * @Retourner(naturel64) Symbole retenu ou sentinelle après le premier diagnostic.
     * @etc. Ne publie ni sélection finale ni plan ; chaque consommateur conserve ses propres drapeaux.
     **/
    naturel64 ResoudreArgumentsConstructeurContextuelsSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexArguments, naturel64 indexType) {

        ErreurAnalyseSemantique erreur = ValiderPrefixeConstructeurSemantique(etat, indexArguments, indexType, 0);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner etat->NombreSymboles;
        naturel64 nombreArguments = CompterEnfantsDirectsSemantique(etat, indexArguments);
        naturel64 position = 0;
        tantque (position < nombreArguments) {

            naturel64 argument = TrouverEnfantDirectSemantique(etat, indexArguments, position);
            naturel64 finArgument = argument + 1;
            tantque (finArgument < etat->Requete->NombreNoeuds && etat->Requete->Noeuds[finArgument].Parent >= argument)
                finArgument = finArgument + 1;
            si (etat->Requete->Noeuds[argument].Genre != 32)
                erreur = ResoudreExpressionsSemantiques(etat, argument, finArgument);
            si (erreur != ErreurAnalyseSemantique::Reussite) retourner etat->NombreSymboles;
            position = position + 1;
            erreur = ValiderPrefixeConstructeurSemantique(etat, indexArguments, indexType, position);
            si (erreur != ErreurAnalyseSemantique::Reussite) retourner etat->NombreSymboles;
        }
        naturel64 cible = SelectionnerConstructeurSemantique(etat, indexArguments, indexType);
        si (cible >= etat->NombreSymboles) retourner etat->NombreSymboles;
        si (!AccesMembreAutoriseSemantique(etat, cible, indexArguments)) {

            SignalerErreurSemantique(etat, ErreurAnalyseSemantique::ConstructeurInaccessible,
                indexArguments, convertir<naturel32>(cible));
            retourner etat->NombreSymboles;
        }
        naturel64 positionAgregat = 0;
        tantque (positionAgregat < nombreArguments) {

            naturel64 argumentAgregat = TrouverEnfantDirectSemantique(etat, indexArguments, positionAgregat);
            si (etat->Requete->Noeuds[argumentAgregat].Genre == 32) {

                naturel64 parametre = TrouverParametreFonctionSemantique(
                    etat, etat->SymbolesTravail[cible].IndexNoeud, positionAgregat);
                erreur = ValiderArgumentAgregeTypeSemantique(
                    etat, argumentAgregat, etat->Requete->Noeuds[parametre].HachageType);
                si (erreur != ErreurAnalyseSemantique::Reussite) retourner etat->NombreSymboles;
            }
            positionAgregat = positionAgregat + 1;
        }
        retourner cible;
    }

    /**
     * <résumé>Sélectionne et planifie un objet local avant de visiter l'instruction suivante.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Résolutions privées sans mutation de l'AST public.
     * @Paramètre(naturel64: indexVariable) Objet ou tableau de classes déclaré dans un corps.
     * @Paramètre(naturel64: finVariable) Borne exclusive de ses arguments.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic de sélection, d'argument ou de durée de vie.
     * @etc. Les agrégats attendent sélection et visibilité ; un tableau sans arguments se construit par défaut.
     **/
    ErreurAnalyseSemantique ResoudreConstructionLocaleContextuelleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexVariable, naturel64 finVariable) {

        constante NoeudDeclaration* variable = &etat->Requete->Noeuds[indexVariable];
        si (EstTypeAdresseSemantique(etat, variable->HachageType)
            || EstTypeReferenceSemantique(etat, variable->HachageType))
            retourner ResoudreExpressionsSemantiques(etat, indexVariable, finVariable);
        naturel64 typeElementTableau = HachageElementFinalTableauSemantique(etat, indexVariable);
        booléen variableTableau = typeElementTableau != 0;
        naturel64 hachageType = variable->HachageType;
        si (variableTableau) hachageType = typeElementTableau;
        naturel64 type = TrouverTypeDepuisHachageSemantique(etat, hachageType, 0);
        si (type >= etat->NombreSymboles
            || etat->Requete->Noeuds[etat->SymbolesTravail[type].IndexNoeud].Genre != 6)
            retourner ResoudreExpressionsSemantiques(etat, indexVariable, finVariable);

        naturel64 nombreConstructeurs = CompterConstructeursTypeSemantique(etat, type);
        naturel64 nombreArguments = CompterEnfantsDirectsSemantique(etat, indexVariable);
        booléen explicite = (variable->Drapeaux & 8_192) != 0;
        ContextePlanDureeVieSemantique contexte = {
            indexVariable, TrouverRecepteurSemantique(etat, indexVariable), 0, 0, indexVariable, 0};
        ErreurAnalyseSemantique erreur = ErreurAnalyseSemantique::Reussite;
        si (nombreConstructeurs == 0) {

            si (variableTableau && nombreArguments != 0)
                retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::ConstructeurNonDeclare,
                    indexVariable, convertir<naturel32>(nombreArguments));
            erreur = PlanifierConstructionObjetSemantique(etat, indexVariable, type, &contexte);
            si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
            si (!variableTableau && (explicite || nombreArguments != 0))
                retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::ConstructeurNonDeclare,
                    indexVariable, convertir<naturel32>(nombreArguments));
        }
        sinon {

            naturel64 cible = ResoudreArgumentsConstructeurContextuelsSemantique(etat, indexVariable, type);
            si (cible >= etat->NombreSymboles) retourner etat->Requete->Resultat.Erreur;
            naturel32 drapeaux = 64;
            si (explicite) drapeaux = drapeaux | 128;
            sinon si (variableTableau) drapeaux = drapeaux | 4_096;
            si (variableTableau) drapeaux = drapeaux | 8_192;
            si (nombreConstructeurs > 1) drapeaux = drapeaux | 1;
            AjouterResolutionSemantique(etat, indexVariable, cible, drapeaux);
            si (explicite) contexte.Drapeaux = 128;
            sinon contexte.Drapeaux = 4_096;
            erreur = PlanifierConstructeurUniformeSemantique(etat, indexVariable, cible, &contexte);
            si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
        }
        retourner PlanifierDestructionObjetSemantique(etat, indexVariable, type, &contexte);
    }

    /**
     * <résumé>Contrôle les noms des paramètres à l'entrée de chaque fonction.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Symboles et positions privés.
     * @Paramètre(naturel64: indexFonction) Fonction, méthode, constructeur ou prototype analysé.
     * @Retourner(ErreurAnalyseSemantique) Premier nom de paramètre répété avant les initialiseurs et le corps.
     **/
    ErreurAnalyseSemantique ValiderParametresContextuelsSemantiques(
        EtatAnalyseSemantique* etat, naturel64 indexFonction) {

        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {

            SymboleSemantique* courant = &etat->SymbolesTravail[index];
            si (courant->Genre == 8 && courant->IndexPortee == indexFonction) {

                naturel64 precedent = 0;
                tantque (precedent < index) {

                    SymboleSemantique* autre = &etat->SymbolesTravail[precedent];
                    si (autre->Genre == 8 && autre->IndexPortee == indexFonction
                        && autre->HachageNom == courant->HachageNom)
                        retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::ParametreDeclarePlusieursFois,
                            courant->IndexNoeud, convertir<naturel32>(autre->IndexNoeud));
                    precedent = precedent + 1;
                }
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Vérifie une déclaration locale avant son initialiseur ou ses arguments de construction.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) Types canoniques et portées privées.
     * @Paramètre(naturel64: indexVariable) Déclaration visitée dans l'ordre des instructions.
     * @Retourner(ErreurAnalyseSemantique) Premier refus de type, nom, initialisation obligatoire ou construction.
     * @etc. Les noms d'une portée sœur ne masquent pas la portée courante ; une portée ancêtre reste active.
     **/
    ErreurAnalyseSemantique ValiderDeclarationLocaleContextuelleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexVariable) {

        constante NoeudDeclaration* variable = &etat->Requete->Noeuds[indexVariable];
        etat->ErreurTypeDeclare = ErreurAnalyseSemantique::Reussite;
        DescriptionTypeJetonsSemantique type;
        si (!LireTypeNoeudSemantique(etat, indexVariable, &type))
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, indexVariable, 19);
        etat->ErreurTypeDeclare = ErreurAnalyseSemantique::Reussite;
        CurseurTypeJetonsSemantique curseur = {type.DebutType, faux};
        si (!AnalyserTypeJetonsSemantique(etat, &curseur, &type))
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::AstInvalide, indexVariable, 19);
        DescriptionHachageTypeSemantique dimensions;
        LireDimensionsNoeudSemantique(etat, indexVariable, &dimensions);
        si ((type.Qualificatifs & 4) != 0 && dimensions.NombreDimensions != 0)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::ReferenceTableauInterdite, indexVariable, 0);
        si (etat->ErreurTypeDeclare != ErreurAnalyseSemantique::Reussite) {

            ErreurAnalyseSemantique erreurType = etat->ErreurTypeDeclare;
            etat->ErreurTypeDeclare = ErreurAnalyseSemantique::Reussite;
            retourner SignalerErreurSemantique(etat, erreurType, indexVariable, 0);
        }
        si (type.Genre == 12 && type.NiveauPointeur == 0)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::VariableLocaleVideInterdite, indexVariable, 0);
        naturel64 fonction = TrouverFonctionAncetreSemantique(etat, indexVariable);
        naturel64 indexSymbole = 0;
        tantque (indexSymbole < etat->NombreSymboles) {

            SymboleSemantique* autre = &etat->SymbolesTravail[indexSymbole];
            si (autre->IndexNoeud < indexVariable && autre->HachageNom == variable->HachageNom
                && TrouverFonctionAncetreSemantique(etat, autre->IndexNoeud) == fonction
                && (autre->Genre == 8 || (autre->Genre == 9 && VariableLocaleVisibleSemantique(etat, autre->IndexNoeud, indexVariable))))
                retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::VariableLocaleDeclareePlusieursFois,
                    indexVariable, convertir<naturel32>(autre->IndexNoeud));
            indexSymbole = indexSymbole + 1;
        }
        booléen initialisee = (variable->Drapeaux & 4) != 0;
        booléen reference = (type.Qualificatifs & 4) != 0;
        si (reference && !initialisee)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::ReferenceLocaleNonInitialisee, indexVariable, 0);
        booléen adresse = dimensions.NombreDimensions == 0 && !reference
            && (type.NiveauPointeur != 0 || type.Genre == 14);
        si ((type.Qualificatifs & 1) != 0 && !adresse && !reference && !initialisee)
            retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::VariableLocaleConstanteNonInitialisee, indexVariable, 0);
        si ((variable->Drapeaux & 8_192) != 0) {

            naturel64 indexClasseLocale = etat->NombreSymboles;
            si (type.NiveauPointeur == 0 && !reference)
                indexClasseLocale = TrouverTypeDepuisHachageSemantique(etat, type.HachageType, 0);
            si (indexClasseLocale >= etat->NombreSymboles
                || etat->Requete->Noeuds[etat->SymbolesTravail[indexClasseLocale].IndexNoeud].Genre != 6)
                retourner SignalerErreurSemantique(etat, ErreurAnalyseSemantique::ConstructionExigeClasse, indexVariable, 0);
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Résout les instructions et conditions d'un corps dans l'ordre source.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST préordonné et résolutions privées.
     * @Paramètre(naturel64: debut) Première déclaration du sous-arbre à parcourir.
     * @Paramètre(naturel64: fin) Borne exclusive du sous-arbre.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic de l'instruction ou branche analysée.
     * @etc. Chaque expression garde son parcours interne ; les blocs et branches ne sont pas inversés.
     **/
    ErreurAnalyseSemantique ResoudreInstructionsSemantiques(
        EtatAnalyseSemantique* etat, naturel64 debut, naturel64 fin) {

        naturel64 index = debut;
        tantque (index < fin) {

            naturel32 genre = etat->Requete->Noeuds[index].Genre;
            booléen unite = (genre >= 17 && genre <= 19)
                || (genre >= 22 && genre <= 35);
            si (unite) {

                naturel64 finUnite = index + 1;
                tantque (finUnite < fin && etat->Requete->Noeuds[finUnite].Parent >= index)
                    finUnite = finUnite + 1;
                ErreurAnalyseSemantique erreur = ErreurAnalyseSemantique::Reussite;
                si (genre == 19) erreur = ValiderDeclarationLocaleContextuelleSemantique(etat, index);
                si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
                si (genre == 19 && (etat->Requete->Noeuds[index].Drapeaux & 4) != 0)
                    erreur = ValiderInitialiseurLocalContextuelSemantique(etat, index, finUnite);
                sinon si (genre == 19)
                    erreur = ResoudreConstructionLocaleContextuelleSemantique(etat, index, finUnite);
                sinon erreur = ResoudreExpressionsSemantiques(etat, index, finUnite);
                si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
                index = finUnite;
            }
            sinon index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Résout base, liste explicite et champs par défaut avant le corps d'un constructeur défini.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST et résolutions privés.
     * @Paramètre(naturel64: indexConstructeur) Déclaration du constructeur.
     * @Paramètre(naturel64: fin) Borne exclusive de son sous-arbre.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic d'initialisation ou de corps.
     **/
    ErreurAnalyseSemantique ResoudreConstructeurContextuelSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConstructeur, naturel64 fin) {

        si ((etat->Requete->Noeuds[indexConstructeur].Drapeaux & 2) != 0)
            retourner ErreurAnalyseSemantique::Reussite;
        ErreurAnalyseSemantique erreur = ResoudreBaseImpliciteConstructeurSemantique(etat, indexConstructeur);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
        naturel64 index = indexConstructeur + 1;
        tantque (index < fin) {
            constante NoeudDeclaration* noeud = &etat->Requete->Noeuds[index];
            si (noeud->Parent == indexConstructeur && noeud->Genre >= 33 && noeud->Genre <= 35) {
                naturel64 finInitialiseur = index + 1;
                tantque (finInitialiseur < fin && etat->Requete->Noeuds[finInitialiseur].Parent >= index)
                    finInitialiseur = finInitialiseur + 1;
                si (noeud->Genre == 35) erreur = ResoudreInitialiseurChampSemantique(etat, index);
                sinon {
                    si (noeud->Genre == 33) erreur = ResoudreInitialiseurDelegueSemantique(etat, index);
                    sinon erreur = ResoudreInitialiseurBaseSemantique(etat, index);
                }
                si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
                index = finInitialiseur;
            }
            sinon index = index + 1;
        }
        erreur = ResoudreChampsImplicitesConstructeurSemantique(etat, indexConstructeur);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
        erreur = PlanifierCorpsConstructeurSemantique(etat, indexConstructeur);
        si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
        index = indexConstructeur + 1;
        tantque (index < fin) {
            si (etat->Requete->Noeuds[index].Parent == indexConstructeur && etat->Requete->Noeuds[index].Genre == 16)
                retourner ResoudreInstructionsSemantiques(etat, index, fin);
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Résout chaque catégorie dans l'ordre source, globales complètes avant fonctions et constructeurs.</résumé>
     * @Paramètre(EtatAnalyseSemantique*: etat) AST préordonné et résolutions privées.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic dans la catégorie de déclaration analysée.
     * @etc. Les groupes attendent les arguments ; les cibles indirectes et arités sont contrôlées avant eux.
     **/
    ErreurAnalyseSemantique ResoudreExpressionsDeclarationsSemantiques(EtatAnalyseSemantique* etat) {

        naturel32 phase = 0;
        tantque (phase < 3) {

            naturel64 index = 0;
            tantque (index < etat->Requete->NombreNoeuds) {

                naturel32 genre = etat->Requete->Noeuds[index].Genre;
                booléen traiter = phase == 0 && genre == 9;
                si (phase == 1) traiter = genre == 3;
                si (phase == 2) traiter = genre == 1 || (genre >= 12 && genre <= 15);
                si (traiter) {

                    naturel64 fin = index + 1;
                    tantque (fin < etat->Requete->NombreNoeuds && etat->Requete->Noeuds[fin].Parent >= index)
                        fin = fin + 1;
                    ErreurAnalyseSemantique erreur = ErreurAnalyseSemantique::Reussite;
                    si (phase == 2) erreur = ValiderParametresContextuelsSemantiques(etat, index);
                    si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
                    si (phase == 2 && genre == 13) erreur = ResoudreConstructeurContextuelSemantique(etat, index, fin);
                    sinon si (phase == 2) erreur = ResoudreInstructionsSemantiques(etat, index, fin);
                    sinon si (phase == 1) erreur = ValiderInitialiseurGlobalContextuelSemantique(etat, index);
                    sinon erreur = ResoudreExpressionsSemantiques(etat, index, fin);
                    si (erreur != ErreurAnalyseSemantique::Reussite) retourner erreur;
                    index = fin;
                }
                sinon index = index + 1;
            }
            phase = phase + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    structure ContexteEmissionGlobale {

        EtatAnalyseSemantique* Etat;
        RequeteEmissionGlobales* Sortie;
        GlobaleEmise* Globale;
        booléen Ecrire;
    };

    /**
     * <résumé>Émet une feuille ou descend dans une destination agrégée validée.</résumé>
     * @etc. La passe de mesure valide aussi les calculs et bornes avant toute écriture.
     **/
    ErreurAnalyseSemantique EmettreInitialiseurGlobalSemantique(
        ContexteEmissionGlobale* contexte,
        naturel64 indexExpression,
        DestinationInitialiseurSemantique* destination,
        naturel64 decalage) {

        EtatAnalyseSemantique* etat = contexte->Etat;
        RequeteEmissionGlobales* sortie = contexte->Sortie;
        GlobaleEmise* globale = contexte->Globale;
        booléen ecrire = contexte->Ecrire;
        constante NoeudDeclaration* expression = &etat->Requete->Noeuds[indexExpression];
        si (expression->Genre == 32) {

            naturel64 nombre = CompterEnfantsDirectsSemantique(etat, indexExpression);
            si (destination->ProfondeurTableau < destination->NombreDimensions) {

                naturel64 tailleElement = 0;
                naturel64 alignementElement = 0;
                ErreurAnalyseSemantique erreurTaille = CalculerTailleValeurSemantique(
                    etat, destination->IndexNoeudDeclaration, &tailleElement, &alignementElement);
                si (erreurTaille != ErreurAnalyseSemantique::Reussite)
                    retourner erreurTaille;
                naturel32 dimension = 0;
                tantque (dimension <= destination->ProfondeurTableau) {

                    naturel64 capacite = 0;
                    si (!LireDimensionNoeudSemantique(
                            etat, destination->IndexNoeudDeclaration, dimension, &capacite)
                        || capacite == 0)
                        retourner SignalerErreurSemantique(
                            etat, ErreurAnalyseSemantique::AstInvalide, indexExpression, 58);
                    tailleElement = tailleElement / capacite;
                    dimension = dimension + 1;
                }
                DestinationInitialiseurSemantique element = *destination;
                element.ProfondeurTableau = element.ProfondeurTableau + 1;
                naturel64 position = 0;
                tantque (position < nombre) {

                    ErreurAnalyseSemantique erreurElement = EmettreInitialiseurGlobalSemantique(
                        contexte,
                        TrouverEnfantDirectSemantique(etat, indexExpression, position),
                        &element, decalage + position * tailleElement);
                    si (erreurElement != ErreurAnalyseSemantique::Reussite)
                        retourner erreurElement;
                    position = position + 1;
                }
                retourner ErreurAnalyseSemantique::Reussite;
            }
            naturel64 type = TrouverTypeDepuisHachageSemantique(etat, destination->HachageElement, 0);
            si (type < etat->NombreSymboles
                && (etat->Requete->Noeuds[etat->SymbolesTravail[type].IndexNoeud].Genre == 4
                    || etat->Requete->Noeuds[etat->SymbolesTravail[type].IndexNoeud].Genre == 5)) {

                naturel64 positionChamp = 0;
                tantque (positionChamp < nombre) {

                    naturel64 champ = TrouverChampTypeAgregeSemantique(etat, type, positionChamp);
                    si (champ >= etat->NombreSymboles)
                        retourner SignalerErreurSemantique(
                            etat, ErreurAnalyseSemantique::AstInvalide, indexExpression, 59);
                    DestinationInitialiseurSemantique destinationChamp;
                    si (!InitialiserDestinationInitialiseurSemantique(
                            etat, etat->SymbolesTravail[champ].IndexNoeud, &destinationChamp))
                        retourner SignalerErreurSemantique(
                            etat, ErreurAnalyseSemantique::AstInvalide, indexExpression, 60);
                    destinationChamp.Globale = 1;
                    ErreurAnalyseSemantique erreurChamp = EmettreInitialiseurGlobalSemantique(
                        contexte,
                        TrouverEnfantDirectSemantique(etat, indexExpression, positionChamp),
                        &destinationChamp, decalage + etat->DecalagesChamps[champ]);
                    si (erreurChamp != ErreurAnalyseSemantique::Reussite)
                        retourner erreurChamp;
                    positionChamp = positionChamp + 1;
                }
                retourner ErreurAnalyseSemantique::Reussite;
            }
            si (nombre == 0)
                retourner ErreurAnalyseSemantique::Reussite;
            retourner EmettreInitialiseurGlobalSemantique(
                contexte,
                TrouverEnfantDirectSemantique(etat, indexExpression, 0),
                destination, decalage);
        }

        naturel64 tailleScalaire = 8;
        naturel64 bits = 0;
        naturel64 cibleFonction = etat->NombreSymboles;
        si (GenrePointeurFonctionDestinationGlobaleSemantique(etat, destination) == 1) {

            naturel64 reference = indexExpression;
            si (expression->Genre == 25)
                reference = TrouverEnfantDirectSemantique(etat, indexExpression, 0);
            cibleFonction = TrouverCibleSymboleExpressionSemantique(etat, reference);
            si (cibleFonction >= etat->NombreSymboles
                || etat->SymbolesTravail[cibleFonction].Genre != 2)
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::CiblePointeurFonctionGlobalInvalide,
                    indexExpression, 0);
        }
        sinon {

            ErreurAnalyseSemantique erreurValeur = EvaluerConstanteNumeriqueSemantique(
                etat, indexExpression, &bits);
            si (erreurValeur != ErreurAnalyseSemantique::Reussite)
                retourner erreurValeur;
            DescriptionTypeNumeriqueSemantique source;
            DescriptionTypeNumeriqueSemantique cible;
            si (!DecrireTypeNumeriqueSemantique(
                    etat, HachageTypeExpressionSemantique(etat, indexExpression), &source)
                || !DecrireTypeNumeriqueSemantique(etat, destination->HachageElement, &cible))
                retourner SignalerErreurSemantique(
                    etat, ErreurAnalyseSemantique::AstInvalide, indexExpression, 61);
            si (source.Signe != 0)
                bits = ConvertirSigneEnNaturelSemantique(
                    InterpreterSigneNumeriqueSemantique(bits, &source));
            bits = NormaliserValeurNumeriqueSemantique(bits, &cible);
            tailleScalaire = convertir<naturel64>(cible.Largeur / 8);
        }
        si (decalage > globale->Taille || tailleScalaire > globale->Taille - decalage)
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::AstInvalide, indexExpression, 62);
        si (cibleFonction < etat->NombreSymboles) {

            si (ecrire) {

                RelocalisationGlobale* relocalisation =
                    &sortie->Relocalisations[sortie->Resultat.NombreRelocalisations];
                relocalisation->IndexNoeudGlobale = globale->IndexNoeud;
                relocalisation->Decalage = decalage;
                relocalisation->IndexSymboleCible = cibleFonction;
                relocalisation->Genre = 1;
                relocalisation->Reserve = 0;
            }
            sortie->Resultat.NombreRelocalisations = sortie->Resultat.NombreRelocalisations + 1;
        }
        sinon si (ecrire) {

            naturel64 indexOctet = 0;
            tantque (indexOctet < tailleScalaire) {

                sortie->Donnees[globale->Decalage + decalage + indexOctet] =
                    convertir<octet>(bits & 255);
                bits = bits >> 8;
                indexOctet = indexOctet + 1;
            }
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    /**
     * <résumé>Dispose les globales dans deux zones indépendantes et alignées.</résumé>
     * @etc. Les imports sont omis. Les limites de 32 bits suivent le backend actuel.
     **/
    ErreurAnalyseSemantique ParcourirEmissionGlobalesSemantique(
        EtatAnalyseSemantique* etat,
        RequeteEmissionGlobales* sortie,
        booléen ecrire) {

        sortie->Resultat.NombreGlobales = 0;
        sortie->Resultat.NombreOctetsDonnees = 0;
        sortie->Resultat.NombreOctetsZero = 0;
        sortie->Resultat.NombreRelocalisations = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {

            SymboleSemantique* symbole = &etat->SymbolesTravail[index];
            constante NoeudDeclaration* noeud = &etat->Requete->Noeuds[symbole->IndexNoeud];
            si (symbole->Genre == 3 && (noeud->Drapeaux & 2) == 0) {

                GlobaleEmise globale;
                globale.IndexNoeud = symbole->IndexNoeud;
                globale.IndexSymbole = index;
                globale.Drapeaux = 0;
                globale.Reserve = 0;
                si ((noeud->Drapeaux & 1) != 0)
                    globale.Drapeaux = 2;
                ErreurAnalyseSemantique erreurTailleGlobale = CalculerTailleValeurSemantique(
                    etat, symbole->IndexNoeud, &globale.Taille, &globale.Alignement);
                si (erreurTailleGlobale != ErreurAnalyseSemantique::Reussite)
                    retourner erreurTailleGlobale;
                naturel64 positionZone = sortie->Resultat.NombreOctetsZero;
                si ((noeud->Drapeaux & 4) != 0) {

                    globale.Drapeaux = globale.Drapeaux | 1;
                    positionZone = sortie->Resultat.NombreOctetsDonnees;
                }
                globale.Decalage = AlignerDispositionSemantique(positionZone, globale.Alignement);
                si (globale.Decalage > 4_294_967_295
                    || globale.Taille > 4_294_967_295 - globale.Decalage)
                    retourner SignalerErreurSemantique(
                        etat, ErreurAnalyseSemantique::TailleObjetInvalide, symbole->IndexNoeud, 0);
                si ((globale.Drapeaux & 1) != 0) {

                    sortie->Resultat.NombreOctetsDonnees = globale.Decalage + globale.Taille;
                    DestinationInitialiseurSemantique destination;
                    si (!InitialiserDestinationInitialiseurSemantique(
                            etat, symbole->IndexNoeud, &destination))
                        retourner SignalerErreurSemantique(
                            etat, ErreurAnalyseSemantique::AstInvalide, symbole->IndexNoeud, 63);
                    ContexteEmissionGlobale contexte = {etat, sortie, &globale, ecrire};
                    ErreurAnalyseSemantique erreurInitialiseur = EmettreInitialiseurGlobalSemantique(
                        &contexte,
                        TrouverEnfantDirectSemantique(etat, symbole->IndexNoeud, 0),
                        &destination, 0);
                    si (erreurInitialiseur != ErreurAnalyseSemantique::Reussite)
                        retourner erreurInitialiseur;
                }
                sinon sortie->Resultat.NombreOctetsZero = globale.Decalage + globale.Taille;
                si (ecrire)
                    sortie->Globales[sortie->Resultat.NombreGlobales] = globale;
                sortie->Resultat.NombreGlobales = sortie->Resultat.NombreGlobales + 1;
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ProduireGlobalesSemantiques(
        EtatAnalyseSemantique* etat, RequeteEmissionGlobales* sortie) {

        ErreurAnalyseSemantique mesure = ParcourirEmissionGlobalesSemantique(etat, sortie, faux);
        si (mesure != ErreurAnalyseSemantique::Reussite)
            retourner mesure;
        si (sortie->CapaciteGlobales < sortie->Resultat.NombreGlobales)
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::CapaciteGlobalesInsuffisante, 0, 0);
        si (sortie->CapaciteDonnees < sortie->Resultat.NombreOctetsDonnees)
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::CapaciteDonneesGlobalesInsuffisante, 0, 0);
        si (sortie->CapaciteRelocalisations < sortie->Resultat.NombreRelocalisations)
            retourner SignalerErreurSemantique(
                etat, ErreurAnalyseSemantique::CapaciteRelocalisationsGlobalesInsuffisante, 0, 0);
        naturel64 indexZero = 0;
        tantque (indexZero < sortie->Resultat.NombreOctetsDonnees) {

            sortie->Donnees[indexZero] = 0;
            indexZero = indexZero + 1;
        }
        retourner ParcourirEmissionGlobalesSemantique(etat, sortie, vrai);
    }

    ErreurAnalyseSemantique AnalyserSemantiqueInterne(
        RequeteAnalyseSemantique* requete,
        RequeteEmissionGlobales* emission) {
        si (requete == NulRequetesAnalyseSemantique)
            retourner ErreurAnalyseSemantique::ArgumentInvalide;

        requete->Resultat.Erreur = ErreurAnalyseSemantique::Reussite;
        requete->Resultat.LigneErreur = 0;
        requete->Resultat.ColonneErreur = 0;
        requete->Resultat.Detail = 0;
        requete->Resultat.NombreSymboles = 0;
        requete->Resultat.CapaciteSymbolesRequise = 0;
        requete->Resultat.NombreResolutions = 0;
        requete->Resultat.CapaciteResolutionsRequise = 0;
        requete->Resultat.NombreOctetsArene = 0;

        EtatAnalyseSemantique etat;
        etat.Requete = requete;
        etat.ConstructeurChampActif = requete->NombreNoeuds;
        etat.SymbolesTravail = NulSymbolesSemantiques;
        etat.NombreSymboles = 0;
        etat.NombreResolutions = 0;
        etat.CiblesInitialiseurs = NulCiblesInitialiseursSemantiques;
        etat.CiblesExpressions = NulCiblesExpressionsSemantiques;
        etat.TypesConversionsImplicites = NulCiblesExpressionsSemantiques;
        etat.CiblesAliasesChamps = NulCiblesExpressionsSemantiques;
        etat.EtatsAliasesChamps = NulEtatsDispositionSemantique;
        etat.CiblesAliasesRacines = NulCiblesExpressionsSemantiques;
        etat.EtatsAliasesRacines = NulEtatsDispositionSemantique;
        etat.NombreAliasesRacines = 0;
        etat.NombreEspacesUtilises = 0;
        etat.NomsEspacesUtilises = NulNaturelsDispositionSemantique;
        etat.ParentsEspacesUtilises = NulNaturelsDispositionSemantique;
        etat.PositionsEspacesUtilises = NulNaturelsDispositionSemantique;
        etat.CiblesEspacesUtilises = NulNaturelsDispositionSemantique;
        etat.FileEspacesUtilises = NulNaturelsDispositionSemantique;
        etat.VisitesEspacesUtilises = NulEtatsDispositionSemantique;
        etat.JetonsTypes = NulJetonsTypesSemantiques;
        etat.NombreJetonsTypes = 0;
        etat.EspacesJetonsTypes = NulCiblesExpressionsSemantiques;
        etat.ErreurTypeDeclare = ErreurAnalyseSemantique::Reussite;
        etat.TypesComposes = NulDescriptionsTypesSemantiques;
        etat.NombreTypesComposes = 0;
        etat.ContextesNomsLiaison = NulContextesNomsLiaisonSemantiques;
        etat.EspacesNomsLiaisonJetons = NulNaturelsDispositionSemantique;
        etat.TypesBases = NulNaturelsDispositionSemantique;
        etat.TaillesTypes = NulNaturelsDispositionSemantique;
        etat.AlignementsTypes = NulNaturelsDispositionSemantique;
        etat.DecalagesChamps = NulNaturelsDispositionSemantique;
        etat.DecalagesTablesVirtuelles = NulNaturelsDispositionSemantique;
        etat.ValeursEnumerateurs = NulNaturelsDispositionSemantique;
        etat.ConstanteHorsPlage = 0;
        etat.EtatsDisposition = NulEtatsDispositionSemantique;
        etat.EtatsPolymorphisme = NulEtatsDispositionSemantique;
        etat.EtatsEnumerateurs = NulEtatsDispositionSemantique;
        GalacticShrine::GsPP::Hebergee::InitialiserArene(&etat.Arene, 4096);
        naturel64 index = 0;

        si (requete->Source == NulCaracteresSemantiques
            || (requete->CapaciteSymboles != 0
                && requete->Symboles == NulSymbolesSemantiques)
            || (requete->CapaciteResolutions != 0
                && requete->Resolutions == NulResolutionsSemantiques)) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::ArgumentInvalide, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        si (!ValiderAstSemantique(&etat)) {
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        si (requete->NombreNoeuds
            > 384_307_168_202_282_325) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        si (!InitialiserJetonsTypesSemantiques(&etat)) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        etat.SymbolesTravail = convertir<SymboleSemantique*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene,
                requete->NombreNoeuds * 48,
                8));
        si (etat.SymbolesTravail == NulSymbolesSemantiques) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        etat.CiblesInitialiseurs = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene,
                requete->NombreNoeuds * 8,
                8));
        si (etat.CiblesInitialiseurs
            == NulCiblesInitialiseursSemantiques) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        etat.CiblesExpressions = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene,
                requete->NombreNoeuds * 8,
                8));
        etat.TypesConversionsImplicites = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, requete->NombreNoeuds * 8, 8));
        si (etat.CiblesExpressions == NulCiblesExpressionsSemantiques
            || etat.TypesConversionsImplicites == NulCiblesExpressionsSemantiques) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        index = 0;
        tantque (index < requete->NombreNoeuds) {
            etat.CiblesInitialiseurs[index] = requete->NombreNoeuds;
            etat.CiblesExpressions[index] = requete->NombreNoeuds;
            etat.TypesConversionsImplicites[index] = 0;
            index = index + 1;
        }

        index = 0;
        tantque (index < requete->NombreNoeuds) {
            AjouterSymboleSemantique(&etat, index);
            index = index + 1;
        }
        requete->Resultat.NombreSymboles = etat.NombreSymboles;
        requete->Resultat.CapaciteSymbolesRequise = etat.NombreSymboles;

        etat.TypesBases = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.TaillesTypes = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.AlignementsTypes = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.DecalagesChamps = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.DecalagesTablesVirtuelles = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.ValeursEnumerateurs = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, requete->NombreNoeuds * 8, 8));
        etat.EtatsDisposition = convertir<octet*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles, 1));
        etat.EtatsPolymorphisme = convertir<octet*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles, 1));
        etat.CiblesAliasesChamps = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.EtatsAliasesChamps = convertir<octet*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles, 1));
        etat.CiblesAliasesRacines = convertir<naturel64*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles * 8, 8));
        etat.EtatsAliasesRacines = convertir<octet*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, etat.NombreSymboles, 1));
        etat.EtatsEnumerateurs = convertir<octet*>(
            GalacticShrine::GsPP::Hebergee::AllouerArene(
                &etat.Arene, requete->NombreNoeuds, 1));
        si (etat.TypesBases == NulNaturelsDispositionSemantique
            || etat.TaillesTypes == NulNaturelsDispositionSemantique
            || etat.AlignementsTypes == NulNaturelsDispositionSemantique
            || etat.DecalagesChamps == NulNaturelsDispositionSemantique
            || etat.DecalagesTablesVirtuelles
                == NulNaturelsDispositionSemantique
            || etat.ValeursEnumerateurs
                == NulNaturelsDispositionSemantique
            || etat.EtatsDisposition == NulEtatsDispositionSemantique
            || etat.EtatsPolymorphisme == NulEtatsDispositionSemantique
            || etat.CiblesAliasesChamps == NulCiblesExpressionsSemantiques
            || etat.EtatsAliasesChamps == NulEtatsDispositionSemantique
            || etat.CiblesAliasesRacines == NulCiblesExpressionsSemantiques
            || etat.EtatsAliasesRacines == NulEtatsDispositionSemantique
            || etat.EtatsEnumerateurs == NulEtatsDispositionSemantique) {
            SignalerErreurSemantique(
                &etat, ErreurAnalyseSemantique::AllocationImpossible, 0, 0);
            GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
            retourner requete->Resultat.Erreur;
        }
        index = 0;
        tantque (index < etat.NombreSymboles) {
            etat.TypesBases[index] = etat.NombreSymboles;
            etat.TaillesTypes[index] = 0;
            etat.AlignementsTypes[index] = 0;
            etat.DecalagesChamps[index] = 0;
            etat.DecalagesTablesVirtuelles[index] = 0;
            etat.EtatsDisposition[index] = 0;
            etat.EtatsPolymorphisme[index] = 0;
            etat.CiblesAliasesChamps[index] = etat.NombreSymboles;
            etat.EtatsAliasesChamps[index] = 0;
            etat.CiblesAliasesRacines[index] = etat.NombreSymboles;
            etat.EtatsAliasesRacines[index] = 0;
            index = index + 1;
        }
        index = 0;
        tantque (index < requete->NombreNoeuds) {
            etat.ValeursEnumerateurs[index] = 0;
            etat.EtatsEnumerateurs[index] = 0;
            index = index + 1;
        }

        RequeteAnalyseSemantique* requetePublique = requete;
        RequeteAnalyseSemantique requetePrivee = *requete;
        requete = &requetePrivee;
        etat.Requete = requete;
        ErreurAnalyseSemantique erreur = VerifierConflitsRacinesSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = InitialiserPorteesNommeesSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = CalculerEnumerationsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite && etat.NombreAliasesRacines != 0)
            erreur = ResoudreAliasesRacinesSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ResoudreHeritageSemantique(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ResoudreTypesDeclaresSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = VerifierConflitsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderAritesOperateursSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderSignaturesFonctionsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = CalculerDispositionsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderDoublonsSurchargesSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderCollisionsSymbolesFonctionsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderRemplacementsVirtuelsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderChampsParDefautSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ResoudreExpressionsDeclarationsSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = VerifierCyclesDelegationConstructeurSemantique(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite)
            erreur = ValiderInitialiseursAgregesSemantiques(&etat);
        si (erreur == ErreurAnalyseSemantique::Reussite
            && emission != NulRequetesEmissionGlobales)
            erreur = ProduireGlobalesSemantiques(&etat, emission);

        requete->Resultat.NombreResolutions = etat.NombreResolutions;
        requete->Resultat.CapaciteResolutionsRequise = etat.NombreResolutions;
        requete->Resultat.NombreOctetsArene = etat.Arene.NombreOctets;

        naturel64 nombreCopie = etat.NombreSymboles;
        si (nombreCopie > requete->CapaciteSymboles)
            nombreCopie = requete->CapaciteSymboles;
        index = 0;
        tantque (index < nombreCopie) {
            requete->Symboles[index] = etat.SymbolesTravail[index];
            index = index + 1;
        }

        si (erreur == ErreurAnalyseSemantique::Reussite
            && emission == NulRequetesEmissionGlobales
            && requete->CapaciteSymboles < etat.NombreSymboles)
            erreur = SignalerErreurSemantique(
                &etat,
                ErreurAnalyseSemantique::CapaciteSymbolesInsuffisante,
                0,
                convertir<naturel32>(etat.NombreSymboles));
        sinon si (erreur == ErreurAnalyseSemantique::Reussite
            && emission == NulRequetesEmissionGlobales
            && requete->CapaciteResolutions < etat.NombreResolutions)
            erreur = SignalerErreurSemantique(
                &etat,
                ErreurAnalyseSemantique::CapaciteResolutionsInsuffisante,
                0,
                convertir<naturel32>(etat.NombreResolutions));

        requetePublique->Resultat = requete->Resultat;
        GalacticShrine::GsPP::Hebergee::DetruireArene(&etat.Arene);
        retourner erreur;
    }

    publique ErreurAnalyseSemantique AnalyserSemantique(RequeteAnalyseSemantique* requete) {

        retourner AnalyserSemantiqueInterne(requete, NulRequetesEmissionGlobales);
    }

    publique ErreurAnalyseSemantique EmettreGlobales(RequeteEmissionGlobales* requete) {

        si (requete == NulRequetesEmissionGlobales)
            retourner ErreurAnalyseSemantique::ArgumentInvalide;
        ResultatEmissionGlobales resultatVide = {};
        requete->Resultat = resultatVide;
        si ((requete->CapaciteGlobales != 0 && requete->Globales == NulGlobalesEmises)
            || (requete->CapaciteDonnees != 0 && requete->Donnees == NulEtatsDispositionSemantique)
            || (requete->CapaciteRelocalisations != 0
                && requete->Relocalisations == NulRelocalisationsGlobales)) {

            requete->Resultat.Erreur = ErreurAnalyseSemantique::ArgumentInvalide;
            retourner requete->Resultat.Erreur;
        }
        RequeteAnalyseSemantique analyse = {};
        analyse.Source = requete->Source;
        analyse.TailleSource = requete->TailleSource;
        analyse.Noeuds = requete->Noeuds;
        analyse.NombreNoeuds = requete->NombreNoeuds;
        ErreurAnalyseSemantique erreur = AnalyserSemantiqueInterne(&analyse, requete);
        requete->Resultat.Erreur = erreur;
        requete->Resultat.LigneErreur = analyse.Resultat.LigneErreur;
        requete->Resultat.ColonneErreur = analyse.Resultat.ColonneErreur;
        requete->Resultat.Detail = analyse.Resultat.Detail;
        requete->Resultat.NombreOctetsArene = analyse.Resultat.NombreOctetsArene;
        retourner erreur;
    }
}
