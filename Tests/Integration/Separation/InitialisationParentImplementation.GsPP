publique entier32 TraceParentSepare = 0;

classe BaseParentSepare
{
    protégée:
        entier32 Valeur;

    publique:
        constructeur(entier32 initiale)
        {
            soi.Valeur = initiale;
            TraceParentSepare = TraceParentSepare * 10 + 1;
        }

        virtuel entier32 Lire()
        {
            retourner soi.Valeur;
        }

        virtuel destructeur()
        {
            TraceParentSepare = TraceParentSepare * 10 + 4;
        }
};

classe DeriveeParentSepare : publique BaseParentSepare
{
    privée:
        entier32 Bonus;

    publique:
        constructeur(entier32 initiale, entier32 bonus)
            : parent(initiale)
        {
            soi.Bonus = bonus;
            TraceParentSepare = TraceParentSepare * 10 + 2;
        }

        remplacer entier32 Lire()
        {
            retourner parent.Lire() + soi.Bonus;
        }

        entier32 LireParent()
        {
            retourner parent.Lire();
        }

        remplacer destructeur()
        {
            TraceParentSepare = TraceParentSepare * 10 + 3;
        }
};

publique entier32 EvaluerParent(BaseParentSepare& valeur)
{
    retourner valeur.Lire();
}
