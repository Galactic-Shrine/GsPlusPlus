espace GalacticShrine::GsPP::Hebergee {

    octet* NulOctetsConteneur;
    naturel64* NulNaturelsConteneur;
    EntreeTableSymboles* NulEntreesConteneur;

    /**
     * @retourne Un pointeur nul pour les octets conteneur.
     **/
    octet* PointeurNulOctetsConteneur() {

        retourner NulOctetsConteneur;
    }

    /**
     * @retourne Un pointeur nul pour les naturels conteneur.
     **/
    naturel64* PointeurNulNaturelsConteneur() {

        retourner NulNaturelsConteneur;
    }

    /**
     * @retourne Un pointeur nul pour les entrées de table de symboles.
     **/
    EntreeTableSymboles* PointeurNulEntreesConteneur() {

        retourner NulEntreesConteneur;
    }

    /**
     * Calcule la prochaine capacité de conteneur supérieure ou égale à la capacité requise.
     * @param actuelle La capacité actuelle du conteneur.
     * @param requise La capacité requise pour le conteneur.
     * @retourne La prochaine capacité de conteneur supérieure ou égale à la capacité requise.
     **/
    naturel64 CapaciteSuivanteConteneur(naturel64 actuelle, naturel64 requise) {

        naturel64 resultat = actuelle;

        si (resultat < 8)
            resultat = 8;

        tantque (resultat < requise) {

            si (resultat > 9_223_372_036_854_775_807)
                retourner requise;

            resultat = resultat * 2;
        }

        retourner resultat;
    }

    /**
     * Initialise un vecteur d'octets dynamique.
     * @param vecteur Le vecteur d'octets dynamique à initialiser.
     **/
    publique vide InitialiserVecteurOctetsDynamique(VecteurOctetsDynamique* vecteur) {

        vecteur->Donnees = PointeurNulOctetsConteneur();
        vecteur->Taille = 0;
        vecteur->Capacite = 0;
    }

    /**
     * Détruit un vecteur d'octets dynamique.
     * @param vecteur Le vecteur d'octets dynamique à détruire.
     **/
    publique vide DetruireVecteurOctetsDynamique(VecteurOctetsDynamique* vecteur) {

        si (vecteur->Donnees) 
            GalacticShrine::GsPP::Hote::LibererMemoire(vecteur->Donnees);

        InitialiserVecteurOctetsDynamique(vecteur);
    }

    /**
     * Réserve de la mémoire pour un vecteur d'octets dynamique.
     * @param vecteur Le vecteur d'octets dynamique pour lequel réserver de la mémoire.
     * @param capacite La capacité à réserver pour le vecteur d'octets dynamique.
     * @retourne Un code d'erreur hébergé indiquant le succès ou l'échec de l'opération.
     **/
    publique CodeErreurHebergee ReserverVecteurOctetsDynamique(VecteurOctetsDynamique* vecteur, naturel64 capacite) {

        si (capacite <= vecteur->Capacite)
            retourner CodeErreurHebergee::Reussite;

        octet* nouveau = GalacticShrine::GsPP::Hote::AllouerMemoire(capacite);

        si (!nouveau) 
            retourner CodeErreurHebergee::AllocationEchouee;

        naturel64 index = 0;

        tantque (index < vecteur->Taille) {

            nouveau[index] = vecteur->Donnees[index];
            index = index + 1;
        }

        octet* ancien = vecteur->Donnees;
        vecteur->Donnees = nouveau;
        vecteur->Capacite = capacite;

        si (ancien)
            GalacticShrine::GsPP::Hote::LibererMemoire(ancien);

        retourner CodeErreurHebergee::Reussite;
    }
    
    /**
     * Ajoute un bloc d'octets à un vecteur d'octets dynamique.
     * @param vecteur Le vecteur d'octets dynamique auquel ajouter le bloc d'octets.
     * @param source Le bloc d'octets à ajouter au vecteur.
     * @param taille La taille du bloc d'octets à ajouter.
     * @retourne Un code d'erreur hébergé indiquant le succès ou l'échec de l'opération.
     **/
    publique CodeErreurHebergee AjouterBlocVecteurOctetsDynamique(VecteurOctetsDynamique* vecteur, octet* source, naturel64 taille) {

        si (taille == 0) 
            retourner CodeErreurHebergee::Reussite;

        si (!source) 
            retourner CodeErreurHebergee::ArgumentInvalide;

        si (taille > 18_446_744_073_709_551_615 - vecteur->Taille)
            retourner CodeErreurHebergee::CapaciteDepassee;

        naturel64 requise = vecteur->Taille + taille;

        si (requise <= vecteur->Capacite) {

            naturel64 indexDirect = 0;

            tantque (indexDirect < taille) {

                vecteur->Donnees[vecteur->Taille + indexDirect] = source[indexDirect];
                indexDirect = indexDirect + 1;
            }

            vecteur->Taille = requise;

            retourner CodeErreurHebergee::Reussite;
        }

        naturel64 capacite = CapaciteSuivanteConteneur(vecteur->Capacite, requise);
        octet* nouveau = GalacticShrine::GsPP::Hote::AllouerMemoire(capacite);

        si (!nouveau) 
            retourner CodeErreurHebergee::AllocationEchouee;

        naturel64 indexAncien = 0;

        tantque (indexAncien < vecteur->Taille) {

            nouveau[indexAncien] = vecteur->Donnees[indexAncien];
            indexAncien = indexAncien + 1;
        }

        naturel64 indexSource = 0;

        tantque (indexSource < taille) {

            nouveau[vecteur->Taille + indexSource] = source[indexSource];
            indexSource = indexSource + 1;
        }

        octet* ancien = vecteur->Donnees;
        vecteur->Donnees = nouveau;
        vecteur->Taille = requise;
        vecteur->Capacite = capacite;

        si (ancien) 
            GalacticShrine::GsPP::Hote::LibererMemoire(ancien);

        retourner CodeErreurHebergee::Reussite;
    }

    /**
     * Initialise un vecteur de naturels dynamique.
     * @param vecteur Le vecteur de naturels dynamique à initialiser.
     **/
    publique vide InitialiserVecteurNaturelsDynamique(VecteurNaturelsDynamique* vecteur) {

        vecteur->Donnees = PointeurNulNaturelsConteneur();
        vecteur->Taille = 0;
        vecteur->Capacite = 0;
    }

    /**
     * Détruit un vecteur de naturels dynamique.
     * @param vecteur Le vecteur de naturels dynamique à détruire.
     **/
    publique vide DetruireVecteurNaturelsDynamique(VecteurNaturelsDynamique* vecteur) {

        si (vecteur->Donnees)
            GalacticShrine::GsPP::Hote::LibererMemoire(convertir<octet*>(vecteur->Donnees));

        InitialiserVecteurNaturelsDynamique(vecteur);
    }

    /**
     * Réserve de la mémoire pour un vecteur de naturels dynamique.
     * @param vecteur Le vecteur de naturels dynamique pour lequel réserver de la mémoire.
     * @param capacite La capacité à réserver pour le vecteur de naturels dynamique.
     * @retourne Un code d'erreur hébergé indiquant le succès ou l'échec de l'opération.
     **/
    publique CodeErreurHebergee ReserverVecteurNaturelsDynamique(VecteurNaturelsDynamique* vecteur, naturel64 capacite) {

        si (capacite <= vecteur->Capacite)
            retourner CodeErreurHebergee::Reussite;

        si (capacite > 2_305_843_009_213_693_951)
            retourner CodeErreurHebergee::CapaciteDepassee;

        octet* brut = GalacticShrine::GsPP::Hote::AllouerMemoire(capacite * 8);

        si (!brut) 
            retourner CodeErreurHebergee::AllocationEchouee;

        naturel64* nouveau = convertir<naturel64*>(brut);
        naturel64 index = 0;

        tantque (index < vecteur->Taille) {

            nouveau[index] = vecteur->Donnees[index];
            index = index + 1;
        }

        naturel64* ancien = vecteur->Donnees;
        vecteur->Donnees = nouveau;
        vecteur->Capacite = capacite;

        si (ancien) 
            GalacticShrine::GsPP::Hote::LibererMemoire(convertir<octet*>(ancien));

        retourner CodeErreurHebergee::Reussite;
    }

    /**
     * Ajoute un naturel à un vecteur de naturels dynamique.
     * @param vecteur Le vecteur de naturels dynamique auquel ajouter le naturel.
     * @param valeur Le naturel à ajouter au vecteur.
     * @retourne Un code d'erreur hébergé indiquant le succès ou l'échec de l'opération.
     **/
    publique CodeErreurHebergee AjouterVecteurNaturelsDynamique(VecteurNaturelsDynamique* vecteur, naturel64 valeur) {

        si (vecteur->Taille == 18_446_744_073_709_551_615)
            retourner CodeErreurHebergee::CapaciteDepassee;

        naturel64 requise = vecteur->Taille + 1;

        si (requise > vecteur->Capacite) {

            naturel64 capacite = CapaciteSuivanteConteneur(vecteur->Capacite, requise);
            CodeErreurHebergee resultat = ReserverVecteurNaturelsDynamique(vecteur, capacite);

            si (resultat != CodeErreurHebergee::Reussite)
                retourner resultat;
        }

        vecteur->Donnees[vecteur->Taille] = valeur;
        vecteur->Taille = requise;

        retourner CodeErreurHebergee::Reussite;
    }

    /**
     * Lit un naturel à partir d'un vecteur de naturels dynamique.
     * @param vecteur Le vecteur de naturels dynamique à partir duquel lire le naturel.
     * @param index L'index du naturel à lire dans le vecteur.
     * @param valeur Un pointeur vers la variable où stocker le naturel lu.
     * @retourne Vrai si la lecture a réussi, faux sinon.
     **/
    publique booléen LireVecteurNaturelsDynamique(VecteurNaturelsDynamique* vecteur, naturel64 index, naturel64* valeur) {

        si (index >= vecteur->Taille) 
            retourner faux;

        *valeur = vecteur->Donnees[index];

        retourner vrai;
    }
    
    /**
     * Trouve une entrée dans une table de symboles dynamique.
     * @param table La table de symboles dynamique dans laquelle chercher l'entrée.
     * @param cle La clé de l'entrée à chercher.
     * @retourne Un pointeur vers l'entrée trouvée, ou un pointeur nul si l'entrée n'est pas trouvée.
     **/
    EntreeTableSymboles* TrouverEntreeDynamique(TableSymbolesDynamique* table, VueTexte cle) {

        si (table->Capacite == 0 || cle.Taille == 0)
            retourner PointeurNulEntreesConteneur();

        naturel64 position = HacherVueTexte(cle) % table->Capacite;
        naturel64 examines = 0;

        tantque (examines < table->Capacite) {

            EntreeTableSymboles* entree = &table->Entrees[position];

            si (!entree->Occupee) 
                retourner PointeurNulEntreesConteneur();

            si (VuesTexteEgales(entree->Cle, cle)) 
                retourner entree;

            position = (position + 1) % table->Capacite;
            examines = examines + 1;
        }

        retourner PointeurNulEntreesConteneur();
    }

    /**
     * Insère une entrée dans une table de symboles dynamique sans croissance.
     * @param table La table de symboles dynamique dans laquelle insérer l'entrée.
     * @param cle La clé de l'entrée à insérer.
     * @param valeur La valeur de l'entrée à insérer.
     * @retourne Vrai si l'insertion a réussi, faux sinon.
     **/
    booléen InsererEntreeDynamiqueSansCroissance(TableSymbolesDynamique* table, VueTexte cle, naturel64 valeur) {

        naturel64 position = HacherVueTexte(cle) % table->Capacite;
        naturel64 examines = 0;

        tantque (examines < table->Capacite) {

            EntreeTableSymboles* entree = &table->Entrees[position];

            si (!entree->Occupee) {

                entree->Cle = cle;
                entree->Valeur = valeur;
                entree->Occupee = vrai;
                table->Nombre = table->Nombre + 1;

                retourner vrai;
            }

            position = (position + 1) % table->Capacite;
            examines = examines + 1;
        }

        retourner faux;
    }

    /**
     * Initialise une table de symboles dynamique.
     * @param table La table de symboles dynamique à initialiser.
     **/
    publique vide InitialiserTableSymbolesDynamique(TableSymbolesDynamique* table) {

        table->Entrees = PointeurNulEntreesConteneur();
        table->Capacite = 0;
        table->Nombre = 0;
    }

    /**
     * Détruit une table de symboles dynamique.
     * @param table La table de symboles dynamique à détruire.
     **/
    publique vide DetruireTableSymbolesDynamique(TableSymbolesDynamique* table) {

        si (table->Entrees)
            GalacticShrine::GsPP::Hote::LibererMemoire(convertir<octet*>(table->Entrees));

        InitialiserTableSymbolesDynamique(table);
    }

    /**
     * Réserve de la mémoire pour une table de symboles dynamique.
     * @param table La table de symboles dynamique pour laquelle réserver de la mémoire.
     * @param capacite La capacité à réserver pour la table de symboles dynamique.
     * @retourne Un code d'erreur hébergé indiquant le succès ou l'échec de l'opération.
     **/
    publique CodeErreurHebergee ReserverTableSymbolesDynamique(TableSymbolesDynamique* table, naturel64 capacite) {

        si (capacite <= table->Capacite)
            retourner CodeErreurHebergee::Reussite;

        si (capacite < table->Nombre)
            retourner CodeErreurHebergee::CapaciteDepassee;

        si (capacite > 576_460_752_303_423_487)
            retourner CodeErreurHebergee::CapaciteDepassee;

        octet* brut = GalacticShrine::GsPP::Hote::AllouerMemoire(capacite * 32);

        si (!brut) 
            retourner CodeErreurHebergee::AllocationEchouee;

        TableSymbolesDynamique nouvelle = {

            convertir<EntreeTableSymboles*>(brut), 
            capacite, 
            0
        };
        naturel64 indexVide = 0;

        tantque (indexVide < capacite) {

            nouvelle.Entrees[indexVide].Occupee = faux;
            indexVide = indexVide + 1;
        }
        naturel64 indexAncien = 0;

        tantque (indexAncien < table->Capacite) {

            si (table->Entrees[indexAncien].Occupee) {

                InsererEntreeDynamiqueSansCroissance(&nouvelle, table->Entrees[indexAncien].Cle, table->Entrees[indexAncien].Valeur);
            }

            indexAncien = indexAncien + 1;
        }

        EntreeTableSymboles* anciennes = table->Entrees;
        table->Entrees = nouvelle.Entrees;
        table->Capacite = nouvelle.Capacite;
        table->Nombre = nouvelle.Nombre;

        si (anciennes)
            GalacticShrine::GsPP::Hote::LibererMemoire(convertir<octet*>(anciennes));

        retourner CodeErreurHebergee::Reussite;
    }

    /**
     * Insère une entrée dans une table de symboles dynamique.
     * @param table La table de symboles dynamique dans laquelle insérer l'entrée.
     * @param cle La clé de l'entrée à insérer.
     * @param valeur La valeur de l'entrée à insérer.
     * @retourne Un code d'erreur hébergé indiquant le succès ou l'échec de l'opération.
     **/
    publique CodeErreurHebergee InsererTableSymbolesDynamique(TableSymbolesDynamique* table, VueTexte cle, naturel64 valeur) {

        si (cle.Taille == 0 || !cle.Donnees)
            retourner CodeErreurHebergee::ArgumentInvalide;

        EntreeTableSymboles* existante = TrouverEntreeDynamique(table, cle);

        si (existante) {

            existante->Valeur = valeur;

            retourner CodeErreurHebergee::Reussite;
        }

        naturel64 requise = table->Nombre + 1;

        si (table->Capacite == 0 || requise > table->Capacite - table->Capacite / 4) {

            naturel64 capacite = CapaciteSuivanteConteneur(table->Capacite, table->Capacite + 1);
            CodeErreurHebergee resultat = ReserverTableSymbolesDynamique(table, capacite);

            si (resultat != CodeErreurHebergee::Reussite)
                retourner resultat;
        }

        si (!InsererEntreeDynamiqueSansCroissance(table, cle, valeur))
            retourner CodeErreurHebergee::CapaciteDepassee;

        retourner CodeErreurHebergee::Reussite;
    }

    /**
     * Cherche une entrée dans une table de symboles dynamique.
     * @param table La table de symboles dynamique dans laquelle chercher l'entrée.
     * @param cle La clé de l'entrée à chercher.
     * @param valeur Un pointeur vers la variable où stocker la valeur trouvée.
     * @retourne Vrai si l'entrée a été trouvée, faux sinon.
     **/
    publique booléen ChercherTableSymbolesDynamique(TableSymbolesDynamique* table, VueTexte cle, naturel64* valeur) {

        EntreeTableSymboles* entree = TrouverEntreeDynamique(table, cle);

        si (!entree) 
            retourner faux;

        *valeur = entree->Valeur;

        retourner vrai;
    }
}
