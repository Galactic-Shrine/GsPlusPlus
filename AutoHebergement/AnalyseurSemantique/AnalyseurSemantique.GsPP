        EtatAnalyseSemantique* etat, naturel64 indexMembre);

    naturel64 HacherOperateurExpressionSemantique(
        octet premier, octet second) {
        naturel64 hachage = AjouterOctetSemantique(
            HachageVideSemantique(), premier);
        si (second != 0)
            hachage = AjouterOctetSemantique(hachage, second);
        retourner hachage;
    }

    booléen EstOperateurComparaisonExpressionSemantique(
        constante NoeudDeclaration* expression) {
        naturel64 nom = expression->HachageNom;
        retourner nom == HacherOperateurExpressionSemantique(61, 61)
            || nom == HacherOperateurExpressionSemantique(33, 61)
            || nom == HacherOperateurExpressionSemantique(60, 0)
            || nom == HacherOperateurExpressionSemantique(60, 61)
            || nom == HacherOperateurExpressionSemantique(62, 0)
            || nom == HacherOperateurExpressionSemantique(62, 61);
    }

    booléen EstOperateurLogiqueExpressionSemantique(
        constante NoeudDeclaration* expression) {
        naturel64 nom = expression->HachageNom;
        retourner nom == HacherOperateurExpressionSemantique(33, 0)
            || nom == HacherOperateurExpressionSemantique(38, 38)
            || nom == HacherOperateurExpressionSemantique(124, 124);
    }

    booléen EstOperateurDecalageExpressionSemantique(
        constante NoeudDeclaration* expression) {
        naturel64 nom = expression->HachageNom;
        retourner nom == HacherOperateurExpressionSemantique(60, 60)
            || nom == HacherOperateurExpressionSemantique(62, 62);
    }

    externe booléen LitteralExpressionCompatibleTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 hachageType);

    naturel64 HachageTypeOperateurIntrinsequeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        constante NoeudDeclaration* expressionOperateurType =
            &etat->Requete->Noeuds[indexExpression];
        si (EstOperateurComparaisonExpressionSemantique(
                expressionOperateurType)
            || EstOperateurLogiqueExpressionSemantique(
                expressionOperateurType))
            retourner HacherTypeSimpleSemantique(9, 0, 0);

        naturel64 operandeGaucheType = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        naturel64 hachageGaucheType = HachageTypeExpressionSemantique(
            etat, operandeGaucheType);
        si (expressionOperateurType->Genre == 25) {
            naturel64 operateurAdresseType =
                HacherOperateurExpressionSemantique(38, 0);
            naturel64 operateurDereferencementType =
                HacherOperateurExpressionSemantique(42, 0);
            si (expressionOperateurType->HachageNom
                == operateurAdresseType) {
                naturel64 symboleOperandeAdresseType =
                    TrouverCibleSymboleExpressionSemantique(
                        etat, operandeGaucheType);
                si (symboleOperandeAdresseType < etat->NombreSymboles
                    && etat->SymbolesTravail[
                        symboleOperandeAdresseType].Genre == 2)
                    retourner hachageGaucheType;
                retourner TransformerPointeurTypeSemantique(
                    etat,
                    hachageGaucheType,
                    TrouverOrigineTypeExpressionSemantique(
                        etat, operandeGaucheType),
                    vrai);
            }
            si (expressionOperateurType->HachageNom
                == operateurDereferencementType)
                retourner TransformerPointeurTypeSemantique(
                    etat,
                    hachageGaucheType,
                    TrouverOrigineTypeExpressionSemantique(
                        etat, operandeGaucheType),
                    faux);
            naturel64 operateurMoinsType =
                HacherOperateurExpressionSemantique(45, 0);
            si (expressionOperateurType->HachageNom == operateurMoinsType
                && operandeGaucheType < etat->Requete->NombreNoeuds
                && etat->Requete->Noeuds[operandeGaucheType].Genre == 22
                && etat->Requete->Noeuds[operandeGaucheType].HachageType
                    == 9_223_372_036_854_775_808)
                retourner HacherTypeSimpleSemantique(4, 0, 0);
            retourner SansQualificatifsValeurSemantique(
                etat, hachageGaucheType);
        }

        naturel64 operandeDroiteType = TrouverEnfantDirectSemantique(
            etat, indexExpression, 1);
        naturel64 hachageDroiteType = HachageTypeExpressionSemantique(
            etat, operandeDroiteType);
        si (!EstOperateurDecalageExpressionSemantique(
                expressionOperateurType)
            && !TypesValeurEgauxSemantique(
                etat, hachageGaucheType, hachageDroiteType)) {
            naturel64 cibleGaucheType =
                SansQualificatifsValeurSemantique(
                    etat, hachageDroiteType);
            naturel64 cibleDroiteType =
                SansQualificatifsValeurSemantique(
                    etat, hachageGaucheType);
            si (LitteralExpressionCompatibleTypeSemantique(
                    etat, operandeGaucheType, cibleGaucheType))
                hachageGaucheType = cibleGaucheType;
            sinon si (LitteralExpressionCompatibleTypeSemantique(
                    etat, operandeDroiteType, cibleDroiteType))
                hachageDroiteType = cibleDroiteType;
        }
        retourner SansQualificatifsValeurSemantique(
            etat, hachageGaucheType);
    }

    naturel64 HachageTypeAppelSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexAppel) {
        naturel64 cibleAppelType = TrouverEnfantDirectSemantique(
            etat, indexAppel, 0);
        naturel64 symboleCibleAppel = TrouverCibleSymboleExpressionSemantique(
            etat, cibleAppelType);
        si (symboleCibleAppel < etat->NombreSymboles
            && etat->SymbolesTravail[symboleCibleAppel].Genre == 2)
            retourner SansReferenceTypeSemantique(
                etat,
                etat->SymbolesTravail[symboleCibleAppel].HachageType);

        naturel64 typeCibleAppel = HachageTypeExpressionSemantique(
            etat, cibleAppelType);
        naturel64 origineCibleAppel =
            TrouverOrigineTypeExpressionSemantique(
                etat, cibleAppelType);
        naturel64 symboleOrigineCibleAppel =
            TrouverSymboleNoeudSemantique(
                etat, origineCibleAppel, 2);
        si (symboleOrigineCibleAppel < etat->NombreSymboles
            && typeCibleAppel
                == HacherPointeurFonctionDeclarationSemantique(
                    etat, origineCibleAppel))
            retourner SansReferenceTypeSemantique(
                etat,
                etat->SymbolesTravail[
                    symboleOrigineCibleAppel].HachageType);
        naturel64 retourCibleAppel = 0;
        si (LireRetourPointeurFonctionNoeudSemantique(
                etat,
                origineCibleAppel,
                typeCibleAppel,
                &retourCibleAppel))
            retourner SansReferenceTypeSemantique(
                etat, retourCibleAppel);
        retourner 0;
    }

    naturel64 HachageTypeExpressionSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner 0;
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];

        si (expression->Genre == 22) {
            si ((expression->Drapeaux & 16_384) != 0)
                retourner HacherTypeSimpleSemantique(9, 0, 0);
            si (expression->HachageType <= 2_147_483_647)
                retourner HacherTypeSimpleSemantique(3, 0, 0);
            si (expression->HachageType
                <= 9_223_372_036_854_775_807)
                retourner HacherTypeSimpleSemantique(4, 0, 0);
            retourner HacherTypeSimpleSemantique(8, 0, 0);
        }
        si (expression->Genre == 23)
            retourner HacherTypeSimpleSemantique(11, 1, 1);
        si (expression->Genre == 24)
            retourner HachageTypeReferenceSemantique(
                etat, indexExpression);
        si (expression->Genre == 28)
            retourner HachageTypeAppelSemantique(etat, indexExpression);
        si (expression->Genre == 29) {
            naturel64 cibleSymboleMembre =
                TrouverCibleSymboleExpressionSemantique(
                    etat, indexExpression);
            si (cibleSymboleMembre < etat->NombreSymboles
                && etat->SymbolesTravail[cibleSymboleMembre].Genre == 2)
                retourner HacherPointeurFonctionDeclarationSemantique(
                    etat,
                    etat->SymbolesTravail[cibleSymboleMembre].IndexNoeud);
            naturel64 typeResolutionMembre =
                HachageTypeResolutionExpressionSemantique(
                    etat, indexExpression);
            si (typeResolutionMembre != 0) retourner typeResolutionMembre;
            retourner HachageTypeMembreSemantique(
                etat, indexExpression);
        }
        si (expression->Genre == 31)
            retourner expression->HachageType;
        si (expression->Genre == 30)
            retourner HachageTypeIndexationSemantique(
                etat, indexExpression);
        si (expression->Genre == 25 || expression->Genre == 26) {
            naturel64 typeResolutionOperateur =
                HachageTypeResolutionExpressionSemantique(
                    etat, indexExpression);
            si (typeResolutionOperateur != 0)
                retourner typeResolutionOperateur;
            retourner HachageTypeOperateurIntrinsequeSemantique(
                etat, indexExpression);
        }
        si (expression->Genre == 27) {
            naturel64 enfant = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner HachageTypeExpressionSemantique(etat, enfant);
        }
        retourner 0;
    }

    booléen LitteralCompatibleTypeSemantique(
        constante NoeudDeclaration* argument, naturel64 hachageType) {
        si (argument->Genre != 22
            || (argument->Drapeaux & 16_384) != 0)
            retourner faux;
        naturel64 valeur = argument->HachageType;
        si (hachageType == HacherTypeSimpleSemantique(1, 0, 0))
            retourner valeur <= 127;
        si (hachageType == HacherTypeSimpleSemantique(2, 0, 0))
            retourner valeur <= 32_767;
        si (hachageType == HacherTypeSimpleSemantique(3, 0, 0))
            retourner valeur <= 2_147_483_647;
        si (hachageType == HacherTypeSimpleSemantique(4, 0, 0))
            retourner valeur <= 9_223_372_036_854_775_807;
        si (hachageType == HacherTypeSimpleSemantique(5, 0, 0))
            retourner valeur <= 255;
        si (hachageType == HacherTypeSimpleSemantique(6, 0, 0))
            retourner valeur <= 65_535;
        si (hachageType == HacherTypeSimpleSemantique(7, 0, 0))
            retourner valeur <= 4_294_967_295;
        si (hachageType == HacherTypeSimpleSemantique(8, 0, 0))
            retourner vrai;
        si (hachageType == HacherTypeSimpleSemantique(10, 0, 0)
            || hachageType == HacherTypeSimpleSemantique(11, 0, 0))
            retourner valeur <= 255;
        retourner faux;
    }

    booléen LitteralExpressionCompatibleTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 hachageType) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner faux;
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        si (LitteralCompatibleTypeSemantique(expression, hachageType))
            retourner vrai;
        si (expression->Genre != 25) retourner faux;

        naturel64 plus = AjouterOctetSemantique(
            HachageVideSemantique(), 43);
        naturel64 moins = AjouterOctetSemantique(
            HachageVideSemantique(), 45);
        naturel64 operande = TrouverEnfantDirectSemantique(
            etat, indexExpression, 0);
        si (operande >= etat->Requete->NombreNoeuds)
            retourner faux;
        constante NoeudDeclaration* litteral =
            &etat->Requete->Noeuds[operande];
        si (litteral->Genre != 22
            || (litteral->Drapeaux & 16_384) != 0)
            retourner faux;
        si (expression->HachageNom == plus)
            retourner LitteralCompatibleTypeSemantique(
                litteral, hachageType);
        si (expression->HachageNom != moins) retourner faux;

        naturel64 valeur = litteral->HachageType;
        si (hachageType == HacherTypeSimpleSemantique(1, 0, 0))
            retourner valeur <= 128;
        si (hachageType == HacherTypeSimpleSemantique(2, 0, 0))
            retourner valeur <= 32_768;
        si (hachageType == HacherTypeSimpleSemantique(3, 0, 0))
            retourner valeur <= 2_147_483_648;
        si (hachageType == HacherTypeSimpleSemantique(4, 0, 0))
            retourner valeur <= 9_223_372_036_854_775_808;
        retourner faux;
    }

    naturel64 TrouverTypeBaseSymboleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        si (indexType >= etat->NombreSymboles) retourner etat->NombreSymboles;
        constante NoeudDeclaration* type = &etat->Requete->Noeuds[
            etat->SymbolesTravail[indexType].IndexNoeud];
        si ((type->Drapeaux & 32) == 0 || type->HachageType == 0)
            retourner etat->NombreSymboles;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 1
                && (type->HachageType == candidat->HachageNom
                    || type->HachageType == HacherNomCompletSemantique(
                        etat, candidat->IndexNoeud)))
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    booléen EstTypeDeriveSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexSource,
        naturel64 indexDestination) {
        naturel64 courant = indexSource;
        naturel64 profondeur = 0;
        tantque (courant < etat->NombreSymboles
            && profondeur < etat->NombreSymboles) {
            courant = TrouverTypeBaseSymboleSemantique(etat, courant);
            si (courant == indexDestination) retourner vrai;
            profondeur = profondeur + 1;
        }
        retourner faux;
    }

    booléen AccesMembreAutoriseSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexMembre,
        naturel64 indexUtilisation) {
        si (indexMembre >= etat->NombreSymboles) retourner faux;
        SymboleSemantique* membre = &etat->SymbolesTravail[indexMembre];
        constante NoeudDeclaration* declaration =
            &etat->Requete->Noeuds[membre->IndexNoeud];
        si ((declaration->Drapeaux & 1) != 0) retourner vrai;

        naturel64 typeDeclarant = TrouverSymboleNoeudSemantique(
            etat, membre->IndexPortee);
        naturel64 typeContexte = TrouverRecepteurSemantique(
            etat, indexUtilisation);
        si (typeDeclarant >= etat->NombreSymboles
            || typeContexte >= etat->NombreSymboles)
            retourner faux;
        si (typeContexte == typeDeclarant) retourner vrai;
        retourner (declaration->Drapeaux & 8) != 0
            && EstTypeDeriveSemantique(
                etat, typeContexte, typeDeclarant);
    }

    booléen ConversionHeritageSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 source,
        naturel64 destination,
        booléen liaisonReference) {
        si (EstTypeConstantSemantique(etat, source)
            && !EstTypeConstantSemantique(etat, destination))
            retourner faux;
        naturel32 niveauPointeur = 0;
        tantque (niveauPointeur <= 1) {
            si (niveauPointeur != 0 || liaisonReference) {
                naturel64 typeSource = TrouverTypeDepuisHachageSemantique(
                    etat, source, niveauPointeur);
                naturel64 typeDestination = TrouverTypeDepuisHachageSemantique(
                    etat, destination, niveauPointeur);
                si (typeSource < etat->NombreSymboles
                    && typeDestination < etat->NombreSymboles
                    && typeSource != typeDestination
                    && EstTypeDeriveSemantique(
                        etat, typeSource, typeDestination))
                    retourner vrai;
            }
            niveauPointeur = niveauPointeur + 1;
        }
        retourner faux;
    }

    externe booléen EstValeurGaucheSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression);

    externe booléen EstExpressionValeurConstanteSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression);

    externe booléen LiaisonReferenceCompatibleSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 typeReference);

    booléen InitialiseurCompatibleTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 typeDestination) {
        naturel64 typeSource = HachageTypeExpressionSemantique(
            etat, indexExpression);
        si (typeSource == 0) retourner vrai;
        typeSource = SansReferenceTypeSemantique(etat, typeSource);
        typeDestination = SansReferenceTypeSemantique(
            etat, typeDestination);
        si (typeSource == typeDestination) retourner vrai;

        booléen sourceAdresse = EstTypeAdresseSemantique(
            etat, typeSource);
        booléen destinationAdresse = EstTypeAdresseSemantique(
            etat, typeDestination);
        naturel64 sourceValeur = SansQualificatifsValeurSemantique(
            etat, typeSource);
        naturel64 destinationValeur = SansQualificatifsValeurSemantique(
            etat, typeDestination);
        si (!sourceAdresse && !destinationAdresse
            && sourceValeur == destinationValeur)
            retourner vrai;
        si (ConversionHeritageSemantique(
                etat, typeSource, typeDestination, faux))
            retourner vrai;
        retourner LitteralExpressionCompatibleTypeSemantique(
            etat, indexExpression, destinationValeur);
    }

    booléen InitialiserDestinationInitialiseurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeudDeclaration,
        DestinationInitialiseurSemantique* destination) {
        si (indexNoeudDeclaration >= etat->Requete->NombreNoeuds)
            retourner faux;
        destination->IndexNoeudDeclaration = indexNoeudDeclaration;
        destination->ProfondeurTableau = 0;
        DescriptionHachageTypeSemantique dimensions;
        si (LireDimensionsNoeudSemantique(
                etat, indexNoeudDeclaration, &dimensions)) {
            destination->NombreDimensions = dimensions.NombreDimensions;
            destination->HachageElement =
                HachageElementFinalTableauSemantique(
                    etat, indexNoeudDeclaration);
            retourner destination->HachageElement != 0;
        }
        destination->NombreDimensions = 0;
        destination->HachageElement = etat->Requete->Noeuds[
            indexNoeudDeclaration].HachageType;
        retourner destination->HachageElement != 0;
    }

    booléen EstDestinationClasseSemantique(
        EtatAnalyseSemantique* etat,
        DestinationInitialiseurSemantique* destination) {
        naturel64 type = TrouverTypeDepuisHachageSemantique(
            etat, destination->HachageElement, 0);
        retourner type < etat->NombreSymboles
            && etat->Requete->Noeuds[
                etat->SymbolesTravail[type].IndexNoeud].Genre == 6;
    }

    ErreurAnalyseSemantique ValiderGlobalesSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* globale =
                &etat->Requete->Noeuds[index];
            si (globale->Genre == 3) {
                DescriptionTypeJetonsSemantique typeGlobale;
                si (!LireTypeNoeudSemantique(
                        etat, index, &typeGlobale))
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AstInvalide,
                        index,
                        46);

                booléen estReference =
                    (typeGlobale.Qualificatifs & 4) != 0;
                si (typeGlobale.Genre == 13
                    && typeGlobale.NiveauPointeur == 0
                    && !estReference) {
                    naturel64 type = TrouverTypeDepuisHachageSemantique(
                        etat, typeGlobale.HachageType, 0);
                    si (type < etat->NombreSymboles
                        && etat->Requete->Noeuds[
                            etat->SymbolesTravail[type].IndexNoeud].Genre == 6)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                ObjetClasseGlobalInterdit,
                            index,
                            convertir<naturel32>(type));
                }
                si (estReference)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::ReferenceGlobaleInterdite,
                        index,
                        0);
                si (typeGlobale.Genre == 12
                    && typeGlobale.NiveauPointeur == 0)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::GlobaleVideInterdite,
                        index,
                        0);
                si ((globale->Drapeaux & 2) != 0) {
                    si ((globale->Drapeaux & 1) != 0)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                GlobaleExternePubliqueInterdite,
                            index,
                            0);
                }
                sinon si ((typeGlobale.Qualificatifs & 1) != 0
                    && typeGlobale.NiveauPointeur == 0
                    && typeGlobale.Genre != 14
                    && (globale->Drapeaux & 4) == 0)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::
                            GlobaleConstanteNonInitialisee,
                        index,
                        0);
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 CompterChampsTypeAgregeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        si (indexType >= etat->NombreSymboles)
            retourner 0;
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 nombre = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 5
                && candidat->IndexPortee == indexNoeudType)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 TrouverChampTypeAgregeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 position) {
        si (indexType >= etat->NombreSymboles)
            retourner etat->NombreSymboles;
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 nombre = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 5
                && candidat->IndexPortee == indexNoeudType) {
                si (nombre == position) retourner index;
                nombre = nombre + 1;
            }
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    externe ErreurAnalyseSemantique
        ValiderInitialiseurDestinationSemantique(
            EtatAnalyseSemantique* etat,
            naturel64 indexExpression,
            DestinationInitialiseurSemantique* destination);

    ErreurAnalyseSemantique ValiderInitialiseurDestinationSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        DestinationInitialiseurSemantique* destination) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                destination->IndexNoeudDeclaration,
                42);
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];

        si (EstTypeReferenceSemantique(
                etat, destination->HachageElement)) {
            si (expression->Genre == 32
                || !LiaisonReferenceCompatibleSemantique(
                    etat,
                    indexExpression,
                    destination->HachageElement))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::LiaisonReferenceIncompatible,
                    indexExpression,
                    0);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (destination->ProfondeurTableau
            < destination->NombreDimensions) {
            si (expression->Genre != 32)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        TypeElementInitialiseurAgregeIncompatible,
                    indexExpression,
                    destination->ProfondeurTableau);
            naturel64 capaciteTableau = 0;
            si (!LireDimensionNoeudSemantique(
                    etat,
                    destination->IndexNoeudDeclaration,
                    destination->ProfondeurTableau,
                    &capaciteTableau))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    destination->IndexNoeudDeclaration,
                    43);
            naturel64 nombreElementsTableau =
                CompterEnfantsDirectsSemantique(
                etat, indexExpression);
            si (nombreElementsTableau > capaciteTableau)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        TropElementsInitialiseurTableau,
                    indexExpression,
                    convertir<naturel32>(nombreElementsTableau));
            DestinationInitialiseurSemantique destinationElement =
                *destination;
            destinationElement.ProfondeurTableau =
                destinationElement.ProfondeurTableau + 1;
            naturel64 indexElementTableau = 0;
            tantque (indexElementTableau < nombreElementsTableau) {
                naturel64 elementTableau = TrouverEnfantDirectSemantique(
                    etat, indexExpression, indexElementTableau);
                ErreurAnalyseSemantique erreurElementTableau =
                    ValiderInitialiseurDestinationSemantique(
                        etat, elementTableau, &destinationElement);
                si (erreurElementTableau
                    != ErreurAnalyseSemantique::Reussite)
                    retourner erreurElementTableau;
                indexElementTableau = indexElementTableau + 1;
            }
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (expression->Genre == 32) {
            naturel64 type = TrouverTypeDepuisHachageSemantique(
                etat, destination->HachageElement, 0);
            si (type < etat->NombreSymboles) {
                naturel32 genreType = etat->Requete->Noeuds[
                    etat->SymbolesTravail[type].IndexNoeud].Genre;
                si (genreType == 6)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::InitialiseurClasseInterdit,
                        indexExpression,
                        convertir<naturel32>(type));
                si (genreType == 4 || genreType == 5) {
                    naturel64 nombreChamps =
                        CompterChampsTypeAgregeSemantique(etat, type);
                    naturel64 capaciteStructure = nombreChamps;
                    si (genreType == 5 && capaciteStructure > 1)
                        capaciteStructure = 1;
                    naturel64 nombreElementsStructure =
                        CompterEnfantsDirectsSemantique(
                            etat, indexExpression);
                    si (nombreElementsStructure > capaciteStructure)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                TropElementsInitialiseurStructure,
                            indexExpression,
                            convertir<naturel32>(
                                nombreElementsStructure));
                    naturel64 indexElementStructure = 0;
                    tantque (indexElementStructure
                        < nombreElementsStructure) {
                        naturel64 champ = TrouverChampTypeAgregeSemantique(
                            etat, type, indexElementStructure);
                        si (champ >= etat->NombreSymboles)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::AstInvalide,
                                indexExpression,
                                44);
                        DestinationInitialiseurSemantique destinationChamp;
                        si (InitialiserDestinationInitialiseurSemantique(
                                etat,
                                etat->SymbolesTravail[champ].IndexNoeud,
                                &destinationChamp)) {
                            naturel64 elementStructure =
                                TrouverEnfantDirectSemantique(
                                    etat,
                                    indexExpression,
                                    indexElementStructure);
                            ErreurAnalyseSemantique erreurChamp =
                                ValiderInitialiseurDestinationSemantique(
                                    etat,
                                    elementStructure,
                                    &destinationChamp);
                            si (erreurChamp
                                != ErreurAnalyseSemantique::Reussite)
                                retourner erreurChamp;
                        }
                        indexElementStructure =
                            indexElementStructure + 1;
                    }
                    retourner ErreurAnalyseSemantique::Reussite;
                }
            }

            naturel64 nombreValeurs = CompterEnfantsDirectsSemantique(
                etat, indexExpression);
            si (nombreValeurs > 1)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        TropElementsInitialiseurScalaire,
                    indexExpression,
                    convertir<naturel32>(nombreValeurs));
            si (nombreValeurs == 1) {
                naturel64 valeur = TrouverEnfantDirectSemantique(
                    etat, indexExpression, 0);
                retourner ValiderInitialiseurDestinationSemantique(
                    etat, valeur, destination);
            }
            retourner ErreurAnalyseSemantique::Reussite;
        }

        si (!InitialiseurCompatibleTypeSemantique(
                etat, indexExpression, destination->HachageElement))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::
                    TypeElementInitialiseurAgregeIncompatible,
                indexExpression,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderInitialiseurDeclarationSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexDeclaration,
        naturel64 indexExpression) {
        DestinationInitialiseurSemantique destination;
        si (!InitialiserDestinationInitialiseurSemantique(
                etat, indexDeclaration, &destination))
            retourner ErreurAnalyseSemantique::Reussite;
        si (destination.NombreDimensions != 0
            && etat->Requete->Noeuds[indexExpression].Genre != 32)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::InitialiseurTableauNonAgrege,
                indexDeclaration,
                destination.NombreDimensions);
        retourner ValiderInitialiseurDestinationSemantique(
            etat, indexExpression, &destination);
    }

    ErreurAnalyseSemantique ValiderInitialiseursAgregesSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[index];
            si ((noeud->Genre == 3
                    || noeud->Genre == 7
                    || noeud->Genre == 19)
                && (noeud->Drapeaux & 4) != 0) {
                naturel64 expressionDeclaration =
                    TrouverEnfantDirectSemantique(
                    etat, index, 0);
                si (expressionDeclaration >= etat->Requete->NombreNoeuds)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AstInvalide,
                        index,
                        45);
                DestinationInitialiseurSemantique destinationDeclaration;
                si (InitialiserDestinationInitialiseurSemantique(
                        etat, index, &destinationDeclaration)) {
                    si (!(noeud->Genre == 3
                            && EstDestinationClasseSemantique(
                                etat, &destinationDeclaration))) {
                        ErreurAnalyseSemantique erreurDeclaration =
                            ValiderInitialiseurDeclarationSemantique(
                                etat, index, expressionDeclaration);
                        si (erreurDeclaration
                            != ErreurAnalyseSemantique::Reussite)
                            retourner erreurDeclaration;
                    }
                }
            }
            sinon si (noeud->Genre == 35) {
                naturel64 cible = etat->CiblesInitialiseurs[index];
                si (cible < etat->NombreSymboles
                    && etat->SymbolesTravail[cible].Genre == 5) {
                    naturel64 indexChamp = etat->SymbolesTravail[
                        cible].IndexNoeud;
                    naturel64 expressionChamp =
                        TrouverEnfantDirectSemantique(
                        etat, index, 0);
                    DestinationInitialiseurSemantique destinationChamp;
                    si (expressionChamp < etat->Requete->NombreNoeuds
                        && InitialiserDestinationInitialiseurSemantique(
                            etat, indexChamp, &destinationChamp)
                        && !EstDestinationClasseSemantique(
                            etat, &destinationChamp)
                        && (destinationChamp.NombreDimensions != 0
                            || etat->Requete->Noeuds[
                                expressionChamp].Genre == 32)) {
                        ErreurAnalyseSemantique erreurInitialiseurChamp =
                            ValiderInitialiseurDestinationSemantique(
                                etat,
                                expressionChamp,
                                &destinationChamp);
                        si (erreurInitialiseurChamp
                            != ErreurAnalyseSemantique::Reussite)
                            retourner erreurInitialiseurChamp;
                    }
                }
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    externe booléen EstExpressionConstanteGlobaleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression);

    /**
     * Vérifie la forme constante d'une expression globale sans encore
     * calculer sa valeur numérique.
     * @Paramètre(EtatAnalyseSemantique*: etat) État sémantique courant.
     * @Paramètre(naturel64: indexExpression) Expression à examiner.
     * @Retourner(booléen) Vrai pour une forme constante structurelle.
     **/
    booléen EstExpressionConstanteGlobaleSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner faux;
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        si (expression->Genre == 22) retourner vrai;
        si (expression->Genre == 24) {
            naturel64 cible = TrouverCibleSymboleExpressionSemantique(
                etat, indexExpression);
            retourner cible < etat->NombreSymboles
                && etat->SymbolesTravail[cible].Genre == 7;
        }
        si (expression->Genre == 25) {
            si (expression->HachageNom
                    != HacherOperateurExpressionSemantique(43, 0)
                && expression->HachageNom
                    != HacherOperateurExpressionSemantique(45, 0)
                && expression->HachageNom
                    != HacherOperateurExpressionSemantique(33, 0)
                && expression->HachageNom
                    != HacherOperateurExpressionSemantique(126, 0))
                retourner faux;
            naturel64 operande = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner EstExpressionConstanteGlobaleSemantique(
                etat, operande);
        }
        si (expression->Genre == 26) {
            naturel64 gauche = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            naturel64 droite = TrouverEnfantDirectSemantique(
                etat, indexExpression, 1);
            retourner EstExpressionConstanteGlobaleSemantique(etat, gauche)
                && EstExpressionConstanteGlobaleSemantique(etat, droite);
        }
        si (expression->Genre == 31) {
            naturel64 valeur = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner EstExpressionConstanteGlobaleSemantique(
                etat, valeur);
        }
        retourner faux;
    }

    naturel32 GenrePointeurFonctionDestinationGlobaleSemantique(
        EtatAnalyseSemantique* etat,
        DestinationInitialiseurSemantique* destination) {
        DescriptionTypeJetonsSemantique typeDestination;
        si (!LireTypePointeurFonctionNoeudSemantique(
                etat,
                destination->IndexNoeudDeclaration,
                &typeDestination))
            retourner 0;
        si (typeDestination.NiveauPointeur == 0) retourner 1;
        retourner 2;
    }

    externe ErreurAnalyseSemantique
        ValiderInitialiseurGlobalDestinationSemantique(
            EtatAnalyseSemantique* etat,
            naturel64 indexExpression,
            DestinationInitialiseurSemantique* destination);

    /**
     * Applique récursivement les contraintes des initialiseurs émis dans la
     * zone de données globale du bootstrap.
     * @Paramètre(EtatAnalyseSemantique*: etat) État sémantique courant.
     * @Paramètre(naturel64: indexExpression) Expression à valider.
     * @Paramètre(DestinationInitialiseurSemantique*: destination) Type visé.
     * @Retourner(ErreurAnalyseSemantique) Premier diagnostic rencontré.
     **/
    ErreurAnalyseSemantique ValiderInitialiseurGlobalDestinationSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        DestinationInitialiseurSemantique* destination) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                destination->IndexNoeudDeclaration,
                47);
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];

        si (expression->Genre == 32) {
            naturel64 nombreElements = CompterEnfantsDirectsSemantique(
                etat, indexExpression);
            si (destination->ProfondeurTableau
                < destination->NombreDimensions) {
                DestinationInitialiseurSemantique destinationElement =
                    *destination;
                destinationElement.ProfondeurTableau =
                    destinationElement.ProfondeurTableau + 1;
                naturel64 positionElement = 0;
                tantque (positionElement < nombreElements) {
                    naturel64 element = TrouverEnfantDirectSemantique(
                        etat, indexExpression, positionElement);
                    ErreurAnalyseSemantique erreurElement =
                        ValiderInitialiseurGlobalDestinationSemantique(
                            etat, element, &destinationElement);
                    si (erreurElement
                        != ErreurAnalyseSemantique::Reussite)
                        retourner erreurElement;
                    positionElement = positionElement + 1;
                }
                retourner ErreurAnalyseSemantique::Reussite;
            }

            naturel64 type = TrouverTypeDepuisHachageSemantique(
                etat, destination->HachageElement, 0);
            si (type < etat->NombreSymboles) {
                naturel32 genreType = etat->Requete->Noeuds[
                    etat->SymbolesTravail[type].IndexNoeud].Genre;
                si (genreType == 4 || genreType == 5) {
                    naturel64 positionChamp = 0;
                    tantque (positionChamp < nombreElements) {
                        naturel64 champ = TrouverChampTypeAgregeSemantique(
                            etat, type, positionChamp);
                        si (champ >= etat->NombreSymboles)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::AstInvalide,
                                indexExpression,
                                48);
                        DestinationInitialiseurSemantique destinationChamp;
                        si (InitialiserDestinationInitialiseurSemantique(
                                etat,
                                etat->SymbolesTravail[champ].IndexNoeud,
                                &destinationChamp)) {
                            naturel64 elementChamp =
                                TrouverEnfantDirectSemantique(
                                    etat,
                                    indexExpression,
                                    positionChamp);
                            ErreurAnalyseSemantique erreurChamp =
                                ValiderInitialiseurGlobalDestinationSemantique(
                                    etat,
                                    elementChamp,
                                    &destinationChamp);
                            si (erreurChamp
                                != ErreurAnalyseSemantique::Reussite)
                                retourner erreurChamp;
                        }
                        positionChamp = positionChamp + 1;
                    }
                    retourner ErreurAnalyseSemantique::Reussite;
                }
            }

            si (nombreElements == 0)
                retourner ErreurAnalyseSemantique::Reussite;
            naturel64 valeurScalaire = TrouverEnfantDirectSemantique(
                etat, indexExpression, 0);
            retourner ValiderInitialiseurGlobalDestinationSemantique(
                etat, valeurScalaire, destination);
        }

        naturel64 typeAgrege = TrouverTypeDepuisHachageSemantique(
            etat, destination->HachageElement, 0);
        si (typeAgrege < etat->NombreSymboles) {
            naturel32 genreAgrege = etat->Requete->Noeuds[
                etat->SymbolesTravail[typeAgrege].IndexNoeud].Genre;
            si (genreAgrege == 4 || genreAgrege == 5)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::
                        InitialiseurGlobalAgregeRequis,
                    indexExpression,
                    convertir<naturel32>(typeAgrege));
        }

        naturel32 genrePointeurFonction =
            GenrePointeurFonctionDestinationGlobaleSemantique(
                etat, destination);
        si (genrePointeurFonction == 1) {
            naturel64 cibleExpression = indexExpression;
            si (expression->Genre == 25
                && expression->HachageNom
                    == HacherOperateurExpressionSemantique(38, 0))
                cibleExpression = TrouverEnfantDirectSemantique(
                    etat, indexExpression, 0);
            si (cibleExpression < etat->Requete->NombreNoeuds
                && etat->Requete->Noeuds[cibleExpression].Genre == 24) {
                naturel64 cibleFonction =
                    TrouverCibleSymboleExpressionSemantique(
                        etat, cibleExpression);
                si (cibleFonction < etat->NombreSymboles
                    && etat->SymbolesTravail[
                        cibleFonction].Genre == 2)
                    retourner ErreurAnalyseSemantique::Reussite;
            }
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::
                    CiblePointeurFonctionGlobalInvalide,
                indexExpression,
                0);
        }
        si (genrePointeurFonction == 2
            || EstTypeAdresseSemantique(
                etat, destination->HachageElement))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::
                    InitialiseurPointeurDonneesGlobalInterdit,
                indexExpression,
                0);
        si (!EstExpressionConstanteGlobaleSemantique(
                etat, indexExpression))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::InitialiseurGlobalNonConstant,
                indexExpression,
                0);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ValiderInitialiseursGlobauxSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* globale =
                &etat->Requete->Noeuds[index];
            si (globale->Genre == 3
                && (globale->Drapeaux & 4) != 0) {
                naturel64 expression = TrouverEnfantDirectSemantique(
                    etat, index, 0);
                si (expression >= etat->Requete->NombreNoeuds)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::AstInvalide,
                        index,
                        49);
                DestinationInitialiseurSemantique destination;
                si (InitialiserDestinationInitialiseurSemantique(
                        etat, index, &destination)) {
                    ErreurAnalyseSemantique erreur =
                        ValiderInitialiseurGlobalDestinationSemantique(
                            etat, expression, &destination);
                    si (erreur != ErreurAnalyseSemantique::Reussite)
                        retourner erreur;
                }
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    booléen EstValeurGaucheSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (indexExpression >= etat->Requete->NombreNoeuds)
            retourner faux;
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        si (expression->Genre == 24) {
            si (expression->HachageNom == HacherSoiSemantique())
                retourner vrai;
            naturel64 cibleValeurGauche =
                TrouverCibleSymboleExpressionSemantique(
                    etat, indexExpression);
            si (cibleValeurGauche >= etat->NombreSymboles)
                retourner faux;
            naturel32 genreValeurGauche = etat->SymbolesTravail[
                cibleValeurGauche].Genre;
            retourner genreValeurGauche != 2 && genreValeurGauche != 7;
        }
        si (expression->Genre == 29 || expression->Genre == 30)
            retourner vrai;
        si (expression->Genre == 25)
            retourner expression->HachageNom
                == HacherOperateurExpressionSemantique(42, 0);
        si (expression->Genre == 28) {
            naturel64 cibleAppelValeurGauche =
                TrouverEnfantDirectSemantique(etat, indexExpression, 0);
            naturel64 symboleAppelValeurGauche =
                TrouverCibleSymboleExpressionSemantique(
                    etat, cibleAppelValeurGauche);
            si (symboleAppelValeurGauche < etat->NombreSymboles
                && etat->SymbolesTravail[
                    symboleAppelValeurGauche].Genre == 2)
                retourner EstTypeReferenceSemantique(
                    etat,
                    etat->SymbolesTravail[
                        symboleAppelValeurGauche].HachageType);
            naturel64 typeCibleValeurGauche =
                HachageTypeExpressionSemantique(
                    etat, cibleAppelValeurGauche);
            naturel64 origineCibleValeurGauche =
                TrouverOrigineTypeExpressionSemantique(
                    etat, cibleAppelValeurGauche);
            DescriptionTypeJetonsSemantique descriptionAppelValeurGauche;
            si (LireDescriptionPointeurFonctionNoeudSemantique(
                    etat,
                    origineCibleValeurGauche,
                    typeCibleValeurGauche,
                    &descriptionAppelValeurGauche))
                retourner EstTypeReferenceSemantique(
                    etat,
                    descriptionAppelValeurGauche.HachageRetourFonction);
        }
        retourner faux;
    }

    booléen EstExpressionValeurConstanteSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexExpression) {
        si (!EstValeurGaucheSemantique(etat, indexExpression))
            retourner faux;
        naturel64 typeExpressionConstante =
            HachageTypeExpressionSemantique(etat, indexExpression);
        si (EstTypeConstantSemantique(etat, typeExpressionConstante)
            && !EstTypeAdresseSemantique(etat, typeExpressionConstante))
            retourner vrai;

        constante NoeudDeclaration* expressionConstante =
            &etat->Requete->Noeuds[indexExpression];
        si (expressionConstante->Genre == 29
            || expressionConstante->Genre == 30) {
            naturel64 objetExpressionConstante =
                TrouverEnfantDirectSemantique(
                    etat, indexExpression, 0);
            naturel64 typeObjetExpressionConstante =
                HachageTypeExpressionSemantique(
                    etat, objetExpressionConstante);
            si (EstTypeConstantSemantique(
                    etat, typeObjetExpressionConstante))
                retourner vrai;
            retourner EstExpressionValeurConstanteSemantique(
                etat, objetExpressionConstante);
        }
        retourner faux;
    }

    booléen LiaisonReferenceCompatibleSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 typeReference) {
        si (!EstValeurGaucheSemantique(etat, indexExpression))
            retourner faux;
        naturel64 typeSourceReference =
            HachageTypeExpressionSemantique(etat, indexExpression);
        naturel64 typeDestinationReference =
            SansReferenceTypeSemantique(etat, typeReference);
        si (!TypesValeurEgauxSemantique(
                etat,
                typeSourceReference,
                typeDestinationReference)
            && !ConversionHeritageSemantique(
                etat,
                typeSourceReference,
                typeDestinationReference,
                vrai))
            retourner faux;
        si (!EstTypeConstantSemantique(
                etat, typeDestinationReference)
            && EstExpressionValeurConstanteSemantique(
                etat, indexExpression))
            retourner faux;
        retourner vrai;
    }

    booléen EstMembreDuGenreSemantique(
        EtatAnalyseSemantique* etat,
        SymboleSemantique* symbole,
        naturel32 masque) {
        si ((masque & 1) != 0
            && (symbole->Genre == 5 || symbole->Genre == 6))
            retourner vrai;
        si ((masque & 2) != 0 && symbole->Genre == 2) {
            naturel32 genreNoeud = etat->Requete->Noeuds[
                symbole->IndexNoeud].Genre;
            retourner genreNoeud == 12 || genreNoeud == 15;
        }
        retourner faux;
    }

    naturel64 CompterMembresTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageNom,
        naturel32 masque) {
        naturel64 nombre = 0;
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->IndexPortee == indexNoeudType
                && candidat->HachageNom == hachageNom
                && EstMembreDuGenreSemantique(etat, candidat, masque))
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 TrouverTypeDeclarantMembreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageNom,
        naturel32 masque) {
        naturel64 courant = indexType;
        naturel64 profondeur = 0;
        tantque (courant < etat->NombreSymboles
            && profondeur < etat->NombreSymboles) {
            si (CompterMembresTypeSemantique(
                    etat, courant, hachageNom, masque) != 0)
                retourner courant;
            courant = TrouverTypeBaseSymboleSemantique(etat, courant);
            profondeur = profondeur + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverPremierMembreTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageNom,
        naturel32 masque) {
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->IndexPortee == indexNoeudType
                && candidat->HachageNom == hachageNom
                && EstMembreDuGenreSemantique(etat, candidat, masque))
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverTypeObjetMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre) {
        naturel64 objet = TrouverEnfantDirectSemantique(
            etat, indexMembre, 0);
        naturel64 hachageType = HachageTypeExpressionSemantique(
            etat, objet);
        naturel32 niveauPointeur = 0;
        si ((etat->Requete->Noeuds[indexMembre].Drapeaux & 32_768) != 0)
            niveauPointeur = 1;
        retourner TrouverTypeDepuisHachageSemantique(
            etat, hachageType, niveauPointeur);
    }

    naturel64 ResoudreAliasChampSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexAlias,
        naturel64 indexType) {
        SymboleSemantique* symboleAlias =
            &etat->SymbolesTravail[indexAlias];
        si (symboleAlias->Genre != 6) retourner indexAlias;
        retourner TrouverPremierMembreTypeSemantique(
            etat, indexType, symboleAlias->HachageType, 1);
    }

    naturel64 HachageTypeMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre) {
        si (indexMembre >= etat->Requete->NombreNoeuds) retourner 0;
        constante NoeudDeclaration* membre =
            &etat->Requete->Noeuds[indexMembre];
        naturel64 typeObjet = TrouverTypeObjetMembreSemantique(
            etat, indexMembre);
        si (typeObjet >= etat->NombreSymboles) retourner 0;
        naturel64 typeDeclarant = TrouverTypeDeclarantMembreSemantique(
            etat, typeObjet, membre->HachageNom, 3);
        si (typeDeclarant >= etat->NombreSymboles) retourner 0;
        naturel64 cible = TrouverPremierMembreTypeSemantique(
            etat, typeDeclarant, membre->HachageNom, 3);
        si (cible >= etat->NombreSymboles) retourner 0;
        cible = ResoudreAliasChampSemantique(
            etat, cible, typeDeclarant);
        si (cible >= etat->NombreSymboles) retourner 0;
        retourner SansReferenceTypeSemantique(
            etat, etat->SymbolesTravail[cible].HachageType);
    }

    naturel32 EvaluerArgumentsFonctionSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexParent,
        naturel64 indexFonction,
        naturel64 premierArgument) {
        naturel64 nombreEnfants = CompterEnfantsDirectsSemantique(
            etat, indexParent);
        si (nombreEnfants < premierArgument)
            retourner 4_294_967_295;
        naturel64 nombreArguments = nombreEnfants - premierArgument;
        si (CompterParametresFonctionSemantique(
                etat, indexFonction) != nombreArguments)
            retourner 4_294_967_295;

        naturel32 score = 0;
        naturel64 indexArgument = 0;
        tantque (indexArgument < nombreArguments) {
            naturel64 argument = TrouverEnfantDirectSemantique(
                etat,
                indexParent,
                indexArgument + premierArgument);
            naturel64 parametre = TrouverParametreFonctionSemantique(
                etat, indexFonction, indexArgument);
            si (argument >= etat->Requete->NombreNoeuds
                || parametre >= etat->Requete->NombreNoeuds)
                retourner 4_294_967_295;
            naturel64 typeArgument = HachageTypeExpressionSemantique(
                etat, argument);
            naturel64 typeParametre =
                etat->Requete->Noeuds[parametre].HachageType;
            booléen parametreReference = EstTypeReferenceSemantique(
                etat, typeParametre);
            typeParametre = SansReferenceTypeSemantique(
                etat, typeParametre);

            si (etat->Requete->Noeuds[argument].Genre == 32) {
                si (parametreReference) retourner 4_294_967_295;
                score = score + 2;
            }
            sinon si (parametreReference) {
                si (!LiaisonReferenceCompatibleSemantique(
                        etat, argument, typeParametre))
                    retourner 4_294_967_295;
                si (!TypesValeurEgauxSemantique(
                        etat, typeArgument, typeParametre))
                    score = score + 1;
            }
            sinon si (!TypesValeurEgauxSemantique(
                    etat, typeArgument, typeParametre)) {
                si (ConversionHeritageSemantique(
                        etat,
                        typeArgument,
                        typeParametre,
                        faux))
                    score = score + 1;
                sinon {
                    si (!LitteralExpressionCompatibleTypeSemantique(
                            etat, argument, typeParametre))
                        retourner 4_294_967_295;
                    score = score + 1;
                }
            }
            indexArgument = indexArgument + 1;
        }
        retourner score;
    }

    booléen EvaluerSurchargeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexAppel,
        naturel64 indexFonction,
        naturel32* score) {
        *score = EvaluerArgumentsFonctionSemantique(
            etat, indexAppel, indexFonction, 1);
        retourner *score != 4_294_967_295;
    }

    naturel64 SelectionnerSurchargeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexReference,
        naturel64 indexAppel) {
        constante NoeudDeclaration* reference =
            &etat->Requete->Noeuds[indexReference];
        naturel64 meilleure = etat->NombreSymboles;
        naturel32 meilleurScore = 4_294_967_295;
        naturel32 nombreMeilleures = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == 0
                && ReferenceCorrespondSymboleSemantique(
                    etat, reference, candidat)) {
                naturel32 score = 0;
                si (EvaluerSurchargeSemantique(
                        etat,
                        indexAppel,
                        candidat->IndexNoeud,
                        &score)) {
                    si (score < meilleurScore) {
                        meilleure = index;
                        meilleurScore = score;
                        nombreMeilleures = 1;
                    }
                    sinon si (score == meilleurScore)
                        nombreMeilleures = nombreMeilleures + 1;
                }
            }
            index = index + 1;
        }

        si (meilleure >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexReference,
                convertir<naturel32>(
                    CompterEnfantsDirectsSemantique(etat, indexAppel) - 1));
            retourner etat->NombreSymboles;
        }
        si (nombreMeilleures > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexReference,
                nombreMeilleures);
            retourner etat->NombreSymboles;
        }
        retourner meilleure;
    }

    naturel64 SelectionnerSurchargeMembreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexMembre,
        naturel64 indexAppel,
        naturel64 indexTypeDeclarant) {
        constante NoeudDeclaration* membre =
            &etat->Requete->Noeuds[indexMembre];
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexTypeDeclarant].IndexNoeud;
        naturel64 meilleure = etat->NombreSymboles;
        naturel32 meilleurScore = 4_294_967_295;
        naturel32 nombreMeilleures = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->IndexPortee == indexNoeudType
                && candidat->HachageNom == membre->HachageNom
                && EstMembreDuGenreSemantique(etat, candidat, 2)) {
                naturel32 score = 0;
                si (EvaluerSurchargeSemantique(
                        etat,
                        indexAppel,
                        candidat->IndexNoeud,
                        &score)) {
                    si (score < meilleurScore) {
                        meilleure = index;
                        meilleurScore = score;
                        nombreMeilleures = 1;
                    }
                    sinon si (score == meilleurScore)
                        nombreMeilleures = nombreMeilleures + 1;
                }
            }
            index = index + 1;
        }

        si (meilleure >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexMembre,
                convertir<naturel32>(
                    CompterEnfantsDirectsSemantique(etat, indexAppel) - 1));
            retourner etat->NombreSymboles;
        }
        si (nombreMeilleures > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexMembre,
                nombreMeilleures);
            retourner etat->NombreSymboles;
        }
        retourner meilleure;
    }

    ErreurAnalyseSemantique ResoudreMembreSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexMembre) {
        constante NoeudDeclaration* membre =
            &etat->Requete->Noeuds[indexMembre];
        si (membre->Genre != 29)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 typeObjet = TrouverTypeObjetMembreSemantique(
            etat, indexMembre);
        si (typeObjet >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::RecepteurMembreInvalide,
                indexMembre,
                0);

        constante NoeudDeclaration* noeudParentMembre =
            &etat->Requete->Noeuds[membre->Parent];
        booléen cibleAppel = noeudParentMembre->Genre == 28
            && indexMembre == membre->Parent + 1;
        naturel32 masque = 1;
        si (cibleAppel) masque = 2;
        naturel64 typeDeclarant = TrouverTypeDeclarantMembreSemantique(
            etat, typeObjet, membre->HachageNom, masque);
        si (typeDeclarant >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::MembreIntrouvable,
                indexMembre,
                0);

        naturel64 cible = etat->NombreSymboles;
        naturel32 drapeaux = 8;
        si (typeDeclarant != typeObjet) drapeaux = drapeaux | 16;
        si (cibleAppel) {
            cible = SelectionnerSurchargeMembreSemantique(
                etat, indexMembre, membre->Parent, typeDeclarant);
            si (cible >= etat->NombreSymboles)
                retourner etat->Requete->Resultat.Erreur;
            drapeaux = drapeaux | 32;
            si (CompterMembresTypeSemantique(
                    etat,
                    typeDeclarant,
                    membre->HachageNom,
                    2) > 1)
                drapeaux = drapeaux | 1;
        }
        sinon {
            cible = TrouverPremierMembreTypeSemantique(
                etat, typeDeclarant, membre->HachageNom, 1);
            cible = ResoudreAliasChampSemantique(
                etat, cible, typeDeclarant);
        }
        si (cible >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::MembreIntrouvable,
                indexMembre,
                0);
        si (!AccesMembreAutoriseSemantique(etat, cible, indexMembre))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::MembreInaccessible,
                indexMembre,
                convertir<naturel32>(cible));
        AjouterResolutionSemantique(
            etat, indexMembre, cible, drapeaux);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 CompterConstructeursTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        naturel64 nombre = 0;
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 13)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 SelectionnerConstructeurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexArguments,
        naturel64 indexType) {
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 meilleure = etat->NombreSymboles;
        naturel32 meilleurScore = 4_294_967_295;
        naturel32 nombreMeilleures = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 13) {
                naturel32 score = EvaluerArgumentsFonctionSemantique(
                        etat,
                        indexArguments,
                        candidat->IndexNoeud,
                        0);
                si (score != 4_294_967_295) {
                    si (score < meilleurScore) {
                        meilleure = index;
                        meilleurScore = score;
                        nombreMeilleures = 1;
                    }
                    sinon si (score == meilleurScore)
                        nombreMeilleures = nombreMeilleures + 1;
                }
            }
            index = index + 1;
        }

        si (meilleure >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexArguments,
                convertir<naturel32>(
                    CompterEnfantsDirectsSemantique(etat, indexArguments)));
            retourner etat->NombreSymboles;
        }
        si (nombreMeilleures > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexArguments,
                nombreMeilleures);
            retourner etat->NombreSymboles;
        }
        retourner meilleure;
    }

    naturel64 SelectionnerConstructeurSansArgumentSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexPosition,
        naturel64 indexType) {
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 cible = etat->NombreSymboles;
        naturel32 nombreCibles = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 13
                && CompterParametresFonctionSemantique(
                    etat, candidat->IndexNoeud) == 0) {
                si (cible >= etat->NombreSymboles) cible = index;
                nombreCibles = nombreCibles + 1;
            }
            index = index + 1;
        }
        si (cible >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexPosition,
                0);
            retourner etat->NombreSymboles;
        }
        si (nombreCibles > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexPosition,
                nombreCibles);
            retourner etat->NombreSymboles;
        }
        retourner cible;
    }

    ErreurAnalyseSemantique ValiderChampsParDefautSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 indexType = 0;
        tantque (indexType < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* type =
                &etat->Requete->Noeuds[indexType];
            si (type->Genre == 6) {
                booléen possedeValeurParDefaut = faux;
                naturel64 indexChamp = 0;
                tantque (indexChamp < etat->NombreSymboles) {
                    SymboleSemantique* symboleChamp =
                        &etat->SymbolesTravail[indexChamp];
                    si (symboleChamp->Genre == 5
                        && symboleChamp->IndexPortee == indexType) {
                        constante NoeudDeclaration* champ =
                            &etat->Requete->Noeuds[
                                symboleChamp->IndexNoeud];
                        si ((champ->Drapeaux & 4) != 0) {
                            possedeValeurParDefaut = vrai;
                            naturel64 typeChamp =
                                TrouverTypeDepuisHachageSemantique(
                                    etat, champ->HachageType, 0);
                            si (typeChamp >= etat->NombreSymboles)
                                typeChamp =
                                    TrouverTypeElementFinalTableauSemantique(
                                        etat, symboleChamp->IndexNoeud);
                            si (typeChamp < etat->NombreSymboles
                                && etat->Requete->Noeuds[
                                    etat->SymbolesTravail[
                                        typeChamp].IndexNoeud].Genre == 6)
                                retourner SignalerErreurSemantique(
                                    etat,
                                    ErreurAnalyseSemantique::
                                        ValeurChampParDefautObjetClasseInterdite,
                                    symboleChamp->IndexNoeud,
                                    convertir<naturel32>(indexChamp));
                        }
                    }
                    indexChamp = indexChamp + 1;
                }
                si (possedeValeurParDefaut) {
                    naturel64 symboleType = TrouverSymboleNoeudSemantique(
                        etat, indexType);
                    si (symboleType >= etat->NombreSymboles
                        || CompterConstructeursTypeSemantique(
                            etat, symboleType) == 0)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                ClasseValeurChampParDefautSansConstructeur,
                            indexType,
                            0);
                }
            }
            indexType = indexType + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 TrouverTypeConstructeurInitialiseurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexInitialiseur) {
        si (indexInitialiseur >= etat->Requete->NombreNoeuds)
            retourner etat->NombreSymboles;
        constante NoeudDeclaration* initialiseur =
            &etat->Requete->Noeuds[indexInitialiseur];
        si (initialiseur->Parent >= etat->Requete->NombreNoeuds)
            retourner etat->NombreSymboles;
        constante NoeudDeclaration* noeudConstructeurInitialiseur =
            &etat->Requete->Noeuds[initialiseur->Parent];
        si (noeudConstructeurInitialiseur->Genre != 13
            || noeudConstructeurInitialiseur->Parent
                >= etat->Requete->NombreNoeuds)
            retourner etat->NombreSymboles;
        retourner TrouverSymboleNoeudSemantique(
            etat, noeudConstructeurInitialiseur->Parent);
    }

    naturel64 TrouverInitialiseurDelegueConstructeurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConstructeur) {
        naturel64 indexInitialiseurDelegue = indexConstructeur + 1;
        tantque (indexInitialiseurDelegue < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* candidatInitialiseurDelegue =
                &etat->Requete->Noeuds[indexInitialiseurDelegue];
            si (candidatInitialiseurDelegue->Genre == 33
                && candidatInitialiseurDelegue->Parent == indexConstructeur)
                retourner indexInitialiseurDelegue;
            indexInitialiseurDelegue = indexInitialiseurDelegue + 1;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    ErreurAnalyseSemantique ResoudreInitialiseurDelegueSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexInitialiseurDelegue) {
        naturel64 typeConstructeurDelegue =
            TrouverTypeConstructeurInitialiseurSemantique(
                etat, indexInitialiseurDelegue);
        si (typeConstructeurDelegue >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexInitialiseurDelegue,
                33);
        naturel64 cibleConstructeurDelegue =
            SelectionnerConstructeurSemantique(
                etat,
                indexInitialiseurDelegue,
                typeConstructeurDelegue);
        si (cibleConstructeurDelegue >= etat->NombreSymboles)
            retourner etat->Requete->Resultat.Erreur;
        naturel64 indexConstructeurDelegant =
            etat->Requete->Noeuds[indexInitialiseurDelegue].Parent;
        si (etat->SymbolesTravail[
                cibleConstructeurDelegue].IndexNoeud
            == indexConstructeurDelegant)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::DelegationConstructeurDirecte,
                indexInitialiseurDelegue,
                convertir<naturel32>(cibleConstructeurDelegue));
        etat->CiblesInitialiseurs[indexInitialiseurDelegue] =
            cibleConstructeurDelegue;
        naturel32 drapeauxDelegation = 64 | 128 | 512;
        si (CompterConstructeursTypeSemantique(
                etat, typeConstructeurDelegue) > 1)
            drapeauxDelegation = drapeauxDelegation | 1;
        AjouterResolutionSemantique(
            etat,
            indexInitialiseurDelegue,
            cibleConstructeurDelegue,
            drapeauxDelegation);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ResoudreInitialiseurBaseSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexInitialiseurBase) {
        naturel64 typeConstructeurBase =
            TrouverTypeConstructeurInitialiseurSemantique(
                etat, indexInitialiseurBase);
        si (typeConstructeurBase >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexInitialiseurBase,
                34);
        naturel64 typeBaseInitialisee = TrouverTypeBaseSymboleSemantique(
            etat, typeConstructeurBase);
        si (typeBaseInitialisee >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::InitialiseurBaseSansClasseBase,
                indexInitialiseurBase,
                0);
        naturel64 nombreConstructeursBase =
            CompterConstructeursTypeSemantique(etat, typeBaseInitialisee);
        naturel64 nombreArgumentsBase = CompterEnfantsDirectsSemantique(
            etat, indexInitialiseurBase);
        si (nombreConstructeursBase == 0) {
            si (nombreArgumentsBase != 0)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::ConstructeurNonDeclare,
                    indexInitialiseurBase,
                    convertir<naturel32>(nombreArgumentsBase));
            retourner ErreurAnalyseSemantique::Reussite;
        }
        naturel64 cibleConstructeurBase = SelectionnerConstructeurSemantique(
            etat, indexInitialiseurBase, typeBaseInitialisee);
        si (cibleConstructeurBase >= etat->NombreSymboles)
            retourner etat->Requete->Resultat.Erreur;
        si (!AccesMembreAutoriseSemantique(
                etat, cibleConstructeurBase, indexInitialiseurBase))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ConstructeurInaccessible,
                indexInitialiseurBase,
                convertir<naturel32>(cibleConstructeurBase));
        etat->CiblesInitialiseurs[indexInitialiseurBase] =
            cibleConstructeurBase;
        naturel32 drapeauxBase = 64 | 128 | 1_024;
        si (nombreConstructeursBase > 1)
            drapeauxBase = drapeauxBase | 1;
        AjouterResolutionSemantique(
            etat,
            indexInitialiseurBase,
            cibleConstructeurBase,
            drapeauxBase);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ResoudreInitialiseurChampSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexInitialiseurChamp) {
        naturel64 typeConstructeurChamp =
            TrouverTypeConstructeurInitialiseurSemantique(
                etat, indexInitialiseurChamp);
        si (typeConstructeurChamp >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexInitialiseurChamp,
                35);
        constante NoeudDeclaration* initialiseurChamp =
            &etat->Requete->Noeuds[indexInitialiseurChamp];
        naturel64 cibleChampInitialise = TrouverPremierMembreTypeSemantique(
            etat,
            typeConstructeurChamp,
            initialiseurChamp->HachageNom,
            1);
        si (cibleChampInitialise < etat->NombreSymboles)
            cibleChampInitialise = ResoudreAliasChampSemantique(
                etat, cibleChampInitialise, typeConstructeurChamp);
        si (cibleChampInitialise >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ChampInitialiseurIntrouvable,
                indexInitialiseurChamp,
                0);

        naturel64 indexConstructeurChamp = initialiseurChamp->Parent;
        naturel64 indexInitialiseurChampPrecedent = indexConstructeurChamp + 1;
        naturel64 derniereCibleChamp = etat->NombreSymboles;
        tantque (indexInitialiseurChampPrecedent < indexInitialiseurChamp) {
            constante NoeudDeclaration* candidatChampPrecedent =
                &etat->Requete->Noeuds[indexInitialiseurChampPrecedent];
            si (candidatChampPrecedent->Genre == 35
                && candidatChampPrecedent->Parent == indexConstructeurChamp) {
                naturel64 cibleChampPrecedente = etat->CiblesInitialiseurs[
                    indexInitialiseurChampPrecedent];
                si (cibleChampPrecedente == cibleChampInitialise)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::ChampInitialisePlusieursFois,
                        indexInitialiseurChamp,
                        convertir<naturel32>(cibleChampInitialise));
                si (cibleChampPrecedente < etat->NombreSymboles)
                    derniereCibleChamp = cibleChampPrecedente;
            }
            indexInitialiseurChampPrecedent =
                indexInitialiseurChampPrecedent + 1;
        }
        si (derniereCibleChamp < etat->NombreSymboles
            && etat->SymbolesTravail[
                derniereCibleChamp].IndexNoeud
                >= etat->SymbolesTravail[
                    cibleChampInitialise].IndexNoeud)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::OrdreInitialisationChampInvalide,
                indexInitialiseurChamp,
                convertir<naturel32>(cibleChampInitialise));

        SymboleSemantique* symboleChamp = &etat->SymbolesTravail[
            cibleChampInitialise];
        naturel64 indexNoeudChamp = symboleChamp->IndexNoeud;
        naturel64 typeElementTableau = HachageElementFinalTableauSemantique(
            etat, indexNoeudChamp);
        booléen champTableau = typeElementTableau != 0;
        naturel64 typeChamp = TrouverTypeDepuisHachageSemantique(
            etat, symboleChamp->HachageType, 0);
        si (champTableau)
            typeChamp = TrouverTypeDepuisHachageSemantique(
                etat, typeElementTableau, 0);
        booléen champObjetClasse = typeChamp < etat->NombreSymboles
            && etat->Requete->Noeuds[
                etat->SymbolesTravail[typeChamp].IndexNoeud].Genre == 6;
        naturel64 nombreArgumentsChamp = CompterEnfantsDirectsSemantique(
            etat, indexInitialiseurChamp);
        naturel64 cibleConstructeurChamp = etat->NombreSymboles;

        si (champObjetClasse) {
            naturel64 nombreConstructeursChamp =
                CompterConstructeursTypeSemantique(etat, typeChamp);
            si (nombreConstructeursChamp == 0) {
                si (nombreArgumentsChamp != 0)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::ConstructeurNonDeclare,
                        indexInitialiseurChamp,
                        convertir<naturel32>(nombreArgumentsChamp));
            }
            sinon {
                cibleConstructeurChamp = SelectionnerConstructeurSemantique(
                    etat, indexInitialiseurChamp, typeChamp);
                si (cibleConstructeurChamp >= etat->NombreSymboles)
                    retourner etat->Requete->Resultat.Erreur;
                si (!AccesMembreAutoriseSemantique(
                        etat,
                        cibleConstructeurChamp,
                        indexInitialiseurChamp))
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::ConstructeurInaccessible,
                        indexInitialiseurChamp,
                        convertir<naturel32>(cibleConstructeurChamp));
            }
        }
        sinon si (champTableau) {
            si (nombreArgumentsChamp != 1)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AriteInitialiseurChampInvalide,
                    indexInitialiseurChamp,
                    convertir<naturel32>(nombreArgumentsChamp));
            naturel64 argumentTableau = TrouverEnfantDirectSemantique(
                etat, indexInitialiseurChamp, 0);
            si (argumentTableau >= etat->Requete->NombreNoeuds)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    indexInitialiseurChamp,
                    41);
            si (etat->Requete->Noeuds[argumentTableau].Genre != 32)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::InitialiseurChampTableauNonAgrege,
                    indexInitialiseurChamp,
                    convertir<naturel32>(cibleChampInitialise));
        }
        sinon si (EstTypeScalaireSemantique(
                etat, symboleChamp->HachageType)) {
            si (nombreArgumentsChamp != 1)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AriteInitialiseurChampInvalide,
                    indexInitialiseurChamp,
                    convertir<naturel32>(nombreArgumentsChamp));
            naturel64 argumentChamp = TrouverEnfantDirectSemantique(
                etat, indexInitialiseurChamp, 0);
            si (argumentChamp >= etat->Requete->NombreNoeuds)
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::AstInvalide,
                    indexInitialiseurChamp,
                    36);
            si (!InitialiseurCompatibleTypeSemantique(
                    etat, argumentChamp, symboleChamp->HachageType))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::TypeInitialiseurChampIncompatible,
                    argumentChamp,
                    convertir<naturel32>(cibleChampInitialise));
        }

        etat->CiblesInitialiseurs[indexInitialiseurChamp] =
            cibleChampInitialise;
        naturel32 drapeauxChamp = 8 | 2_048;
        si (champTableau) drapeauxChamp = drapeauxChamp | 8_192;
        AjouterResolutionSemantique(
            etat,
            indexInitialiseurChamp,
            cibleChampInitialise,
            drapeauxChamp);
        si (cibleConstructeurChamp < etat->NombreSymboles) {
            naturel32 drapeauxConstructeurChamp = 64 | 128 | 2_048;
            si (champTableau)
                drapeauxConstructeurChamp =
                    drapeauxConstructeurChamp | 8_192;
            si (CompterConstructeursTypeSemantique(
                    etat, typeChamp) > 1)
                drapeauxConstructeurChamp =
                    drapeauxConstructeurChamp | 1;
            AjouterResolutionSemantique(
                etat,
                indexInitialiseurChamp,
                cibleConstructeurChamp,
                drapeauxConstructeurChamp);
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ResoudreBaseImpliciteConstructeurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConstructeur) {
        constante NoeudDeclaration* noeudConstructeur =
            &etat->Requete->Noeuds[indexConstructeur];
        si ((noeudConstructeur->Drapeaux & 256) != 0
            || (noeudConstructeur->Drapeaux & 512) != 0)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 typeConstructeur = TrouverSymboleNoeudSemantique(
            etat, noeudConstructeur->Parent);
        si (typeConstructeur >= etat->NombreSymboles)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexConstructeur,
                13);
        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(
            etat, typeConstructeur);
        si (typeBase >= etat->NombreSymboles)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 nombreConstructeursBase =
            CompterConstructeursTypeSemantique(etat, typeBase);
        si (nombreConstructeursBase == 0)
            retourner ErreurAnalyseSemantique::Reussite;

        naturel64 cibleConstructeurBase =
            SelectionnerConstructeurSansArgumentSemantique(
                etat, indexConstructeur, typeBase);
        si (cibleConstructeurBase >= etat->NombreSymboles)
            retourner etat->Requete->Resultat.Erreur;
        si (!AccesMembreAutoriseSemantique(
                etat, cibleConstructeurBase, indexConstructeur))
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::ConstructeurInaccessible,
                indexConstructeur,
                convertir<naturel32>(cibleConstructeurBase));

        naturel32 drapeauxBase = 64 | 1_024;
        si (nombreConstructeursBase > 1)
            drapeauxBase = drapeauxBase | 1;
        AjouterResolutionSemantique(
            etat,
            indexConstructeur,
            cibleConstructeurBase,
            drapeauxBase);
        retourner ErreurAnalyseSemantique::Reussite;
    }

    booléen ChampInitialiseExplicitementSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexConstructeur,
        naturel64 indexSymboleChamp) {
        naturel64 index = indexConstructeur + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud =
                &etat->Requete->Noeuds[index];
            si (noeud->Genre == 35
                && noeud->Parent == indexConstructeur
                && etat->CiblesInitialiseurs[index] == indexSymboleChamp)
                retourner vrai;
            index = index + 1;
        }
        retourner faux;
    }

    ErreurAnalyseSemantique ResoudreChampsImplicitesConstructeurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConstructeur) {
        constante NoeudDeclaration* noeudConstructeurImplicite =
            &etat->Requete->Noeuds[indexConstructeur];
        si ((noeudConstructeurImplicite->Drapeaux & 512) != 0)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 indexType = noeudConstructeurImplicite->Parent;
        si (indexType >= etat->Requete->NombreNoeuds
            || etat->Requete->Noeuds[indexType].Genre != 6)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AstInvalide,
                indexConstructeur,
                40);

        naturel64 indexChamp = 0;
        tantque (indexChamp < etat->NombreSymboles) {
            SymboleSemantique* symboleChamp =
                &etat->SymbolesTravail[indexChamp];
            si (symboleChamp->Genre == 5
                && symboleChamp->IndexPortee == indexType
                && !ChampInitialiseExplicitementSemantique(
                    etat, indexConstructeur, indexChamp)) {
                naturel64 indexNoeudChamp = symboleChamp->IndexNoeud;
                constante NoeudDeclaration* champ =
                    &etat->Requete->Noeuds[indexNoeudChamp];
                naturel64 typeElementTableau =
                    HachageElementFinalTableauSemantique(
                        etat, indexNoeudChamp);
                booléen champTableau = typeElementTableau != 0;
                naturel64 hachageTypeValeur = champ->HachageType;
                si (champTableau)
                    hachageTypeValeur = typeElementTableau;
                naturel64 typeChamp = TrouverTypeDepuisHachageSemantique(
                    etat, hachageTypeValeur, 0);
                booléen champObjetClasse = typeChamp < etat->NombreSymboles
                    && etat->Requete->Noeuds[
                        etat->SymbolesTravail[
                            typeChamp].IndexNoeud].Genre == 6;
                naturel32 drapeauxChamp = 8 | 2_048 | 4_096;
                si (champTableau)
                    drapeauxChamp = drapeauxChamp | 8_192;

                si ((champ->Drapeaux & 4) != 0) {
                    naturel64 expression = TrouverEnfantDirectSemantique(
                        etat, indexNoeudChamp, 0);
                    si (expression >= etat->Requete->NombreNoeuds)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::AstInvalide,
                            indexNoeudChamp,
                            41);
                    si (champTableau
                        && etat->Requete->Noeuds[expression].Genre != 32)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                InitialiseurChampTableauNonAgrege,
                            expression,
                            convertir<naturel32>(indexChamp));
                    si (!champTableau
                        && EstTypeScalaireSemantique(
                            etat, champ->HachageType)
                        && !InitialiseurCompatibleTypeSemantique(
                            etat, expression, champ->HachageType))
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::
                                TypeInitialiseurChampIncompatible,
                            expression,
                            convertir<naturel32>(indexChamp));
                    AjouterResolutionSemantique(
                        etat,
                        indexConstructeur,
                        indexChamp,
                        drapeauxChamp | 16_384);
                }
                sinon si (champObjetClasse) {
                    AjouterResolutionSemantique(
                        etat,
                        indexConstructeur,
                        indexChamp,
                        drapeauxChamp);
                    naturel64 nombreConstructeursChamp =
                        CompterConstructeursTypeSemantique(
                            etat, typeChamp);
                    si (nombreConstructeursChamp != 0) {
                        naturel64 cibleConstructeurChamp =
                            SelectionnerConstructeurSansArgumentSemantique(
                                etat, indexNoeudChamp, typeChamp);
                        si (cibleConstructeurChamp >= etat->NombreSymboles)
                            retourner etat->Requete->Resultat.Erreur;
                        si (!AccesMembreAutoriseSemantique(
                                etat,
                                cibleConstructeurChamp,
                                indexConstructeur))
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::
                                    ConstructeurInaccessible,
                                indexNoeudChamp,
                                convertir<naturel32>(
                                    cibleConstructeurChamp));
                        naturel32 drapeauxConstructeur =
                            64 | 2_048 | 4_096;
                        si (champTableau)
                            drapeauxConstructeur =
                                drapeauxConstructeur | 8_192;
                        si (nombreConstructeursChamp > 1)
                            drapeauxConstructeur =
                                drapeauxConstructeur | 1;
                        AjouterResolutionSemantique(
                            etat,
                            indexConstructeur,
                            cibleConstructeurChamp,
                            drapeauxConstructeur);
                    }
                }
                sinon {
                    booléen champConstant = EstTypeConstantSemantique(
                        etat, hachageTypeValeur);
                    booléen champAdresse = EstTypeAdresseSemantique(
                            etat, hachageTypeValeur)
                        || EstTypeReferenceSemantique(
                            etat, hachageTypeValeur);
                    si (champConstant && !champAdresse)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::ChampConstantNonInitialise,
                            indexNoeudChamp,
                            convertir<naturel32>(indexChamp));
                }
            }
            indexChamp = indexChamp + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    naturel64 AlignerDispositionSemantique(
        naturel64 valeur, naturel64 alignement) {
        si (alignement <= 1) retourner valeur;
        retourner ((valeur + alignement - 1) / alignement) * alignement;
    }

    externe ErreurAnalyseSemantique CalculerDispositionTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType);

    ErreurAnalyseSemantique CalculerTailleValeurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeud,
        naturel64* taille,
        naturel64* alignement) {
        constante NoeudDeclaration* noeud = &etat->Requete->Noeuds[indexNoeud];
        naturel64 hachageValeur = noeud->HachageType;
        DescriptionHachageTypeSemantique dimensions;
        booléen tableau = LireDimensionsNoeudSemantique(
            etat, indexNoeud, &dimensions);
        si (tableau)
            hachageValeur = HachageElementFinalTableauSemantique(
                etat, indexNoeud);

        *taille = 0;
        *alignement = 1;
        DescriptionTypeJetonsSemantique typeFonctionDisposition;
        booléen pointeurFonctionDisposition =
            LireTypePointeurFonctionNoeudSemantique(
                etat, indexNoeud, &typeFonctionDisposition)
            && typeFonctionDisposition.Genre == 14;
        si (pointeurFonctionDisposition
            || EstTypeAdresseSemantique(etat, hachageValeur)
            || EstTypeReferenceSemantique(etat, hachageValeur)) {
            *taille = 8;
            *alignement = 8;
        }
        sinon {
            naturel32 genre = 1;
            tantque (genre <= 12 && *taille == 0) {
                naturel32 qualificatifs = 0;
                tantque (qualificatifs < 8 && *taille == 0) {
                    si (hachageValeur == HacherTypeSimpleSemantique(
                            genre, qualificatifs, 0)) {
                        si (genre == 1 || genre == 5 || genre == 9
                            || genre == 10 || genre == 11) {
                            *taille = 1;
                            *alignement = 1;
                        }
                        sinon si (genre == 2 || genre == 6) {
                            *taille = 2;
                            *alignement = 2;
                        }
                        sinon si (genre == 3 || genre == 7) {
                            *taille = 4;
                            *alignement = 4;
                        }
                        sinon si (genre == 4 || genre == 8) {
                            *taille = 8;
                            *alignement = 8;
                        }
                    }
                    qualificatifs = qualificatifs + 1;
                }
                genre = genre + 1;
            }
        }

        si (*taille == 0) {
            naturel64 indexType = TrouverTypeDepuisHachageSemantique(
                etat, hachageValeur, 0);
            si (indexType < etat->NombreSymboles) {
                naturel32 genreType = etat->Requete->Noeuds[
                    etat->SymbolesTravail[indexType].IndexNoeud].Genre;
                si (genreType == 8) {
                    *taille = 4;
                    *alignement = 4;
                }
                sinon {
                    ErreurAnalyseSemantique erreurDisposition =
                        CalculerDispositionTypeSemantique(etat, indexType);
                    si (erreurDisposition != ErreurAnalyseSemantique::Reussite)
                        retourner erreurDisposition;
                    *taille = etat->TaillesTypes[indexType];
                    *alignement = etat->AlignementsTypes[indexType];
                }
            }
        }

        si (*taille == 0)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::TailleObjetInvalide,
                indexNoeud,
                0);

        si (tableau) {
            naturel32 indexDimension = 0;
            tantque (indexDimension < dimensions.NombreDimensions) {
                naturel64 valeurDimension = 0;
                si (!LireDimensionNoeudSemantique(
                        etat,
                        indexNoeud,
                        indexDimension,
                        &valeurDimension)
                    || valeurDimension == 0
                    || *taille > 4_294_967_295 / valeurDimension)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::TailleObjetInvalide,
                        indexNoeud,
                        indexDimension);
                *taille = *taille * valeurDimension;
                indexDimension = indexDimension + 1;
            }
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    booléen EstTypePolymorpheSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        si (indexType >= etat->NombreSymboles) retourner faux;
        si (etat->EtatsPolymorphisme[indexType] == 2) retourner faux;
        si (etat->EtatsPolymorphisme[indexType] == 3) retourner vrai;
        si (etat->EtatsPolymorphisme[indexType] == 1) retourner faux;
        etat->EtatsPolymorphisme[indexType] = 1;

        booléen polymorphe = faux;
        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(etat, indexType);
        si (typeBase < etat->NombreSymboles)
            polymorphe = EstTypePolymorpheSemantique(etat, typeBase);
        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles && !polymorphe) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 12
                && (etat->Requete->Noeuds[
                        candidat->IndexNoeud].Drapeaux & (64 | 128)) != 0)
                polymorphe = vrai;
            index = index + 1;
        }
        si (polymorphe) etat->EtatsPolymorphisme[indexType] = 3;
        sinon etat->EtatsPolymorphisme[indexType] = 2;
        retourner polymorphe;
    }

    ErreurAnalyseSemantique CalculerDispositionTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        si (indexType >= etat->NombreSymboles)
            retourner ErreurAnalyseSemantique::TailleObjetInvalide;
        si (etat->EtatsDisposition[indexType] == 2)
            retourner ErreurAnalyseSemantique::Reussite;
        si (etat->EtatsDisposition[indexType] == 1)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::CycleTypeParValeur,
                etat->SymbolesTravail[indexType].IndexNoeud,
                convertir<naturel32>(indexType));
        etat->EtatsDisposition[indexType] = 1;

        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        constante NoeudDeclaration* noeudType = &etat->Requete->Noeuds[
            indexNoeudType];
        naturel64 position = 0;
        naturel64 alignement = 1;
        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(etat, indexType);
        booléen basePolymorphe = faux;
        si (typeBase < etat->NombreSymboles) {
            ErreurAnalyseSemantique erreurBase =
                CalculerDispositionTypeSemantique(etat, typeBase);
            si (erreurBase != ErreurAnalyseSemantique::Reussite)
                retourner erreurBase;
            position = etat->TaillesTypes[typeBase];
            alignement = etat->AlignementsTypes[typeBase];
            basePolymorphe = EstTypePolymorpheSemantique(etat, typeBase);
        }

        si (noeudType->Genre == 6
            && EstTypePolymorpheSemantique(etat, indexType)) {
            si (basePolymorphe)
                etat->DecalagesTablesVirtuelles[indexType] =
                    etat->DecalagesTablesVirtuelles[typeBase];
            sinon {
                position = AlignerDispositionSemantique(position, 8);
                etat->DecalagesTablesVirtuelles[indexType] = position;
                position = position + 8;
                si (alignement < 8) alignement = 8;
            }
        }

        naturel64 indexChamp = 0;
        tantque (indexChamp < etat->NombreSymboles) {
            SymboleSemantique* champ = &etat->SymbolesTravail[indexChamp];
            si (champ->Genre == 5 && champ->IndexPortee == indexNoeudType) {
                naturel64 tailleChamp = 0;
                naturel64 alignementChamp = 1;
                ErreurAnalyseSemantique erreurChamp =
                    CalculerTailleValeurSemantique(
                        etat,
                        champ->IndexNoeud,
                        &tailleChamp,
                        &alignementChamp);
                si (erreurChamp != ErreurAnalyseSemantique::Reussite)
                    retourner erreurChamp;
                si (noeudType->Genre == 5) {
                    etat->DecalagesChamps[indexChamp] = 0;
                    si (position < tailleChamp) position = tailleChamp;
                }
                sinon {
                    position = AlignerDispositionSemantique(
                        position, alignementChamp);
                    etat->DecalagesChamps[indexChamp] = position;
                    position = position + tailleChamp;
                }
                si (alignement < alignementChamp)
                    alignement = alignementChamp;
            }
            indexChamp = indexChamp + 1;
        }

        si (position == 0) position = 1;
        position = AlignerDispositionSemantique(position, alignement);
        si (position > 4_294_967_295)
            retourner SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::TailleObjetInvalide,
                indexNoeudType,
                0);
        etat->TaillesTypes[indexType] = position;
        etat->AlignementsTypes[indexType] = alignement;
        etat->EtatsDisposition[indexType] = 2;
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique CalculerDispositionsSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            si (etat->SymbolesTravail[index].Genre == 1) {
                naturel32 genre = etat->Requete->Noeuds[
                    etat->SymbolesTravail[index].IndexNoeud].Genre;
                si (genre == 4 || genre == 5 || genre == 6) {
                    ErreurAnalyseSemantique erreur =
                        CalculerDispositionTypeSemantique(etat, index);
                    si (erreur != ErreurAnalyseSemantique::Reussite)
                        retourner erreur;
                }
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique VerifierCyclesDelegationConstructeurSemantique(
        EtatAnalyseSemantique* etat) {
        naturel64 indexDepartDelegation = 0;
        tantque (indexDepartDelegation < etat->Requete->NombreNoeuds) {
            si (etat->Requete->Noeuds[indexDepartDelegation].Genre == 33) {
                naturel64 indexCourantDelegation = indexDepartDelegation;
                naturel64 profondeurDelegation = 0;
                tantque (indexCourantDelegation
                        < etat->Requete->NombreNoeuds
                    && profondeurDelegation < etat->NombreSymboles) {
                    naturel64 cibleCouranteDelegation =
                        etat->CiblesInitialiseurs[indexCourantDelegation];
                    si (cibleCouranteDelegation >= etat->NombreSymboles) {
                        indexCourantDelegation =
                            etat->Requete->NombreNoeuds;
                    }
                    sinon {
                        naturel64 constructeurCourantDelegation =
                            etat->SymbolesTravail[
                                cibleCouranteDelegation].IndexNoeud;
                        indexCourantDelegation =
                            TrouverInitialiseurDelegueConstructeurSemantique(
                                etat, constructeurCourantDelegation);
                        profondeurDelegation = profondeurDelegation + 1;
                    }
                }
                si (indexCourantDelegation
                    < etat->Requete->NombreNoeuds)
                    retourner SignalerErreurSemantique(
                        etat,
                        ErreurAnalyseSemantique::CycleDelegationConstructeur,
                        indexDepartDelegation,
                        convertir<naturel32>(profondeurDelegation));
            }
            indexDepartDelegation = indexDepartDelegation + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    structure ContextePlanDureeVieSemantique {
        naturel64 IndexNoeudOrigine;
        naturel64 IndexTypeContexte;
        naturel64 Decalage;
        naturel32 Drapeaux;
        naturel32 Reserve;
    };

    booléen AccesMembreDepuisTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexMembre,
        naturel64 indexTypeContexte) {
        si (indexMembre >= etat->NombreSymboles) retourner faux;
        constante NoeudDeclaration* declaration = &etat->Requete->Noeuds[
            etat->SymbolesTravail[indexMembre].IndexNoeud];
        si ((declaration->Drapeaux & 1) != 0) retourner vrai;
        naturel64 indexTypeDeclarant = TrouverSymboleNoeudSemantique(
            etat, etat->SymbolesTravail[indexMembre].IndexPortee);
        si (indexTypeDeclarant >= etat->NombreSymboles
            || indexTypeContexte >= etat->NombreSymboles)
            retourner faux;
        si (indexTypeDeclarant == indexTypeContexte) retourner vrai;
        retourner (declaration->Drapeaux & 8) != 0
            && EstTypeDeriveSemantique(
                etat, indexTypeContexte, indexTypeDeclarant);
    }

    naturel64 TrouverDestructeurTypeSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexType) {
        si (indexType >= etat->NombreSymboles) retourner etat->NombreSymboles;
        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 14)
                retourner index;
            index = index + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 TrouverInitialiseurGenreConstructeurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexConstructeur,
        naturel32 genre) {
        naturel64 index = indexConstructeur + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* candidat = &etat->Requete->Noeuds[index];
            si (candidat->Parent == indexConstructeur
                && candidat->Genre == genre)
                retourner index;
            index = index + 1;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    naturel64 TrouverInitialiseurChampPlanSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexConstructeur,
        naturel64 indexChamp) {
        naturel64 index = indexConstructeur + 1;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* candidat = &etat->Requete->Noeuds[index];
            si (candidat->Parent == indexConstructeur
                && candidat->Genre == 35
                && etat->CiblesInitialiseurs[index] == indexChamp)
                retourner index;
            index = index + 1;
        }
        retourner etat->Requete->NombreNoeuds;
    }

    naturel64 CompterElementsTableauPlanSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexNoeud) {
        DescriptionHachageTypeSemantique dimensions;
        si (!LireDimensionsNoeudSemantique(etat, indexNoeud, &dimensions))
            retourner 1;
        naturel64 nombre = 1;
        naturel32 index = 0;
        tantque (index < dimensions.NombreDimensions) {
            naturel64 valeur = 0;
            si (!LireDimensionNoeudSemantique(
                    etat, indexNoeud, index, &valeur))
                retourner 0;
            nombre = nombre * valeur;
            index = index + 1;
        }
        retourner nombre;
    }

    externe ErreurAnalyseSemantique PlanifierConstructionClasseSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte);

    externe ErreurAnalyseSemantique PlanifierDestructionClasseSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte);

    ErreurAnalyseSemantique PlanifierConstructeurUniformeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeudType,
        naturel64 indexConstructeur,
        ContextePlanDureeVieSemantique* contexte) {
        naturel64 indexType = TrouverTypeElementFinalTableauSemantique(
            etat, indexNoeudType);
        si (indexType >= etat->NombreSymboles)
            indexType = TrouverTypeDepuisHachageSemantique(
                etat,
                etat->Requete->Noeuds[indexNoeudType].HachageType,
                0);
        si (indexType >= etat->NombreSymboles)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 nombre = CompterElementsTableauPlanSemantique(
            etat, indexNoeudType);
        naturel64 tailleElement = etat->TaillesTypes[indexType];
        naturel64 index = 0;
        tantque (index < nombre) {
            DescriptionEtapeDureeVieSemantique etape = {
                contexte->Decalage + index * tailleElement,
                contexte->Drapeaux | 65_536,
                0};
            si (nombre > 1) etape.Drapeaux = etape.Drapeaux | 2_097_152;
            AjouterEtapeDureeVieSemantique(
                etat,
                contexte->IndexNoeudOrigine,
                indexConstructeur,
                &etape);
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique PlanifierConstructionObjetSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeudType,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte) {
        si (indexType >= etat->NombreSymboles
            || etat->Requete->Noeuds[
                etat->SymbolesTravail[indexType].IndexNoeud].Genre != 6)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 nombre = CompterElementsTableauPlanSemantique(
            etat, indexNoeudType);
        naturel64 tailleElement = etat->TaillesTypes[indexType];
        naturel64 index = 0;
        tantque (index < nombre) {
            ContextePlanDureeVieSemantique element = *contexte;
            element.Decalage = contexte->Decalage + index * tailleElement;
            si (nombre > 1)
                element.Drapeaux = element.Drapeaux | 2_097_152;
            ErreurAnalyseSemantique erreur = PlanifierConstructionClasseSemantique(
                etat, indexType, &element);
            si (erreur != ErreurAnalyseSemantique::Reussite)
                retourner erreur;
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique PlanifierDestructionObjetSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexNoeudType,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte) {
        si (indexType >= etat->NombreSymboles
            || etat->Requete->Noeuds[
                etat->SymbolesTravail[indexType].IndexNoeud].Genre != 6)
            retourner ErreurAnalyseSemantique::Reussite;
        naturel64 nombre = CompterElementsTableauPlanSemantique(
            etat, indexNoeudType);
        naturel64 tailleElement = etat->TaillesTypes[indexType];
        tantque (nombre > 0) {
            nombre = nombre - 1;
            ContextePlanDureeVieSemantique element = *contexte;
            element.Decalage = contexte->Decalage + nombre * tailleElement;
            si (CompterElementsTableauPlanSemantique(etat, indexNoeudType) > 1)
                element.Drapeaux = element.Drapeaux | 2_097_152;
            ErreurAnalyseSemantique erreur = PlanifierDestructionClasseSemantique(
                etat, indexType, &element);
            si (erreur != ErreurAnalyseSemantique::Reussite)
                retourner erreur;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique PlanifierConstructionClasseSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte) {
        naturel64 nombreConstructeurs = CompterConstructeursTypeSemantique(
            etat, indexType);
        si (nombreConstructeurs != 0) {
            naturel64 cibleConstructeurPlan = SelectionnerConstructeurSansArgumentSemantique(
                etat, contexte->IndexNoeudOrigine, indexType);
            si (cibleConstructeurPlan >= etat->NombreSymboles)
                retourner etat->Requete->Resultat.Erreur;
            si (!AccesMembreDepuisTypeSemantique(
                    etat, cibleConstructeurPlan, contexte->IndexTypeContexte))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::ConstructeurInaccessible,
                    contexte->IndexNoeudOrigine,
                    convertir<naturel32>(cibleConstructeurPlan));
            DescriptionEtapeDureeVieSemantique etape = {
                contexte->Decalage,
                contexte->Drapeaux | 65_536,
                0};
            AjouterEtapeDureeVieSemantique(
                etat,
                contexte->IndexNoeudOrigine,
                cibleConstructeurPlan,
                &etape);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(etat, indexType);
        si (typeBase < etat->NombreSymboles) {
            ContextePlanDureeVieSemantique base = *contexte;
            base.IndexTypeContexte = indexType;
            base.Drapeaux = base.Drapeaux | 524_288;
            ErreurAnalyseSemantique erreurBase =
                PlanifierConstructionClasseSemantique(etat, typeBase, &base);
            si (erreurBase != ErreurAnalyseSemantique::Reussite)
                retourner erreurBase;
        }

        si (EstTypePolymorpheSemantique(etat, indexType)) {
            DescriptionEtapeDureeVieSemantique table = {
                contexte->Decalage
                    + etat->DecalagesTablesVirtuelles[indexType],
                contexte->Drapeaux | 65_536 | 262_144,
                0};
            AjouterEtapeDureeVieSemantique(
                etat,
                contexte->IndexNoeudOrigine,
                indexType,
                &table);
        }

        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 indexChamp = 0;
        tantque (indexChamp < etat->NombreSymboles) {
            SymboleSemantique* champ = &etat->SymbolesTravail[indexChamp];
            si (champ->Genre == 5 && champ->IndexPortee == indexNoeudType) {
                naturel64 typeChamp = TrouverTypeElementFinalTableauSemantique(
                    etat, champ->IndexNoeud);
                si (typeChamp >= etat->NombreSymboles)
                    typeChamp = TrouverTypeDepuisHachageSemantique(
                        etat, champ->HachageType, 0);
                ContextePlanDureeVieSemantique sousObjet = *contexte;
                sousObjet.IndexTypeContexte = indexType;
                sousObjet.Decalage = contexte->Decalage
                    + etat->DecalagesChamps[indexChamp];
                sousObjet.Drapeaux = sousObjet.Drapeaux | 1_048_576;
                ErreurAnalyseSemantique erreurChamp =
                    PlanifierConstructionObjetSemantique(
                        etat, champ->IndexNoeud, typeChamp, &sousObjet);
                si (erreurChamp != ErreurAnalyseSemantique::Reussite)
                    retourner erreurChamp;
            }
            indexChamp = indexChamp + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique PlanifierDestructionClasseSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        ContextePlanDureeVieSemantique* contexte) {
        naturel64 cibleDestructeurPlan = TrouverDestructeurTypeSemantique(
            etat, indexType);
        si (cibleDestructeurPlan < etat->NombreSymboles) {
            si (!AccesMembreDepuisTypeSemantique(
                    etat, cibleDestructeurPlan, contexte->IndexTypeContexte))
                retourner SignalerErreurSemantique(
                    etat,
                    ErreurAnalyseSemantique::DestructeurInaccessible,
                    contexte->IndexNoeudOrigine,
                    convertir<naturel32>(cibleDestructeurPlan));
            DescriptionEtapeDureeVieSemantique etape = {
                contexte->Decalage,
                contexte->Drapeaux | 131_072,
                0};
            AjouterEtapeDureeVieSemantique(
                etat,
                contexte->IndexNoeudOrigine,
                cibleDestructeurPlan,
                &etape);
        }

        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 indexChamp = etat->NombreSymboles;
        tantque (indexChamp > 0) {
            indexChamp = indexChamp - 1;
            SymboleSemantique* champ = &etat->SymbolesTravail[indexChamp];
            si (champ->Genre == 5 && champ->IndexPortee == indexNoeudType) {
                naturel64 typeChamp = TrouverTypeElementFinalTableauSemantique(
                    etat, champ->IndexNoeud);
                si (typeChamp >= etat->NombreSymboles)
                    typeChamp = TrouverTypeDepuisHachageSemantique(
                        etat, champ->HachageType, 0);
                ContextePlanDureeVieSemantique sousObjet = *contexte;
                sousObjet.IndexTypeContexte = indexType;
                sousObjet.Decalage = contexte->Decalage
                    + etat->DecalagesChamps[indexChamp];
                sousObjet.Drapeaux = sousObjet.Drapeaux | 1_048_576;
                ErreurAnalyseSemantique erreurChamp =
                    PlanifierDestructionObjetSemantique(
                        etat, champ->IndexNoeud, typeChamp, &sousObjet);
                si (erreurChamp != ErreurAnalyseSemantique::Reussite)
                    retourner erreurChamp;
            }
        }

        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(etat, indexType);
        si (typeBase < etat->NombreSymboles) {
            ContextePlanDureeVieSemantique base = *contexte;
            base.IndexTypeContexte = indexType;
            base.Drapeaux = base.Drapeaux | 524_288;
            retourner PlanifierDestructionClasseSemantique(
                etat, typeBase, &base);
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique PlanifierCorpsConstructeurSemantique(
        EtatAnalyseSemantique* etat, naturel64 indexConstructeur) {
        naturel64 indexType = TrouverSymboleNoeudSemantique(
            etat, etat->Requete->Noeuds[indexConstructeur].Parent);
        si (indexType >= etat->NombreSymboles)
            retourner ErreurAnalyseSemantique::AstInvalide;
        ContextePlanDureeVieSemantique contexte = {
            indexConstructeur,
            indexType,
            0,
            0,
            0};

        naturel64 delegation = TrouverInitialiseurGenreConstructeurSemantique(
            etat, indexConstructeur, 33);
        si (delegation < etat->Requete->NombreNoeuds) {
            naturel64 cibleDelegationPlan =
                etat->CiblesInitialiseurs[delegation];
            DescriptionEtapeDureeVieSemantique etape = {
                0, 65_536 | 512, 0};
            AjouterEtapeDureeVieSemantique(
                etat, indexConstructeur, cibleDelegationPlan, &etape);
            retourner ErreurAnalyseSemantique::Reussite;
        }

        naturel64 typeBase = TrouverTypeBaseSymboleSemantique(etat, indexType);
        si (typeBase < etat->NombreSymboles) {
            naturel64 initialiseurBase =
                TrouverInitialiseurGenreConstructeurSemantique(
                    etat, indexConstructeur, 34);
            si (initialiseurBase < etat->Requete->NombreNoeuds) {
                DescriptionEtapeDureeVieSemantique etapeBase = {
                    0, 65_536 | 1_024 | 524_288, 0};
                AjouterEtapeDureeVieSemantique(
                    etat,
                    indexConstructeur,
                    etat->CiblesInitialiseurs[initialiseurBase],
                    &etapeBase);
            }
            sinon {
                ContextePlanDureeVieSemantique base = contexte;
                base.Drapeaux = 524_288;
                ErreurAnalyseSemantique erreurBase =
                    PlanifierConstructionClasseSemantique(
                        etat, typeBase, &base);
                si (erreurBase != ErreurAnalyseSemantique::Reussite)
                    retourner erreurBase;
            }
        }

        si (EstTypePolymorpheSemantique(etat, indexType)) {
            DescriptionEtapeDureeVieSemantique table = {
                etat->DecalagesTablesVirtuelles[indexType],
                65_536 | 262_144,
                0};
            AjouterEtapeDureeVieSemantique(
                etat, indexConstructeur, indexType, &table);
        }

        naturel64 indexNoeudType = etat->SymbolesTravail[indexType].IndexNoeud;
        naturel64 indexChamp = 0;
        tantque (indexChamp < etat->NombreSymboles) {
            SymboleSemantique* champ = &etat->SymbolesTravail[indexChamp];
            si (champ->Genre == 5 && champ->IndexPortee == indexNoeudType) {
                naturel64 typeChamp = TrouverTypeElementFinalTableauSemantique(
                    etat, champ->IndexNoeud);
                si (typeChamp >= etat->NombreSymboles)
                    typeChamp = TrouverTypeDepuisHachageSemantique(
                        etat, champ->HachageType, 0);
                si (typeChamp < etat->NombreSymboles
                    && etat->Requete->Noeuds[
                        etat->SymbolesTravail[typeChamp].IndexNoeud].Genre == 6) {
                    ContextePlanDureeVieSemantique sousObjet = contexte;
                    sousObjet.Decalage = etat->DecalagesChamps[indexChamp];
                    sousObjet.Drapeaux = 1_048_576;
                    naturel64 initialiseur = TrouverInitialiseurChampPlanSemantique(
                        etat, indexConstructeur, indexChamp);
                    naturel64 nombreConstructeurs =
                        CompterConstructeursTypeSemantique(etat, typeChamp);
                    si (initialiseur < etat->Requete->NombreNoeuds
                        && nombreConstructeurs != 0) {
                        naturel64 cibleConstructeurChampPlan =
                            SelectionnerConstructeurSemantique(
                            etat, initialiseur, typeChamp);
                        si (cibleConstructeurChampPlan >= etat->NombreSymboles)
                            retourner etat->Requete->Resultat.Erreur;
                        sousObjet.Drapeaux = sousObjet.Drapeaux | 128 | 2_048;
                        ErreurAnalyseSemantique erreurChampExplicitePlan =
                            PlanifierConstructeurUniformeSemantique(
                                etat,
                                champ->IndexNoeud,
                                cibleConstructeurChampPlan,
                                &sousObjet);
                        si (erreurChampExplicitePlan
                            != ErreurAnalyseSemantique::Reussite)
                            retourner erreurChampExplicitePlan;
                    }
                    sinon {
                        si (initialiseur < etat->Requete->NombreNoeuds)
                            sousObjet.Drapeaux = sousObjet.Drapeaux | 2_048;
                        sinon sousObjet.Drapeaux = sousObjet.Drapeaux | 4_096;
                        ErreurAnalyseSemantique erreurChampImplicitePlan =
                            PlanifierConstructionObjetSemantique(
                                etat,
                                champ->IndexNoeud,
                                typeChamp,
                                &sousObjet);
                        si (erreurChampImplicitePlan
                            != ErreurAnalyseSemantique::Reussite)
                            retourner erreurChampImplicitePlan;
                    }
                }
            }
            indexChamp = indexChamp + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique PlanifierDureesVieSemantiques(
        EtatAnalyseSemantique* etat) {
        naturel64 index = 0;
        tantque (index < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* noeud = &etat->Requete->Noeuds[index];
            si (noeud->Genre == 13) {
                ErreurAnalyseSemantique erreurConstructeur =
                    PlanifierCorpsConstructeurSemantique(etat, index);
                si (erreurConstructeur != ErreurAnalyseSemantique::Reussite)
                    retourner erreurConstructeur;
            }
            sinon si (noeud->Genre == 19
                && !EstTypeAdresseSemantique(etat, noeud->HachageType)
                && !EstTypeReferenceSemantique(etat, noeud->HachageType)) {
                naturel64 indexType = TrouverTypeElementFinalTableauSemantique(
                    etat, index);
                si (indexType >= etat->NombreSymboles)
                    indexType = TrouverTypeDepuisHachageSemantique(
                        etat, noeud->HachageType, 0);
                si (indexType < etat->NombreSymboles
                    && etat->Requete->Noeuds[
                        etat->SymbolesTravail[indexType].IndexNoeud].Genre == 6) {
                    ContextePlanDureeVieSemantique contexte = {
                        index,
                        TrouverRecepteurSemantique(etat, index),
                        0,
                        0,
                        0};
                    naturel64 nombreConstructeurs =
                        CompterConstructeursTypeSemantique(etat, indexType);
                    ErreurAnalyseSemantique erreurConstruction =
                        ErreurAnalyseSemantique::Reussite;
                    si (nombreConstructeurs != 0) {
                        naturel64 cible = SelectionnerConstructeurSemantique(
                            etat, index, indexType);
                        si (cible >= etat->NombreSymboles)
                            retourner etat->Requete->Resultat.Erreur;
                        si ((noeud->Drapeaux & 8_192) != 0)
                            contexte.Drapeaux = contexte.Drapeaux | 128;
                        sinon contexte.Drapeaux = contexte.Drapeaux | 4_096;
                        erreurConstruction =
                            PlanifierConstructeurUniformeSemantique(
                                etat, index, cible, &contexte);
                    }
                    sinon erreurConstruction =
                        PlanifierConstructionObjetSemantique(
                            etat, index, indexType, &contexte);
                    si (erreurConstruction != ErreurAnalyseSemantique::Reussite)
                        retourner erreurConstruction;

                    ErreurAnalyseSemantique erreurDestruction =
                        PlanifierDestructionObjetSemantique(
                            etat, index, indexType, &contexte);
                    si (erreurDestruction != ErreurAnalyseSemantique::Reussite)
                        retourner erreurDestruction;
                }
            }
            index = index + 1;
        }
        retourner ErreurAnalyseSemantique::Reussite;
    }

    ErreurAnalyseSemantique ResoudreConstructionsSemantiques(
        EtatAnalyseSemantique* etat) {
        ErreurAnalyseSemantique erreurChampsParDefaut =
            ValiderChampsParDefautSemantiques(etat);
        si (erreurChampsParDefaut != ErreurAnalyseSemantique::Reussite)
            retourner erreurChampsParDefaut;
        naturel64 indexVariable = 0;
        tantque (indexVariable < etat->Requete->NombreNoeuds) {
            constante NoeudDeclaration* variable =
                &etat->Requete->Noeuds[indexVariable];
            si (variable->Genre == 13) {
                ErreurAnalyseSemantique erreurBaseImplicite =
                    ResoudreBaseImpliciteConstructeurSemantique(
                        etat, indexVariable);
                si (erreurBaseImplicite
                    != ErreurAnalyseSemantique::Reussite)
                    retourner erreurBaseImplicite;
            }
            sinon si (variable->Genre == 33) {
                ErreurAnalyseSemantique erreurDelegation =
                    ResoudreInitialiseurDelegueSemantique(
                        etat, indexVariable);
                si (erreurDelegation != ErreurAnalyseSemantique::Reussite)
                    retourner erreurDelegation;
            }
            sinon si (variable->Genre == 34) {
                ErreurAnalyseSemantique erreurBase =
                    ResoudreInitialiseurBaseSemantique(
                        etat, indexVariable);
                si (erreurBase != ErreurAnalyseSemantique::Reussite)
                    retourner erreurBase;
            }
            sinon si (variable->Genre == 35) {
                ErreurAnalyseSemantique erreurChamp =
                    ResoudreInitialiseurChampSemantique(
                        etat, indexVariable);
                si (erreurChamp != ErreurAnalyseSemantique::Reussite)
                    retourner erreurChamp;
            }
            sinon si (variable->Genre == 19) {
                naturel64 typeElementTableau =
                    HachageElementFinalTableauSemantique(
                        etat, indexVariable);
                booléen variableTableau = typeElementTableau != 0;
                naturel64 type = TrouverTypeDepuisHachageSemantique(
                    etat, variable->HachageType, 0);
                si (variableTableau)
                    type = TrouverTypeDepuisHachageSemantique(
                        etat, typeElementTableau, 0);
                si (type < etat->NombreSymboles
                    && etat->Requete->Noeuds[
                        etat->SymbolesTravail[type].IndexNoeud].Genre == 6) {
                    si ((variable->Drapeaux & 2_048) != 0)
                        retourner SignalerErreurSemantique(
                            etat,
                            ErreurAnalyseSemantique::InitialiseurClasseInterdit,
                            indexVariable,
                            0);
                    naturel64 nombreConstructeurs =
                        CompterConstructeursTypeSemantique(etat, type);
                    booléen explicite = (variable->Drapeaux & 8_192) != 0;
                    naturel64 nombreArguments =
                        CompterEnfantsDirectsSemantique(etat, indexVariable);
                    si (nombreConstructeurs == 0) {
                        si (explicite || nombreArguments != 0)
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::ConstructeurNonDeclare,
                                indexVariable,
                                convertir<naturel32>(nombreArguments));
                    }
                    sinon {
                        naturel64 cibleConstructeur =
                            SelectionnerConstructeurSemantique(
                                etat, indexVariable, type);
                        si (cibleConstructeur >= etat->NombreSymboles)
                            retourner etat->Requete->Resultat.Erreur;
                        si (!AccesMembreAutoriseSemantique(
                                etat, cibleConstructeur, indexVariable))
                            retourner SignalerErreurSemantique(
                                etat,
                                ErreurAnalyseSemantique::ConstructeurInaccessible,
                                indexVariable,
                                convertir<naturel32>(cibleConstructeur));
                        naturel32 drapeaux = 64;
                        si (explicite) drapeaux = drapeaux | 128;
                        sinon si (variableTableau)
                            drapeaux = drapeaux | 4_096;
                        si (variableTableau)
                            drapeaux = drapeaux | 8_192;
                        si (nombreConstructeurs > 1)
                            drapeaux = drapeaux | 1;
                        AjouterResolutionSemantique(
                            etat,
                            indexVariable,
                            cibleConstructeur,
                            drapeaux);
                    }
                }
            }
            indexVariable = indexVariable + 1;
        }
        indexVariable = 0;
        tantque (indexVariable < etat->Requete->NombreNoeuds) {
            si (etat->Requete->Noeuds[indexVariable].Genre == 13) {
                ErreurAnalyseSemantique erreurChampsImplicites =
                    ResoudreChampsImplicitesConstructeurSemantique(
                        etat, indexVariable);
                si (erreurChampsImplicites
                    != ErreurAnalyseSemantique::Reussite)
                    retourner erreurChampsImplicites;
            }
            indexVariable = indexVariable + 1;
        }
        ErreurAnalyseSemantique erreurCycles =
            VerifierCyclesDelegationConstructeurSemantique(etat);
        si (erreurCycles != ErreurAnalyseSemantique::Reussite)
            retourner erreurCycles;
        retourner PlanifierDureesVieSemantiques(etat);
    }

    naturel64 CompterOperateursTypeSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageOperateur) {
        naturel64 nombre = 0;
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexType].IndexNoeud;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && candidat->HachageNom == hachageOperateur
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 15)
                nombre = nombre + 1;
            index = index + 1;
        }
        retourner nombre;
    }

    naturel64 TrouverTypeDeclarantOperateurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexType,
        naturel64 hachageOperateur) {
        naturel64 courant = indexType;
        naturel64 profondeur = 0;
        tantque (courant < etat->NombreSymboles
            && profondeur < etat->NombreSymboles) {
            si (CompterOperateursTypeSemantique(
                    etat, courant, hachageOperateur) != 0)
                retourner courant;
            courant = TrouverTypeBaseSymboleSemantique(etat, courant);
            profondeur = profondeur + 1;
        }
        retourner etat->NombreSymboles;
    }

    naturel64 SelectionnerOperateurSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64 indexTypeDeclarant) {
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        naturel64 indexNoeudType = etat->SymbolesTravail[
            indexTypeDeclarant].IndexNoeud;
        naturel64 meilleure = etat->NombreSymboles;
        naturel32 meilleurScore = 4_294_967_295;
        naturel32 nombreMeilleures = 0;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == indexNoeudType
                && candidat->HachageNom == expression->HachageNom
                && etat->Requete->Noeuds[candidat->IndexNoeud].Genre == 15) {
                naturel32 score = EvaluerArgumentsFonctionSemantique(
                        etat,
                        indexExpression,
                        candidat->IndexNoeud,
                        1);
                si (score != 4_294_967_295) {
                    si (score < meilleurScore) {
                        meilleure = index;
                        meilleurScore = score;
                        nombreMeilleures = 1;
                    }
                    sinon si (score == meilleurScore)
                        nombreMeilleures = nombreMeilleures + 1;
                }
            }
            index = index + 1;
        }

        si (meilleure >= etat->NombreSymboles) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AucuneSurchargeCompatible,
                indexExpression,
                convertir<naturel32>(
                    CompterEnfantsDirectsSemantique(
                        etat, indexExpression) - 1));
            retourner etat->NombreSymboles;
        }
        si (nombreMeilleures > 1) {
            SignalerErreurSemantique(
                etat,
                ErreurAnalyseSemantique::AppelSurchargeAmbigu,
                indexExpression,
                nombreMeilleures);
            retourner etat->NombreSymboles;
        }
        retourner meilleure;
    }

    booléen TrouverEspaceOperateurLibreSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
        naturel64* hachageEspace) {
        constante NoeudDeclaration* expression =
            &etat->Requete->Noeuds[indexExpression];
        naturel64 espaceGlobal = HachageVideSemantique();
        booléen espaceCourantTrouve = faux;
        naturel64 index = 0;
        tantque (index < etat->NombreSymboles) {
            SymboleSemantique* candidat = &etat->SymbolesTravail[index];
            si (candidat->Genre == 2
                && candidat->IndexPortee == 0
                && candidat->HachageNom == expression->HachageNom
                && etat->Requete->Noeuds[
                    candidat->IndexNoeud].Genre == 15) {
                si (candidat->HachageEspace == espaceGlobal) {
                    *hachageEspace = espaceGlobal;
                    retourner vrai;
                }
                si (candidat->HachageEspace
                    == expression->HachageEspace)
                    espaceCourantTrouve = vrai;
            }
            index = index + 1;
        }
        si (espaceCourantTrouve) {
            *hachageEspace = expression->HachageEspace;
            retourner vrai;
        }
        retourner faux;
    }

    naturel64 CompterOperateursLibresSemantique(
        EtatAnalyseSemantique* etat,
        naturel64 indexExpression,
