/**
 * Bibliothèque hébergée de Gs++ 0.26.
 * Les allocations sont toujours demandées explicitement. Les seuls services
 * dépendant de l’hôte sont regroupés dans l’espace GalacticShrine::GsPP::Hote.
 **/

espace GalacticShrine::GsPP::Hebergee {
    énumération CodeErreurHebergee {
        Reussite = 0,
        Success = 0,
        ArgumentInvalide = 1,
        InvalidArgument = 1,
        AllocationEchouee = 2,
        AllocationFailed = 2,
        CapaciteDepassee = 3,
        CapacityExceeded = 3,
        LectureEchouee = 4,
        ReadFailed = 4,
        EcritureEchouee = 5,
        WriteFailed = 5,
        CheminInvalide = 6,
        InvalidPath = 6,
        Utf8Invalide = 7,
        InvalidUtf8 = 7,
    };

    structure VueTexte {
        constante caractère* Donnees;
        naturel64 Taille;
        alias Data = Donnees;
        alias Size = Taille;
    };

    structure ChaineUtf8 {
        caractère* Donnees;
        naturel64 Taille;
        naturel64 Capacite;
    };

    structure VecteurOctetsDynamique {
        octet* Donnees;
        naturel64 Taille;
        naturel64 Capacite;
    };

    structure VecteurNaturelsDynamique {
        naturel64* Donnees;
        naturel64 Taille;
        naturel64 Capacite;
    };

    structure BlocArene {
        BlocArene* Suivant;
        naturel64 Capacite;
        naturel64 Position;
    };

    structure AreneMemoire {
        BlocArene* Premier;
        BlocArene* Dernier;
        naturel64 TailleBloc;
        naturel64 NombreOctets;
    };

    structure FluxLecture {
        octet* Donnees;
        naturel64 Taille;
        naturel64 Position;
    };

    structure FluxEcriture {
        octet* Donnees;
        naturel64 Capacite;
        naturel64 Position;
    };

    structure VecteurNaturels {
        naturel64* Donnees;
        naturel64 Taille;
        naturel64 Capacite;
    };

    structure EntreeTableSymboles {
        VueTexte Cle;
        naturel64 Valeur;
        booléen Occupee;
    };

    structure TableSymboles {
        EntreeTableSymboles* Entrees;
        naturel64 Capacite;
        naturel64 Nombre;
    };

    structure TableSymbolesDynamique {
        EntreeTableSymboles* Entrees;
        naturel64 Capacite;
        naturel64 Nombre;
    };

    structure RequeteFichier {
        constante caractère* Chemin;
        octet* Donnees;
        naturel64 Taille;
        naturel64 Capacite;
    };

    structure FichierAlloue {
        octet* Donnees;
        naturel64 Taille;
    };

    structure Diagnostic {
        naturel32 Niveau;
        naturel32 Ligne;
        naturel32 Colonne;
        naturel32 Reserve;
        VueTexte Fichier;
        VueTexte Message;
    };

    /**
     * <résumé>Construit une vue non propriétaire sur une zone de caractères.</résumé>
     * @Paramètre(constante caractère*: donnees) Adresse du premier caractère.
     * @Paramètre(naturel64: taille) Nombre de caractères accessibles.
     * @Retourner(VueTexte) Vue formée à partir de l'adresse et de la taille.
     **/
    publique VueTexte CreerVueTexte(
        constante caractère* donnees, naturel64 taille);
    /**
     * <résumé>Construit une vue sur un texte terminé par un caractère nul.</résumé>
     * @Paramètre(constante caractère*: texte) Adresse du premier caractère.
     * @Retourner(VueTexte) Vue qui exclut le caractère nul final.
     **/
    publique VueTexte CreerVueTexteTerminee(
        constante caractère* texte);
    /**
     * <résumé>Compare deux vues de texte octet par octet.</résumé>
     * @Paramètre(VueTexte: gauche) Première vue à comparer.
     * @Paramètre(VueTexte: droite) Deuxième vue à comparer.
     * @Retourner(booléen) `vrai` si les tailles et contenus sont identiques.
     **/
    publique booléen VuesTexteEgales(
        VueTexte gauche, VueTexte droite);
    /**
     * <résumé>Calcule le hachage FNV-1a d'une vue de texte.</résumé>
     * @Paramètre(VueTexte: texte) Vue dont le contenu doit être haché.
     * @Retourner(naturel64) Valeur de hachage non signée sur 64 bits.
     **/
    publique naturel64 HacherVueTexte(VueTexte texte);
    publique booléen ValiderUtf8(VueTexte texte);

    publique vide InitialiserChaineUtf8(ChaineUtf8* chaine);
    publique vide DetruireChaineUtf8(ChaineUtf8* chaine);
    publique CodeErreurHebergee ReserverChaineUtf8(
        ChaineUtf8* chaine, naturel64 capacite);
    publique CodeErreurHebergee AssignerChaineUtf8(
        ChaineUtf8* chaine, VueTexte texte);
    publique CodeErreurHebergee AjouterVueChaineUtf8(
        ChaineUtf8* chaine, VueTexte texte);
    publique CodeErreurHebergee AjouterAsciiChaineUtf8(
        ChaineUtf8* chaine, caractère valeur);
    publique VueTexte VueDepuisChaineUtf8(ChaineUtf8* chaine);

    publique vide InitialiserArene(
        AreneMemoire* arene, naturel64 tailleBloc);
    publique vide DetruireArene(AreneMemoire* arene);
    publique octet* AllouerArene(
        AreneMemoire* arene, naturel64 taille, naturel64 alignement);

    /**
     * <résumé>Crée un flux de lecture non propriétaire.</résumé>
     * @Paramètre(octet*: donnees) Adresse du premier octet lisible.
     * @Paramètre(naturel64: taille) Nombre total d'octets lisibles.
     * @Retourner(FluxLecture) Flux positionné au début de la zone.
     **/
    publique FluxLecture CreerFluxLecture(
        octet* donnees, naturel64 taille);
    /**
     * <résumé>Lit l'octet courant d'un flux et avance sa position.</résumé>
     * @Paramètre(FluxLecture*: flux) Flux de lecture à consommer.
     * @Paramètre(octet*: valeur) Destination qui reçoit l'octet lu.
     * @Retourner(booléen) `vrai` si un octet a été lu, sinon `faux`.
     **/
    publique booléen LireOctetFlux(
        FluxLecture* flux, octet* valeur);
    /**
     * <résumé>Copie un bloc depuis la position courante d'un flux.</résumé>
     * @Paramètre(FluxLecture*: flux) Flux de lecture à consommer.
     * @Paramètre(octet*: destination) Zone qui reçoit les octets.
     * @Paramètre(naturel64: taille) Nombre maximal d'octets à lire.
     * @Retourner(naturel64) Nombre d'octets effectivement copiés.
     **/
    publique naturel64 LireBlocFlux(
        FluxLecture* flux, octet* destination, naturel64 taille);
    /**
     * <résumé>Crée un flux d'écriture non propriétaire.</résumé>
     * @Paramètre(octet*: donnees) Adresse du premier octet inscriptible.
     * @Paramètre(naturel64: capacite) Nombre total d'octets inscriptibles.
     * @Retourner(FluxEcriture) Flux positionné au début de la zone.
     **/
    publique FluxEcriture CreerFluxEcriture(
        octet* donnees, naturel64 capacite);
    /**
     * <résumé>Écrit un octet à la position courante d'un flux.</résumé>
     * @Paramètre(FluxEcriture*: flux) Flux d'écriture à modifier.
     * @Paramètre(octet: valeur) Octet à écrire.
     * @Retourner(booléen) `vrai` si l'octet a été écrit, sinon `faux`.
     **/
    publique booléen EcrireOctetFlux(
        FluxEcriture* flux, octet valeur);
    /**
     * <résumé>Copie un bloc dans un flux d'écriture.</résumé>
     * @Paramètre(FluxEcriture*: flux) Flux d'écriture à modifier.
     * @Paramètre(octet*: source) Zone contenant les octets à copier.
     * @Paramètre(naturel64: taille) Nombre maximal d'octets à écrire.
     * @Retourner(naturel64) Nombre d'octets effectivement copiés.
     **/
    publique naturel64 EcrireBlocFlux(
        FluxEcriture* flux, octet* source, naturel64 taille);

    publique vide InitialiserVecteurNaturels(
        VecteurNaturels* vecteur, naturel64* stockage, naturel64 capacite);
    publique booléen AjouterNaturel(
        VecteurNaturels* vecteur, naturel64 valeur);
    publique booléen LireNaturel(
        VecteurNaturels* vecteur, naturel64 index, naturel64* valeur);

    publique vide InitialiserVecteurOctetsDynamique(
        VecteurOctetsDynamique* vecteur);
    publique vide DetruireVecteurOctetsDynamique(
        VecteurOctetsDynamique* vecteur);
    publique CodeErreurHebergee ReserverVecteurOctetsDynamique(
        VecteurOctetsDynamique* vecteur, naturel64 capacite);
    publique CodeErreurHebergee AjouterBlocVecteurOctetsDynamique(
        VecteurOctetsDynamique* vecteur, octet* source, naturel64 taille);

    publique vide InitialiserVecteurNaturelsDynamique(
        VecteurNaturelsDynamique* vecteur);
    publique vide DetruireVecteurNaturelsDynamique(
        VecteurNaturelsDynamique* vecteur);
    publique CodeErreurHebergee ReserverVecteurNaturelsDynamique(
        VecteurNaturelsDynamique* vecteur, naturel64 capacite);
    publique CodeErreurHebergee AjouterVecteurNaturelsDynamique(
        VecteurNaturelsDynamique* vecteur, naturel64 valeur);
    publique booléen LireVecteurNaturelsDynamique(
        VecteurNaturelsDynamique* vecteur,
        naturel64 index,
        naturel64* valeur);

    publique vide InitialiserTableSymboles(
        TableSymboles* table,
        EntreeTableSymboles* stockage,
        naturel64 capacite);
    publique booléen InsererSymbole(
        TableSymboles* table, VueTexte cle, naturel64 valeur);
    publique booléen ChercherSymbole(
        TableSymboles* table, VueTexte cle, naturel64* valeur);
    publique vide InitialiserTableSymbolesDynamique(
        TableSymbolesDynamique* table);
    publique vide DetruireTableSymbolesDynamique(
        TableSymbolesDynamique* table);
    publique CodeErreurHebergee ReserverTableSymbolesDynamique(
        TableSymbolesDynamique* table, naturel64 capacite);
    publique CodeErreurHebergee InsererTableSymbolesDynamique(
        TableSymbolesDynamique* table, VueTexte cle, naturel64 valeur);
    publique booléen ChercherTableSymbolesDynamique(
        TableSymbolesDynamique* table, VueTexte cle, naturel64* valeur);

    publique booléen ChargerFichier(
        constante caractère* chemin,
        octet* destination,
        naturel64 capacite,
        naturel64* taille);
    publique booléen SauverFichier(
        constante caractère* chemin, octet* source, naturel64 taille);
    publique CodeErreurHebergee ChargerFichierAlloue(
        constante caractère* chemin, FichierAlloue* fichier);
    publique vide InitialiserFichierAlloue(FichierAlloue* fichier);
    publique vide LibererFichierAlloue(FichierAlloue* fichier);
    publique CodeErreurHebergee SauverFichierResultat(
        constante caractère* chemin, octet* source, naturel64 taille);
    publique CodeErreurHebergee JoindreCheminUtf8(
        ChaineUtf8* sortie,
        VueTexte base,
        VueTexte enfant,
        caractère separateur);
    publique VueTexte NomFichierVue(VueTexte chemin);
    publique VueTexte ExtensionVue(VueTexte chemin);
    publique vide SignalerDiagnostic(Diagnostic diagnostic);

    alias MakeTextView = CreerVueTexte;
    alias MakeTerminatedTextView = CreerVueTexteTerminee;
    alias TextViewsEqual = VuesTexteEgales;
    alias HashTextView = HacherVueTexte;
    alias ValidateUtf8 = ValiderUtf8;
    alias InitializeUtf8String = InitialiserChaineUtf8;
    alias DestroyUtf8String = DetruireChaineUtf8;
    alias ReserveUtf8String = ReserverChaineUtf8;
    alias AssignUtf8String = AssignerChaineUtf8;
    alias AppendUtf8View = AjouterVueChaineUtf8;
    alias AppendAscii = AjouterAsciiChaineUtf8;
    alias ViewUtf8String = VueDepuisChaineUtf8;
    alias InitializeArena = InitialiserArene;
    alias DestroyArena = DetruireArene;
    alias ArenaAllocate = AllouerArene;
    alias MakeInputStream = CreerFluxLecture;
    alias ReadByte = LireOctetFlux;
    alias ReadBlock = LireBlocFlux;
    alias MakeOutputStream = CreerFluxEcriture;
    alias WriteByte = EcrireOctetFlux;
    alias WriteBlock = EcrireBlocFlux;
    alias InitializeVector = InitialiserVecteurNaturels;
    alias AppendValue = AjouterNaturel;
    alias ReadValue = LireNaturel;
    alias InitializeDynamicByteVector = InitialiserVecteurOctetsDynamique;
    alias DestroyDynamicByteVector = DetruireVecteurOctetsDynamique;
    alias ReserveDynamicByteVector = ReserverVecteurOctetsDynamique;
    alias AppendDynamicByteBlock = AjouterBlocVecteurOctetsDynamique;
    alias InitializeDynamicValueVector = InitialiserVecteurNaturelsDynamique;
    alias DestroyDynamicValueVector = DetruireVecteurNaturelsDynamique;
    alias ReserveDynamicValueVector = ReserverVecteurNaturelsDynamique;
    alias AppendDynamicValue = AjouterVecteurNaturelsDynamique;
    alias ReadDynamicValue = LireVecteurNaturelsDynamique;
    alias InitializeSymbolTable = InitialiserTableSymboles;
    alias InsertSymbol = InsererSymbole;
    alias FindSymbol = ChercherSymbole;
    alias InitializeDynamicSymbolTable = InitialiserTableSymbolesDynamique;
    alias DestroyDynamicSymbolTable = DetruireTableSymbolesDynamique;
    alias ReserveDynamicSymbolTable = ReserverTableSymbolesDynamique;
    alias InsertDynamicSymbol = InsererTableSymbolesDynamique;
    alias FindDynamicSymbol = ChercherTableSymbolesDynamique;
    alias LoadFile = ChargerFichier;
    alias SaveFile = SauverFichier;
    alias LoadAllocatedFile = ChargerFichierAlloue;
    alias InitializeAllocatedFile = InitialiserFichierAlloue;
    alias FreeAllocatedFile = LibererFichierAlloue;
    alias SaveFileResult = SauverFichierResultat;
    alias JoinUtf8Path = JoindreCheminUtf8;
    alias FileNameView = NomFichierVue;
    alias ExtensionView = ExtensionVue;
    alias ReportDiagnostic = SignalerDiagnostic;
}

espace GalacticShrine::GsPP::Hote {
    externe octet* AllouerMemoire(naturel64 taille);
    externe vide LibererMemoire(octet* adresse);
    externe naturel32 LireFichier(
        GalacticShrine::GsPP::Hebergee::RequeteFichier* requete);
    externe naturel32 EcrireFichier(
        GalacticShrine::GsPP::Hebergee::RequeteFichier* requete);
    externe vide EmettreDiagnostic(
        GalacticShrine::GsPP::Hebergee::Diagnostic diagnostic);
}

alias GalacticShrine::GsPP::Hosted::TextView = GalacticShrine::GsPP::Hebergee::VueTexte;
alias GalacticShrine::GsPP::Hosted::Utf8String = GalacticShrine::GsPP::Hebergee::ChaineUtf8;
alias GalacticShrine::GsPP::Hosted::DynamicByteVector =
    GalacticShrine::GsPP::Hebergee::VecteurOctetsDynamique;
alias GalacticShrine::GsPP::Hosted::DynamicValueVector =
    GalacticShrine::GsPP::Hebergee::VecteurNaturelsDynamique;
alias GalacticShrine::GsPP::Hosted::ArenaBlock = GalacticShrine::GsPP::Hebergee::BlocArene;
alias GalacticShrine::GsPP::Hosted::Arena = GalacticShrine::GsPP::Hebergee::AreneMemoire;
alias GalacticShrine::GsPP::Hosted::InputStream = GalacticShrine::GsPP::Hebergee::FluxLecture;
alias GalacticShrine::GsPP::Hosted::OutputStream = GalacticShrine::GsPP::Hebergee::FluxEcriture;
alias GalacticShrine::GsPP::Hosted::ValueVector = GalacticShrine::GsPP::Hebergee::VecteurNaturels;
alias GalacticShrine::GsPP::Hosted::SymbolEntry = GalacticShrine::GsPP::Hebergee::EntreeTableSymboles;
alias GalacticShrine::GsPP::Hosted::SymbolTable = GalacticShrine::GsPP::Hebergee::TableSymboles;
alias GalacticShrine::GsPP::Hosted::DynamicSymbolTable =
    GalacticShrine::GsPP::Hebergee::TableSymbolesDynamique;
alias GalacticShrine::GsPP::Hosted::FileRequest = GalacticShrine::GsPP::Hebergee::RequeteFichier;
alias GalacticShrine::GsPP::Hosted::AllocatedFile = GalacticShrine::GsPP::Hebergee::FichierAlloue;
alias GalacticShrine::GsPP::Hosted::Diagnostic = GalacticShrine::GsPP::Hebergee::Diagnostic;
alias GalacticShrine::GsPP::Hosted::MakeTextView = GalacticShrine::GsPP::Hebergee::CreerVueTexte;
alias GalacticShrine::GsPP::Hosted::MakeTerminatedTextView =
    GalacticShrine::GsPP::Hebergee::CreerVueTexteTerminee;
alias GalacticShrine::GsPP::Hosted::TextViewsEqual = GalacticShrine::GsPP::Hebergee::VuesTexteEgales;
alias GalacticShrine::GsPP::Hosted::HashTextView = GalacticShrine::GsPP::Hebergee::HacherVueTexte;
alias GalacticShrine::GsPP::Hosted::ValidateUtf8 = GalacticShrine::GsPP::Hebergee::ValiderUtf8;
alias GalacticShrine::GsPP::Hosted::InitializeUtf8String =
    GalacticShrine::GsPP::Hebergee::InitialiserChaineUtf8;
alias GalacticShrine::GsPP::Hosted::DestroyUtf8String = GalacticShrine::GsPP::Hebergee::DetruireChaineUtf8;
alias GalacticShrine::GsPP::Hosted::ReserveUtf8String = GalacticShrine::GsPP::Hebergee::ReserverChaineUtf8;
alias GalacticShrine::GsPP::Hosted::AssignUtf8String = GalacticShrine::GsPP::Hebergee::AssignerChaineUtf8;
alias GalacticShrine::GsPP::Hosted::AppendUtf8View = GalacticShrine::GsPP::Hebergee::AjouterVueChaineUtf8;
alias GalacticShrine::GsPP::Hosted::AppendAscii = GalacticShrine::GsPP::Hebergee::AjouterAsciiChaineUtf8;
alias GalacticShrine::GsPP::Hosted::ViewUtf8String = GalacticShrine::GsPP::Hebergee::VueDepuisChaineUtf8;
alias GalacticShrine::GsPP::Hosted::InitializeArena = GalacticShrine::GsPP::Hebergee::InitialiserArene;
alias GalacticShrine::GsPP::Hosted::DestroyArena = GalacticShrine::GsPP::Hebergee::DetruireArene;
alias GalacticShrine::GsPP::Hosted::ArenaAllocate = GalacticShrine::GsPP::Hebergee::AllouerArene;
alias GalacticShrine::GsPP::Hosted::MakeInputStream = GalacticShrine::GsPP::Hebergee::CreerFluxLecture;
alias GalacticShrine::GsPP::Hosted::ReadByte = GalacticShrine::GsPP::Hebergee::LireOctetFlux;
alias GalacticShrine::GsPP::Hosted::ReadBlock = GalacticShrine::GsPP::Hebergee::LireBlocFlux;
alias GalacticShrine::GsPP::Hosted::MakeOutputStream = GalacticShrine::GsPP::Hebergee::CreerFluxEcriture;
alias GalacticShrine::GsPP::Hosted::WriteByte = GalacticShrine::GsPP::Hebergee::EcrireOctetFlux;
alias GalacticShrine::GsPP::Hosted::WriteBlock = GalacticShrine::GsPP::Hebergee::EcrireBlocFlux;
alias GalacticShrine::GsPP::Hosted::InitializeVector =
    GalacticShrine::GsPP::Hebergee::InitialiserVecteurNaturels;
alias GalacticShrine::GsPP::Hosted::AppendValue = GalacticShrine::GsPP::Hebergee::AjouterNaturel;
alias GalacticShrine::GsPP::Hosted::ReadValue = GalacticShrine::GsPP::Hebergee::LireNaturel;
alias GalacticShrine::GsPP::Hosted::InitializeDynamicByteVector =
    GalacticShrine::GsPP::Hebergee::InitialiserVecteurOctetsDynamique;
alias GalacticShrine::GsPP::Hosted::DestroyDynamicByteVector =
    GalacticShrine::GsPP::Hebergee::DetruireVecteurOctetsDynamique;
alias GalacticShrine::GsPP::Hosted::ReserveDynamicByteVector =
    GalacticShrine::GsPP::Hebergee::ReserverVecteurOctetsDynamique;
alias GalacticShrine::GsPP::Hosted::AppendDynamicByteBlock =
    GalacticShrine::GsPP::Hebergee::AjouterBlocVecteurOctetsDynamique;
alias GalacticShrine::GsPP::Hosted::InitializeDynamicValueVector =
    GalacticShrine::GsPP::Hebergee::InitialiserVecteurNaturelsDynamique;
alias GalacticShrine::GsPP::Hosted::DestroyDynamicValueVector =
    GalacticShrine::GsPP::Hebergee::DetruireVecteurNaturelsDynamique;
alias GalacticShrine::GsPP::Hosted::ReserveDynamicValueVector =
    GalacticShrine::GsPP::Hebergee::ReserverVecteurNaturelsDynamique;
alias GalacticShrine::GsPP::Hosted::AppendDynamicValue =
    GalacticShrine::GsPP::Hebergee::AjouterVecteurNaturelsDynamique;
alias GalacticShrine::GsPP::Hosted::ReadDynamicValue =
    GalacticShrine::GsPP::Hebergee::LireVecteurNaturelsDynamique;
alias GalacticShrine::GsPP::Hosted::InitializeSymbolTable =
    GalacticShrine::GsPP::Hebergee::InitialiserTableSymboles;
alias GalacticShrine::GsPP::Hosted::InsertSymbol = GalacticShrine::GsPP::Hebergee::InsererSymbole;
alias GalacticShrine::GsPP::Hosted::FindSymbol = GalacticShrine::GsPP::Hebergee::ChercherSymbole;
alias GalacticShrine::GsPP::Hosted::InitializeDynamicSymbolTable =
    GalacticShrine::GsPP::Hebergee::InitialiserTableSymbolesDynamique;
alias GalacticShrine::GsPP::Hosted::DestroyDynamicSymbolTable =
    GalacticShrine::GsPP::Hebergee::DetruireTableSymbolesDynamique;
alias GalacticShrine::GsPP::Hosted::ReserveDynamicSymbolTable =
    GalacticShrine::GsPP::Hebergee::ReserverTableSymbolesDynamique;
alias GalacticShrine::GsPP::Hosted::InsertDynamicSymbol =
    GalacticShrine::GsPP::Hebergee::InsererTableSymbolesDynamique;
alias GalacticShrine::GsPP::Hosted::FindDynamicSymbol =
    GalacticShrine::GsPP::Hebergee::ChercherTableSymbolesDynamique;
alias GalacticShrine::GsPP::Hosted::LoadFile = GalacticShrine::GsPP::Hebergee::ChargerFichier;
alias GalacticShrine::GsPP::Hosted::SaveFile = GalacticShrine::GsPP::Hebergee::SauverFichier;
alias GalacticShrine::GsPP::Hosted::LoadAllocatedFile = GalacticShrine::GsPP::Hebergee::ChargerFichierAlloue;
alias GalacticShrine::GsPP::Hosted::InitializeAllocatedFile =
    GalacticShrine::GsPP::Hebergee::InitialiserFichierAlloue;
alias GalacticShrine::GsPP::Hosted::FreeAllocatedFile = GalacticShrine::GsPP::Hebergee::LibererFichierAlloue;
alias GalacticShrine::GsPP::Hosted::SaveFileResult = GalacticShrine::GsPP::Hebergee::SauverFichierResultat;
alias GalacticShrine::GsPP::Hosted::JoinUtf8Path = GalacticShrine::GsPP::Hebergee::JoindreCheminUtf8;
alias GalacticShrine::GsPP::Hosted::FileNameView = GalacticShrine::GsPP::Hebergee::NomFichierVue;
alias GalacticShrine::GsPP::Hosted::ExtensionView = GalacticShrine::GsPP::Hebergee::ExtensionVue;
alias GalacticShrine::GsPP::Hosted::ReportDiagnostic = GalacticShrine::GsPP::Hebergee::SignalerDiagnostic;
